-165,23000,-1800,-164,23000,-1400,-163,23000,-1000,-163,23000,-600,-162,23000,-200,-161,23000,200,-160,23000,600,-159,23000,1000,-159,23000,1400,-159,23000,1800,-159,23000,2200,-159,23000,2600,-159,23000,3000,-159,23000,3400,-160,23000,3800,-160,23000,4200,-160,23000,4600,-160,23000,5000,-161,23000,5400,-161,23000,5800,-161,23000,6200,-160,23000,6600,-160,23000,7000,-160,23000,7400,-159,23000,7800,-158,23000,8200,-157,23000,8600,-156,23000,9000,-154,23000,9400,-152,23000,9800,-149,23000,10200,-147,23000,10600,-144,23400,-9800,-203,23400,-9400,-199,23400,-9000,-196,23400,-8600,-193,23400,-8200,-190,23400,-7800,-188,23400,-7400,-185,23400,-7000,-183,23400,-6600,-181,23400,-6200,-179,23400,-5800,-178,23400,-5400,-176,23400,-5000,-175,23400,-4600,-173,23400,-4200,-172,23400,-3800,-171,23400,-3400,-170,23400,-3000,-169,23400,-2600,-168,23400,-2200,-167,23400,-1800,-166,23400,-1400,-165,23400,-1000,-164,23400,-600,-162,23400,-200,-161,23400,200,-160,23400,600,-160,23400,1000,-159,23400,1400,-159,23400,1800,-159,23400,2200,-159,23400,2600,-159,23400,3000,-159,23400,3400,-159,23400,3800,-159,23400,4200,-159,23400,4600,-159,23400,5000,-159,23400,5400,-159,23400,5800,-159,23400,6200,-159,23400,6600,-159,23400,7000,-158,23400,7400,-157,23400,7800,-157,23400,8200,-155,23400,8600,-154,23400,9000,-152,23400,9400,-150,23400,9800,-148,23800,-8600,-199,23800,-8200,-196,23800,-7800,-193,23800,-7400,-191,23800,-7000,-188,23800,-6600,-186,23800,-6200,-184,23800,-5800,-182,23800,-5400,-180,23800,-5000,-178,23800,-4600,-177,23800,-4200,-175,23800,-3800,-174,23800,-3400,-172,23800,-3000,-171,23800,-2600,-170,23800,-2200,-168,23800,-1800,-167,23800,-1400,-166,23800,-1000,-164,23800,-600,-163,23800,-200,-162,23800,200,-161,23800,600,-160,23800,1000,-159,23800,1400,-159,23800,1800,-158,23800,2200,-158,23800,2600,-158,23800,3000,-158,23800,3400,-158,23800,3800,-158,23800,4200,-158,23800,4600,-158,23800,5000,-158,23800,5400,-158,23800,5800,-158,23800,6200,-158,23800,6600,-157,23800,7000,-157,23800,7400,-156,23800,7800,-155,23800,8200,-154,23800,8600,-153,24200,-7400,-196,24200,-7000,-193,24200,-6600,-191,24200,-6200,-188,24200,-5800,-186,24200,-5400,-184,24200,-5000,-182,24200,-4600,-180,24200,-4200,-178,24200,-3800,-176,24200,-3400,-175,24200,-3000,-173,24200,-2600,-172,24200,-2200,-170,24200,-1800,-168,24200,-1400,-167,24200,-1000,-166,24200,-600,-164,24200,-200,-163,24200,200,-161,24200,600,-160,24200,1000,-160,24200,1400,-159,24200,1800,-158,24200,2200,-158,24200,2600,-158,24200,3000,-158,24200,3400,-157,24200,3800,-157,24200,4200,-157,24200,4600,-157,24200,5000,-157,24200,5400,-157,24200,5800,-157,24200,6200,-156,24200,6600,-156,24200,7000,-155,24200,7400,-155,24600,-6200,-192,24600,-5800,-190,24600,-5400,-188,24600,-5000,-185,24600,-4600,-183,24600,-4200,-181,24600,-3800,-179,24600,-3400,-177,24600,-3000,-175,24600,-2600,-173,24600,-2200,-172,24600,-1800,-170,24600,-1400,-168,24600,-1000,-167,24600,-600,-165,24600,-200,-163,24600,200,-162,24600,600,-161,24600,1000,-160,24600,1400,-159,24600,1800,-158,24600,2200,-158,24600,2600,-158,24600,3000,-157,24600,3400,-157,24600,3800,-157,24600,4200,-157,24600,4600,-156,24600,5000,-156,24600,5400,-156,24600,5800,-156,24600,6200,-155,25000,-4200,-184,25000,-3800,-182,25000,-3400,-179,25000,-3000,-177,25000,-2600,-175,25000,-2200,-173,25000,-1800,-171,25000,-1400,-169,25000,-1000,-168,25000,-600,-166,25000,-200,-164,25000,200,-163,25000,600,-161,25000,1000,-160,25000,1400,-159,25000,1800,-159,25000,2200,-158,25000,2600,-157,25000,3000,-157,25000,3400,-157,25000,3800,-156,25000,4200,-156]]
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX22"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX20"><Properties><string name="Name">GameServer</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - players, cars, money, upgrades, the car wheel, race and heist rewards, saving, purchases, day and night.
-- Each player always drives: on spawn the server builds their car, seats them and gives their device network ownership; the device
-- (StarterPlayerScripts/Main + Client modules) runs the driving model, traffic, races and the heist, and asks the server for every
-- change of money, which the server checks (rate caps, minimum times, distances) before it pays.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local PhysicsService = game:GetService("PhysicsService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Shared = ReplicatedStorage:WaitForChild("IrbidShared")
local Meta = require(Shared:WaitForChild("Meta"))
local Circuits = require(Shared:WaitForChild("Circuits"))
local S = Config.SCALE
-- characters load only once the map exists (otherwise they fall through the empty world while WorldBuilder runs)
Players.CharacterAutoLoads = false

Workspace:SetAttribute("StartHeading", Meta.startHeading)
Workspace:SetAttribute("StartY", Meta.startY)
Workspace:SetAttribute("Attribution", Meta.attribution)

-- ---- remotes ----
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local function remote(cls, name)
	local r = Instance.new(cls)
	r.Name = name
	r.Parent = remotes
	return r
end
local BankDrift = remote("RemoteEvent", "BankDrift")
local CarAction = remote("RemoteFunction", "CarAction")
local ResetCar = remote("RemoteEvent", "ResetCar")
local CarReady = remote("RemoteEvent", "CarReady")
local Mission = remote("RemoteFunction", "Mission")
remotes.Parent = ReplicatedStorage

-- cars and drivers do not collide with the world through the physics engine: the devices do their own ground and wall tests
pcall(function() PhysicsService:RegisterCollisionGroup("Drive") end)
PhysicsService:CollisionGroupSetCollidable("Drive", "Default", false)
PhysicsService:CollisionGroupSetCollidable("Drive", "Drive", false)

-- ---- saving (works in a published game; in Studio enable "Studio Access to API Services" to test it) ----
local store
pcall(function() store = DataStoreService:GetDataStore("IrbidDrive_v1") end)
local data = {} -- [player] = {cash, bank, dt, owned = {[i]=true}, cur, tune = {[i] = {4 levels}}, vip, last, ...}

local function cleanLevels(t)
	local l = {}
	for k = 1, 4 do
		local v = type(t) == "table" and tonumber(t[k]) or 0
		l[k] = math.clamp(math.floor(v or 0), 0, Config.UPGRADE_MAX)
	end
	return l
end

local function load(plr)
	local d
	if store then
		local ok, v = pcall(function() return store:GetAsync("u" .. plr.UserId) end)
		if ok and type(v) == "table" then d = v end
	end
	d = d or {}
	local owned = {}
	for _, i in ipairs(type(d.owned) == "table" and d.owned or {}) do
		if Config.CARS[i] then owned[i] = true end
	end
	owned[1] = true
	local tune = {}
	if type(d.tune) == "table" then
		for k, t in pairs(d.tune) do
			local i = tonumber(k)
			if i and Config.CARS[i] then tune[i] = cleanLevels(t) end
		end
	end
	local cur = (type(d.cur) == "number" and owned[d.cur]) and d.cur or 1
	-- version 1 saves (the first Roblox build) had only a lifetime "drift" total
	local dt = tonumber(d.dt) or tonumber(d.drift) or 0
	return {
		cash = math.max(0, tonumber(d.cash) or Config.START_CASH), bank = math.max(0, tonumber(d.bank) or 0), dt = math.max(0, dt),
		owned = owned, cur = cur, tune = tune, last = os.clock(), heistCool = 0,
	}
end

local function save(plr)
	local d = data[plr]
	if not (d and store) then return end
	local owned, tune = {}, {}
	for i in pairs(d.owned) do owned[#owned + 1] = i end
	for i, t in pairs(d.tune) do tune[tostring(i)] = t end
	pcall(function()
		store:SetAsync("u" .. plr.UserId, { v = 2, cash = math.floor(d.cash), bank = math.floor(d.bank), dt = math.floor(d.dt), owned = owned, cur = d.cur, tune = tune })
	end)
end

local function vipOwned(plr)
	if Config.GAMEPASS_VIP == 0 then return false end
	local ok, has = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(plr.UserId, Config.GAMEPASS_VIP) end)
	return ok and has
end

local function levels(d, i)
	local t = d.tune[i]
	if not t then
		t = { 0, 0, 0, 0 }
		d.tune[i] = t
	end
	return t
end

local function syncStats(plr)
	local d = data[plr]
	local ls = plr:FindFirstChild("leaderstats")
	if not (d and ls) then return end
	ls.Cash.Value = math.floor(d.cash)
	ls.Drift.Value = math.floor(d.dt)
	local owned = {}
	for i in pairs(d.owned) do owned[#owned + 1] = i end
	table.sort(owned)
	plr:SetAttribute("Owned", table.concat(owned, ","))
	plr:SetAttribute("CurCar", d.cur)
	plr:SetAttribute("VIP", d.vip == true)
	plr:SetAttribute("Cash", math.floor(d.cash))
	plr:SetAttribute("DriftBank", math.floor(d.bank))
	plr:SetAttribute("Tune", table.concat(levels(d, d.cur), ","))
end

-- ---- the car: a simple body (no brand), cabin, four wheels, lights and a seat, all welded; the player's device moves it ----
local night = false
local function buildCar(spec, color, carIndex)
	local L, W, H = spec.L * S, spec.W * S, spec.H * S
	local m = Instance.new("Model")
	m.Name = "Car"
	local body = Instance.new("Part")
	body.Name = "Body"
	-- anchored until the player's device has taken the car over (CarReady), so it cannot fall through the map before that
	body.Anchored = true
	body.Size = Vector3.new(W, H * 0.55, L)
	body.Color = color
	body.Material = Enum.Material.SmoothPlastic
	body.CFrame = CFrame.new(0, H * 0.45, 0)
	body.Parent = m
	m.PrimaryPart = body
	local function add(name, size, cf, col, mat, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = body.CFrame * cf
		p.Color = col
		p.Material = mat or Enum.Material.SmoothPlastic
		if shape then p.Shape = shape end
		p.Massless = true
		p.Parent = m
		local w = Instance.new("WeldConstraint")
		w.Part0 = body
		w.Part1 = p
		w.Parent = p
		return p
	end
	-- cabin height by body type (web game classes): SUV / pickup tall, open cars low
	local bt = spec.body
	local ch = (bt == "s" or bt == "p") and 0.55 or (bt == "o" or bt == "q") and 0.22 or 0.42
	add("Cabin", Vector3.new(W * 0.86, H * ch, L * 0.48), CFrame.new(0, H * (0.27 + ch / 2), L * 0.05), Color3.fromRGB(30, 36, 44), Enum.Material.Glass)
	local wr = H * 0.22
	for _, q in ipairs({ { 1, -1 }, { -1, -1 }, { 1, 1 }, { -1, 1 } }) do
		add("Wheel", Vector3.new(W * 0.12, wr * 2, wr * 2), CFrame.new(q[1] * W * 0.47, -H * 0.12, q[2] * L * 0.32), Color3.fromRGB(20, 20, 20), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
	end
	for _, x in ipairs({ -1, 1 }) do
		local hl = add("Headlight", Vector3.new(W * 0.18, H * 0.08, 0.2), CFrame.new(x * W * 0.32, H * 0.05, -L * 0.5), Color3.fromRGB(255, 250, 220), Enum.Material.Neon)
		local sl = Instance.new("SpotLight")
		sl.Name = "Beam"
		sl.Face = Enum.NormalId.Front
		sl.Range = 40 * S
		sl.Angle = 70
		sl.Brightness = 3
		sl.Enabled = night
		sl.Parent = hl
		add("Taillight", Vector3.new(W * 0.18, H * 0.08, 0.2), CFrame.new(x * W * 0.32, H * 0.05, L * 0.5), Color3.fromRGB(140, 10, 10), Enum.Material.Neon)
	end
	local seat = Instance.new("Seat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2, 0.4, 2)
	seat.CFrame = body.CFrame * CFrame.new(-W * 0.2, H * 0.12, L * 0.08)
	seat.Transparency = 1
	seat.Massless = true
	seat.Parent = m
	local sw = Instance.new("WeldConstraint"); sw.Part0 = body; sw.Part1 = seat; sw.Parent = seat
	-- counter gravity so the device's position updates are not fought by the physics engine
	local att = Instance.new("Attachment"); att.Parent = body
	local vf = Instance.new("VectorForce")
	vf.Name = "Lift"
	vf.Attachment0 = att
	vf.RelativeTo = Enum.ActuatorRelativeTo.World
	vf.ApplyAtCenterOfMass = true
	vf.Parent = body
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CollisionGroup = "Drive"
			p.CanQuery = false
			p.CanTouch = false
		end
	end
	m:SetAttribute("carIndex", carIndex)
	m:SetAttribute("carName", spec.name)
	return m
end

local COLORS = { Color3.fromRGB(20, 90, 200), Color3.fromRGB(200, 30, 30), Color3.fromRGB(240, 240, 240), Color3.fromRGB(250, 170, 0), Color3.fromRGB(20, 160, 90), Color3.fromRGB(120, 40, 180) }

-- builds the player's current car and seats them. keep = put it where the old car was (car change, reset), else at the start street
local function spawnCar(plr, keep)
	local char = plr.Character
	local d = data[plr]
	if not (char and d) then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) then return end
	while not Workspace:GetAttribute("MapReady") do task.wait(0.5) end
	local spec = Config.CARS[d.cur]
	local pos, f
	local old = Workspace:FindFirstChild("Car_" .. plr.UserId)
	if old and keep and old.PrimaryPart then
		local cf = old.PrimaryPart.CFrame
		local lv = cf.LookVector
		f = Vector3.new(lv.X, 0, lv.Z)
		f = f.Magnitude > 0.01 and f.Unit or Vector3.new(0, 0, 1)
		pos = cf.Position + Vector3.new(0, 1.5 * S, 0)
	end
	if old then old:Destroy() end
	if not pos then
		-- each player starts a little apart along the start street
		local off = (#Players:GetPlayers() - 1) % 6
		local h = Meta.startHeading
		f = Vector3.new(math.sin(h), 0, math.cos(h))
		pos = Vector3.new(0, Meta.startY * S + spec.H * S * 0.6, 0) - f * off * 8 * S
	end
	local car = buildCar(spec, COLORS[(plr.UserId % #COLORS) + 1], d.cur)
	car.Name = "Car_" .. plr.UserId
	car:SetAttribute("Owner", plr.UserId)
	car:PivotTo(CFrame.lookAt(pos, pos + f))
	car.Parent = Workspace
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CollisionGroup = "Drive"
			p.CanQuery = false
		end
	end
	hum.UseJumpPower = true
	hum.JumpPower = 0
	root.CFrame = car.DriverSeat.CFrame + Vector3.new(0, 2, 0)
	car.DriverSeat:Sit(hum)
	plr:SetAttribute("CarReady", os.clock())
end

-- the device has attached to its car: let it go (unanchored, owned by that device, gravity cancelled by its Lift force)
CarReady.OnServerEvent:Connect(function(plr, m)
	if typeof(m) ~= "Instance" or m.Name ~= "Car_" .. plr.UserId or m.Parent ~= Workspace then return end
	local body = m:FindFirstChild("Body")
	if not (body and body.Anchored) then return end
	body.Anchored = false
	local lift = body:FindFirstChild("Lift")
	if lift then lift.Force = Vector3.new(0, body.AssemblyMass * Workspace.Gravity, 0) end
	pcall(function() body:SetNetworkOwner(plr) end)
end)

local function setup(plr)
	local d = load(plr)
	d.vip = vipOwned(plr)
	if d.vip then
		for i, c in ipairs(Config.CARS) do
			if c.vip then d.owned[i] = true end
		end
	end
	data[plr] = d
	local ls = Instance.new("Folder"); ls.Name = "leaderstats"; ls.Parent = plr
	local c = Instance.new("IntValue"); c.Name = "Cash"; c.Parent = ls
	local dr = Instance.new("IntValue"); dr.Name = "Drift"; dr.Parent = ls
	syncStats(plr)
	plr.CharacterAdded:Connect(function(char)
		local hum = char:WaitForChild("Humanoid")
		hum.Died:Connect(function()
			task.wait(2)
			if plr.Parent then plr:LoadCharacter() end
		end)
		task.wait(0.5)
		spawnCar(plr, false)
	end)
	while not Workspace:GetAttribute("MapReady") do task.wait(0.5) end
	if plr.Parent then plr:LoadCharacter() end
end

Players.PlayerAdded:Connect(setup)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(setup, p) end
Players.PlayerRemoving:Connect(function(plr)
	save(plr)
	local car = Workspace:FindFirstChild("Car_" .. plr.UserId)
	if car then car:Destroy() end
	data[plr] = nil
end)
game:BindToClose(function()
	for _, p in ipairs(Players:GetPlayers()) do save(p) end
end)
task.spawn(function()
	while true do
		task.wait(120)
		for _, p in ipairs(Players:GetPlayers()) do save(p) end
	end
end)

-- ---- drift points -> drift bank (upgrades) + cash. Server cap: points per second of driving since the last bank, scaled by the car's
-- rarity and drift upgrade (the most a long, fast, full-combo drift can score), and never more than 60,000 at once ----
BankDrift.OnServerEvent:Connect(function(plr, pts)
	local d = data[plr]
	if not d or type(pts) ~= "number" or pts ~= pts or pts <= 0 then return end
	local now = os.clock()
	local t = Config.tuned(d.cur, levels(d, d.cur))
	local cap = math.min(60000, (now - d.last) * 1500 * t.rm * (1 + 0.2 * t.dr))
	d.last = now
	pts = math.floor(math.min(pts, cap))
	d.bank += pts
	d.dt += pts
	d.cash += pts * Config.DRIFT_CASH * (d.vip and 2 or 1)
	syncStats(plr)
end)

ResetCar.OnServerEvent:Connect(function(plr)
	local d = data[plr]
	if d and (not d.lastReset or os.clock() - d.lastReset > 3) then
		d.lastReset = os.clock()
		spawnCar(plr, true)
	end
end)

-- ---- the car wheel: tier by the web game's odds, then one of that tier's (non-VIP) cars ----
local function spinWheel(d)
	local r, a, tier = math.random(), 0, 0
	for i, p in ipairs(Config.WHEEL_ODDS) do
		a += p
		if r < a then
			tier = i - 1
			break
		end
	end
	for t = tier, 0, -1 do
		local pool = {}
		for i, c in ipairs(Config.CARS) do
			if c.tier == t and not c.vip then pool[#pool + 1] = i end
		end
		if #pool > 0 then
			return pool[math.random(#pool)], t
		end
	end
	return 1, 0
end

-- ---- garage, tuning shop, wheel; Robux buttons only when the IDs are set in Config ----
local function nearSite(plr, site, metres)
	local car = Workspace:FindFirstChild("Car_" .. plr.UserId)
	if not (car and car.PrimaryPart) then return false end
	local p = car.PrimaryPart.Position / S
	return math.sqrt((p.X - site.x) ^ 2 + (p.Z - site.z) ^ 2) <= metres
end

CarAction.OnServerInvoke = function(plr, action, i)
	local d = data[plr]
	if not d then return false, "not ready" end
	if action == "use" or action == "buy" then
		local spec = type(i) == "number" and Config.CARS[i]
		if not spec then return false, "no such car" end
		if spec.vip and not d.vip then
			if Config.GAMEPASS_VIP ~= 0 then MarketplaceService:PromptGamePassPurchase(plr, Config.GAMEPASS_VIP) end
			return false, "VIP car"
		end
		if not d.owned[i] then
			if d.cash < spec.price then return false, "Not enough cash" end
			d.cash -= spec.price
			d.owned[i] = true
		end
		d.cur = i
		syncStats(plr)
		save(plr)
		spawnCar(plr, true)
		return true, spec.name
	elseif action == "upgrade" then
		local part = type(i) == "number" and Config.UPGRADES[i] and i
		if not part then return false, "no such part" end
		if not nearSite(plr, Meta.shop, 40) then return false, "Drive to Apex Drift Customs first" end
		local l = levels(d, d.cur)
		if l[part] >= Config.UPGRADE_MAX then return false, "Already at the top level" end
		local price = Config.upgradePrice(part, l[part])
		if d.bank < price then return false, "Not enough drift points" end
		d.bank -= price
		l[part] += 1
		syncStats(plr)
		save(plr)
		return true, l[part]
	elseif action == "spin" then
		if d.cash < Config.WHEEL_COST then return false, "Not enough cash" end
		d.cash -= Config.WHEEL_COST
		local car, tier = spinWheel(d)
		local dup = d.owned[car] == true
		if dup then
			d.cash += Config.WHEEL_REFUND
		else
			d.owned[car] = true
			d.cur = car
		end
		syncStats(plr)
		save(plr)
		if not dup then task.spawn(spawnCar, plr, true) end
		return true, { car = car, tier = tier, dup = dup }
	elseif action == "cash_small" and Config.PRODUCT_CASH_SMALL ~= 0 then
		MarketplaceService:PromptProductPurchase(plr, Config.PRODUCT_CASH_SMALL)
	elseif action == "cash_big" and Config.PRODUCT_CASH_BIG ~= 0 then
		MarketplaceService:PromptProductPurchase(plr, Config.PRODUCT_CASH_BIG)
	elseif action == "vip" and Config.GAMEPASS_VIP ~= 0 then
		MarketplaceService:PromptGamePassPurchase(plr, Config.GAMEPASS_VIP)
	end
	return true
end

-- ---- races and the heist: the device plays them; the server pays only for results that are possible ----
local circuitLen = {}
for _, c in ipairs(Circuits) do
	local v, len, px, pz = {}, 0, nil, nil
	for n in string.gmatch(c.path, "-?%d+") do v[#v + 1] = tonumber(n) / 10 end
	for k = 1, #v, 3 do
		if px then len += math.sqrt((v[k] - px) ^ 2 + (v[k + 1] - pz) ^ 2) end
		px, pz = v[k], v[k + 1]
	end
	circuitLen[c.name] = len
end

Mission.OnServerInvoke = function(plr, action, arg)
	local d = data[plr]
	if not d then return false, "not ready" end
	local now = os.clock()
	if action == "race_start" then
		if type(arg) ~= "string" or not circuitLen[arg] then return false, "no such race" end
		d.race = { name = arg, t0 = now }
		return true
	elseif action == "race_cancel" then
		d.race = nil
		return true
	elseif action == "race_finish" then
		local r = d.race
		d.race = nil
		if not r or type(arg) ~= "number" then return false, "no race" end
		-- no car can lap faster than its top speed (+20 %) the whole way, from the 3 s countdown on
		local t = Config.tuned(d.cur, levels(d, d.cur))
		if now - r.t0 < 3 + circuitLen[r.name] / (t.vm * 1.2) then return false, "Result not accepted" end
		local reward = Config.RACE_REWARD[math.clamp(math.floor(arg), 1, #Config.RACE_REWARD)] or 0
		d.cash += reward
		syncStats(plr)
		save(plr)
		return true, reward
	elseif action == "heist_start" then
		if now < d.heistCool then return false, "The bank is closed for now" end
		if not nearSite(plr, Meta.bank, 30) then return false, "Drive to the bank first" end
		d.heist = now
		return true
	elseif action == "heist_end" then
		local t0 = d.heist
		d.heist = nil
		if not t0 then return false, "no heist" end
		d.heistCool = now + Config.HEIST_COOLDOWN
		plr:SetAttribute("BankOpenAt", Workspace.DistributedGameTime + Config.HEIST_COOLDOWN)
		if arg == true then
			if now - t0 < Config.HEIST_TIME - 3 then return false, "Result not accepted" end
			d.cash += Config.HEIST_REWARD
			syncStats(plr)
			save(plr)
			return true, Config.HEIST_REWARD
		end
		local loss = math.min(Config.HEIST_FINE, math.floor(d.cash))
		d.cash -= loss
		syncStats(plr)
		save(plr)
		return true, -loss
	end
	return false, "unknown action"
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(plr, id, bought)
	local d = data[plr]
	if bought and id == Config.GAMEPASS_VIP and d then
		d.vip = true
		for i, c in ipairs(Config.CARS) do
			if c.vip then d.owned[i] = true end
		end
		syncStats(plr)
	end
end)

-- developer products: grant once per receipt (Roblox retries until we return PurchaseGranted)
local granted = {}
MarketplaceService.ProcessReceipt = function(info)
	local plr = Players:GetPlayerByUserId(info.PlayerId)
	local d = plr and data[plr]
	if not d then return Enum.ProductPurchaseDecision.NotProcessedYet end
	if granted[info.PurchaseId] then return Enum.ProductPurchaseDecision.PurchaseGranted end
	local add = (info.ProductId == Config.PRODUCT_CASH_SMALL and Config.CASH_SMALL) or (info.ProductId == Config.PRODUCT_CASH_BIG and Config.CASH_BIG) or 0
	if add == 0 then return Enum.ProductPurchaseDecision.NotProcessedYet end
	d.cash += add
	granted[info.PurchaseId] = true
	syncStats(plr)
	save(plr)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- ---- day and night: one in-game day every Config.DAY_MINUTES real minutes; car headlights on at night ----
task.spawn(function()
	local t0 = os.clock()
	while true do
		local h = (9 + (os.clock() - t0) / (Config.DAY_MINUTES * 60) * 24) % 24
		Lighting.ClockTime = h
		local nowNight = h < 6.3 or h > 18.2
		if nowNight ~= night then
			night = nowNight
			for _, m in ipairs(Workspace:GetChildren()) do
				if m:IsA("Model") and string.sub(m.Name, 1, 4) == "Car_" then
					for _, l in ipairs(m:GetDescendants()) do
						if l:IsA("SpotLight") then l.Enabled = night end
					end
				end
			end
		end
		Workspace:SetAttribute("Night", night)
		task.wait(1)
	end
end)
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX21"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - builds the map when the server starts, from ServerStorage.IrbidData (generated by tools/make_roblox.js from
-- OpenStreetMap roads + buildings and NASA SRTM terrain; the same data as the web game). Units in the data: decimetres, centred on the start.
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Shared = ReplicatedStorage:WaitForChild("IrbidShared")
local Meta = require(Shared:WaitForChild("Meta"))
local Circuits = require(Shared:WaitForChild("Circuits"))

local DATA = ServerStorage:WaitForChild("IrbidData")
local S = Config.SCALE
local D = S / 10 -- decimetres -> studs

local function nums(s)
	local t = {}
	for n in string.gmatch(s, "-?%d+") do
		t[#t + 1] = tonumber(n)
	end
	return t
end

local function chunks(prefix)
	local list, i = {}, 1
	while DATA:FindFirstChild(prefix .. i) do
		list[#list + 1] = nums(require(DATA[prefix .. i]))
		i += 1
	end
	return list
end

Lighting.ClockTime = 9
Lighting.Brightness = 2.5
Lighting.OutdoorAmbient = Color3.fromRGB(150, 140, 125)
local atm = Instance.new("Atmosphere")
atm.Density = 0.28
atm.Haze = 1.2
atm.Color = Color3.fromRGB(214, 200, 176)
atm.Decay = Color3.fromRGB(120, 110, 95)
atm.Parent = Lighting
Workspace.Gravity = 196.2

local map = Instance.new("Folder")
map.Name = "IrbidMap"
local roadsF = Instance.new("Folder"); roadsF.Name = "Roads"; roadsF.Parent = map
local bldF = Instance.new("Folder"); bldF.Name = "Buildings"; bldF.Parent = map
local siteF = Instance.new("Folder"); siteF.Name = "Sites"; siteF.Parent = map

-- ---- terrain: 40 m tiles of ground, top 0.6 m under the road level ----
local T = Workspace.Terrain
local tile = 40 * S
for _, t in ipairs(chunks("Terrain")) do
	for i = 1, #t, 3 do
		local x, z, y = t[i] * D, t[i + 1] * D, t[i + 2] * D
		T:FillBlock(CFrame.new(x, y - 0.6 * S - 6, z), Vector3.new(tile, 12, tile), Enum.Material.Ground)
	end
	task.wait()
end

-- ---- roads: one part per OSM segment, sloped between the two terrain heights, overlapping at joints ----
local ROADC = {
	[0] = Color3.fromRGB(58, 60, 64), -- major
	[1] = Color3.fromRGB(70, 72, 76), -- local
	[2] = Color3.fromRGB(96, 92, 86), -- service / alley
	[3] = Color3.fromRGB(58, 60, 64), -- roundabout
}
local n = 0
for _, r in ipairs(chunks("Roads")) do
	for i = 1, #r, 8 do
		local a = Vector3.new(r[i] * D, r[i + 4] * D + 0.1 * S, r[i + 1] * D)
		local b = Vector3.new(r[i + 2] * D, r[i + 5] * D + 0.1 * S, r[i + 3] * D)
		local w = r[i + 6] * D
		local len = (b - a).Magnitude
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanTouch = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.Material = Enum.Material.Asphalt
		p.Color = ROADC[r[i + 7]] or ROADC[1]
		p.Size = Vector3.new(w, 1.2 * S, len + w * 0.5)
		-- part centre sits 0.6 m below the road surface (thick slab, so it meets the ground)
		p.CFrame = CFrame.lookAt((a + b) / 2, b) * CFrame.new(0, -0.6 * S, 0)
		p.Name = "Road"
		p.Parent = roadsF
		n += 1
		if n % 1500 == 0 then task.wait() end
	end
end

-- ---- buildings: OSM footprint pieces (rectangles), estimated heights where OSM has none ----
local BC = {
	[0] = Color3.fromRGB(214, 200, 176), [1] = Color3.fromRGB(226, 214, 190), [2] = Color3.fromRGB(205, 192, 170),
	[3] = Color3.fromRGB(190, 186, 176), [4] = Color3.fromRGB(170, 166, 160), [5] = Color3.fromRGB(236, 230, 214),
	[6] = Color3.fromRGB(180, 196, 205), [7] = Color3.fromRGB(160, 150, 136),
}
for _, b in ipairs(chunks("Buildings")) do
	for i = 1, #b, 8 do
		local w, d, h = b[i + 2] * D, b[i + 3] * D, b[i + 5] * D + 1 * S
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanTouch = false
		p.Material = Enum.Material.Concrete
		p.Color = BC[b[i + 7]] or BC[0]
		p.Size = Vector3.new(w, h, d)
		p.CFrame = CFrame.new(b[i] * D, b[i + 6] * D - 1 * S + h / 2, b[i + 1] * D) * CFrame.Angles(0, b[i + 4] / 1000, 0)
		p.Name = "Building"
		p.Parent = bldF
		n += 1
		if n % 1500 == 0 then task.wait() end
	end
end

-- ---- a floating name sign ----
local function sign(parent, pos, text, color, maxDist, w)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.Position = pos
	p.Name = "Label"
	local g = Instance.new("BillboardGui")
	g.Size = UDim2.fromOffset(w or 260, 40)
	g.MaxDistance = maxDist or 700
	g.AlwaysOnTop = false
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.TextScaled = true
	t.Font = Enum.Font.GothamBold
	t.TextColor3 = color or Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.3
	t.Text = text
	t.Parent = g
	g.Parent = p
	p.Parent = parent
	return p
end

-- ---- landmark name labels ----
for _, L in ipairs(Meta.labels) do
	sign(map, Vector3.new(L.x * S, L.y * S + 18 * S, L.z * S), L.n)
end

-- ---- game sites (the web game's positions): the bank, Apex Drift Customs, race starts. Glowing pads, no collision ----
local function pad(name, x, y, z, radius, color, text)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Shape = Enum.PartType.Cylinder
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 0.45
	p.Size = Vector3.new(0.3 * S, radius * 2 * S, radius * 2 * S)
	p.CFrame = CFrame.new(x * S, (y + 0.25) * S, z * S) * CFrame.Angles(0, 0, math.pi / 2)
	p.Parent = siteF
	sign(siteF, Vector3.new(x * S, (y + 9) * S, z * S), text, color, 1500, 320)
	return p
end
pad("BankPad", Meta.bank.x, Meta.bank.y, Meta.bank.z, 7, Color3.fromRGB(255, 60, 60), "🏦 BANK · press E")
pad("ShopPad", Meta.shop.x, Meta.shop.y, Meta.shop.z, 7, Color3.fromRGB(255, 122, 0), "🔧 APEX DRIFT CUSTOMS · press U")
for _, c in ipairs(Circuits) do
	local x, z, y = string.match(c.path, "^(-?%d+),(-?%d+),(-?%d+)")
	pad("RacePad", tonumber(x) / 10, tonumber(y) / 10, tonumber(z) / 10, 5, Color3.fromRGB(51, 224, 255), "🏁 " .. c.name .. " · press R")
end

-- spawn point at the web game's start (Baghdad Street, Al-Balad)
local sp = Instance.new("SpawnLocation")
sp.Anchored = true
sp.Size = Vector3.new(6, 1, 6)
sp.Transparency = 1
sp.CanCollide = false
sp.CanQuery = false
sp.Position = Vector3.new(0, Meta.startY * S + 6, 0)
sp.Parent = map

map.Parent = Workspace
Workspace:SetAttribute("MapReady", true)
print(("Irbid Drive map built: %d roads, %d buildings, %d labels"):format(Meta.roadCount, Meta.buildingCount, #Meta.labels))
]]></ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX33"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX32"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX30"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">Drive</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the player's car on this device: driving model, ground and wall tests, bumping into AI cars and other
-- players, drift points, reset, camera, brake lights and the optional engine sound.
-- Driving model = the web game's Arcade handling (10_laws_player.js updP): world velocity, heading turned by steering, the velocity split into
-- forward / sideways parts, the sideways part decays (slowly with the handbrake -> drift). Drift points use the web formula, with the car's
-- rarity multiplier and the Extra Drift Points upgrade. Units: metres and seconds; drawn at Config.SCALE studs per metre.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Road = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Road"))
local State = require(script.Parent:WaitForChild("State"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Drive = {}
local S = Config.SCALE
local plr = Players.LocalPlayer
local st, spec, inp = State.st, State.spec, State.input
local drift = { pts = 0, t = 0, off = 0 }
Drive.drift = drift

local map = Workspace:WaitForChild("IrbidMap")
-- ground = roads + terrain only; walls = buildings only (so road joints and terrain steps never stop the car)
local groundP = RaycastParams.new()
groundP.FilterType = Enum.RaycastFilterType.Include
groundP.FilterDescendantsInstances = { map:WaitForChild("Roads"), Workspace.Terrain }
local wallP = RaycastParams.new()
wallP.FilterType = Enum.RaycastFilterType.Include
wallP.FilterDescendantsInstances = { map:WaitForChild("Buildings") }

local function clamp(v, a, b)
	return v < a and a or v > b and b or v
end

-- ground height (m) under (x, z), looking down from yTop (m) at most 400 m; nil when there is none
function Drive.groundY(x, z, yTop)
	local g = Workspace:Raycast(Vector3.new(x, yTop, z) * S, Vector3.new(0, -400 * S, 0), groundP)
	return g and g.Position.Y / S, g
end

-- ---- car stats: the car's base numbers (Config.CARS) with this player's upgrades ----
function Drive.applySpec()
	local car = State.car
	local ci = (car and car:GetAttribute("carIndex")) or plr:GetAttribute("CurCar") or 1
	local lv, i = { 0, 0, 0, 0 }, 0
	for n in string.gmatch(plr:GetAttribute("Tune") or "", "%d+") do
		i += 1
		lv[i] = tonumber(n)
	end
	local t = Config.tuned(ci, lv)
	local c = Config.CARS[ci] or Config.CARS[1]
	spec.vm, spec.a0, spec.hd, spec.dr, spec.bk, spec.rm = t.vm, t.a0, t.hd, t.dr, t.bk, t.rm
	spec.tier, spec.name, spec.L, spec.W, spec.H = c.tier, c.name, c.L, c.W, c.H
	Hud.car.Text = c.name .. " · " .. Config.RARITY[c.tier + 1].name .. " ×" .. string.format("%.1f", t.rm)
end
plr:GetAttributeChangedSignal("Tune"):Connect(Drive.applySpec)

-- ---- attach to a newly built car ----
local lights, sound = {}, nil
local function attach(m)
	State.car = m
	local body = m:WaitForChild("Body")
	State.body = body
	Drive.applySpec()
	local cf = body.CFrame
	local lv = cf.LookVector
	st.h = math.atan2(lv.X, lv.Z)
	st.x, st.y, st.z = cf.X / S, cf.Y / S, cf.Z / S
	st.vx, st.vz, st.vy = 0, 0, 0
	lights = {}
	for _, p in ipairs(m:GetChildren()) do
		if p.Name == "Taillight" then lights[#lights + 1] = p end
	end
	sound = nil
	if Config.ENGINE_SOUND_ID ~= 0 then
		sound = Instance.new("Sound")
		sound.SoundId = "rbxassetid://" .. Config.ENGINE_SOUND_ID
		sound.Looped = true
		sound.Volume = 0.45
		sound.Parent = body
		sound:Play()
	end
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	if hum then hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false) end
	-- the server keeps the car anchored until now
	Remotes.CarReady:FireServer(m)
end
Workspace.ChildAdded:Connect(function(c)
	if c.Name == "Car_" .. plr.UserId then attach(c) end
end)
local existing = Workspace:FindFirstChild("Car_" .. plr.UserId)
if existing then task.spawn(attach, existing) end

-- ---- teleport the car (races, reset): position in metres on the ground, heading h, stopped ----
function Drive.place(x, z, h)
	-- the map's ground lies between about -80 m and +80 m: look down from 300 m, so this works from anywhere (also from under the map)
	local gy = Drive.groundY(x, z, 300)
	st.x, st.z, st.h = x, z, h
	st.y = (gy or st.y) + spec.H * 0.34
	st.vx, st.vz, st.vy = 0, 0, 0
	drift.pts, drift.t = 0, 0
end

-- F / Reset: back onto the nearest road (right-hand lane, facing the way the car was going); far from any road -> the start
function Drive.reset()
	local near = State.road and Road.nearest(State.road, st.x, st.z, 400)
	if not near then
		Remotes.ResetCar:FireServer()
		return
	end
	local d = Road.dirFor(near, math.sin(st.h), math.cos(st.h))
	local tx, tz = near.tx * d, near.tz * d
	local off = Road.lane(near.e)
	Drive.place(near.x - tz * off, near.z + tx * off, math.atan2(tx, tz))
end

-- ---- bumping: the player's car as two circles (front and rear axle, r 1 m) against each AI car's box ----
local function bump(cx, cz, ox, oz, oh, hl, hw, ovx, ovz)
	local fx, fz = math.sin(oh), math.cos(oh)
	local rx, rz = -fz, fx
	local dx, dz = cx - ox, cz - oz
	local lon, lat = dx * fx + dz * fz, dx * rx + dz * rz
	local pl, pw = hl + 1 - math.abs(lon), hw + 1 - math.abs(lat)
	if pl <= 0 or pw <= 0 then return false end
	local nx, nz, pen
	if pw < pl then
		local sg = lat >= 0 and 1 or -1
		nx, nz, pen = rx * sg, rz * sg, pw
	else
		local sg = lon >= 0 and 1 or -1
		nx, nz, pen = fx * sg, fz * sg, pl
	end
	st.x += nx * pen
	st.z += nz * pen
	local rv = (st.vx - ovx) * nx + (st.vz - ovz) * nz
	if rv < 0 then
		st.vx -= 1.3 * rv * nx
		st.vz -= 1.3 * rv * nz
		if -rv > 6 then Hud.toast("Crash! " .. math.floor(-rv * 3.6) .. " km/h", 2) end
		if drift.pts > 0 then
			drift.pts, drift.t = 0, 0
			Hud.drift.Text = ""
			Hud.toast("Drift lost", 1.5)
		end
	end
	return true
end

local others, othersT = {}, 0
local function collide(dt)
	local fx, fz = math.sin(st.h), math.cos(st.h)
	local c1x, c1z, c2x, c2z = st.x + fx * 1.2, st.z + fz * 1.2, st.x - fx * 1.2, st.z - fz * 1.2
	for _, a in ipairs(State.ai) do
		local dx, dz = a.x - st.x, a.z - st.z
		if dx * dx + dz * dz < 64 then
			local avx, avz = math.sin(a.h) * a.v, math.cos(a.h) * a.v
			local hit = bump(c1x, c1z, a.x, a.z, a.h, a.L / 2, a.W / 2, avx, avz)
			hit = bump(c2x, c2z, a.x, a.z, a.h, a.L / 2, a.W / 2, avx, avz) or hit
			if hit then a.hit = a.cop and 0.6 or 2.5 end
		end
	end
	-- other players' cars (moved by their own devices): the player only bounces off them
	othersT -= dt
	if othersT <= 0 then
		othersT = 1
		table.clear(others)
		for _, m in ipairs(Workspace:GetChildren()) do
			if m:IsA("Model") and string.sub(m.Name, 1, 4) == "Car_" and m ~= State.car and m.PrimaryPart then
				others[#others + 1] = m.PrimaryPart
			end
		end
	end
	for _, b in ipairs(others) do
		if b.Parent then
			local p = b.Position / S
			local dx, dz = p.X - st.x, p.Z - st.z
			if dx * dx + dz * dz < 64 then
				local lv = b.CFrame.LookVector
				local v = b.AssemblyLinearVelocity / S
				bump(c1x, c1z, p.X, p.Z, math.atan2(lv.X, lv.Z), b.Size.Z / S / 2, b.Size.X / S / 2, v.X, v.Z)
				bump(c2x, c2z, p.X, p.Z, math.atan2(lv.X, lv.Z), b.Size.Z / S / 2, b.Size.X / S / 2, v.X, v.Z)
			end
		end
	end
end

-- ---- one frame of driving ----
function Drive.step(dtr)
	local car, body = State.car, State.body
	if not (car and car.Parent and body and body.Parent) then return end
	-- the driver left the seat (should not happen; jumping is off): ask the server to seat them again
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	if hum and not hum.Sit and os.clock() - (st.reseat or 0) > 3 then
		st.reseat = os.clock()
		Remotes.ResetCar:FireServer()
	end
	local dt = clamp(dtr, 0.004, 0.05)
	local th, br, steer, hb = inp.th, inp.br, inp.steer, inp.hb
	if State.ui then th, br, steer, hb = 0, 0.6, 0, false end
	if State.frozen then
		th, br, steer, hb = 0, 1, 0, false
		st.vx, st.vz = 0, 0
	end
	local fx, fz = math.sin(st.h), math.cos(st.h)
	local fs = st.vx * fx + st.vz * fz
	-- steering (Arcade: rate falls with speed, needs speed to turn, handbrake turns sharper)
	st.h += steer * 1.8 * spec.hd / (1 + math.abs(fs) / 18) * clamp(fs / 4, -1, 1) * (hb and 1.5 or 1) * (st.gnd and 1 or 0.2) * dt
	fx, fz = math.sin(st.h), math.cos(st.h)
	local rx, rz = -fz, fx
	fs = st.vx * fx + st.vz * fz
	local ls = st.vx * rx + st.vz * rz
	if st.gnd then
		if th > 0 then
			local ac = spec.a0 * th * (1 - math.pow(math.max(fs, 0) / (spec.vm * 1.05), 2.5))
			if fs < 0 then ac = math.min(ac * 2, spec.bk) end
			fs += ac * dt
		end
		if br > 0 then
			if fs > 0.5 then
				fs = math.max(0, fs - spec.bk * dt * br)
			else
				fs = math.max(-10, fs - 3.5 * dt * br)
			end
		end
		if hb then fs *= 1 - 0.8 * dt end
		if math.abs(fs) > 0.5 then fs -= math.sign(fs) * 0.5 * dt end
		fs -= fs * 0.012 * dt
		ls *= math.exp(-(hb and 1.1 or ((th > 0 and steer ~= 0 and fs > 15) and 2.4 or 6.5 * spec.hd)) * dt)
	end
	st.vx, st.vz = fx * fs + rx * ls, fz * fs + rz * ls
	-- walls: a ray along the motion; on a hit the car stops against the wall and bounces back a little
	local sp = math.sqrt(st.vx * st.vx + st.vz * st.vz)
	if sp > 0.05 then
		local dir = Vector3.new(st.vx, 0, st.vz) / sp
		local o = Vector3.new(st.x, st.y + 0.3, st.z) * S
		local hit = Workspace:Raycast(o, dir * (sp * dt + 2.4) * S, wallP)
		if hit and hit.Normal.Y < 0.6 then
			local n = Vector3.new(hit.Normal.X, 0, hit.Normal.Z).Unit
			local vn = st.vx * n.X + st.vz * n.Z
			if vn < 0 then
				st.vx -= 1.3 * vn * n.X
				st.vz -= 1.3 * vn * n.Z
				if -vn > 6 then Hud.toast("Crash! " .. math.floor(-vn * 3.6) .. " km/h", 2) end
				if drift.pts > 0 then
					drift.pts, drift.t = 0, 0
					Hud.drift.Text = ""
					Hud.toast("Drift lost", 1.5)
				end
			end
		end
	end
	st.x += st.vx * dt
	st.z += st.vz * dt
	collide(dt)
	-- ground: ray down from 3 m above the car, 40 m long (it climbs kerbs and terrain steps up to 3 m)
	local H0 = spec.H * 0.34
	local g = Workspace:Raycast(Vector3.new(st.x, st.y + 3, st.z) * S, Vector3.new(0, -40 * S, 0), groundP)
	local gy = g and g.Position.Y / S
	if gy and st.y - H0 <= gy + 0.35 and st.vy <= 0.5 then
		st.y = gy + H0
		st.vy = 0
		st.gnd = true
	else
		st.gnd = false
		st.vy -= 9.81 * dt
		st.y += st.vy * dt
		-- fell off the map (nothing below, well under the lowest ground): back onto a road
		if not gy and st.y < -150 then
			Drive.reset()
		end
	end
	-- drift points (the web game's formula: angle x speed x combo, x Extra Drift Points upgrade, x rarity)
	local sa = math.abs(math.atan2(ls, math.abs(fs) + 0.5))
	if st.gnd and sp > 8 and sa > 0.22 - 0.012 * spec.dr and not State.frozen then
		drift.t += dt
		drift.off = 0
		local combo = 1 + math.min(4, drift.t / 3)
		drift.pts += sa * sp * 8 * dt * combo * (1 + 0.2 * spec.dr) * spec.rm
		Hud.drift.Text = "DRIFT  " .. Hud.fmt(drift.pts) .. "  ×" .. string.format("%.1f", combo)
	elseif drift.pts > 0 then
		drift.off += dt
		if drift.off > 0.7 then
			if drift.pts > 40 then
				local n = math.floor(drift.pts + 0.5)
				Remotes.BankDrift:FireServer(n)
				Hud.toast("Drift +" .. Hud.fmt(n) .. (spec.rm > 1 and ("  (" .. Config.RARITY[spec.tier + 1].name .. " ×" .. string.format("%.1f", spec.rm) .. ")") or ""))
			end
			drift.pts, drift.t = 0, 0
			Hud.drift.Text = ""
		end
	end
	st.sp, st.fs = sp, fs
	-- place the car (tilted to the ground normal), cancel gravity, report the velocity for other players' interpolation
	local up = (g and st.gnd and g.Normal.Y > 0.5) and g.Normal.Unit or Vector3.yAxis
	local f = Vector3.new(math.sin(st.h), 0, math.cos(st.h))
	local right = f:Cross(up).Unit
	local fwd = up:Cross(right).Unit
	car:PivotTo(CFrame.fromMatrix(Vector3.new(st.x, st.y, st.z) * S, right, up, -fwd))
	local lift = body:FindFirstChild("Lift")
	if lift then lift.Force = Vector3.new(0, body.AssemblyMass * Workspace.Gravity, 0) end
	body.AssemblyLinearVelocity = Vector3.new(st.vx, 0, st.vz) * S
	body.AssemblyAngularVelocity = Vector3.zero
	-- brake lights (seen on this device) and engine pitch
	local braking = br > 0 and fs > 0.5
	for _, l in ipairs(lights) do
		l.Color = braking and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(140, 10, 10)
	end
	if sound then sound.PlaybackSpeed = 0.7 + 1.1 * math.min(1, math.abs(fs) / spec.vm) + 0.25 * th end
	Hud.speed.Text = tostring(math.floor(sp * 3.6 + 0.5))
end

-- ---- camera: 0 chase, 1 far chase, 2 Roblox's own orbit camera (mouse / touch drag) ----
local camMode, camPos = 0, nil
function Drive.cycleCam()
	camMode = (camMode + 1) % 3
	local cam = Workspace.CurrentCamera
	if camMode == 2 then
		cam.CameraType = Enum.CameraType.Custom
		if State.body then cam.CameraSubject = State.body end
	end
	camPos = nil
	Hud.toast(({ "Camera: chase", "Camera: far chase", "Camera: free (drag to look around)" })[camMode + 1], 1.5)
end
function Drive.camera(dt)
	if camMode == 2 or not (State.car and State.body) then return end
	local cam = Workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	local back, height = camMode == 0 and 7.5 or 13, camMode == 0 and 2.7 or 4.5
	-- look along the direction of travel when moving fast enough (drifts stay readable), else along the car
	local hx, hz = math.sin(st.h), math.cos(st.h)
	if st.sp > 4 and st.fs > 0 then
		local mx, mz = st.vx / st.sp, st.vz / st.sp
		hx, hz = hx * 0.6 + mx * 0.4, hz * 0.6 + mz * 0.4
	end
	local p = Vector3.new(st.x, st.y, st.z)
	local want = (p - Vector3.new(hx, 0, hz) * back + Vector3.new(0, height, 0)) * S
	camPos = camPos and camPos:Lerp(want, 1 - math.exp(-dt * 7)) or want
	cam.CFrame = CFrame.lookAt(camPos, (p + Vector3.new(hx, 0, hz) * 4 + Vector3.new(0, 1, 0)) * S)
end

return Drive
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the on-screen display: info line, speed, drift, mission line, toasts, the context button (rob the bank /
-- tune the car), the button column, and a helper for the menus (garage, shop, wheel, GPS). Sizes in pixels, so it also fits phones.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local State = require(script.Parent:WaitForChild("State"))

local Hud = {}
local plr = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "IrbidHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = plr:WaitForChild("PlayerGui")
Hud.gui = gui

local DARK = Color3.fromRGB(21, 24, 29)
local BLUE = Color3.fromRGB(39, 64, 107)

function Hud.fmt(n)
	local s = tostring(math.floor(n + 0.5))
	local neg = string.sub(s, 1, 1) == "-"
	if neg then s = string.sub(s, 2) end
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1,")))
	if string.sub(out, 1, 1) == "," then out = string.sub(out, 2) end
	return (neg and "-" or "") .. out
end

function Hud.label(parent, pos, size, anchor, txt, ts)
	local t = Instance.new("TextLabel")
	t.Position = pos
	t.Size = size
	t.AnchorPoint = anchor
	t.BackgroundTransparency = 1
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.4
	t.Font = Enum.Font.GothamBold
	t.TextScaled = true
	t.Text = txt
	t.Parent = parent
	if ts then
		local c = Instance.new("UITextSizeConstraint")
		c.MaxTextSize = ts
		c.Parent = t
	end
	return t
end

function Hud.button(parent, txt, cb, w, h, color)
	local b = Instance.new("TextButton")
	b.Size = UDim2.fromOffset(w or 310, h or 34)
	b.BackgroundColor3 = color or BLUE
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 15
	b.TextWrapped = true
	b.AutoButtonColor = true
	b.Text = txt
	b.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = b
	b.Activated:Connect(cb)
	return b
end

-- ---- fixed HUD ----
Hud.info = Hud.label(gui, UDim2.new(0.5, 0, 0, 4), UDim2.fromOffset(760, 40), Vector2.new(0.5, 0), "IRBID DRIVE", 15)
Hud.info.TextWrapped = true
Hud.speed = Hud.label(gui, UDim2.new(1, -20, 1, -70), UDim2.fromOffset(200, 60), Vector2.new(1, 1), "0", 54)
Hud.label(gui, UDim2.new(1, -20, 1, -50), UDim2.fromOffset(200, 22), Vector2.new(1, 1), "km/h", 18)
Hud.drift = Hud.label(gui, UDim2.new(0.5, 0, 0, 48), UDim2.fromOffset(460, 36), Vector2.new(0.5, 0), "", 30)
Hud.mission = Hud.label(gui, UDim2.new(0.5, 0, 0, 86), UDim2.fromOffset(620, 26), Vector2.new(0.5, 0), "", 20)
Hud.mission.TextColor3 = Color3.fromRGB(255, 220, 120)
Hud.gps = Hud.label(gui, UDim2.new(0.5, 0, 0, 114), UDim2.fromOffset(620, 22), Vector2.new(0.5, 0), "", 17)
Hud.gps.TextColor3 = Color3.fromRGB(120, 255, 160)
local toastL = Hud.label(gui, UDim2.new(0.5, 0, 0, 140), UDim2.fromOffset(620, 30), Vector2.new(0.5, 0), "", 22)
local credit = Hud.label(gui, UDim2.new(0.5, 0, 1, -4), UDim2.fromOffset(520, 16), Vector2.new(0.5, 1),
	Workspace:GetAttribute("Attribution") or "Map data © OpenStreetMap contributors (ODbL)", 13)
credit.TextStrokeTransparency = 0.6
Hud.car = Hud.label(gui, UDim2.new(1, -20, 1, -128), UDim2.fromOffset(330, 20), Vector2.new(1, 1), "", 16)
Hud.car.TextXAlignment = Enum.TextXAlignment.Right

local toastT = 0
function Hud.toast(s, secs)
	toastL.Text = s
	toastT = secs or 3.5
end

-- context button (bottom centre): shown near the bank / the tuning shop / a race start
local ctxB = Hud.button(gui, "", function() end, 230, 46, Color3.fromRGB(200, 60, 40))
ctxB.AnchorPoint = Vector2.new(0.5, 1)
ctxB.Position = UDim2.new(0.5, 0, 1, -30)
ctxB.TextSize = 18
ctxB.Visible = false
local ctxCb
ctxB.Activated:Connect(function()
	if ctxCb then ctxCb() end
end)
function Hud.context(text, cb, color)
	if text and not State.ui then
		ctxB.Text = text
		ctxB.BackgroundColor3 = color or Color3.fromRGB(200, 60, 40)
		ctxB.Visible = true
		ctxCb = cb
	else
		ctxB.Visible = false
		ctxCb = nil
	end
end

-- button column (left)
local col = Instance.new("Frame")
col.BackgroundTransparency = 1
col.Position = UDim2.new(0, 12, 0, 56)
col.Size = UDim2.fromOffset(124, 300)
col.Parent = gui
local cl = Instance.new("UIListLayout")
cl.Padding = UDim.new(0, 6)
cl.Parent = col
function Hud.sideButton(txt, cb)
	return Hud.button(col, txt, cb, 124, 32)
end

-- ---- menus: one open at a time; while one is open the car does not take input ----
local open
function Hud.panel(title, w, h)
	if open then open.close() end
	local f = Instance.new("Frame")
	f.Size = UDim2.fromOffset(w or 360, h or 330)
	f.Position = UDim2.fromScale(0.5, 0.5)
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.BackgroundColor3 = DARK
	f.BackgroundTransparency = 0.05
	f.Parent = gui
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 10)
	c.Parent = f
	local t = Hud.label(f, UDim2.new(0.5, 0, 0, 8), UDim2.new(1, -60, 0, 26), Vector2.new(0.5, 0), title, 20)
	t.TextStrokeTransparency = 1
	local sub = Hud.label(f, UDim2.new(0.5, 0, 0, 36), UDim2.new(1, -24, 0, 18), Vector2.new(0.5, 0), "", 14)
	sub.Font = Enum.Font.Gotham
	sub.TextStrokeTransparency = 1
	sub.TextColor3 = Color3.fromRGB(200, 205, 215)
	local list = Instance.new("ScrollingFrame")
	list.Position = UDim2.fromOffset(10, 60)
	list.Size = UDim2.new(1, -20, 1, -70)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 6
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	list.Parent = f
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, 6)
	l.HorizontalAlignment = Enum.HorizontalAlignment.Center
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = list
	local p = { frame = f, list = list, sub = sub, title = title }
	function p.close()
		if open == p then
			open = nil
			State.ui = nil
		end
		f:Destroy()
	end
	local x = Hud.button(f, "✕", p.close, 34, 30, Color3.fromRGB(90, 40, 40))
	x.Position = UDim2.new(1, -40, 0, 6)
	open = p
	State.ui = title
	Hud.context(nil)
	return p
end
function Hud.closePanel()
	if open then open.close() end
end
function Hud.isOpen(title)
	return open ~= nil and open.title == title
end

function Hud.step(dt)
	if toastT > 0 then
		toastT -= dt
		if toastT <= 0 then toastL.Text = "" end
	end
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">Menus</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the garage (buy / switch cars, Robux packs), Apex Drift Customs (upgrades paid with banked drift points,
-- only at the shop) and the car wheel (10,000 cash per spin, the web game's tier odds). Every purchase is done by the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local State = require(script.Parent:WaitForChild("State"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Menus = {}
local plr = Players.LocalPlayer
local fmt = Hud.fmt

local function owned()
	local o = {}
	for i in string.gmatch(plr:GetAttribute("Owned") or "1", "%d+") do o[tonumber(i)] = true end
	return o
end

local function tierLine(c)
	local r = Config.RARITY[c.tier + 1]
	return r.name .. " ×" .. string.format("%.1f", r.mult)
end

-- ---- garage ----
function Menus.garage()
	if Hud.isOpen("Garage") then
		Hud.closePanel()
		return
	end
	local p = Hud.panel("Garage", 400, 400)
	local function fill()
		for _, ch in ipairs(p.list:GetChildren()) do
			if ch:IsA("GuiObject") then ch:Destroy() end
		end
		p.sub.Text = "Cash: " .. fmt(plr:GetAttribute("Cash") or 0) .. " · cars come from the shop list or the wheel"
		local o = owned()
		for i, c in ipairs(Config.CARS) do
			local km = math.floor(c.vm * 3.6 + 0.5)
			local status = plr:GetAttribute("CurCar") == i and "driving" or o[i] and "use" or c.vip and "VIP pass" or (fmt(c.price) .. " cash")
			local b = Hud.button(p.list, c.name .. " · " .. tierLine(c) .. " · " .. km .. " km/h · " .. status, function()
				local ok, msg = Remotes.CarAction:InvokeServer("buy", i)
				Hud.toast(ok and ("Now driving: " .. tostring(msg)) or tostring(msg))
				fill()
			end, 370, 32, plr:GetAttribute("CurCar") == i and Color3.fromRGB(40, 110, 60) or nil)
			b.TextSize = 13
			b.LayoutOrder = i
			local bar = Instance.new("Frame")
			bar.Size = UDim2.new(0, 6, 1, 0)
			bar.BorderSizePixel = 0
			bar.BackgroundColor3 = Config.TIER_COLORS[c.tier + 1]
			bar.Parent = b
		end
		local k = #Config.CARS
		if Config.PRODUCT_CASH_SMALL ~= 0 then
			Hud.button(p.list, "+" .. fmt(Config.CASH_SMALL) .. " cash (Robux)", function() Remotes.CarAction:InvokeServer("cash_small") end, 370, 32, Color3.fromRGB(0, 140, 80)).LayoutOrder = k + 1
		end
		if Config.PRODUCT_CASH_BIG ~= 0 then
			Hud.button(p.list, "+" .. fmt(Config.CASH_BIG) .. " cash (Robux)", function() Remotes.CarAction:InvokeServer("cash_big") end, 370, 32, Color3.fromRGB(0, 140, 80)).LayoutOrder = k + 2
		end
		if Config.GAMEPASS_VIP ~= 0 and not plr:GetAttribute("VIP") then
			Hud.button(p.list, "VIP pass: double drift cash + the VIP car (Robux)", function() Remotes.CarAction:InvokeServer("vip") end, 370, 32, Color3.fromRGB(180, 140, 0)).LayoutOrder = k + 3
		end
	end
	fill()
end

-- ---- Apex Drift Customs ----
function Menus.shop()
	if Hud.isOpen("Apex Drift Customs") then
		Hud.closePanel()
		return
	end
	local p = Hud.panel("Apex Drift Customs", 400, 340)
	local function fill()
		for _, ch in ipairs(p.list:GetChildren()) do
			if ch:IsA("GuiObject") then ch:Destroy() end
		end
		local bank = plr:GetAttribute("DriftBank") or 0
		local lv, i = { 0, 0, 0, 0 }, 0
		for n in string.gmatch(plr:GetAttribute("Tune") or "", "%d+") do
			i += 1
			lv[i] = tonumber(n)
		end
		p.sub.Text = "Drift bank: " .. fmt(bank) .. " points · " .. State.spec.name .. " (" .. tierLine(Config.CARS[plr:GetAttribute("CurCar") or 1]) .. ")"
		for k, u in ipairs(Config.UPGRADES) do
			local l = lv[k]
			local max = l >= Config.UPGRADE_MAX
			local price = Config.upgradePrice(k, l)
			local txt = u.name .. " · level " .. (l + 1) .. (max and " (MAX)" or "") .. "\n" .. u.info .. (max and "" or (" · next: " .. fmt(price) .. " pts"))
			local b = Hud.button(p.list, txt, function()
				if max then return end
				local ok, msg = Remotes.CarAction:InvokeServer("upgrade", k)
				Hud.toast(ok and (u.name .. " → level " .. (tonumber(msg) + 1)) or tostring(msg))
				fill()
			end, 370, 52, (max or bank < price) and Color3.fromRGB(60, 62, 70) or nil)
			b.TextSize = 14
			b.LayoutOrder = k
		end
	end
	fill()
end

-- ---- the car wheel ----
local spinning = false
function Menus.wheel()
	if spinning then return end
	if Hud.isOpen("Car Wheel") then
		Hud.closePanel()
		return
	end
	local p = Hud.panel("Car Wheel", 380, 330)
	local odds = {}
	for k, r in ipairs(Config.RARITY) do
		odds[#odds + 1] = r.name .. " " .. math.floor(Config.WHEEL_ODDS[k] * 100 + 0.5) .. "%"
	end
	p.sub.Text = table.concat(odds, " · ")
	local reel = Hud.label(p.list, UDim2.new(), UDim2.fromOffset(340, 70), Vector2.zero, "?", 34)
	reel.LayoutOrder = 1
	local res = Hud.label(p.list, UDim2.new(), UDim2.fromOffset(340, 48), Vector2.zero, "Each spin costs " .. fmt(Config.WHEEL_COST) .. " cash · a duplicate refunds " .. fmt(Config.WHEEL_REFUND), 15)
	res.TextWrapped = true
	res.LayoutOrder = 2
	local go
	go = Hud.button(p.list, "SPIN · " .. fmt(Config.WHEEL_COST) .. " cash", function()
		if spinning then return end
		if (plr:GetAttribute("Cash") or 0) < Config.WHEEL_COST then
			res.Text = "Not enough cash: drift, race and rob the bank to earn more"
			return
		end
		spinning = true
		go.Text = "Spinning…"
		local ok, r = Remotes.CarAction:InvokeServer("spin")
		if not ok or type(r) ~= "table" then
			spinning = false
			go.Text = "SPIN · " .. fmt(Config.WHEEL_COST) .. " cash"
			res.Text = tostring(r)
			return
		end
		-- reel: cycles the tiers, slowing down, and stops on the result
		local steps = 22 + r.tier
		for k = 0, steps do
			local t = (r.tier - (steps - k)) % #Config.RARITY
			reel.Text = Config.RARITY[t + 1].name
			reel.TextColor3 = Config.TIER_COLORS[t + 1]
			task.wait(0.04 + 0.012 * k)
		end
		local car = Config.CARS[r.car]
		reel.Text = Config.RARITY[r.tier + 1].name .. " · " .. car.name
		res.Text = r.dup and ("Duplicate: you already own it, " .. fmt(Config.WHEEL_REFUND) .. " cash refunded")
			or ("Unlocked and equipped! (×" .. string.format("%.1f", Config.RARITY[r.tier + 1].mult) .. " drift points)")
		Hud.toast("Wheel: " .. car.name .. (r.dup and " (duplicate)" or " unlocked!"), 4)
		spinning = false
		if go.Parent then go.Text = "SPIN AGAIN · " .. fmt(Config.WHEEL_COST) .. " cash" end
	end, 340, 40, Color3.fromRGB(180, 120, 0))
	go.LayoutOrder = 3
end

return Menus
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">Missions</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - street races and the bank heist, played on this device (the server checks the results before it pays).
-- Races: the web game's circuits (routed over real roads), 3 rivals on the racing line, a 3 s countdown, checkpoints as a light beam,
-- positions by checkpoints passed. Heist: rob the bank (E near it), police cars hunt the player for 2:00 over the real road graph
-- (straight at the player when close); 2.5 s next to a police car = caught. Same rules and numbers as the web game.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Road = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Road"))
local Shared = ReplicatedStorage:WaitForChild("IrbidShared")
local Meta = require(Shared:WaitForChild("Meta"))
local Circuits = require(Shared:WaitForChild("Circuits"))
local State = require(script.Parent:WaitForChild("State"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local Drive = require(script.Parent:WaitForChild("Drive"))
local Traffic = require(script.Parent:WaitForChild("Traffic"))
local Nav = require(script.Parent:WaitForChild("Nav"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Missions = {}
local S = Config.SCALE
local st, spec = State.st, State.spec
Missions.rivals, Missions.cops = {}, {}

-- circuits: polyline, checkpoint distances along it, per-point safe speeds
local C = {}
for _, c in ipairs(Circuits) do
	local P = Road.pathFromString(c.path)
	local cpS, j = {}, 1
	for k, cp in ipairs(c.cps) do
		-- each checkpoint is matched forward along the line (laps pass the same place more than once)
		local best, bd = j, math.huge
		for i = j, #P.x do
			local d = (P.x[i] - cp.x) ^ 2 + (P.z[i] - cp.z) ^ 2
			if d < bd then
				best, bd = i, d
			end
			if bd < 4 and d > 400 then break end
		end
		cpS[k] = P.c[best]
		j = best + 1
	end
	C[#C + 1] = { name = c.name, laps = c.laps, cps = c.cps, cpS = cpS, P = P, caps = Road.speedCaps(P) }
end
Missions.circuits = C

-- the light beam over the next checkpoint
local beam = Instance.new("Part")
beam.Name = "Checkpoint"
beam.Anchored = true
beam.CanCollide = false
beam.CanQuery = false
beam.CanTouch = false
beam.Shape = Enum.PartType.Cylinder
beam.Material = Enum.Material.Neon
beam.Color = Color3.fromRGB(51, 224, 255)
beam.Transparency = 1
beam.Size = Vector3.new(70 * S, 12 * S, 12 * S)
beam.Parent = Workspace.CurrentCamera

local race = nil -- {c, t, s = "count"|"run"|"done", prog, fin, finished}
local heist = nil -- {t, catch, spawnT}

local function clearRivals()
	for _, a in ipairs(Missions.rivals) do Traffic.remove(a) end
	table.clear(Missions.rivals)
end

local function endRace(msg)
	if race and race.s ~= "done" then pcall(function() Remotes.Mission:InvokeServer("race_cancel") end) end
	race = nil
	State.mission = nil
	State.frozen = false
	beam.Transparency = 1
	Nav.raceMark = nil
	clearRivals()
	Hud.mission.Text = ""
	if msg then Hud.toast(msg) end
end

-- R: start the nearest circuit (or cancel the current race)
function Missions.race()
	if heist then
		Hud.toast("Lose the police first")
		return
	end
	if race then
		endRace("Race cancelled")
		return
	end
	if #C == 0 then return end
	local best, bd = C[1], math.huge
	for _, c in ipairs(C) do
		local d = (c.P.x[1] - st.x) ^ 2 + (c.P.z[1] - st.z) ^ 2
		if d < bd then
			best, bd = c, d
		end
	end
	local ok, err = Remotes.Mission:InvokeServer("race_start", best.name)
	if not ok then
		Hud.toast(tostring(err))
		return
	end
	Nav.clear()
	Traffic.clear(best.P.x[1], best.P.z[1], 120)
	-- rivals: cars of about the player's tier, on the web game's grid (20 / 34 / 48 m), the player at 62 m
	local pool = {}
	for i, car in ipairs(Config.CARS) do
		if math.abs(car.tier - spec.tier) <= 1 and not car.vip then pool[#pool + 1] = i end
	end
	local names = {}
	for k, s0 in ipairs({ 20, 34, 48 }) do
		local car = Config.CARS[pool[math.random(#pool)]]
		local a = Traffic.agent("rival", car)
		a.P, a.s, a.pi = best.P, s0, 1
		a.skill = 0.9 + math.random() * 0.1
		a.lane = (k - 2) * 1.6
		local x, z, y, tx, tz, i = Road.sample(a.P, a.s, 1)
		a.x, a.z, a.y, a.h, a.pi = x, z, y, math.atan2(tx, tz), i
		Traffic.draw(a)
		Missions.rivals[#Missions.rivals + 1] = a
		names[#names + 1] = car.name
	end
	local x, z, _, tx, tz = Road.sample(best.P, 62, 1)
	Drive.place(x, z, math.atan2(tx, tz))
	race = { c = best, t = 3.99, s = "count", prog = 1, fin = 0 }
	State.mission = "race"
	State.frozen = true
	Hud.toast(best.name .. " · rivals: " .. table.concat(names, ", "), 4)
end

local function rivalStep(a, dt)
	local c = race.c
	if a.done then
		Traffic.follow(a, dt, 0)
	else
		local vt = math.min(a.vm * a.skill, c.caps[a.pi] or 30)
		Traffic.follow(a, dt, vt)
		if a.s >= c.cpS[#c.cpS] - 2 then
			a.done = true
			race.fin += 1
		end
	end
	-- side offset so the three rivals do not drive inside each other (follow() puts the car back on the line every frame)
	a.x, a.z = a.x - math.cos(a.h) * a.lane, a.z + math.sin(a.h) * a.lane
	Traffic.draw(a)
end

local function raceStep(dt)
	local c = race.c
	if race.s == "count" then
		race.t -= dt
		Hud.mission.Text = c.name .. " · starts in " .. math.ceil(race.t)
		if race.t <= 0 then
			race.s = "run"
			race.time = 0
			State.frozen = false
			Hud.toast("GO!", 1.5)
		end
	end
	if race.s ~= "count" then
		for _, a in ipairs(Missions.rivals) do rivalStep(a, dt) end
	else
		for _, a in ipairs(Missions.rivals) do Traffic.draw(a) end
	end
	if race.s == "run" then
		race.time += dt
		local cp = c.cps[race.prog]
		if (cp.x - st.x) ^ 2 + (cp.z - st.z) ^ 2 < 28 * 28 then
			race.prog += 1
			if race.prog > #c.cps then
				race.s = "done"
				race.t = 6
				local place = race.fin + 1
				Hud.mission.Text = "Finished P" .. place .. " of 4 · " .. string.format("%.1f s", race.time)
				local ok, reward = Remotes.Mission:InvokeServer("race_finish", place)
				Hud.toast("Finished P" .. place .. " of 4!" .. (ok and reward and reward > 0 and ("  +" .. Hud.fmt(reward) .. " cash") or ""), 5)
				beam.Transparency = 1
				Nav.raceMark = nil
				return
			end
		end
		-- position: checkpoints passed, then distance to the next one
		local pos = 1
		local myS = c.cpS[race.prog] - math.sqrt((cp.x - st.x) ^ 2 + (cp.z - st.z) ^ 2)
		for _, a in ipairs(Missions.rivals) do
			if a.done or a.s > myS then pos += 1 end
		end
		local lap = c.laps > 1 and (" · lap " .. math.min(c.laps, 1 + math.floor((race.prog - 1) / (#c.cps / c.laps)))) or ""
		Hud.mission.Text = c.name .. " · P" .. pos .. " of 4 · checkpoint " .. race.prog .. "/" .. #c.cps .. lap .. " · " .. string.format("%.1f s", race.time)
	end
	if race.s == "done" then
		race.t -= dt
		if race.t <= 0 then endRace() end
		return
	end
	local cp = c.cps[race.prog]
	local gy = Drive.groundY(cp.x, cp.z, st.y + 80) or st.y
	beam.CFrame = CFrame.new(cp.x * S, (gy + 35) * S, cp.z * S) * CFrame.Angles(0, 0, math.pi / 2)
	beam.Transparency = 0.7
	Nav.raceMark = { cp.x, cp.z }
end

-- ---- heist ----
local function nearBank()
	return (Meta.bank.x - st.x) ^ 2 + (Meta.bank.z - st.z) ^ 2 < 14 * 14
end
local function nearShop()
	return (Meta.shop.x - st.x) ^ 2 + (Meta.shop.z - st.z) ^ 2 < 14 * 14
end
Missions.nearShop = nearShop

local function clearCops()
	for _, a in ipairs(Missions.cops) do Traffic.remove(a) end
	table.clear(Missions.cops)
end

function Missions.rob()
	if State.ui or heist or not nearBank() then return end
	if race then
		Hud.toast("Finish the race first")
		return
	end
	local ok, err = Remotes.Mission:InvokeServer("heist_start")
	if not ok then
		Hud.toast(tostring(err))
		return
	end
	heist = { t = Config.HEIST_TIME, catch = 0 }
	State.mission = "heist"
	Hud.toast("🚨 Bank robbed! Stay away from the police for 2:00", 4)
end

local function endHeist(escaped)
	clearCops()
	heist = nil
	State.mission = nil
	Hud.mission.Text = ""
	local ok, amount = Remotes.Mission:InvokeServer("heist_end", escaped)
	if escaped then
		Hud.toast(ok and ("Escaped! +" .. Hud.fmt(amount) .. " cash") or "Escaped!", 5)
	else
		st.vx *= 0.2
		st.vz *= 0.2
		Hud.toast("Busted! " .. (ok and Hud.fmt(amount) or "") .. " cash", 5)
	end
end

local function spawnCop()
	for _ = 1, 10 do
		local ang, r = math.random() * 2 * math.pi, 220 + math.random() * 240
		local near = Road.nearest(State.road, st.x + math.sin(ang) * r, st.z + math.cos(ang) * r, 80)
		if near then
			local a = Traffic.agent("cop", { L = 5.2, W = 1.95, H = 1.45, vm = spec.vm * 0.85, a0 = spec.a0 * 0.85 }, Color3.fromRGB(244, 244, 244))
			a.x, a.z, a.y = near.x, near.z, near.y
			a.h = math.atan2(st.x - a.x, st.z - a.z)
			a.thinkT = 0
			Missions.cops[#Missions.cops + 1] = a
			Traffic.draw(a)
			return
		end
	end
end

local function copStep(a, dt)
	a.vm, a.a0 = spec.vm * 0.85, spec.a0 * 0.85
	local dx, dz = st.x - a.x, st.z - a.z
	local d = math.sqrt(dx * dx + dz * dz)
	-- close, or at the end of the route (the junction nearest the player): straight at where the player is going
	local endOfPath = a.P ~= nil and a.s >= a.P.c[#a.P.c] - 3
	if d < 28 or (a.direct and d < 60) or (endOfPath and d < 200) then
		a.direct = true
		local tx, tz = st.x + st.vx * 0.4 - a.x, st.z + st.vz * 0.4 - a.z
		local want = math.atan2(tx, tz)
		local df = (want - a.h + math.pi) % (2 * math.pi) - math.pi
		local r = 2.2 / (1 + a.v / 14) * dt
		a.h += math.clamp(df, -r, r)
		-- approach at a speed that can still stop ~5 m from the player (7 m/s^2), and slow down to turn round:
		-- the police box the car in instead of ramming past it
		local vt = math.min(a.vm, math.sqrt(2 * 7 * math.max(0, d - 5)) + st.sp, a.vm * (1 - math.abs(df) / math.pi) + 4)
		if a.hit > 0 then vt = 0 end
		if a.hit > 0 then a.hit -= dt end
		a.v = math.max(0, a.v + math.clamp(vt - a.v, -9 * dt, a.a0 * dt))
		a.x += math.sin(a.h) * a.v * dt
		a.z += math.cos(a.h) * a.v * dt
		a.y = Drive.groundY(a.x, a.z, a.y + 4) or a.y
		a.P = nil
		return
	end
	a.direct = false
	-- far: follow a route to the player over the road graph, planned again every 0.8 s
	a.thinkT -= dt
	if not a.P or a.thinkT <= 0 then
		a.thinkT = 0.8
		local trs, s0 = Road.routeFrom(State.road, a.x, a.z, math.sin(a.h), math.cos(a.h), st.x + st.vx * 1.2, st.z + st.vz * 1.2)
		if trs then
			a.P = Road.path(trs, nil)
			a.s, a.pi = s0, 1
		else
			a.direct = true
			return
		end
	end
	Traffic.follow(a, dt, math.min(a.vm, Traffic.curveCap(a) * 1.15))
end

local function heistStep(dt)
	heist.t -= dt
	if #Missions.cops < math.min(8, 4 + math.floor((Config.HEIST_TIME - heist.t) / 25)) then spawnCop() end
	local near = false
	for _, a in ipairs(Missions.cops) do
		copStep(a, dt)
		Traffic.draw(a)
		if (a.x - st.x) ^ 2 + (a.z - st.z) ^ 2 < 49 then near = true end
	end
	heist.catch = near and heist.catch + dt or math.max(0, heist.catch - dt * 2)
	if heist.catch >= 2.5 then
		endHeist(false)
		return
	end
	if heist.t <= 0 then
		endHeist(true)
		return
	end
	local m, s = math.floor(heist.t / 60), math.floor(heist.t % 60)
	Hud.mission.Text = string.format("🚨 ROBBERY · survive %d:%02d · police %d · caught %d%%", m, s, #Missions.cops, math.floor(heist.catch / 2.5 * 100))
end

-- the current race / heist tables (or nil), read-only for tests
function Missions.debug()
	return race, heist
end

-- ---- every frame: missions, police lights, and the context button ----
local flash = 0
function Missions.step(dt)
	if race then raceStep(dt) end
	if heist then heistStep(dt) end
	flash += dt
	local on = math.floor(flash * 6) % 2 == 0
	for _, a in ipairs(Missions.cops) do
		local r, b = a.model:FindFirstChild("LightR"), a.model:FindFirstChild("LightB")
		if r and b then
			r.Color = on and Color3.fromRGB(255, 30, 30) or Color3.fromRGB(50, 0, 0)
			b.Color = on and Color3.fromRGB(0, 0, 50) or Color3.fromRGB(30, 80, 255)
		end
	end
	-- context button / prompt
	if State.ui then return end
	if not heist and not race and nearBank() then
		local openAt = game:GetService("Players").LocalPlayer:GetAttribute("BankOpenAt") or 0
		if Workspace.DistributedGameTime < openAt then
			Hud.context("Bank closed · back in " .. math.ceil(openAt - Workspace.DistributedGameTime) .. " s", function() end, Color3.fromRGB(90, 90, 90))
		else
			Hud.context("🏦 ROB THE BANK (E)", Missions.rob)
		end
	elseif not heist and nearShop() then
		Hud.context("🔧 TUNE CAR (U)", Missions.openShop, Color3.fromRGB(230, 110, 0))
	else
		Hud.context(nil)
	end
end

return Missions
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">Nav</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - street names, the GPS (search the real OSM places, route over the real road graph with one-way streets,
-- a trail of dots on the road, re-route when the player leaves it) and the minimap (roads near the player, turning with the car).
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Road = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Road"))
local Shared = ReplicatedStorage:WaitForChild("IrbidShared")
local Meta = require(Shared:WaitForChild("Meta"))
local Places = require(Shared:WaitForChild("Places"))
local Circuits = require(Shared:WaitForChild("Circuits"))
local State = require(script.Parent:WaitForChild("State"))
local Hud = require(script.Parent:WaitForChild("Hud"))

local Nav = {}
local S = Config.SCALE
local st = State.st
Nav.street = ""

-- ---- street name under the car (every 0.25 s) ----
local streetT = 0
local function streetTick(dt)
	streetT -= dt
	if streetT > 0 then return end
	streetT = 0.25
	local near = State.road and Road.nearest(State.road, st.x, st.z, 25)
	Nav.street = near and near.e.name or ""
end

-- ---- GPS ----
local nav = nil -- {name, x, z, P (polyline), i (progress index), checkT}
local dots = {}
local function dotPool()
	if #dots > 0 then return end
	for k = 1, 30 do
		local p = Instance.new("Part")
		p.Name = "GpsDot"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(60, 255, 140)
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(0.8, 0.8, 0.8) * S
		p.Transparency = 1
		p.Parent = Workspace.CurrentCamera
		dots[k] = p
	end
end

function Nav.clear()
	nav = nil
	Hud.gps.Text = ""
	for _, p in ipairs(dots) do p.Transparency = 1 end
end

local function plan(target)
	local trs, s0 = Road.routeFrom(State.road, st.x, st.z, math.sin(st.h), math.cos(st.h), target.x, target.z)
	if not trs then return nil end
	local P = Road.path(trs, Road.lane)
	local _, _, i = Road.project(P, st.x, st.z, 1, #P.x)
	return P, i, s0
end

function Nav.go(target)
	local P, i = plan(target)
	if not P then
		Hud.toast("No route found to " .. target.n)
		return false
	end
	dotPool()
	nav = { name = target.n, x = target.x, z = target.z, P = P, i = i, checkT = 1 }
	Hud.toast("GPS: route to " .. target.n, 2.5)
	return true
end
function Nav.active()
	return nav ~= nil
end
-- the current route (or nil): {name, x, z, P, i}
function Nav.route()
	return nav
end

local function gpsTick(dt)
	if not nav then return end
	local P = nav.P
	local s, d, i = Road.project(P, st.x, st.z, nav.i - 3, nav.i + 40)
	nav.i, nav.s = i, s
	local left = P.c[#P.c] - s + math.sqrt((nav.x - P.x[#P.x]) ^ 2 + (nav.z - P.z[#P.z]) ^ 2)
	local direct = math.sqrt((nav.x - st.x) ^ 2 + (nav.z - st.z) ^ 2)
	if direct < 30 then
		Hud.toast("You have arrived: " .. nav.name, 4)
		Nav.clear()
		return
	end
	-- left the route: plan again (at most once a second)
	nav.checkT -= dt
	if d > 35 and nav.checkT <= 0 then
		nav.checkT = 1
		local P2, i2 = plan(nav)
		if P2 then
			nav.P, nav.i, P, i = P2, i2, P2, i2
			s = Road.project(P, st.x, st.z, i, i + 1)
			nav.s = s
		end
	end
	Hud.gps.Text = "📍 GPS: " .. nav.name .. " · " .. (left >= 1000 and string.format("%.1f km", left / 1000) or (math.floor(left / 10) * 10 .. " m"))
	-- dots every 10 m for the next 300 m
	for k, p in ipairs(dots) do
		local sd = s + 8 + (k - 1) * 10
		if sd < P.c[#P.c] then
			local x, z, y = Road.sample(P, sd, i)
			p.Position = Vector3.new(x, y + 0.9, z) * S
			p.Transparency = 0.15
		else
			p.Transparency = 1
		end
	end
end

-- ---- search panel ----
local function lower(s)
	return string.lower(s)
end
function Nav.open()
	if Hud.isOpen("GPS") then
		Hud.closePanel()
		return
	end
	local p = Hud.panel("GPS", 380, 380)
	p.sub.Text = "Search " .. #Places .. " real places (OpenStreetMap)"
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, -12, 0, 34)
	box.BackgroundColor3 = Color3.fromRGB(40, 44, 52)
	box.TextColor3 = Color3.new(1, 1, 1)
	box.PlaceholderText = "Type a place: mall, university, Clock Tower…"
	box.Font = Enum.Font.Gotham
	box.TextSize = 15
	box.ClearTextOnFocus = false
	box.Text = ""
	box.LayoutOrder = 0
	box.Parent = p.list
	local rows = {}
	local function show()
		for _, r in ipairs(rows) do r:Destroy() end
		table.clear(rows)
		local q = lower(box.Text)
		local found = {}
		if nav then
			local b = Hud.button(p.list, "✖ Stop the GPS", function()
				Nav.clear()
				p.close()
			end, 340, 30, Color3.fromRGB(110, 50, 50))
			b.LayoutOrder = 1
			rows[#rows + 1] = b
		end
		for _, pl in ipairs(Places) do
			if q == "" or string.find(lower(pl.n), q, 1, true) or string.find(lower(pl.s), q, 1, true) or string.find(lower(pl.k), q, 1, true) then
				found[#found + 1] = { pl = pl, d = math.sqrt((pl.x - st.x) ^ 2 + (pl.z - st.z) ^ 2) }
			end
		end
		table.sort(found, function(a, b) return a.d < b.d end)
		for k = 1, math.min(14, #found) do
			local pl = found[k].pl
			local dist = found[k].d
			local label = pl.n .. "  ·  " .. (pl.s ~= "" and pl.s or pl.k) .. "  ·  " .. (dist >= 1000 and string.format("%.1f km", dist / 1000) or (math.floor(dist) .. " m"))
			local b = Hud.button(p.list, label, function()
				if Nav.go(pl) then p.close() end
			end, 340, 32)
			b.TextXAlignment = Enum.TextXAlignment.Left
			b.TextSize = 13
			b.LayoutOrder = 1 + k
			rows[#rows + 1] = b
		end
		if #found == 0 then
			local l = Hud.label(p.list, UDim2.new(), UDim2.fromOffset(340, 24), Vector2.zero, "No place matches \"" .. box.Text .. "\"", 15)
			l.LayoutOrder = 2
			rows[#rows + 1] = l
		end
	end
	box:GetPropertyChangedSignal("Text"):Connect(show)
	show()
end

-- ---- minimap: a round window, the car in the centre pointing up; roads within 260 m redrawn 7 times a second ----
local MAP_PX, MAP_R = 180, 260
local mm = Instance.new("CanvasGroup")
mm.Name = "Minimap"
mm.Size = UDim2.fromOffset(MAP_PX, MAP_PX)
mm.AnchorPoint = Vector2.new(0, 1)
mm.Position = UDim2.new(0, 12, 1, -26)
mm.BackgroundColor3 = Color3.fromRGB(28, 32, 26)
mm.BackgroundTransparency = 0.15
mm.Parent = Hud.gui
local mmc = Instance.new("UICorner")
mmc.CornerRadius = UDim.new(0.5, 0)
mmc.Parent = mm
local lines, nLines = {}, 0
local function line(i)
	local f = lines[i]
	if not f then
		f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.BorderSizePixel = 0
		f.Parent = mm
		lines[i] = f
	end
	f.Visible = true
	return f
end
local arrow = Instance.new("TextLabel")
arrow.Size = UDim2.fromOffset(20, 20)
arrow.AnchorPoint = Vector2.new(0.5, 0.5)
arrow.Position = UDim2.fromScale(0.5, 0.5)
arrow.BackgroundTransparency = 1
arrow.Text = "▲"
arrow.TextColor3 = Color3.fromRGB(80, 200, 255)
arrow.TextSize = 18
arrow.Font = Enum.Font.GothamBold
arrow.ZIndex = 5
arrow.Parent = mm
local marks = {}
local function mark(i, color, size)
	local f = marks[i]
	if not f then
		f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.BorderSizePixel = 0
		f.ZIndex = 4
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0.5, 0)
		c.Parent = f
		f.Parent = mm
		marks[i] = f
	end
	f.Size = UDim2.fromOffset(size, size)
	f.BackgroundColor3 = color
	return f
end
local SITES = { { Meta.bank.x, Meta.bank.z, Color3.fromRGB(255, 60, 60) }, { Meta.shop.x, Meta.shop.z, Color3.fromRGB(255, 122, 0) } }
for _, c in ipairs(Circuits) do
	local x, z = string.match(c.path, "^(-?%d+),(-?%d+)")
	SITES[#SITES + 1] = { tonumber(x) / 10, tonumber(z) / 10, Color3.fromRGB(51, 224, 255) }
end

local mmT = 0
local ROADCOL = { [0] = Color3.fromRGB(235, 225, 200), [1] = Color3.fromRGB(170, 170, 165), [2] = Color3.fromRGB(110, 110, 105), [3] = Color3.fromRGB(235, 225, 200) }
local function mapTick(dt)
	mmT -= dt
	if mmT > 0 or not State.road then return end
	mmT = 0.14
	local k = MAP_PX / 2 / MAP_R
	local fx, fz = math.sin(st.h), math.cos(st.h)
	local rx, rz = -fz, fx
	local function proj(x, z)
		local dx, dz = x - st.x, z - st.z
		return MAP_PX / 2 + (dx * rx + dz * rz) * k, MAP_PX / 2 - (dx * fx + dz * fz) * k
	end
	nLines = 0
	local seen = {}
	Road.each(State.road, st.x, st.z, MAP_R, function(e, j)
		local id = e.id * 4096 + j
		if seen[id] or nLines >= 700 then return end
		seen[id] = true
		local x1, z1, x2, z2 = e.x[j], e.z[j], e.x[j + 1], e.z[j + 1]
		if (x1 - st.x) ^ 2 + (z1 - st.z) ^ 2 > MAP_R * MAP_R * 1.1 and (x2 - st.x) ^ 2 + (z2 - st.z) ^ 2 > MAP_R * MAP_R * 1.1 then return end
		local u1, v1 = proj(x1, z1)
		local u2, v2 = proj(x2, z2)
		nLines += 1
		local f = line(nLines)
		local len = math.sqrt((u2 - u1) ^ 2 + (v2 - v1) ^ 2)
		f.Position = UDim2.fromOffset((u1 + u2) / 2, (v1 + v2) / 2)
		f.Size = UDim2.fromOffset(len + 1, math.max(2, e.w * k))
		f.Rotation = math.deg(math.atan2(v2 - v1, u2 - u1))
		f.BackgroundColor3 = ROADCOL[e.kind] or ROADCOL[1]
	end)
	-- the GPS route on top
	if nav then
		local P = nav.P
		local j = nav.i
		while j < #P.x and P.c[j] - P.c[nav.i] < MAP_R * 1.4 and nLines < 760 do
			local u1, v1 = proj(P.x[j], P.z[j])
			local u2, v2 = proj(P.x[j + 1], P.z[j + 1])
			nLines += 1
			local f = line(nLines)
			f.Position = UDim2.fromOffset((u1 + u2) / 2, (v1 + v2) / 2)
			f.Size = UDim2.fromOffset(math.sqrt((u2 - u1) ^ 2 + (v2 - v1) ^ 2) + 1, 4)
			f.Rotation = math.deg(math.atan2(v2 - v1, u2 - u1))
			f.BackgroundColor3 = Color3.fromRGB(60, 255, 140)
			j += 1
		end
	end
	for i = nLines + 1, #lines do lines[i].Visible = false end
	-- sites (clamped to the edge when far), the GPS destination, AI cars (police red)
	local mi = 0
	local function put(x, z, color, size)
		mi += 1
		local u, v = proj(x, z)
		local du, dv = u - MAP_PX / 2, v - MAP_PX / 2
		local r = math.sqrt(du * du + dv * dv)
		local lim = MAP_PX / 2 - 6
		if r > lim then
			u, v = MAP_PX / 2 + du / r * lim, MAP_PX / 2 + dv / r * lim
		end
		local f = mark(mi, color, size)
		f.Position = UDim2.fromOffset(u, v)
		f.Visible = true
	end
	for _, s in ipairs(SITES) do put(s[1], s[2], s[3], 10) end
	if nav then put(nav.x, nav.z, Color3.fromRGB(60, 255, 140), 12) end
	for _, a in ipairs(State.ai) do
		if (a.x - st.x) ^ 2 + (a.z - st.z) ^ 2 < MAP_R * MAP_R then
			put(a.x, a.z, a.cop and Color3.fromRGB(255, 40, 40) or a.kind == "rival" and Color3.fromRGB(255, 200, 40) or Color3.fromRGB(200, 200, 200), a.cop and 8 or 5)
		end
	end
	if State.mission == "race" and Nav.raceMark then put(Nav.raceMark[1], Nav.raceMark[2], Color3.fromRGB(51, 224, 255), 12) end
	for i = mi + 1, #marks do marks[i].Visible = false end
end

function Nav.step(dt)
	streetTick(dt)
	gpsTick(dt)
	mapTick(dt)
end

return Nav
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - state shared by the client modules (one table; every module that requires it gets the same one).
-- Units: metres, metres per second, radians. Heading h has forward (sin h, cos h); x = east, z = south.
return {
	car = nil, -- the player's car model (Car_<UserId>)
	body = nil, -- its Body part
	st = { x = 0, y = 0, z = 0, h = 0, vx = 0, vz = 0, vy = 0, gnd = false, sp = 0, fs = 0 },
	spec = { vm = 40, a0 = 8, bk = 9.81, hd = 1, dr = 0, rm = 1, tier = 0, name = "", L = 4.4, W = 1.8, H = 1.45 },
	input = { th = 0, br = 0, steer = 0, hb = false },
	frozen = false, -- race countdown: the car is held still
	ui = nil, -- name of the open menu (nil = driving)
	road = nil, -- the road graph (Modules/Road)
	ai = {}, -- every AI car this frame (traffic, rivals, police): {x, z, h, v, L, W, hit}
	mission = nil, -- "race" | "heist" | nil
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">Traffic</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - AI cars on this device: traffic that drives the real OSM road graph in the right-hand lane at each street's
-- speed limit, slows for bends and for the car ahead (and for the player), picks a random way at every junction (no U-turns), and is
-- moved back near the player when it gets far away. Also the shared pieces the race rivals and the police use (models, path following).
-- Every device has its own traffic (other players do not see the same AI cars).
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Road = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Road"))
local State = require(script.Parent:WaitForChild("State"))

local Traffic = {}
local S = Config.SCALE
local folder = Instance.new("Folder")
folder.Name = "LocalAI_" .. Players.LocalPlayer.UserId
folder.Parent = Workspace
Traffic.folder = folder
local agents = {}
Traffic.agents = agents

local PAINT = { Color3.fromRGB(235, 235, 235), Color3.fromRGB(30, 30, 34), Color3.fromRGB(150, 155, 160), Color3.fromRGB(170, 30, 30),
	Color3.fromRGB(25, 70, 150), Color3.fromRGB(240, 200, 40), Color3.fromRGB(60, 120, 70), Color3.fromRGB(120, 90, 60) }

-- a simple car model (anchored, no collision, ignored by ray tests); pivot = body centre
function Traffic.model(L, W, H, color, cop)
	local m = Instance.new("Model")
	local function part(name, size, cf, col, mat, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Size = size
		p.CFrame = cf
		p.Color = col
		p.Material = mat or Enum.Material.SmoothPlastic
		if shape then p.Shape = shape end
		p.Parent = m
		return p
	end
	L, W, H = L * S, W * S, H * S
	local body = part("Body", Vector3.new(W, H * 0.55, L), CFrame.new(), color)
	m.PrimaryPart = body
	part("Cabin", Vector3.new(W * 0.86, H * 0.42, L * 0.48), CFrame.new(0, H * 0.48, L * 0.05), cop and Color3.fromRGB(240, 240, 240) or Color3.fromRGB(30, 36, 44), Enum.Material.Glass)
	local wr = H * 0.22
	for _, q in ipairs({ { 1, -1 }, { -1, -1 }, { 1, 1 }, { -1, 1 } }) do
		part("Wheel", Vector3.new(W * 0.12, wr * 2, wr * 2), CFrame.new(q[1] * W * 0.47, -H * 0.12, q[2] * L * 0.32), Color3.fromRGB(20, 20, 20), nil, Enum.PartType.Cylinder)
	end
	for _, x in ipairs({ -1, 1 }) do
		part("Headlight", Vector3.new(W * 0.18, H * 0.08, 0.2), CFrame.new(x * W * 0.32, H * 0.05, -L * 0.5), Color3.fromRGB(255, 250, 220), Enum.Material.Neon)
		part("Taillight", Vector3.new(W * 0.18, H * 0.08, 0.2), CFrame.new(x * W * 0.32, H * 0.05, L * 0.5), Color3.fromRGB(150, 10, 10), Enum.Material.Neon)
	end
	if cop then
		part("LightR", Vector3.new(W * 0.3, 0.4, 0.8), CFrame.new(-W * 0.18, H * 0.72, L * 0.05), Color3.fromRGB(255, 30, 30), Enum.Material.Neon)
		part("LightB", Vector3.new(W * 0.3, 0.4, 0.8), CFrame.new(W * 0.18, H * 0.72, L * 0.05), Color3.fromRGB(30, 80, 255), Enum.Material.Neon)
	end
	m.Parent = folder
	return m
end

-- an AI car: position / heading / speed in metres, a polyline to follow (P) and the distance along it (s)
function Traffic.agent(kind, car, color)
	local c = car or Config.CARS[math.random(#Config.CARS)]
	local a = {
		kind = kind, cop = kind == "cop", L = c.L, W = c.W, H = c.H, vm = c.vm, a0 = c.a0,
		x = 0, z = 0, y = 0, h = 0, v = 0, s = 0, pi = 1, hit = 0, active = true, skill = 1,
	}
	a.model = Traffic.model(c.L, c.W, c.H, color or PAINT[math.random(#PAINT)], a.cop)
	return a
end

function Traffic.draw(a)
	local pos = Vector3.new(a.x, a.y + 0.1 + a.H * 0.34, a.z) * S
	a.model:PivotTo(CFrame.lookAt(pos, pos + Vector3.new(math.sin(a.h), 0, math.cos(a.h))))
end

function Traffic.remove(a)
	a.active = false
	if a.model then a.model:Destroy() end
end

-- move along the polyline at the target speed vt (accelerate with the car's own curve, brake at up to 9 m/s^2)
function Traffic.follow(a, dt, vt)
	if a.hit > 0 then
		a.hit -= dt
		vt = 0
	end
	local acc = a.a0 * (1 - math.pow(math.max(a.v, 0) / (a.vm * 1.05), 2.5))
	a.v = math.max(0, a.v + math.clamp(vt - a.v, -9 * dt, math.max(acc, 0.5) * dt))
	a.s = math.min(a.s + a.v * dt, a.P.c[#a.P.c])
	local x, z, y, tx, tz, i = Road.sample(a.P, a.s, a.pi)
	a.x, a.z, a.y, a.pi = x, z, y, i
	local want = math.atan2(tx, tz)
	local d = (want - a.h + math.pi) % (2 * math.pi) - math.pi
	a.h += math.clamp(d, -4 * dt, 4 * dt)
end

-- the web game's curve cap over the next 150 m of the path, plus braking room
function Traffic.curveCap(a)
	local P, j = a.P, a.pi
	local c0, best = a.s, 1e9
	while j + 3 <= #P.x and P.c[j] - c0 < 150 do
		local a1 = math.atan2(P.x[j + 1] - P.x[j], P.z[j + 1] - P.z[j])
		local a2 = math.atan2(P.x[j + 3] - P.x[j + 2], P.z[j + 3] - P.z[j + 2])
		local sa = math.max(0.02, math.abs((a2 - a1 + math.pi) % (2 * math.pi) - math.pi))
		local cp = math.clamp(math.sqrt(224 / sa), 9, 120)
		best = math.min(best, math.sqrt(cp * cp + 2 * 8 * math.max(0, P.c[j] - c0 - 4)))
		j += 1
	end
	return best
end

-- slow down for anything in front within 24 m and 2.6 m of the lane (other AI cars and the player)
function Traffic.gap(a, vt)
	local sh, ch = math.sin(a.h), math.cos(a.h)
	local function check(x, z)
		local dx, dz = x - a.x, z - a.z
		local f = dx * sh + dz * ch
		if f > 0 and f < 24 then
			local l = dx * ch - dz * sh
			if math.abs(l) < 2.6 then
				vt = math.min(vt, math.max(0, (f - 7) * 1.2))
			end
		end
	end
	for _, o in ipairs(State.ai) do
		if o ~= a then check(o.x, o.z) end
	end
	check(State.st.x, State.st.z)
	return vt
end

-- ---- traffic: random routes over the graph ----
local function nextTrav(tr)
	local e, d = tr.e, tr.d
	local node = State.road.nodes[d > 0 and e.b or e.a]
	-- direction of arrival
	local n = e.n
	local ax, az
	if d > 0 then
		ax, az = e.x[n] - e.x[math.max(1, n - 1)], e.z[n] - e.z[math.max(1, n - 1)]
	else
		ax, az = e.x[1] - e.x[2], e.z[1] - e.z[2]
	end
	local al = math.max(math.sqrt(ax * ax + az * az), 1e-6)
	local opts, wsum = {}, 0
	for _, o in ipairs(node.out) do
		if not (o.e == e and o.d == -d) and o.e.kind ~= 2 then
			local oe = o.e
			local bx, bz
			if o.d > 0 then
				bx, bz = oe.x[2] - oe.x[1], oe.z[2] - oe.z[1]
			else
				bx, bz = oe.x[oe.n - 1] - oe.x[oe.n], oe.z[oe.n - 1] - oe.z[oe.n]
			end
			local cs = (ax * bx + az * bz) / (al * math.max(math.sqrt(bx * bx + bz * bz), 1e-6))
			local w = (1.2 + cs) ^ 2
			opts[#opts + 1] = { o = o, w = w }
			wsum += w
		end
	end
	if #opts == 0 then return nil end
	local r = math.random() * wsum
	for _, q in ipairs(opts) do
		r -= q.w
		if r <= 0 then return q.o end
	end
	return opts[#opts].o
end

local function rebuild(a)
	a.P = Road.path(a.trs, Road.lane)
	a.pi = 1
end

-- keep 160 m of path ahead, and drop traversals already driven
local function extend(a)
	local changed = false
	while a.P.c[#a.P.c] - a.s < 160 and #a.trs < 12 do
		local nt = nextTrav(a.trs[#a.trs])
		if not nt then break end
		a.trs[#a.trs + 1] = nt
		rebuild(a)
		changed = true
	end
	if #a.trs > 3 and a.s > a.P.ends[1] + 25 then
		local cut = a.P.ends[1]
		table.remove(a.trs, 1)
		rebuild(a)
		a.s = math.max(0, a.s - cut)
		changed = true
	end
	return changed
end

-- (re)place a traffic car on a road 140-420 m from the player
local function spawn(a)
	local st = State.st
	for _ = 1, 12 do
		local ang, r = math.random() * 2 * math.pi, 140 + math.random() * 280
		local near = Road.nearest(State.road, st.x + math.sin(ang) * r, st.z + math.cos(ang) * r, 60)
		if near and near.e.kind ~= 2 and near.e.len > 20 then
			local d = near.e.ow and 1 or (math.random() < 0.5 and 1 or -1)
			a.trs = { { e = near.e, d = d } }
			rebuild(a)
			a.s = d > 0 and near.s or near.e.len - near.s
			a.pi = 1
			extend(a)
			a.v = math.min(near.e.lim / 3.6, 12)
			a.lim = near.e.lim
			a.skill = 0.8 + math.random() * 0.2
			local x, z, y, tx, tz, i = Road.sample(a.P, a.s, 1)
			a.x, a.z, a.y, a.pi, a.h = x, z, y, i, math.atan2(tx, tz)
			a.hit = 0
			return true
		end
	end
	return false
end

function Traffic.start()
	for _ = 1, Config.TRAFFIC_CARS do
		local a = Traffic.agent("traffic")
		a.vm = math.min(a.vm, 33)
		if spawn(a) then
			agents[#agents + 1] = a
			Traffic.draw(a)
		else
			Traffic.remove(a)
		end
	end
end

-- move traffic cars out of a circle (race starts)
function Traffic.clear(x, z, r)
	for _, a in ipairs(agents) do
		if (a.x - x) ^ 2 + (a.z - z) ^ 2 < r * r then spawn(a) end
	end
end

function Traffic.step(dt)
	local st = State.st
	for _, a in ipairs(agents) do
		if (a.x - st.x) ^ 2 + (a.z - st.z) ^ 2 > 520 * 520 then
			spawn(a)
		end
		extend(a)
		-- the speed limit of the street this car is on
		local ti = 1
		while ti < #a.trs and a.s > a.P.ends[ti] do ti += 1 end
		local lim = a.trs[ti].e.lim / 3.6
		local vt = math.min(a.vm, lim * a.skill, Traffic.curveCap(a))
		vt = Traffic.gap(a, vt)
		-- dead end: stop, then reappear somewhere else
		if a.s >= a.P.c[#a.P.c] - 1 then
			a.stuck = (a.stuck or 0) + dt
			if a.stuck > 3 then
				a.stuck = 0
				spawn(a)
			end
		end
		Traffic.follow(a, dt, vt)
		Traffic.draw(a)
	end
end

return Traffic
]]></ProtectedString></Properties></Item></Item><Item class="LocalScript" referent="RBX31"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the player's device: loads the road graph, starts the modules in Client/, reads the controls and runs them
-- every frame. Controls: W/S or the thumbstick = gas / brake-reverse, A/D steer, Space or DRIFT = handbrake, F reset, C camera,
-- G garage, N GPS, R race, E rob the bank, U tuning shop, K car wheel. Phones and tablets use the on-screen buttons.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Road = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Road"))
local Shared = ReplicatedStorage:WaitForChild("IrbidShared")
local Client = script.Parent:WaitForChild("Client")
local State = require(Client:WaitForChild("State"))

local plr = Players.LocalPlayer
local controls = require(plr:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()

-- the road graph (traffic, GPS, minimap, street names, reset)
do
	local edges, i = {}, 1
	while Shared:FindFirstChild("GraphEdges" .. i) do
		edges[#edges + 1] = require(Shared["GraphEdges" .. i])
		i += 1
	end
	State.road = Road.build(require(Shared:WaitForChild("GraphNodes")), edges, require(Shared:WaitForChild("GraphNames")))
end
while not Workspace:GetAttribute("MapReady") do task.wait(0.25) end

local Hud = require(Client:WaitForChild("Hud"))
local Drive = require(Client:WaitForChild("Drive"))
local Traffic = require(Client:WaitForChild("Traffic"))
local Nav = require(Client:WaitForChild("Nav"))
local Missions = require(Client:WaitForChild("Missions"))
local Menus = require(Client:WaitForChild("Menus"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

-- the tuning shop opens only at Apex Drift Customs
function Missions.openShop()
	if Missions.nearShop() then
		Menus.shop()
	else
		Hud.toast("Apex Drift Customs is the orange pad: find it on the minimap")
	end
end

-- ---- buttons (all devices) ----
Hud.sideButton("🚗 Garage (G)", Menus.garage)
Hud.sideButton("🎡 Wheel (K)", Menus.wheel)
Hud.sideButton("📍 GPS (N)", Nav.open)
Hud.sideButton("🏁 Race (R)", Missions.race)
Hud.sideButton("🎥 Camera (C)", Drive.cycleCam)
Hud.sideButton("↺ Reset (F)", Drive.reset)

-- ---- keys ----
local hb = false
ContextActionService:BindAction("Handbrake", function(_, state)
	hb = state == Enum.UserInputState.Begin
	return Enum.ContextActionResult.Sink
end, true, Enum.KeyCode.Space, Enum.KeyCode.ButtonR1)
ContextActionService:SetTitle("Handbrake", "DRIFT")
ContextActionService:SetPosition("Handbrake", UDim2.new(1, -170, 1, -150))

local KEYS = {
	[Enum.KeyCode.F] = Drive.reset,
	[Enum.KeyCode.C] = Drive.cycleCam,
	[Enum.KeyCode.G] = Menus.garage,
	[Enum.KeyCode.N] = Nav.open,
	[Enum.KeyCode.R] = Missions.race,
	[Enum.KeyCode.E] = Missions.rob,
	[Enum.KeyCode.U] = Missions.openShop,
	[Enum.KeyCode.K] = Menus.wheel,
	[Enum.KeyCode.Escape] = Hud.closePanel,
}
UserInputService.InputBegan:Connect(function(io, gp)
	if gp then return end
	local f = KEYS[io.KeyCode]
	if f then f() end
end)

-- ---- info line ----
local function clockText()
	local h = game:GetService("Lighting").ClockTime
	return string.format("%02d:%02d", math.floor(h), math.floor((h % 1) * 60))
end
local infoT = 0
local function info(dt)
	infoT -= dt
	if infoT > 0 then return end
	infoT = 0.2
	Hud.info.Text = "IRBID DRIVE · 📍 " .. (Nav.street ~= "" and Nav.street or "off-road") .. " · " .. clockText()
		.. " · Cash " .. Hud.fmt(plr:GetAttribute("Cash") or 0) .. " · Drift bank " .. Hud.fmt(plr:GetAttribute("DriftBank") or 0)
end

Traffic.start()
Hud.toast("Welcome to Irbid! Drift to earn points and cash. R = race, N = GPS, G = garage", 6)

local ai = State.ai
RunService.RenderStepped:Connect(function(dt)
	local mv = controls:GetMoveVector()
	local inp = State.input
	inp.th, inp.br, inp.steer, inp.hb = math.max(0, -mv.Z), math.max(0, mv.Z), -mv.X, hb
	-- every AI car of this frame, for bumping, following and the minimap
	table.clear(ai)
	for _, a in ipairs(Traffic.agents) do ai[#ai + 1] = a end
	for _, a in ipairs(Missions.rivals) do ai[#ai + 1] = a end
	for _, a in ipairs(Missions.cops) do ai[#ai + 1] = a end
	Drive.step(dt)
	Traffic.step(dt)
	Missions.step(dt)
	Nav.step(dt)
	Drive.camera(dt)
	info(dt)
	Hud.step(dt)
end)

-- keep the seat: if the player somehow stands up, the server seats them again
plr.CharacterAdded:Connect(function()
	task.wait(1)
	if State.car and not State.car.Parent then Remotes.ResetCar:FireServer() end
end)
]]></ProtectedString></Properties></Item></Item></Item></roblox>
