<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace" referent="RBX5"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool></Properties><Item class="Part" referent="RBX4"><Properties><string name="Name">EditModeSign</string><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><CoordinateFrame name="CFrame"><X>0</X><Y>25</Y><Z>-60</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>120</X><Y>40</Y><Z>2</Z></Vector3><Color3uint8 name="Color3uint8">4280168528</Color3uint8></Properties><Item class="SurfaceGui" referent="RBX1"><Properties><string name="Name">Msg</string><token name="Face">2</token><token name="SizingMode">1</token><float name="PixelsPerStud">12</float></Properties><Item class="TextLabel" referent="RBX0"><Properties><string name="Name">Text</string><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><float name="BackgroundTransparency">1</float><bool name="TextScaled">true</bool><bool name="TextWrapped">true</bool><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><string name="Text">IRBID DRIVE
Press ▶ Play (F5) to build the map of Irbid and drive.
The streets, buildings and terrain are created when the game starts.</string></Properties></Item></Item><Item class="SurfaceGui" referent="RBX3"><Properties><string name="Name">Msg</string><token name="Face">5</token><token name="SizingMode">1</token><float name="PixelsPerStud">12</float></Properties><Item class="TextLabel" referent="RBX2"><Properties><string name="Name">Text</string><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><float name="BackgroundTransparency">1</float><bool name="TextScaled">true</bool><bool name="TextWrapped">true</bool><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><string name="Text">IRBID DRIVE
Press ▶ Play (F5) to build the map of Irbid and drive.
The streets, buildings and terrain are created when the game starts.</string></Properties></Item></Item></Item></Item><Item class="ReplicatedStorage" referent="RBX63"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - shared settings. Read by the server and by every player's client scripts.
-- MONEY: create these in the Roblox Creator Dashboard (your experience -> Monetization), then paste the numeric IDs here and republish.
-- While an ID is 0 the matching button is hidden and nothing can be bought.
local Meta = require(script.Parent:WaitForChild("IrbidShared"):WaitForChild("Meta"))
local Config = {}

Config.GAMEPASS_VIP = 0        -- Game Pass "VIP": double cash from drifting + the VIP car
Config.PRODUCT_CASH_SMALL = 0  -- Developer Product: +5,000 cash
Config.PRODUCT_CASH_BIG = 0    -- Developer Product: +25,000 cash
Config.CASH_SMALL = 5000
Config.CASH_BIG = 25000

-- SOUND: the web game's synthesised sounds, rendered into one file by tools/make_roblox_audio.js: roblox/audio/IrbidDriveSounds.wav.
-- Upload it once (Creator Dashboard -> Development Items -> Audio, or Studio's Asset Manager -> Bulk Import) and paste its numeric ID
-- here (0 = no sound: everything else works without it).
Config.AUDIO_ATLAS_ID = 0

Config.SCALE = 3               -- studs per metre (the map data is in metres)
Config.START_CASH = 500
Config.DRIFT_CASH = 0.25       -- cash per drift point (VIP: x2); drift points also go to the drift bank that pays for upgrades
Config.TRAFFIC_CARS = 80       -- AI cars around each player (the web game: 80 on "High"; lower it for phones), simulated on that device
Config.DAY_MINUTES = 16       -- one in-game day lasts this many real minutes (the web game: an hour every 40 s), starting at 15:00

-- Cars: speed / acceleration / brakes / handling / rarity tier come from the web game's own car data (tools/make_roblox.js); generic names.
Config.CARS = Meta.cars
-- Rarity tiers (web game): Common x1.0, Uncommon x1.2, Rare x1.5, Epic x2.0, Legendary x3.0 drift points
Config.RARITY = Meta.rarity
Config.TIER_COLORS = { Color3.fromRGB(154, 160, 166), Color3.fromRGB(76, 175, 80), Color3.fromRGB(33, 150, 243), Color3.fromRGB(156, 39, 176), Color3.fromRGB(255, 193, 7) }

-- Apex Drift Customs (web game economy): price = base x 2^level, 5 levels, paid with banked drift points
Config.UPGRADES = {
	{ name = "Speed", base = 1500, info = "Top speed +5% per upgrade" },
	{ name = "Acceleration", base = 1200, info = "Acceleration +6% per upgrade" },
	{ name = "Handling", base = 800, info = "Steering and grip +7% per upgrade" },
	{ name = "Extra Drift Points", base = 3000, info = "Drift points +20% per upgrade" },
}
Config.UPGRADE_MAX = 5
function Config.upgradePrice(part, level)
	return Config.UPGRADES[part].base * 2 ^ level
end

-- Car wheel (web game): 10,000 per spin, tier odds 50 / 35 / 10 / 4 / 1 %, a duplicate refunds 5,000
Config.WHEEL_COST = 10000
Config.WHEEL_ODDS = { 0.50, 0.35, 0.10, 0.04, 0.01 }
Config.WHEEL_REFUND = 5000

-- Bank heist (web game): survive the police for 2:00 -> +500; caught -> lose up to 50; the bank then closes for 3:00
Config.HEIST_TIME = 120
Config.HEIST_REWARD = 500
Config.HEIST_FINE = 50
Config.HEIST_COOLDOWN = 180

-- Street races (Roblox only: the web game gives no money for races): cash by finishing place
Config.RACE_REWARD = { 1000, 500, 250, 100 }

-- Car stats with the player's upgrades (the web game's applyTune)
function Config.tuned(carIndex, levels)
	local c = Config.CARS[carIndex] or Config.CARS[1]
	local l = levels or { 0, 0, 0, 0 }
	return {
		vm = c.vm * (1 + 0.05 * l[1]),
		a0 = c.a0 * (1 + 0.06 * l[2]),
		hd = c.hd + 0.07 * l[3],
		dr = l[4],
		bk = c.bk,
		rm = Config.RARITY[c.tier + 1].mult,
	}
end

return Config
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX12"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">CarBody</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the web game's car shapes (07a_cars.js mkPorsche + 07a4_carvis.js addNeon), for the player's car (server, welded)
-- and the AI cars (devices, anchored). Every car is the side profile of its body type (PROF: nose height, bonnet length, rear-deck height,
-- glass-house points, body-height share) across the car's width; a glass house (four points: windscreen, roof, rear screen; two points
-- for open cars: a windscreen and a dark cockpit); a roof panel; a rear wing on race cars; head and tail lamps; four wheels (radius by body
-- type) with metal rims; and the car's own neon light lines in its two name-hashed colours (the web game's light-line layout per car).
-- Roblox cannot extrude a shape at run time, so each flat run of the profile is a block and each sloped edge a wedge: the side view is
-- the web profile (the web game's 0.1 m bevel and its 10,000-pixel detail texture are not reproduced).
-- Model space: the model faces -Z and +X is the car's right (the web mesh: +x left, +z forward); web point (x, y, z) -> (-x, y - lift, -z)
-- with lift = H * 0.34 - 0.12, the height of the root part "Body" above the car's ground point (where Client/Drive puts it).
local CarBody = {}

-- the web game's body profiles (07a PROF)
CarBody.PROF = {
	c = { nf = 0.55, hl = 0.3, rf = 0.85, g = { 0.12, -0.02, -0.26, -0.36 }, bf = 0.5 },
	m = { nf = 0.3, hl = 0.2, rf = 0.8, g = { 0.24, 0.04, -0.14, -0.32 }, bf = 0.56 },
	o = { nf = 0.5, hl = 0.3, rf = 0.85, g = { 0.16, 0.11 }, bf = 0.62 },
	q = { nf = 0.3, hl = 0.2, rf = 0.8, g = { 0.27, 0.22 }, bf = 0.62 },
	s = { nf = 0.8, hl = 0.2, rf = 0.95, g = { 0.18, 0.1, -0.4, -0.42 }, bf = 0.5 },
	p = { nf = 0.8, hl = 0.22, rf = 0.95, g = { 0.18, 0.1, -0.02, -0.05 }, bf = 0.5 },
	r = { nf = 0.3, hl = 0.24, rf = 0.8, g = { 0.1, -0.02, -0.16, -0.26 }, bf = 0.62 },
	v = { nf = 0.9, hl = 0.25, rf = 0.95, g = { 0.12, 0.12, -0.3, -0.3 }, bf = 0.45 },
	h = { nf = 0.6, hl = 0.2, rf = 0.9, g = { 0.18, 0.06, -0.4, -0.46 }, bf = 0.5 },
}
local GLASS, TYRE, RIM, BLACK = Color3.fromHex("#0b121a"), Color3.fromHex("#0e0e0f"), Color3.fromHex("#d4d8dc"), Color3.fromHex("#111111")
local HEAD, TAIL = Color3.fromHex("#fff4c8"), Color3.fromHex("#ff2020")

local function hex(c)
	return Color3.fromRGB(math.floor(c / 65536) % 256, math.floor(c / 256) % 256, c % 256)
end
CarBody.hex = hex

-- the root part's height above the car's ground point (metres)
function CarBody.lift(H)
	return H * 0.34 - 0.12
end

-- c = Config.CARS[i]; color = paint (Color3); opt = {S = studs per metre, anchored, neon (light lines), cop (police light bar)}
function CarBody.build(c, color, opt)
	local S = opt.S or 3
	local L, W, H, k = c.L, c.W, c.H, c.body or "c"
	local P0 = CarBody.PROF[k] or CarBody.PROF.c
	local bh = (H - 0.3) * P0.bf
	local y0 = 0.3 + bh
	local lift = CarBody.lift(H)
	local m = Instance.new("Model")
	m.Name = "Car"
	local root = Instance.new("Part")
	root.Name = "Body"
	root.Size = Vector3.new(W * 0.6 * S, 0.4 * S, L * 0.6 * S)
	root.Transparency = 1
	root.Color = color
	root.Anchored = true
	root.CanCollide, root.CanQuery, root.CanTouch = false, false, false
	root.CFrame = CFrame.new()
	root.Parent = m
	m.PrimaryPart = root
	m:SetAttribute("Paint", color)
	local anchored = opt.anchored == true
	-- one part at web coordinates; cf in model space
	local function add(name, size, cf, col, mat, shape, cls)
		local p = Instance.new(cls or "Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Color = col
		p.Material = mat or Enum.Material.SmoothPlastic
		if shape then p.Shape = shape end
		p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
		p.Anchored = anchored
		p.Massless = true
		p.Parent = m
		if not anchored then
			local w = Instance.new("WeldConstraint")
			w.Part0, w.Part1 = root, p
			w.Parent = p
		end
		return p
	end
	local function at(x, y, z)
		return Vector3.new(-x * S, (y - lift) * S, -z * S)
	end
	-- an axis-aligned block between web z0..z1, y0..y1, width w (centred)
	local function block(name, z0, z1, ya, yb, w, col, mat)
		if z1 - z0 < 0.005 or yb - ya < 0.005 then return nil end
		return add(name, Vector3.new(w * S, (yb - ya) * S, (z1 - z0) * S), CFrame.new(at(0, (ya + yb) / 2, (z0 + z1) / 2)), col, mat)
	end
	-- a right-triangle prism of width w: right angle at web (zr, yr), one leg to (zh, yr) (along the car), the other to (zr, yv) (up)
	-- Roblox's WedgePart has its right angle at the bottom-back edge (y = -h/2, z = +d/2) and its slope down to the front (-Z)
	local function wedge(name, zr, yr, zh, yv, w, col, mat)
		local d, h = math.abs(zh - zr), yv - yr
		if d < 0.005 or h < 0.005 then return nil end
		local r = at(0, yr, zr)
		local hdir = (at(0, yr, zh) - r).Unit
		local up = Vector3.new(0, 1, 0)
		local zAxis = -hdir
		local xAxis = up:Cross(zAxis)
		local centre = r + hdir * (d * S / 2) + up * (h * S / 2)
		return add(name, Vector3.new(w * S, h * S, d * S), CFrame.fromMatrix(centre, xAxis, up, zAxis), col, mat, nil, "WedgePart")
	end
	-- ---- the body: the profile A (-L/2, .3) B (L/2, .3) C (L/2, nose) D (bonnet end, y0) E (-0.42 L, y0) F (-L/2, deck) ----
	local Cy, Dz, Ez, Fy = 0.3 + bh * P0.nf, L * (0.5 - P0.hl), -L * 0.42, 0.3 + bh * P0.rf
	local yc = math.min(Cy, Fy)
	block("Shell", -L / 2, L / 2, 0.3, yc, W, color)
	block("Shell", Dz, L / 2, yc, Cy, W, color)
	wedge("Shell", Dz, Cy, L / 2, y0, W, color)
	block("Shell", Ez, Dz, yc, y0, W, color)
	block("Shell", -L / 2, Ez, yc, Fy, W, color)
	wedge("Shell", Ez, Fy, -L / 2, y0, W, color)
	-- ---- the glass house ----
	local a = P0.g
	local function u(f) return f * L end
	if #a == 4 then
		local gw = W * 0.84
		block("Glass", u(a[3]), u(a[2]), y0, H, gw, GLASS, Enum.Material.Glass)
		wedge("Glass", u(a[2]), y0, u(a[1]), H, gw, GLASS, Enum.Material.Glass)
		wedge("Glass", u(a[3]), y0, u(a[4]), H, gw, GLASS, Enum.Material.Glass)
		local rl = u(a[2] - a[3])
		if rl > 0.2 then
			add("Roof", Vector3.new(W * 0.8 * S, 0.08 * S, rl * S), CFrame.new(at(0, H + 0.02, u((a[2] + a[3]) / 2))), color)
		end
	else
		-- open cars: a slanted windscreen and a dark cockpit
		local p0, p1 = at(0, y0, u(a[1]) - 0.06), at(0, H, u(a[2]) - 0.06)
		local len = (p1 - p0).Magnitude
		add("Glass", Vector3.new(W * 0.8 * S, len, 0.1 * S), CFrame.lookAt((p0 + p1) / 2, p1) * CFrame.Angles(math.pi / 2, 0, 0), GLASS, Enum.Material.Glass)
		add("Cockpit", Vector3.new(W * 0.7 * S, 0.25 * S, L * 0.22 * S), CFrame.new(at(0, y0 + 0.05, u(a[1] - 0.2))), BLACK)
	end
	if k == "r" then add("Wing", Vector3.new(W * 0.95 * S, 0.08 * S, 0.6 * S), CFrame.new(at(0, H + 0.15, -L * 0.47)), color) end
	-- ---- lamps (Light: 0 / 1 left / right headlight, 2 / 3 left / right tail light; web sx = +1 is the car's left) ----
	for _, sx in ipairs({ 1, -1 }) do
		local hl = add("Headlight", Vector3.new(0.4 * S, 0.14 * S, 0.06 * S), CFrame.new(at(sx * W * 0.33, 0.3 + bh * P0.nf * 0.8, L / 2 + 0.02)), HEAD, Enum.Material.Neon)
		hl:SetAttribute("Light", sx > 0 and 0 or 1)
		local tl = add("Taillight", Vector3.new(0.45 * S, 0.1 * S, 0.06 * S), CFrame.new(at(sx * W * 0.33, 0.3 + bh * P0.rf * 0.75, -L / 2 - 0.02)), TAIL, Enum.Material.Neon)
		tl:SetAttribute("Light", sx > 0 and 2 or 3)
	end
	-- ---- wheels (Corner: 0 FL, 1 FR, 2 RL, 3 RR) ----
	local wr = (k == "s" or k == "p") and 0.5 or k == "v" and 0.45 or 0.38
	local s = wr / 0.42
	for _, q in ipairs({ { -1, 1 }, { 1, 1 }, { -1, -1 }, { 1, -1 } }) do
		local x, z = q[1] * (W / 2 - 0.12), q[2] * L * 0.31
		local ci = (q[2] > 0 and 0 or 2) + (q[1] > 0 and 0 or 1)
		local w = add("Wheel", Vector3.new(0.3 * S, 0.84 * s * S, 0.84 * s * S), CFrame.new(at(x, wr, z)), TYRE, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
		w:SetAttribute("Corner", ci)
		local rim = add("Rim", Vector3.new(0.32 * S, 0.56 * s * S, 0.56 * s * S), CFrame.new(at(x + q[1] * 0.01, wr, z)), RIM, Enum.Material.Metal, Enum.PartType.Cylinder)
		rim:SetAttribute("Corner", ci)
	end
	-- ---- the car's light lines (addNeon): side strips, front line, rear line (split or not), corner marks ----
	local vis = c.vis
	if opt.neon and vis then
		local A, B = hex(vis.c1), hex(vis.c2)
		if vis.ln.swap then A, B = B, A end
		local ln = vis.ln
		local function strip(col, sx, sy, sz, px, py, pz)
			add("Neon", Vector3.new(sx * S, sy * S, sz * S), CFrame.new(at(px, py, pz)), col, Enum.Material.Neon)
		end
		for _, sd in ipairs({ -1, 1 }) do
			strip(A, 0.05, 0.06, L * ln.sideLen, sd * (W / 2 - 0.03), 0.27, -L * 0.02)
			if ln.side > 1 then strip(B, 0.05, 0.05, L * ln.sideLen * 0.7, sd * (W / 2 - 0.03), 0.19, -L * 0.02) end
			if ln.corners then strip(B, 0.05, 0.18, 0.05, sd * (W / 2 - 0.05), 0.4, L / 2 + 0.02) end
		end
		strip(A, W * ln.front, 0.045, 0.05, 0, 0.3, L / 2 + 0.02)
		if ln.rearSplit then
			for _, sd in ipairs({ -1, 1 }) do strip(B, W * ln.rear * 0.42, 0.045, 0.05, sd * W * ln.rear * 0.3, 0.34, -L / 2 - 0.02) end
		else
			strip(B, W * ln.rear, 0.045, 0.05, 0, 0.34, -L / 2 - 0.02)
		end
	end
	-- ---- police: a red / blue light bar on the roof ----
	if opt.cop then
		add("LightR", Vector3.new(W * 0.3 * S, 0.12 * S, 0.25 * S), CFrame.new(at(W * 0.18, H + 0.1, 0)), Color3.fromRGB(255, 30, 30), Enum.Material.Neon)
		add("LightB", Vector3.new(W * 0.3 * S, 0.12 * S, 0.25 * S), CFrame.new(at(-W * 0.18, H + 0.1, 0)), Color3.fromRGB(30, 80, 255), Enum.Material.Neon)
	end
	return m
end

return CarBody
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">CarPhysics</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the player's car physics: the web game's updP (10_laws_player.js) and its Realistic handling (07g_drive.js),
-- line for line, as a PURE module (no Roblox services, only math), so tests/physics_equiv.js can run it next to the web build and compare
-- every frame. Drive.lua feeds it the input and the surface grip and does the moving, the ground height, the walls and the visuals.
--   st:   x, z, h (heading, forward = (sin h, cos h)), vx, vz (m/s), gnd (wheels on the ground), al (forward acceleration of the last step)
--   spec: vm (top speed m/s), a0 (acceleration m/s²), bk (brakes m/s²), hd (handling) [the web game's applyTune values]; ci (car index)
--         and pt (the car's Realistic data, the web game's ptSpec + ptGeom, exported by tools/make_roblox.js)
--   inp:  th, br (0..1), steer (-1..1, + = left), hb (handbrake), an (steering from an analog axis: the web game's wheel path)
--   env:  sfc (surface grip), TH (terrain height function (x, z) -> m), frozen (race countdown), mode (0 Arcade / 1 Realistic),
--         dfx (damage effects, 1 = none), and the Realistic state tables from CarPhysics.newState (pts, tslip, simx, assist, wx)
-- Realistic numbers are the web game's GAMEPLAY ESTIMATES (solved from each car's top speed and 0-100 time), not manufacturer data.
local CarPhysics = {}

local function clamp(v, a, b)
	return v < a and a or v > b and b or v
end
CarPhysics.clamp = clamp
local function hypot(a, b)
	return math.sqrt(a * a + b * b)
end

-- no damage: every effect neutral (the web game's damageEffects() with damage Off)
CarPhysics.NO_DAMAGE = { maxSpeed = 1, accel = 1, steering = 1, grip = 1, brakes = 1, lat = 1, pull = 0, roll = 0 }

-- the Realistic state (the web game's PTS, TSLIP, SIMX, ASSIST; WX = weather grip and wetness)
function CarPhysics.newState()
	return {
		pts = { yr = 0, dl = 0, h0 = 0, gear = 1, rpm = 850, shift = 0, spin = 0, lim = 0, hz = 0, hv = 0, pz = 0, pv = 0, rz = 0, rv = 0, idx = -1,
			man = 0, req = 0, deny = 0, flock = 0, absA = 0, tcA = 0, escA = 0 },
		tslip = { f = 0, r = 0, lock = 0, spin = 0, sa = 0, af = 0, ar = 0 },
		-- optional tyre temperature (tt) and brake fade (bf): off by default (= the plain Realistic handling)
		simx = { tt = false, bf = false, tT = 24, bT = 24, gk = 1, bk = 1 },
		-- driver assists: ABS on, traction control off, stability control off (the web game's defaults)
		assist = { abs = true, tc = false, esc = false },
		wx = { mu = 1, wet = 0 },
	}
end

-- after a car change or a handling switch (the web game's setHandling): gear back to 1, springs at rest
function CarPhysics.resetRealistic(env)
	local p = env.pts
	p.idx, p.yr, p.dl = -1, 0, 0
	p.hz, p.hv, p.pz, p.pv, p.rz, p.rv = 0, 0, 0, 0, 0, 0
end

-- ---- engine and gearbox (07g ptCurve / ptGear / ptShare) ----
-- generic engine torque shape vs x = rpm / redline (petrol NA / turbo blend); EV: constant torque, then constant power
local function ptCurve(x, ev)
	if ev then return x < 0.35 and 1 or 0.35 / x end
	if x < 0.12 then return 0.5 end
	if x < 0.6 then return 0.55 + 0.45 * math.sin((x - 0.12) / 0.48 * math.pi / 2) end
	if x < 0.85 then return 1 end
	return math.max(0.6, 1 - (x - 0.85) * 1.3)
end
CarPhysics.ptCurve = ptCurve
-- engine rpm at road speed v in gear g (clutch locked)
local function ptGear(s, v: number, g: number): number
	return v * s.ratio[g] / s.rw * 60 / (2 * math.pi)
end
CarPhysics.ptGear = ptGear
-- share of the car's weight on the driven wheels at forward acceleration a (longitudinal load transfer)
local function ptShare(s, a)
	local d = a * s.hcg / (s.wb * 9.81)
	if s.drive == "AWD" then return 1 end
	if s.drive == "FWD" then return clamp(s.fw - d, 0.2, 0.9) end
	return clamp(1 - s.fw + d, 0.2, 0.9)
end

-- ---- 07g ptAccel: longitudinal acceleration (throttle, gearbox, traction limit, drag, rolling, engine braking) ----
local function ptAccel(st, spec, env, dt, thA, fs, sfc, dfx)
	local P, A = env.pts, env.assist
	if P.escA ~= 0 then thA *= 0.3 end
	local s = spec.pt
	local kv = math.max(0.3, (spec.vm / s.vref) * dfx.maxSpeed)
	local ka = (spec.a0 / s.aref) * dfx.accel
	local v = math.max(0, fs)
	if P.idx ~= spec.ci then
		P.idx, P.gear, P.shift, P.spin = spec.ci, 1, 0, 0
	end
	local red, idl = s.red, s.idle
	local g = P.gear
	local rpm = ptGear(s, v, g) / kv
	if P.shift > 0 then
		P.shift -= dt
	elseif P.man ~= 0 then
		-- manual (Q / E, paddles): a downshift that would over-rev is refused
		local q = P.req
		P.req = 0
		if q > 0 and g < s.ng then
			g += 1
			P.gear, P.shift = g, s.shiftT
			rpm = ptGear(s, v, g) / kv
		elseif q < 0 and g > 1 then
			if ptGear(s, v, g - 1) / kv <= red * 1.03 then
				g -= 1
				P.gear, P.shift = g, s.shiftT * 0.6
				rpm = ptGear(s, v, g) / kv
			else
				P.deny = 1
			end
		end
	elseif g < s.ng and rpm >= red * (thA > 0.6 and 0.97 or 0.6) then
		g += 1
		P.gear, P.shift = g, s.shiftT
		rpm = ptGear(s, v, g) / kv
	elseif g > 1 and ptGear(s, v, g - 1) / kv < red * (thA > 0.6 and 0.86 or 0.5) and rpm < red * (thA > 0.6 and 0.55 or 0.3) then
		g -= 1
		P.gear, P.shift = g, s.shiftT * 0.6
		rpm = ptGear(s, v, g) / kv
	end
	local F = 0
	local eng = math.max(rpm, idl)
	local gov = s.gov > 0 and v >= s.gov * kv
	if P.shift <= 0 and thA > 0 and not gov and not (P.man ~= 0 and rpm >= red) then
		local r = math.min(math.max(eng, (v < 6 and g == 1 and not s.ev) and red * 0.45 * thA or 0), red)
		F = s.T * ka * thA * ptCurve(r / red, s.ev) * s.ratio[g] / s.rw * s.eff
	elseif thA <= 0 and P.shift <= 0 and not s.ev and v > 1 then
		-- engine braking (EV regeneration is not modelled)
		F = -s.T * 0.12 * (eng / red) * s.ratio[g] / s.rw
	end
	local al = clamp(st.al == st.al and st.al or 0, -12, 12)
	local lim = s.mu * sfc * 9.81 * ptShare(s, math.max(0, al)) * s.m
	P.lim = lim
	P.tcA = 0
	if A.tc and F > lim * 0.97 then
		F = lim * 0.97
		P.tcA = 1
	end
	if F > lim then
		P.spin = math.min(1, P.spin + dt * 4 * (F / lim - 1) + dt)
		F = lim * 0.9
	else
		P.spin = math.max(0, P.spin - dt * 3)
	end
	P.rpm = P.spin > 0.2 and math.min(red, math.max(eng, red * (0.55 + 0.4 * P.spin))) or math.min(eng, red)
	return (F - 0.5 * 1.2 * s.CdA / (kv * kv * kv) * v * v * math.sign(fs) - s.crr * s.m * 9.81 * math.sign(fs) * (math.abs(fs) > 0.3 and 1 or 0)) / s.m
end

-- ---- 07g ptDyn: the two-axle tyre model (slip angles, load transfer, friction circle, locked-rear handbrake, yaw inertia) ----
local C_PAC = 1.4
local function ptDyn(st, spec, env, dt, steer, an, hb, u, v, sfc, ax, frozen, dfx)
	local P, T = env.pts, env.tslip
	local s = spec.pt
	local m, a, b, mu = s.m, s.a, s.b, s.mu * sfc
	if frozen then
		P.yr, P.dl = 0, 0
		return u, v
	end
	local beta = math.abs(math.atan2(v, math.abs(u) + 0.5))
	local dmax = 0.6 * dfx.steering / (1 + math.max(0, u) / (12 + 45 * math.min(1, beta * 2.5)))
	local tgt = steer * dmax
	if an then
		P.dl = tgt
	else
		local rt = (tgt * P.dl < 0 or tgt == 0) and 6 or 4
		P.dl += clamp(tgt - P.dl, -rt * dt, rt * dt)
	end
	local d = P.dl
	local cd, sd = math.cos(d), math.sin(d)
	if not st.gnd then
		st.h += P.yr * dt
		P.yr *= 1 - 0.8 * dt
		return u, v
	end
	local g = 9.81 * m
	local dT = m * clamp(ax, -12, 12) * s.hcg / s.wb
	local dn = 0.6 * s.cl * u * u
	local Ff = math.max(0.15 * g, g * s.fw - dT + dn * 0.45)
	local Fr = math.max(0.15 * g, g * (1 - s.fw) + dT + dn * 0.55)
	local Fx = m * math.min(12, math.abs(ax))
	local sh = ax > 0.3 and (s.drive == "FWD" and 1 or s.drive == "AWD" and 0.4 or 0) or ax < -0.3 and 0.65 or 0.5
	local function ci(c, f)
		return math.max(0.3 * c, math.sqrt(math.max(0, c * c - f * f)))
	end
	local cF, cR = ci(mu * Ff, Fx * sh), ci(mu * Fr, Fx * (1 - sh))
	local sp = P.spin
	if P.flock ~= 0 then cF *= 0.15 end
	if sp > 0 then
		if s.drive == "FWD" then
			cF *= 1 - 0.6 * sp
		else
			cR *= 1 - (s.drive == "RWD" and 0.65 or 0.3) * sp
		end
	end
	local n = math.min(12, math.ceil(dt * 240))
	local h = dt / n
	local kin = clamp((u - 2) / 4, 0, 1)
	local r, af, ar, lk = P.yr, 0, 0, 0
	for _ = 1, n do
		local fyf, fyr, fxr = 0, 0, 0
		if kin > 0 then
			local au = math.max(math.abs(u), 0.5)
			local vr = v + b * r
			af = math.atan2(v - a * r, au) + d
			ar = math.atan2(vr, au)
			fyf = -cF * math.sin(C_PAC * math.atan(s.B * af))
			if hb then
				local q = hypot(u, vr)
				if q == 0 then q = 1 end
				local fsl = 0.8 * mu * Fr
				fyr, fxr, lk = -fsl * vr / q, -fsl * u / q, 1
			else
				fyr = -cR * math.sin(C_PAC * math.atan(s.B * ar))
			end
		end
		local rd = r + (-a * fyf * cd + b * fyr) / s.Iz * h
		local rk = u * math.tan(d) / s.wb
		r = kin * rd + (1 - kin) * rk
		v = kin * (v + ((fyf * cd + fyr) / m + u * r) * h) + (1 - kin) * v * math.exp(-8 * h)
		u += kin * ((fxr - math.abs(fyf * sd) * math.sign(u)) / m - v * r) * h
		if hb and kin < 1 then u *= math.exp(-2.5 * (1 - kin) * h) end
		st.h += r * h
	end
	P.escA = 0
	if env.assist.esc and kin > 0.5 and u > 6 and not hb then
		local rk = u * math.tan(d) / s.wb
		if math.abs(r - rk) > 0.12 then
			r += (rk - r) * math.min(1, 6 * dt)
			P.escA = 1
		end
	end
	P.yr = r
	T.af = kin * math.abs(af) / s.pk
	T.ar = kin * math.abs(ar) / s.pk
	T.f = kin * clamp(math.abs(af) / s.pk - 1, 0, 3)
	T.r = kin * math.max(clamp(math.abs(ar) / s.pk - 1, 0, 3), lk * clamp((hypot(u, v) - 3) / 6, 0, 2))
	T.lock = math.max(lk, P.flock ~= 0 and 1 or 0)
	return u, v
end

-- ---- 07g slipTick: tyre slip for smoke / squeal / audio in both modes (never physics) ----
local function slipTick(st, env, fs, ls, frozen, bo)
	local T = env.tslip
	local sa = math.abs(math.atan2(ls, math.abs(fs) + 0.5))
	local sp = hypot(fs, ls)
	T.sa = sa
	T.spin = bo and 1 or (env.mode == 1 and env.pts.spin or 0)
	if env.mode ~= 1 then
		T.r = (st.gnd and not frozen and sp > 5) and clamp((sa - 0.12) / 0.15, 0, 3) or 0
		T.f = T.r * 0.3
		T.lock = 0
	end
end

-- ---- 07g simxTick: optional tyre temperature and brake fade (Realistic only) ----
local function simxGrip(t)
	if t < 90 then return 1 - 0.08 * math.min(1, ((90 - t) / 65) ^ 2) end
	return 1 - 0.15 * math.min(1, ((t - 90) / 50) ^ 2)
end
CarPhysics.simxGrip = simxGrip
local function simxTick(st, env, dt, fs, bd)
	local X, P, T = env.simx, env.pts, env.tslip
	local v = math.abs(fs)
	local amb = 24 - 8 * env.wx.wet
	if X.tt then
		local ax = math.min(12, math.abs(st.al or 0))
		local ay = math.min(12, math.abs(fs * P.yr))
		local sl = 0.5 * T.f + T.r + 2 * P.spin
		X.tT += ((0.0145 * (ax + ay) + 0.05) * v + 0.32 * sl * math.min(v, 20) - (X.tT - amb) * (0.02 + 0.012 * math.sqrt(v))) * dt
		X.tT = clamp(X.tT, amb - 5, 160)
		X.gk = simxGrip(X.tT)
	else
		X.tT, X.gk = amb, 1
	end
	if X.bf then
		X.bT += (0.31 * bd * v - (X.bT - amb) * (0.004 + 0.0008 * v)) * dt
		X.bT = clamp(X.bT, amb - 5, 900)
		X.bk = X.bT < 400 and 1 or math.max(0.6, 1 - 0.4 * (X.bT - 400) / 300)
	else
		X.bT, X.bk = amb, 1
	end
end

-- ---- one physics step of the web game's updP, up to P.al (+ the slip / temperature ticks). Returns fs, ls. ----
function CarPhysics.step(st, spec, inp, env, dt)
	local thA, brA, steer, hb = inp.th, inp.br, inp.steer, inp.hb
	local th, br = thA > 0, brA > 0
	local frozen = env.frozen
	local real = env.mode == 1
	local dfx = env.dfx or CarPhysics.NO_DAMAGE
	local fx, fz = math.sin(st.h), math.cos(st.h)
	local fs = st.vx * fx + st.vz * fz
	if not real then
		st.h += steer * 1.8 * spec.hd * dfx.steering / (1 + math.abs(fs) / 18) * clamp(fs / 4, -1, 1) * (hb and 1.5 or 1) * (st.gnd and 1 or 0.2) * dt
	end
	if dfx.pull ~= 0 and st.gnd and not frozen then st.h += dfx.pull * clamp(fs / 12, -1, 1) * dt end
	fx, fz = math.sin(st.h), math.cos(st.h)
	local rx, rz = -fz, fx
	fs = st.vx * fx + st.vz * fz
	local ls = st.vx * rx + st.vz * rz
	local sfc = env.sfc * dfx.grip * (real and env.wx.mu * env.simx.gk or 1)
	local vmEff, aEff = math.max(2, spec.vm * dfx.maxSpeed), spec.a0 * dfx.accel
	local bkEff = spec.bk * dfx.brakes * (real and env.simx.bk or 1)
	-- slope along the car's new heading (TH 2 m ahead minus 2 m behind), as the web game measures it after steering
	local slp = (env.TH(st.x + fx * 2, st.z + fz * 2) - env.TH(st.x - fx * 2, st.z - fz * 2)) / 4
	local pfs = fs
	-- burnout (damage Cosmetic / Full only; the damage module sets env.burnout)
	local bo = st.gnd and not frozen and env.burnout ~= nil and env.burnout(th, thA, br, brA, hb, fs) or false
	if real then
		env.pts.flock, env.pts.absA = 0, 0
	end
	if st.gnd and not frozen then
		if bo then
			fs *= math.exp(-5 * dt)
		else
			if real and fs > -0.5 and not (br and fs <= 0.5) then
				fs += ptAccel(st, spec, env, dt, th and thA or 0, fs, sfc, dfx) * dt
			elseif th then
				local ac = aEff * thA * (1 - math.pow(math.max(fs, 0) / (vmEff * 1.05), 2.5)) * (0.5 + 0.5 * sfc)
				if fs < 0 then ac = math.min(ac * 2, bkEff * sfc) end
				fs += ac * dt
			end
			if br then
				if fs > 0.5 then
					-- ABS (Realistic): without it a brake demand above the tyre limit locks the wheels; with it the plain brake line runs
					if real and fs > 2 and bkEff * brA > 0.92 * spec.pt.mu * 9.81 then
						if env.assist.abs then
							env.pts.absA = 1
						else
							env.pts.flock = 1
							fs = math.max(0, fs - 0.8 * spec.pt.mu * 9.81 * sfc * dt)
						end
					end
					if not (real and env.pts.flock ~= 0) then fs = math.max(0, fs - bkEff * sfc * dt * brA) end
				else
					fs = math.max(-10, fs - 3.5 * dt * brA)
				end
			end
		end
		if not (bo or (math.abs(fs) < 1 and not th and (br or hb or math.abs(slp) < 0.15))) then
			fs -= 9.81 * slp / math.sqrt(1 + slp * slp) * dt
		end
		if sfc < 1 and math.abs(fs) > 0.5 then fs -= math.sign(fs) * (1 - sfc) * 1.5 * dt end
		if dfx.roll ~= 0 and math.abs(fs) > 0.3 then fs -= math.sign(fs) * math.min(math.abs(fs) - 0.3, dfx.roll * dt) end
		if hb and not real then fs *= 1 - 0.8 * dt end
		if not real then
			if math.abs(fs) > 0.5 then fs -= math.sign(fs) * 0.5 * dt end
			fs -= fs * 0.012 * dt
			ls *= math.exp(-(hb and 1.1 or ((th and steer ~= 0 and fs > 15) and 2.4 or 6.5 * spec.hd)) * dfx.lat * dt)
		end
	end
	if real then
		fs, ls = ptDyn(st, spec, env, dt, steer, inp.an == true, hb, fs, ls, sfc * dfx.lat, (fs - pfs) / dt, frozen, dfx)
		fx, fz = math.sin(st.h), math.cos(st.h)
		rx, rz = -fz, fx
	end
	st.vx, st.vz = fx * fs + rx * ls, fz * fs + rz * ls
	if frozen then st.vx, st.vz = 0, 0 end
	st.al = (fs - pfs) / dt
	slipTick(st, env, fs, ls, frozen, bo)
	if real then simxTick(st, env, dt, fs, (st.gnd and not frozen and br and fs > 0.5) and math.min(12, bkEff * brA) or 0) end
	return fs, ls, bo
end

-- Realistic: a long frame is split into equal physics steps of at most 1/60 s (the web game's updPStep); Arcade: one step per frame
function CarPhysics.substeps(mode, dt)
	if mode ~= 1 or dt <= 1 / 60 + 1e-6 then return 1 end
	return math.min(4, math.ceil(dt * 60 - 1e-6))
end

-- ---- 07g ptBody (Realistic): the sprung body, pitch / roll / heave spring-dampers driven by acceleration and by bump impulses ----
-- call once per physics step after the move; returns heave (m), pitch (rad, nose down +), roll (rad) to add to the body
function CarPhysics.body(st, spec, env, dt, frozen, fs)
	local P = env.pts
	local s = spec.pt
	local w, z = 2 * math.pi * s.fn, s.zeta
	local k2 = (1.8 / s.fn) * (1.8 / s.fn)
	local dh = st.h - P.h0
	local yr = math.atan2(math.sin(dh), math.cos(dh)) / math.max(dt, 1e-4)
	local al = (st.gnd and not frozen) and clamp(st.al, -12, 8) or 0
	local ay = (st.gnd and not frozen) and clamp(fs * yr, -12, 12) or 0
	local tp, tr = -al * 0.0026 * k2, ay * 0.0075 * k2
	local h = math.min(dt, 1 / 30)
	P.pv += (w * w * (tp - P.pz) - 2 * z * w * P.pv) * h
	P.pz += P.pv * h
	P.rv += (w * w * (tr - P.rz) - 2 * z * w * P.rv) * h
	P.rz += P.rv * h
	P.hv += (-w * w * P.hz - 2 * z * w * P.hv) * h
	P.hz += P.hv * h
	P.h0 = st.h
	P.pz, P.rz, P.hz = clamp(P.pz, -0.09, 0.09), clamp(P.rz, -0.1, 0.1), clamp(P.hz, -0.12, 0.12)
	return P.hz, P.pz, P.rz
end

-- manual gearbox request (the web game's gearKey for Q / E / paddles): -> message or nil. d = +1 up, -1 down.
function CarPhysics.requestShift(spec, env, d)
	if env.mode ~= 1 then return "Gears are simulated in Realistic handling (press H)" end
	local s = spec.pt
	if s.ev or s.ng < 2 then return "Single-speed drive: no gears to shift" end
	local P = env.pts
	local msg = nil
	if P.man == 0 then
		P.man = 1
		msg = "Gearbox: Manual (Q down · E up · gamepad LB / RB)"
	end
	P.req, P.deny = d, 0
	return msg
end

return CarPhysics
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">Damage</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - vehicle damage, tyres and repairs: the web game's 07c_realism.js (records, impacts, landings, speed bumps,
-- engine heat, effects on driving), 07d_tyres.js (per-wheel load, slip, heat, wear, punctures, burnouts), the logic of 07h_dmgparts.js
-- (bumpers, mirrors, bonnet / boot lid, doors, glass cracks, bent rims, flat-tyre rolling drag) and 08d_repair.js (the repair bay: items,
-- prices x rarity tier, one repair at a time, full inspection) with 07f's diagnostics rows. Line for line, as a PURE module (no Roblox
-- services), shared by the devices (driving) and the server (it checks saved records and prices repairs). tests/damage_equiv.js runs it
-- next to the web build and compares the records.
-- Modes: 0 Off (nothing recorded; driving unchanged), 1 Cosmetic (visible damage only), 2 Full (also mechanical damage and tyre grip).
-- EVERY mass, layout, threshold and price is the web game's GAMEPLAY ESTIMATE (no crash-test data, no workshop quotes).
-- car = Config.CARS[i]: dmg = carSpec numbers (mass, drive, eng, b0, b1, maxC, thr, comp, tyre, ...), geo = the body outline (dpGeo).
-- Arrays are 1-based here (the web game's wheel / light / pane j is index j + 1).
local Damage = {}

local function cl(v, a, b)
	return v < a and a or v > b and b or v
end
local function hypot(a, b)
	return math.sqrt(a * a + b * b)
end
-- JavaScript's +x.toFixed(3) and Math.round
local function fix3(x)
	return tonumber(string.format("%.3f", x))
end
local function jsround(x)
	return math.floor(x + 0.5)
end
Damage.jsround = jsround

Damage.MODE_NAMES = { "Off", "Cosmetic", "Full" }
Damage.ZONES = { "fl", "fr", "l", "r", "rl", "rr", "roof", "u" }
Damage.ZONE_NAMES = { fl = "front-left", fr = "front-right", l = "left side", r = "right side", rl = "rear-left", rr = "rear-right", roof = "roof", u = "underbody" }
Damage.WHEEL_NAMES = { "FL", "FR", "RL", "RR" }
Damage.LIGHT_NAMES = { "left headlight", "right headlight", "left tail light", "right tail light" }
Damage.GLASS_NAMES = { "windscreen", "rear screen", "left windows", "right windows" }
Damage.DP_KEYS = { "bf", "br", "ml", "mr", "hood", "trunk", "dl", "dr" }
Damage.DP_NAMES = { bf = "Front bumper", br = "Rear bumper", ml = "Left mirror", mr = "Right mirror", hood = "Bonnet (hood)", trunk = "Boot lid (trunk)",
	dl = "Left doors", dr = "Right doors" }
-- zone centres in car-local metres as fractions of (W, L): +x = the car's left, +z = forward (the order matters: the web game iterates it)
local ZC = { { "fl", 0.3, 0.45 }, { "fr", -0.3, 0.45 }, { "l", 0.5, 0 }, { "r", -0.5, 0 }, { "rl", 0.3, -0.45 }, { "rr", -0.3, -0.45 } }
local COMP_KEYS = { "body", "engine", "tyres", "suspension", "brakes", "cooling", "trans", "driveline", "steer" }

-- ---- records (one per car; the web game keys them by car name, Roblox by car index) ----
function Damage.newWheel()
	return { tread = 100, temp = 25, health = 100, punct = false, km = 0, tmax = 25, wear = { burn = 0, slide = 0, spin = 0, lock = 0, roll = 0 } }
end
function Damage.newRecord(car)
	return {
		v = 2, durability = car.dmg.durability, body = 100, engine = 100, tyres = 100, suspension = 100, brakes = 100, cooling = 100, trans = 100, driveline = 100, steer = 100,
		zones = { fl = 100, fr = 100, l = 100, r = 100, rl = 100, rr = 100, roof = 100, u = 100 }, susp = { 100, 100, 100, 100 }, align = { 0, 0, 0, 0 },
		lights = { 0, 0, 0, 0 }, glass = { 0, 0, 0, 0 }, wheels = { Damage.newWheel(), Damage.newWheel(), Damage.newWheel(), Damage.newWheel() }, dents = {},
		parts = { bf = 0, br = 0, ml = 0, mr = 0, hood = 0, trunk = 0, dl = 0, dr = 0 }, cracks = { {}, {}, {}, {} }, rims = { 0, 0, 0, 0 }, engTemp = 90,
		impacts = 0, lastHit = -99, lastX = 0, lastZ = 0, log = {},
	}
end

-- a record from storage or another device, checked field by field: numbers finite and in range, arrays of the right length (the web
-- game's migrateRecord, stricter because a Roblox server must not trust a device)
local function num(v, d, a, b)
	if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge then return d end
	return cl(v, a, b)
end
function Damage.clean(s, car)
	local n = Damage.newRecord(car)
	if type(s) ~= "table" then return n end
	for _, k in ipairs(COMP_KEYS) do n[k] = num(s[k], 100, 0, 100) end
	n.engTemp = num(s.engTemp, 90, 60, 140)
	n.impacts = math.floor(num(s.impacts, 0, 0, 1e9))
	if type(s.zones) == "table" then
		for _, z in ipairs(Damage.ZONES) do n.zones[z] = num(s.zones[z], 100, 0, 100) end
	end
	for _, a in ipairs({ { "susp", 100, 0, 100 }, { "align", 0, -6, 6 }, { "lights", 0, 0, 1 }, { "glass", 0, 0, 1 }, { "rims", 0, 0, 1 } }) do
		local src = s[a[1]]
		if type(src) == "table" then
			for j = 1, 4 do n[a[1]][j] = num(src[j], a[2], a[3], a[4]) end
		end
	end
	if type(s.wheels) == "table" then
		for j = 1, 4 do
			local w, o = n.wheels[j], s.wheels[j]
			if type(o) == "table" then
				w.tread, w.temp, w.health = num(o.tread, 100, 0, 100), num(o.temp, 25, 20, 320), num(o.health, 100, 0, 100)
				w.punct = o.punct == true
				w.km, w.tmax = num(o.km, 0, 0, 1e7), num(o.tmax, 25, 20, 320)
				if type(o.wear) == "table" then
					for _, k in ipairs({ "burn", "slide", "spin", "lock", "roll" }) do w.wear[k] = num(o.wear[k], 0, 0, 100) end
				end
			end
		end
	end
	if type(s.parts) == "table" then
		for _, k in ipairs(Damage.DP_KEYS) do n.parts[k] = num(s.parts[k], 0, 0, 1) end
	end
	if type(s.dents) == "table" then
		for i = 1, math.min(16, #s.dents) do
			local d = s.dents[i]
			if type(d) == "table" and #d == 7 then
				n.dents[#n.dents + 1] = { num(d[1], 0, -4, 4), num(d[2], 0.55, 0, 3), num(d[3], 0, -4, 4), num(d[4], 0, -1, 1), num(d[5], 0, -1, 1), num(d[6], 0, 0, 0.6), num(d[7], 0.42, 0, 2) }
			end
		end
	end
	if type(s.cracks) == "table" then
		for j = 1, 4 do
			local L = s.cracks[j]
			if type(L) == "table" then
				for i = 1, math.min(3, #L) do
					local c = L[i]
					if type(c) == "table" and #c == 3 then n.cracks[j][#n.cracks[j] + 1] = { num(c[1], 0.5, 0, 1), num(c[2], 0.5, 0, 1), num(c[3], 0, 0, 1) } end
				end
			end
		end
	end
	-- the impact log (shown in the diagnostics): checked strings and numbers, at most 8
	if type(s.log) == "table" then
		local function str(v, m)
			return type(v) == "string" and string.sub(v, 1, m) or ""
		end
		for i = 1, math.min(8, #s.log) do
			local e = s.log[i]
			if type(e) == "table" then
				n.log[#n.log + 1] = { t = num(e.t, 0, -1e9, 1e9), kmh = num(e.kmh, 0, 0, 1000), ebs = num(e.ebs, 0, 0, 1000), zone = str(e.zone, 30), face = str(e.face, 12), obj = str(e.obj, 40) }
			end
		end
	end
	Damage.syncAggregates(n)
	return n
end

-- the old aggregate fields (body / tyres / suspension) stay meaningful for the HUD and the toasts
function Damage.syncAggregates(s)
	local z = 0
	for j = 1, 6 do z += s.zones[Damage.ZONES[j]] end
	s.body = z / 6
	local t, u = 0, 0
	for j = 1, 4 do
		local w = s.wheels[j]
		t += w.punct and 0 or math.min(w.tread, w.health)
		u += s.susp[j]
	end
	s.tyres, s.suspension = t / 4, u / 4
end

-- is anything on the car damaged (the Repair button)
function Damage.hurt(s)
	for _, k in ipairs(COMP_KEYS) do
		if s[k] < 99.9 then return true end
	end
	if #s.dents > 0 then return true end
	for j = 1, 4 do
		if s.lights[j] ~= 0 or s.glass[j] ~= 0 or s.rims[j] > 0.001 or s.wheels[j].tread < 99.9 then return true end
	end
	for _, k in ipairs(Damage.DP_KEYS) do
		if s.parts[k] > 0.001 then return true end
	end
	return false
end

-- ---- grip of one tyre (07d tyreMu): 1 = new and in its working range ----
function Damage.tyreMu(w)
	if w.punct then return 0.35 end
	local t = w.tread
	local tf = t >= 50 and 1 or t >= 5 and 0.78 + 0.22 * (t - 5) / 45 or 0.6 + 0.18 * t / 5
	local T = w.temp
	local hf = T <= 110 and 1 or cl(1 - (T - 110) / 180, 0.7, 1)
	local cf = w.health >= 60 and 1 or 0.75 + 0.25 * w.health / 60
	return tf * hf * cf
end

-- ---- effects on driving (Full only; F is filled in place, no allocation): 07c damageEffects + 07h dpEffects ----
function Damage.effects(s, car, mode, F)
	if mode ~= 2 or not s then
		F.maxSpeed, F.accel, F.steering, F.grip, F.brakes, F.lat, F.limp = 1, 1, 1, 1, 1, 1, 1
		F.pull, F.vib, F.roll = 0, 0, 0
		return F
	end
	local sp, W, mu = car.dmg, s.wheels, Damage.tyreMu
	local m0, m1, m2, m3 = mu(W[1]), mu(W[2]), mu(W[3]), mu(W[4])
	local muF, muR = (m0 + m1) / 2, (m2 + m3) / 2
	local muA = (muF + muR) / 2
	local muD = sp.drive == "FWD" and muF or sp.drive == "RWD" and muR or muA
	local sF, sR = (s.susp[1] + s.susp[2]) / 200, (s.susp[3] + s.susp[4]) / 200
	local sA = (sF + sR) / 2
	local hE, hT, hD, hS, hB = cl(s.engine / 100, 0, 1), cl(s.trans / 100, 0, 1), cl(s.driveline / 100, 0, 1), cl(s.steer / 100, 0, 1), cl(s.brakes / 100, 0, 1)
	local punct = W[1].punct or W[2].punct or W[3].punct or W[4].punct
	local limp = s.engTemp > 112 and cl(1 - (s.engTemp - 112) / 50, 0.55, 1) or 1
	F.limp = limp
	F.maxSpeed = cl((0.55 + 0.45 * math.pow(hE, 0.7)) * limp * (0.72 + 0.28 * hT) * (0.85 + 0.15 * sA) * (punct and 0.62 or 1), 0.4, 1)
	F.accel = cl((0.35 + 0.65 * math.pow(hE, 0.8)) * limp * (0.6 + 0.4 * hT) * (0.8 + 0.2 * hD) * (0.5 + 0.5 * muD), 0.3, 1)
	F.steering = cl((0.58 + 0.42 * hS) * math.pow(muF, 0.7) * (0.8 + 0.2 * sF), 0.45, 1)
	F.grip = cl(muA * (0.85 + 0.15 * sA), 0.35, 1)
	F.brakes = cl(0.5 + 0.5 * hB, 0.5, 1)
	F.lat = cl(muR * (0.75 + 0.25 * sR), 0.45, 1)
	-- pull (rad/s at speed, + = left): toe from wheel hits plus a punctured tyre dragging its side
	F.pull = (s.align[1] + s.align[2] + 0.5 * (s.align[3] + s.align[4])) * 0.012 + ((W[1].punct or W[3].punct) and 0.07 or 0) - ((W[2].punct or W[4].punct) and 0.07 or 0)
	F.vib = cl((punct and 0.8 or 0) + (1 - hD) * 0.6 + (1 - sA) * 0.5 + (1 - math.min(m0, m1, m2, m3)) * 0.4, 0, 1)
	F.roll = 0
	-- 07h: bent rims vibrate, pull and lose a little grip; a flat tyre drags (about ten times a healthy tyre's rolling resistance)
	local r = s.rims
	local b = (r[1] + r[2] + r[3] + r[4]) / 4
	F.vib = cl(F.vib + b * 0.5, 0, 1)
	F.pull += (r[1] - r[2]) * 0.03 + (r[3] - r[4]) * 0.015
	F.grip *= 1 - 0.08 * b
	local flats = 0
	for j = 1, 4 do
		if W[j].punct then flats += 1 end
	end
	F.roll = flats * 0.45
	return F
end

-- ---- the obstacle (07e objectImpact, the two kinds the Roblox map has: buildings and cars) ----
-- ob = {type = "solid" | "vehicle", hw, hd (half sizes, m), r (pole radius)} -> equivalent barrier speed, speed given away, label
local function objectImpact(ob, vn, mass)
	if ob and ob.type == "vehicle" then
		local m2 = 1400
		return vn * math.sqrt(m2 / (2 * (mass + m2))), 0, false, "Car"
	end
	return vn, 0, false, (ob and ob.r ~= nil) and "Structure" or "Wall"
end

-- ---- 07h dpImpact: bumpers, mirrors, lids, doors, glass cracks, rims (Cosmetic and Full). Returns the parts torn off. ----
local function crackAdd(s, j, u, v, sev)
	if sev <= 0 then return end
	local L = s.cracks[j]
	local near = nil
	for _, c in ipairs(L) do
		if hypot(c[1] - u, c[2] - v) < 0.22 then
			near = c
			break
		end
	end
	if near then
		near[3] = fix3(math.min(1, near[3] + sev))
	else
		L[#L + 1] = { fix3(u), fix3(v), fix3(math.min(1, sev)) }
		if #L > 3 then table.remove(L, 1) end
	end
end
local function dpImpact(s, sp, g, face, cx, cz, crush, kmh, tang)
	local q = s.parts
	local b4 = { bf = q.bf, br = q.br, ml = q.ml, mr = q.mr }
	local function add(k, v)
		if v > 0 then q[k] = cl(q[k] + v, 0, 1) end
	end
	local fi = face == "front" and 0 or face == "rear" and 1 or 2
	local sc = math.max(0, kmh - sp.thr[1]) * 0.006
	if face == "front" then
		add("bf", crush / 48 + sc)
		if crush > 58 then q.bf = 1 end
		add("hood", math.max(0, crush - 15) / 40)
	end
	if face == "rear" then
		add("br", crush / 44 + sc)
		if crush > 52 then q.br = 1 end
		add("trunk", math.max(0, crush - 14) / 38)
	end
	if fi == 2 then
		local sd = face == "left" and "l" or "r"
		if math.abs(cz) < g.L * 0.33 then add("d" .. sd, crush / 28 + sc * 0.5) end
		if cz > g.L * 0.36 then add("bf", crush / 70) end
		if cz < -g.L * 0.36 then add("br", crush / 70) end
		if math.abs(cz - (g.ws[1] - 0.08)) < 0.9 then add("m" .. sd, crush / 10 + (tang > 6 and 0.45 or 0) + sc) end
	end
	-- a scrape along a side (high tangential, low normal speed) takes the mirror on that side
	if fi < 2 and tang > 9 and math.abs(cx) > g.W * 0.35 then add(cx > 0 and "ml" or "mr", 0.35) end
	-- glass: crack origin in pane coordinates (u across, v up), merged with a nearby crack
	local ux = cl(0.5 - cx / g.W, 0.08, 0.92)
	if face == "front" and kmh > sp.thr[3] then crackAdd(s, 1, ux, 0.22 + math.min(0.5, crush / 180), (kmh - sp.thr[3]) / 35) end
	if face == "rear" and kmh > sp.thr[3] then crackAdd(s, 2, 1 - ux, 0.3, (kmh - sp.thr[3]) / 35) end
	if fi == 2 and crush > 6 and math.abs(cz) < g.L * 0.3 then
		local j = face == "left" and 3 or 4
		local span = g.ws[1] - (g.four and g.rs[1] or g.ws[1] - 1)
		if span == 0 then span = 1 end
		crackAdd(s, j, cl((g.ws[1] - cz) / span, 0.1, 0.9), 0.45, crush / 25)
	end
	for j = 1, 4 do
		local m = 0
		for _, c in ipairs(s.cracks[j]) do m = math.max(m, c[3]) end
		s.glass[j] = math.max(s.glass[j], m)
	end
	-- rims: a hard hit at a wheel bends the rim
	for j = 1, 4 do
		local wx = ((j - 1) % 2 == 0 and 1 or -1) * (g.W / 2 - 0.12)
		local wz = (j <= 2 and 1 or -1) * g.L * 0.31
		local wf = math.max(0, 1 - hypot(cx - wx, cz - wz) / 1.0)
		local wk = kmh * wf
		if wk > 18 then s.rims[j] = cl(s.rims[j] + (wk - 18) / 40, 0, 1) end
	end
	local torn = {}
	for _, k in ipairs({ "bf", "br", "ml", "mr" }) do
		if q[k] >= 1 and b4[k] < 1 then torn[#torn + 1] = k end
	end
	return torn
end

-- ---- an impact (07c registerPlayerImpact) ----
-- c = {v (normal closing speed m/s), ob (obstacle), nx, nz (contact normal from the obstacle to the car), x, z, h, vx, vz (the car), t (s)}
-- -> nil when nothing was recorded, else {gave, face, kmh, ebs, crush, zone, label, toast, torn = {parts torn off}, cx, cz}
function Damage.impact(s, car, mode, c)
	if mode == 0 or not (c.v == c.v) or c.v < 2.8 then return nil end
	local sp, t = car.dmg, c.t
	-- one hit per contact interval (pressed against a wall it is not counted every frame)
	if t - s.lastHit < 0.48 and hypot(c.x - s.lastX, c.z - s.lastZ) < 2.8 then return nil end
	s.lastHit, s.lastX, s.lastZ = t, c.x, c.z
	s.impacts = (s.impacts or 0) + 1
	local ebs, gave, broke, label = objectImpact(c.ob, c.v, sp.mass)
	local kmh = ebs * 3.6
	-- the contact point on the car's outline, in car-local metres (+x = the car's left, +z = forward)
	local sh, ch = math.sin(c.h), math.cos(c.h)
	local dx, dz = -(c.nx or 0), -(c.nz or 0)
	local lf, lr = dx * sh + dz * ch, dx * -ch + dz * sh
	local X, Z = -lr, lf
	local L, W = sp.L, sp.W
	local tX = math.abs(X) > 1e-6 and W / 2 / math.abs(X) or 1e9
	local tZ = math.abs(Z) > 1e-6 and L / 2 / math.abs(Z) or 1e9
	local tt = math.min(tX, tZ)
	local cx, cz = X * tt, Z * tt
	local face = tZ <= tX and (Z > 0 and "front" or "rear") or (X > 0 and "left" or "right")
	local fi = face == "front" and 0 or face == "rear" and 1 or 2
	local crush = math.max(0, kmh - sp.b0[fi + 1]) / sp.b1[fi + 1]
	-- contact area: a pole concentrates the load (narrow, deeper dent), a wall or a car spreads it (wider, shallower)
	local ob = c.ob
	local narrow = ob ~= nil and ob.r ~= nil and ob.r < 0.7
	local wide = ob ~= nil and (ob.type == "vehicle" or (ob.hw or 0) > 2.5 or (ob.hd or 0) > 2.5)
	local dk = narrow and 1.3 or wide and 0.85 or 1
	local rk = narrow and 0.6 or wide and 1.2 or 1
	local vn0 = c.vx * (c.nx or 0) + c.vz * (c.nz or 0)
	local tang = hypot(c.vx - vn0 * (c.nx or 0), c.vz - vn0 * (c.nz or 0))
	-- spread over the zones by distance from the contact point
	local best, bw = "", 0
	local maxC = sp.maxC[fi + 1]
	local scuff = kmh > sp.thr[1] and math.min(2.5, (kmh - sp.thr[1]) * 0.25) or 0
	for _, zc in ipairs(ZC) do
		local z = zc[1]
		local d = hypot(cx - W * zc[2], cz - L * zc[3])
		local w = math.exp(-((d / (0.8 + crush / 200)) ^ 2))
		if w > bw then bw, best = w, z end
		if w > 0.05 then s.zones[z] = cl(s.zones[z] - (crush / maxC * 100 + scuff) * w, 0, 100) end
	end
	-- a dent at the contact point (merged with a nearby earlier dent; at most 16, the deepest kept)
	if crush > 1.5 then
		local depth = math.min(fi == 2 and 0.3 or 0.5, crush / 100 * 0.8 * dk)
		local rad = (0.42 + math.min(0.9, crush / 100 * 0.9)) * rk
		local il = hypot(cx, cz)
		if il == 0 then il = 1 end
		local d = { fix3(cx), 0.55, fix3(cz), fix3(-cx / il), fix3(-cz / il), fix3(depth), fix3(rad) }
		local near = nil
		for _, q in ipairs(s.dents) do
			if hypot(q[1] - d[1], q[3] - d[3]) < 0.35 then
				near = q
				break
			end
		end
		if near then
			near[6] = fix3(math.min(fi == 2 and 0.32 or 0.52, hypot(near[6], d[6])))
			near[7] = math.max(near[7], d[7])
		else
			s.dents[#s.dents + 1] = d
			if #s.dents > 16 then
				-- the web game's stable sort by depth (deepest first), then the first 16
				local idx = {}
				for i, q in ipairs(s.dents) do idx[i] = { q, i } end
				table.sort(idx, function(a, b)
					if a[1][6] ~= b[1][6] then return a[1][6] > b[1][6] end
					return a[2] < b[2]
				end)
				local keep = {}
				for i = 1, 16 do keep[i] = idx[i][1] end
				s.dents = keep
			end
		end
	end
	-- lights (visible, so recorded in Cosmetic and Full)
	if kmh > sp.thr[2] then
		local lx = W * 0.33
		if face == "front" or face == "rear" or math.abs(cz) > L * 0.36 then
			local base = cz > 0 and 1 or 3
			for sd = 0, 1 do
				local sx = sd == 0 and lx or -lx
				if math.abs(cx - sx) < 0.55 + crush / 100 then s.lights[base + sd] = 1 end
			end
		end
	end
	local torn = dpImpact(s, sp, car.geo, face, cx, cz, crush, kmh, tang)
	if mode == 2 then
		local cc = sp.comp
		local center = 1 - math.min(1, math.abs(cx) / (W / 2)) * 0.5
		-- the radiator sits behind the front bumper (air-cooled cars: at the engine)
		local coolFace = sp.air and (sp.eng == "F" and "front" or "rear") or "front"
		if face == coolFace then s.cooling = cl(s.cooling - math.max(0, crush - 8) * 1.6 * center / cc.cooling, 0, 100) end
		local engFace = sp.eng == "F" and "front" or "rear"
		local engDepth = sp.eng == "F" and 22 or sp.eng == "M" and 30 or 18
		if face == engFace then s.engine = cl(s.engine - math.max(0, crush - engDepth) * 1.4 * center / cc.engine, 0, 100) end
		if fi == 2 and sp.eng == "M" and cz < -L * 0.05 then s.engine = cl(s.engine - math.max(0, crush - 20) * 0.8 / cc.engine, 0, 100) end
		if (face == "front" and sp.eng == "F" and crush > 40) or (face == "rear" and sp.eng ~= "F" and crush > 25) then
			s.trans = cl(s.trans - (crush - (face == "front" and 40 or 25)) * 0.8 / cc.trans, 0, 100)
		end
		-- wheels within reach of the contact point (or behind a deep front / rear crush): tyre, suspension, brakes, steering, alignment
		local reach = L / 2 - L * 0.31 - 0.3
		for j = 1, 4 do
			local wx = ((j - 1) % 2 == 0 and 1 or -1) * (W / 2 - 0.12)
			local wz = (j <= 2 and 1 or -1) * L * 0.31
			local wf = math.max(0, 1 - hypot(cx - wx, cz - wz) / 1.0)
			if fi < 2 and (j <= 2) == (face == "front") and crush / 100 > reach then wf = math.max(wf, math.min(1, (crush / 100 - reach) / 0.4)) end
			if wf > 0 then
				local wk = kmh * wf
				local w = s.wheels[j]
				w.health = cl(w.health - wk * 1.1 / sp.tyre.dur, 0, 100)
				if wk > 32 or w.health < 12 then w.punct = true end
				s.susp[j] = cl(s.susp[j] - math.max(0, wk - 6) * 1.6 / cc.susp, 0, 100)
				s.brakes = cl(s.brakes - math.max(0, wk - 15) * 0.4 / cc.brakes, 0, 100)
				local toe = math.max(0, wk - 8) * 0.06 * (fi == 2 and (face == "left" and -1 or 1) or ((j - 1) % 2 == 0 and 1 or -1))
				s.align[j] = cl(s.align[j] + toe, -6, 6)
				if j <= 2 then s.steer = cl(s.steer - math.max(0, wk - 10) * 1.0 / cc.steer, 0, 100) end
			end
		end
	end
	Damage.syncAggregates(s)
	table.insert(s.log, 1, { t = jsround(t), kmh = jsround(c.v * 3.6), ebs = jsround(kmh), zone = Damage.ZONE_NAMES[best] or best, face = face, obj = label })
	while #s.log > 8 do table.remove(s.log) end
	local toast = (broke and ("💥 " .. label .. " broke · ") or gave > 0 and (label .. " shoved · ") or "Impact · ") .. jsround(c.v * 3.6) .. " km/h · "
		.. (Damage.ZONE_NAMES[best] or face) .. " · body condition " .. jsround(s.body) .. "%" .. (mode == 2 and (" · engine " .. jsround(s.engine) .. "%") or "")
	return { gave = gave, face = face, kmh = jsround(c.v * 3.6), ebs = kmh, crush = crush, zone = best, label = label, toast = toast, torn = torn, cx = cx, cz = cz }
end

-- ---- a hard landing (ramps, crests): vy = vertical speed just before touchdown (07c registerLanding) -> toast or nil ----
function Damage.landing(s, car, mode, vy, t)
	if mode == 0 or vy > -5.5 then return nil end
	local sp = car.dmg
	local e = -vy - 5.5
	local cc = sp.comp
	s.zones.u = cl(s.zones.u - e * 6, 0, 100)
	if mode == 2 then
		for j = 1, 4 do
			s.susp[j] = cl(s.susp[j] - e * 7 / cc.susp, 0, 100)
			s.wheels[j].health = cl(s.wheels[j].health - e * 2 / sp.tyre.dur, 0, 100)
		end
		s.driveline = cl(s.driveline - math.max(0, -vy - 8) * 4 / cc.driveline, 0, 100)
		s.trans = cl(s.trans - math.max(0, -vy - 9) * 3 / cc.trans, 0, 100)
		s.engine = cl(s.engine - math.max(0, -vy - 10) * 3 / cc.engine, 0, 100)
	end
	Damage.syncAggregates(s)
	table.insert(s.log, 1, { t = jsround(t), kmh = jsround(-vy * 3.6), ebs = 0, zone = "underbody", face = "landing", obj = "hard landing" })
	while #s.log > 8 do table.remove(s.log) end
	return "Hard landing · " .. jsround(-vy * 3.6) .. " km/h vertical · check suspension"
end

-- ---- a speed bump taken too fast: sev from the quarter-car (bump stop / damper speed), axle 0 front / 1 rear (07c) -> toast or nil ----
function Damage.speedBump(s, car, mode, speed, sev, axle)
	if mode == 0 then return nil end
	sev = cl(sev == nil and (speed - 11) * 0.12 or sev, 0, 3)
	if sev <= 0 then return nil end
	local sp = car.dmg
	local J = axle == 1 and { 3, 4 } or axle == 0 and { 1, 2 } or { 1, 2, 3, 4 }
	s.zones.u = cl(s.zones.u - sev * 2.2, 0, 100)
	if mode == 2 then
		for _, j in ipairs(J) do
			s.susp[j] = cl(s.susp[j] - sev * 3 / sp.comp.susp, 0, 100)
			s.wheels[j].health = cl(s.wheels[j].health - sev * 1.4 / sp.tyre.dur, 0, 100)
			if sev > 2.2 and s.wheels[j].health < 30 then s.wheels[j].punct = true end
		end
	end
	Damage.syncAggregates(s)
	return sev > 1.2 and "Hard speed-bump impact: suspension bottomed out" or "Speed bump taken too fast"
end
-- the suspension travel before the bump stop, by body type (07c suspTravel)
function Damage.suspTravel(k)
	return (k == "r" or k == "m" or k == "q") and 0.05 or (k == "s" or k == "p" or k == "v") and 0.11 or 0.075
end

-- ---- engine temperature (Full): a damaged radiator cannot reject the heat of sustained throttle (07c damageTick) ----
-- -> true when the engine smokes (badly damaged or overheating)
function Damage.engineTick(s, mode, thr, dt)
	if mode ~= 2 then return false end
	local c = s.cooling / 100
	local heat = thr * ((1 - c) * 6 + 0.4)
	local cool = (s.engTemp - 90) * (0.02 + 0.08 * c)
	s.engTemp = cl(s.engTemp + (heat - cool) * dt, 60, 140)
	if s.engTemp > 125 then s.engine = cl(s.engine - (s.engTemp - 125) * 0.02 * dt, 0, 100) end
	return s.engine < 28 or s.engTemp > 118
end

-- ---- tyres (07d): burnouts, then per-wheel load, slip, heat and wear every frame (Cosmetic and Full) ----
function Damage.newTyreState()
	return { thr = 0, burn = false, burnT = 0, h0 = nil, yaw = 0, fz = { 0, 0, 0, 0 }, sl = { 0, 0, 0, 0 }, sa = { 0, 0, 0, 0 }, pw = { 0, 0, 0, 0 }, mu = { 1, 1, 1, 1 } }
end
-- throttle + brake (FWD: + handbrake) at a standstill burns out when the drivetrain beats the driven wheels' grip plus what holds them
-- p = {gnd, bk, a0}; sfc = the surface grip; dfxAccel = damage effect on acceleration (Full)
function Damage.burnoutState(T, car, mode, th, thA, br, brA, hb, fs, p, sfc, dfxAccel)
	T.burn = false
	if mode == 0 or not th or not p.gnd or math.abs(fs) > 2.5 or not (br or hb) then return false end
	local sp = car.dmg
	local m, g = sp.mass, 9.81
	local Ff, Fr = m * g * sp.fw * sfc, m * g * (1 - sp.fw) * sfc
	local b = br and (brA ~= 0 and brA or 1) or 0
	local holdF = 0.68 * m * p.bk * b
	local holdR = 0.32 * m * p.bk * b + (hb and 0.22 * m * g or 0)
	local Fd = m * p.a0 * 1.8 * (thA ~= 0 and thA or 1) * (mode == 2 and dfxAccel or 1)
	local need = sp.drive == "FWD" and Ff + holdF or sp.drive == "RWD" and Fr + holdR or Ff + Fr + holdF + holdR
	T.burn = Fd > need
	return T.burn
end
local TYRE_AMB, TY_WEAR, TY_HEAT = 25, 5.5e-5, 6e-4
-- the web game keeps the wheel loads in a Float32Array (TYS.fz): each load is rounded to a 32-bit float before it is used
local function f32(x)
	return (string.unpack("<f", string.pack("<f", x)))
end
Damage.f32 = f32
-- p = {gnd, h, al, a0, vm, bk}; -> the index (1-4) of a tyre that just failed, or nil. T.smoke = slip of each wheel for the smoke.
function Damage.tyreStep(T, s, car, mode, dt, thr, brk, hb, fs, ls, frozen, p, sfc)
	T.thr = thr
	if mode == 0 or not (dt > 0) then return nil end
	local sp, W = car.dmg, s.wheels
	local m, g, au = sp.mass, 9.81, math.abs(fs)
	if not p.gnd or frozen then
		for j = 1, 4 do
			local w = W[j]
			w.temp = math.max(TYRE_AMB, w.temp - (w.temp - TYRE_AMB) * 0.05 * dt)
		end
		T.h0, T.burn = p.h, false
		return nil
	end
	if T.h0 == nil then T.h0 = p.h end
	local dh = p.h - T.h0
	local r = math.atan2(math.sin(dh), math.cos(dh)) / dt
	T.h0, T.yaw = p.h, r
	local v, road = -ls, sfc >= 1
	local ax, ay = cl(p.al, -12, 12), cl(fs * r, -12, 12)
	local dX, dY = m * ax * sp.hcg / sp.wb, m * ay * sp.hcg / sp.tr
	local sf, sr = m * g * sp.fw / 2, m * g * (1 - sp.fw) / 2
	local F = T.fz
	-- load per wheel: accelerating moves load rearward, a left turn (ay > 0) moves it to the right-hand wheels
	F[1], F[2], F[3], F[4] = f32(sf - dX / 2 - dY / 2), f32(sf - dX / 2 + dY / 2), f32(sr + dX / 2 - dY / 2), f32(sr + dX / 2 + dY / 2)
	for j = 1, 4 do
		if F[j] < 50 then F[j] = 50 end
	end
	-- lateral slip velocity: rear axle from sideslip + yaw; the fronts slip less while counter-steering a slide (estimate)
	local vr = math.abs(v - r * sp.wb / 2)
	local slide = math.abs(math.atan2(v, au + 0.5)) > 0.15
	local vf = slide and vr * 0.55 or vr
	local latG = math.min(1, math.abs(ay) / g)
	local dF, dR = sp.drive ~= "RWD", sp.drive ~= "FWD"
	local nd = (dF and 2 or 0) + (dR and 2 or 0)
	local spin = T.burn and cl(p.a0 * 2.4, 5, 24) * thr or 0
	local demand = (thr > 0 and not T.burn) and m * p.a0 * 1.8 * thr * math.max(0, 1 - math.pow(math.max(fs, 0) / (p.vm * 1.05), 2.5)) or 0
	if T.burn then T.burnT += dt end
	local blown = nil
	for j = 1, 4 do
		local front = j <= 2
		local isD = front and dF or (not front and dR)
		local w = W[j]
		local mu = Damage.tyreMu(w) * sfc
		local cap = mu * F[j]
		T.mu[j] = mu
		local sl, fl = 0, 0
		if isD and T.burn then
			sl, fl = spin, cap
		elseif isD and demand > 0 then
			local e = demand / nd - cap
			if e > 0 then sl, fl = math.min(18, e / cap * 6), cap end
		end
		if not front and hb and au > 1 then
			-- the handbrake locks the rear wheels
			sl, fl = math.max(sl, au), cap
		elseif brk > 0.6 and au > 3 and not T.burn then
			-- ABS-limited braking slip
			sl = math.max(sl, 0.08 * au)
			fl = math.max(fl, F[j] * math.min(1, p.bk * brk / g))
		end
		local sa = front and vf or vr
		local fa = slide and cap or F[j] * math.min(mu, latG)
		local pl, pa = fl * sl, fa * sa
		local pw = pl + pa
		T.sl[j], T.sa[j], T.pw[j] = sl, sa, pw
		-- heat: slip power in; convection (faster when rolling) and a steep loss above 150 C out
		w.temp = cl(w.temp + (pw * TY_HEAT * sp.tyre.heat * (road and 1 or 0.8) - (w.temp - TYRE_AMB) * (0.05 + 0.006 * au) - math.max(0, w.temp - 150) * 0.5) * dt, TYRE_AMB - 5, 320)
		-- wear: strongly non-linear in slip power and faster when hot; unpaved ground adds more; plus a tiny rolling wear per metre
		local tm = 1 + math.max(0, (w.temp - 90) / 45) ^ 2
		local kw = math.pow(pw / 1000, 2) * TY_WEAR * tm * (road and 1 or 1.6) / sp.tyre.dur * dt
		local roll = au * dt * 2.5e-6 * (road and 1 or 3)
		w.tread = math.max(0, w.tread - kw - roll)
		w.wear.roll += roll
		w.km += au * dt / 1000
		if w.temp > w.tmax then w.tmax = w.temp end
		if kw > 0 then
			local fa2 = pa / (pw ~= 0 and pw or 1)
			local lw = kw * (1 - fa2)
			w.wear.slide += kw * fa2
			if T.burn and isD then
				w.wear.burn += lw
			elseif not front and hb and au > 1 then
				w.wear.lock += lw
			else
				w.wear.spin += lw
			end
		end
		-- the carcass suffers once the tread is gone or the rubber blisters; below 10 % it fails (blow-out)
		if w.tread < 3 and pw > 2000 then w.health = math.max(0, w.health - pw / 1000 * 0.25 * dt) end
		if w.temp > 230 then w.health = math.max(0, w.health - (w.temp - 230) * 0.05 * dt) end
		if not w.punct and w.health < 10 then
			w.punct = true
			blown = j
		end
	end
	if blown then Damage.syncAggregates(s) end
	return blown
end

-- ---- diagnostics rows (07f diagRows): {label, condition %, effect text} ----
function Damage.diagRows(s, car, full)
	local sp = car.dmg
	local ev = sp.ev
	local rows = {}
	local function eff(t)
		return full and t or "visual only in Cosmetic mode"
	end
	local lim = s.engTemp > 112 and cl(1 - (s.engTemp - 112) / 50, 0.55, 1) or 1
	local hE, hT = s.engine / 100, s.trans / 100
	rows[#rows + 1] = { ev and "Motor / inverter" or "Engine", s.engine, eff("power −" .. jsround((1 - (0.35 + 0.65 * math.pow(hE, 0.8)) * lim) * 100) .. "%" .. (s.engine < 28 and " · smoking" or "")) }
	rows[#rows + 1] = { ev and "Battery & motor cooling" or "Cooling (radiator)", s.cooling, eff((ev and "drive unit " or "engine ") .. jsround(s.engTemp) .. " °C"
		.. (s.cooling < 70 and " · overheats under sustained throttle" or "") .. (lim < 1 and (" · power limited " .. jsround((1 - lim) * 100) .. "%") or "")) }
	rows[#rows + 1] = { ev and "Reduction gear" or "Transmission", s.trans, eff("top speed −" .. jsround((1 - (0.72 + 0.28 * hT)) * 100) .. "%, acceleration −" .. jsround((1 - (0.6 + 0.4 * hT)) * 100) .. "%") }
	rows[#rows + 1] = { "Driveline", s.driveline, eff(s.driveline < 90 and ("vibration, acceleration −" .. jsround((1 - (0.8 + 0.2 * s.driveline / 100)) * 100) .. "%") or "no effect") }
	rows[#rows + 1] = { "Steering", s.steer, eff("steering response −" .. jsround((1 - (0.58 + 0.42 * s.steer / 100)) * 100) .. "%") }
	rows[#rows + 1] = { "Brakes", s.brakes, eff("braking −" .. jsround((1 - (0.5 + 0.5 * s.brakes / 100)) * 100) .. "%") }
	for j = 1, 4 do
		rows[#rows + 1] = { "Suspension " .. Damage.WHEEL_NAMES[j], s.susp[j], eff(s.susp[j] < 60 and "camber/instability, less grip" or s.susp[j] < 95 and "slightly softer" or "no effect") }
	end
	local toe = s.align[1] + s.align[2] + 0.5 * (s.align[3] + s.align[4])
	rows[#rows + 1] = { "Wheel alignment", 100 - math.min(100, math.abs(toe) * 25), eff(math.abs(toe) < 0.05 and "straight" or ("pulls " .. (toe > 0 and "left" or "right") .. " (toe " .. string.format("%.1f", toe) .. "°)")) }
	return rows
end

-- ---- the repair bay (08d): items with prices (base + per % lost, x the rarity tier), repairing one item ----
Damage.REP_TIER = { 1, 1.25, 1.6, 2.1, 2.8 }
local REP_ZN = { fl = "Front-left panels (bumper, wing)", fr = "Front-right panels (bumper, wing)", l = "Left side panels (doors, sill)", r = "Right side panels (doors, sill)",
	rl = "Rear-left panels (bumper, quarter)", rr = "Rear-right panels (bumper, quarter)", roof = "Roof", u = "Underbody / floor" }
local function cap1(s)
	return string.upper(string.sub(s, 1, 1)) .. string.sub(s, 2)
end
-- the zone of a dent: the nearest zone centre
local function dentZone(d, sp)
	local b, bd = "", 1e9
	for _, zc in ipairs(ZC) do
		local q = hypot(d[1] - zc[2] * sp.W, d[3] - zc[3] * sp.L)
		if q < bd then bd, b = q, zc[1] end
	end
	return b
end
local function hasZC(z)
	return z ~= "roof" and z ~= "u"
end
function Damage.repairItems(s, car)
	local sp = car.dmg
	local cf = Damage.REP_TIER[(car.tier or 0) + 1]
	local it = {}
	local function pr(b, k, loss)
		return jsround((b + k * loss) * cf)
	end
	local dr = Damage.diagRows(s, car, true)
	for _, z in ipairs(Damage.ZONES) do
		local loss = 100 - s.zones[z]
		local nd = 0
		if hasZC(z) then
			for _, d in ipairs(s.dents) do
				if dentZone(d, sp) == z then nd += 1 end
			end
		end
		if not (loss < 0.5 and nd == 0) then
			it[#it + 1] = { id = "z:" .. z, grp = "Body", label = REP_ZN[z], cond = s.zones[z],
				eff = (nd > 0 and (nd .. " dent" .. (nd > 1 and "s" or "") .. " · ") or "") .. (z == "u" and "scrapes from landings / bumps" or "scuffs"), price = pr(30, 4, loss) }
		end
	end
	for j = 1, 4 do
		if s.lights[j] ~= 0 then it[#it + 1] = { id = "li:" .. (j - 1), grp = "Body", label = cap1(Damage.LIGHT_NAMES[j]), cond = 0, eff = "broken", price = pr(35, 0, 0) } end
	end
	for _, k in ipairs(Damage.DP_KEYS) do
		local v = s.parts[k]
		if v >= 0.005 then
			local c1 = string.sub(k, 1, 1)
			it[#it + 1] = { id = "p:" .. k, grp = "Body", label = Damage.DP_NAMES[k], cond = 100 - v * 100,
				eff = (v >= 1 and c1 ~= "h" and c1 ~= "t" and c1 ~= "d") and "torn off · replace" or v > 0.6 and "badly damaged · replace" or v > 0.3 and "cracked / bent" or "scuffed",
				price = pr(c1 == "m" and 40 or c1 == "b" and 70 or (k == "hood" or k == "trunk") and 80 or 90, c1 == "m" and 0.6 or 1.2, v * 100) }
		end
	end
	for j = 1, 4 do
		if s.glass[j] > 0 then it[#it + 1] = { id = "gl:" .. (j - 1), grp = "Body", label = cap1(Damage.GLASS_NAMES[j]), cond = 100 - s.glass[j] * 100, eff = "cracked", price = pr(j <= 2 and 90 or 50, 0, 0) } end
	end
	for _, q in ipairs({ { "engine", 1, 60, 6 }, { "cooling", 2, 25, 2.5 }, { "trans", 3, 50, 5 }, { "driveline", 4, 30, 3 }, { "steer", 5, 30, 3 }, { "brakes", 6, 20, 2.5 } }) do
		local k = q[1]
		local loss = 100 - s[k]
		if loss >= 0.5 then it[#it + 1] = { id = "c:" .. k, grp = "Mechanical", label = dr[q[2]][1], cond = s[k], eff = dr[q[2]][3], price = pr(q[3], q[4], loss) } end
	end
	for j = 1, 4 do
		local loss = 100 - s.susp[j]
		local al = math.abs(s.align[j]) > 0.01
		if not (loss < 0.5 and not al) then
			it[#it + 1] = { id = "s:" .. (j - 1), grp = "Suspension", label = "Suspension " .. Damage.WHEEL_NAMES[j] .. (al and " + alignment" or ""), cond = s.susp[j],
				eff = dr[6 + j][3] .. (al and (" · toe " .. string.format("%.1f", s.align[j]) .. "°") or ""), price = pr(25, 2.5, loss) + (al and jsround(20 * cf) or 0) }
		end
	end
	for j = 1, 4 do
		local w = s.wheels[j]
		local c = w.punct and 0 or math.min(w.tread, w.health)
		if not (c > 99.5 and w.temp < 200) then
			it[#it + 1] = { id = "t:" .. (j - 1), grp = "Tyres", label = "Tyre " .. Damage.WHEEL_NAMES[j], cond = c,
				eff = w.punct and "punctured" or ("tread " .. jsround(w.tread) .. "% · carcass " .. jsround(w.health) .. "%"), price = pr(45, 0, 0) }
		end
	end
	for j = 1, 4 do
		if s.rims[j] > 0.005 then
			it[#it + 1] = { id = "rim:" .. (j - 1), grp = "Tyres", label = "Rim " .. Damage.WHEEL_NAMES[j], cond = 100 - s.rims[j] * 100,
				eff = s.rims[j] > 0.5 and "bent · replace" or "buckled · straighten", price = pr(40, 1.1, s.rims[j] * 100) }
		end
	end
	return it
end
-- apply one repair (no charge here: the server charges) -> true when the id was known
function Damage.repairPart(s, car, id)
	local k, a = string.match(id, "^(%a+):(.+)$")
	if not k then return false end
	local j = tonumber(a)
	local sp = car.dmg
	if k == "z" and s.zones[a] then
		s.zones[a] = 100
		if hasZC(a) then
			local keep = {}
			for _, d in ipairs(s.dents) do
				if dentZone(d, sp) ~= a then keep[#keep + 1] = d end
			end
			s.dents = keep
		end
	elseif k == "li" and j and s.lights[j + 1] then
		s.lights[j + 1] = 0
	elseif k == "gl" and j and s.glass[j + 1] then
		s.glass[j + 1] = 0
		s.cracks[j + 1] = {}
	elseif k == "p" and s.parts[a] then
		s.parts[a] = 0
	elseif k == "rim" and j and s.rims[j + 1] then
		s.rims[j + 1] = 0
	elseif k == "c" and s[a] and a ~= "body" then
		s[a] = 100
		if a == "cooling" or a == "engine" then s.engTemp = 90 end
	elseif k == "s" and j and s.susp[j + 1] then
		s.susp[j + 1] = 100
		s.align[j + 1] = 0
	elseif k == "t" and j and s.wheels[j + 1] then
		s.wheels[j + 1] = Damage.newWheel()
	else
		return false
	end
	Damage.syncAggregates(s)
	return true
end
-- every part's condition, damaged or not, with its price when it needs work (08d inspectRows)
function Damage.inspectRows(s, car)
	local it, R = {}, {}
	for _, q in ipairs(Damage.repairItems(s, car)) do it[q.id] = q end
	local function add(id, grp, label, cond)
		R[#R + 1] = { id = id, grp = grp, label = label, cond = it[id] and it[id].cond or cond, price = it[id] and it[id].price or 0 }
	end
	for _, z in ipairs(Damage.ZONES) do add("z:" .. z, "Body", REP_ZN[z], s.zones[z]) end
	for j = 1, 4 do add("li:" .. (j - 1), "Body", cap1(Damage.LIGHT_NAMES[j]), s.lights[j] ~= 0 and 0 or 100) end
	for _, k in ipairs(Damage.DP_KEYS) do add("p:" .. k, "Body", Damage.DP_NAMES[k], 100 - s.parts[k] * 100) end
	for j = 1, 4 do add("gl:" .. (j - 1), "Body", cap1(Damage.GLASS_NAMES[j]), 100 - s.glass[j] * 100) end
	for _, q in ipairs({ { "engine", "Engine" }, { "cooling", "Cooling / radiator" }, { "trans", "Gearbox" }, { "driveline", "Driveline" }, { "steer", "Steering" }, { "brakes", "Brakes" } }) do
		add("c:" .. q[1], "Mechanical", q[2], s[q[1]])
	end
	for j = 1, 4 do add("s:" .. (j - 1), "Suspension", "Suspension " .. Damage.WHEEL_NAMES[j], s.susp[j]) end
	for j = 1, 4 do
		local w = s.wheels[j]
		add("t:" .. (j - 1), "Tyres", "Tyre " .. Damage.WHEEL_NAMES[j], w.punct and 0 or math.min(w.tread, w.health))
	end
	for j = 1, 4 do add("rim:" .. (j - 1), "Tyres", "Rim " .. Damage.WHEEL_NAMES[j], 100 - s.rims[j] * 100) end
	return R
end

return Damage
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">Road</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the real road graph (OpenStreetMap, exported by tools/make_roblox.js): parsing, a 50 m spatial hash of
-- segments, nearest-road lookups, Dijkstra routing that respects one-way streets (the web game's route()), and polylines along a route.
-- Units: metres, x = east, z = south, y = terrain height. Pure Luau (no Roblox API), so the tests can run it outside Studio.
local Road = {}

local CELL = 50
-- the web game's road kinds, in the exporter's order
Road.FK = { "hw", "arch", "petra", "main", "local", "svc", "ramp", "ring", "drift", "campus", "alley" }
local function key(i, j)
	return (i + 500) * 1000 + (j + 500)
end

local function nums(s, out)
	for n in string.gmatch(s, "-?%d+") do
		out[#out + 1] = tonumber(n)
	end
	return out
end

-- nodeStr: "x,z,y,..." (decimetres); edgeStrs: list of strings, edges separated by ";" (see tools/make_roblox.js); names: street names
function Road.build(nodeStr, edgeStrs, names)
	local g = { nodes = {}, edges = {}, hash = {}, names = names }
	local v = nums(nodeStr, {})
	for i = 1, #v, 3 do
		local id = #g.nodes + 1
		g.nodes[id] = { id = id, x = v[i] / 10, z = v[i + 1] / 10, y = v[i + 2] / 10, out = {}, deg = 0 }
	end
	for _, s in ipairs(edgeStrs) do
		for row in string.gmatch(s, "[^;]+") do
			local r = nums(row, {})
			local n = r[10]
			-- kind = class (0 major, 1 local, 2 service, 3 roundabout); fk = the web game's road kind (Road.FK); track = unpaved
			local e = { id = #g.edges + 1, a = r[1], b = r[2], ow = r[3] == 1, lim = r[4], name = names[r[5]] or "", kind = r[6], w = r[7] / 10,
				fk = Road.FK[r[8] + 1], track = r[9] == 1, n = n, x = {}, z = {}, y = {}, cum = {} }
			local c = 0
			for k = 1, n do
				local o = 10 + (k - 1) * 3
				e.x[k], e.z[k], e.y[k] = r[o + 1] / 10, r[o + 2] / 10, r[o + 3] / 10
				if k > 1 then
					c += math.sqrt((e.x[k] - e.x[k - 1]) ^ 2 + (e.z[k] - e.z[k - 1]) ^ 2)
				end
				e.cum[k] = c
			end
			e.len = c
			g.edges[e.id] = e
			local na, nb = g.nodes[e.a], g.nodes[e.b]
			na.deg += 1
			nb.deg += 1
			table.insert(na.out, { e = e, d = 1 })
			if not e.ow then
				table.insert(nb.out, { e = e, d = -1 })
			end
			na.inn = na.inn or {}
			nb.inn = nb.inn or {}
			table.insert(na.inn, e)
			table.insert(nb.inn, e)
			-- a junction on a roundabout (traffic slows to 8 m/s near it)
			if e.fk == "ring" then
				na.rb = true
				nb.rb = true
			end
			for k = 1, n - 1 do
				local i0, i1 = math.floor(math.min(e.x[k], e.x[k + 1]) / CELL), math.floor(math.max(e.x[k], e.x[k + 1]) / CELL)
				local j0, j1 = math.floor(math.min(e.z[k], e.z[k + 1]) / CELL), math.floor(math.max(e.z[k], e.z[k + 1]) / CELL)
				for i = i0, i1 do
					for j = j0, j1 do
						local kk = key(i, j)
						local L = g.hash[kk]
						if not L then
							L = {}
							g.hash[kk] = L
						end
						L[#L + 1] = { e, k }
					end
				end
			end
		end
	end
	return g
end

-- every segment within r metres of (x, z): calls fn(edge, k) (k = segment index; may repeat a segment that spans cells)
function Road.each(g, x, z, r, fn)
	local ci, cj, R = math.floor(x / CELL), math.floor(z / CELL), math.ceil(r / CELL)
	for i = ci - R, ci + R do
		for j = cj - R, cj + R do
			local L = g.hash[key(i, j)]
			if L then
				for _, s in ipairs(L) do
					fn(s[1], s[2])
				end
			end
		end
	end
end

-- nearest point on any road within maxd: {e, k, t, x, z, y, d, s (distance along the edge from node a), tx, tz (edge direction)}
function Road.nearest(g, x, z, maxd)
	maxd = maxd or 60
	local best, bd, bk, bt = nil, maxd * maxd, 0, 0
	Road.each(g, x, z, maxd, function(e, k)
		local ax, az = e.x[k], e.z[k]
		local dx, dz = e.x[k + 1] - ax, e.z[k + 1] - az
		local l2 = math.max(dx * dx + dz * dz, 1e-9)
		local t = math.clamp(((x - ax) * dx + (z - az) * dz) / l2, 0, 1)
		local d = (x - ax - dx * t) ^ 2 + (z - az - dz * t) ^ 2
		if d < bd then
			best, bd, bk, bt = e, d, k, t
		end
	end)
	if not best then
		return nil
	end
	local e, k, t = best, bk, bt
	local dx, dz = e.x[k + 1] - e.x[k], e.z[k + 1] - e.z[k]
	local l = math.max(math.sqrt(dx * dx + dz * dz), 1e-6)
	return {
		e = e, k = k, t = t, d = math.sqrt(bd),
		x = e.x[k] + dx * t, z = e.z[k] + dz * t, y = e.y[k] + (e.y[k + 1] - e.y[k]) * t,
		s = e.cum[k] + (e.cum[k + 1] - e.cum[k]) * t, tx = dx / l, tz = dz / l,
	}
end

-- the web game's roadAt(x, z, pad): the segment the point is deepest inside (half width + pad), with the number of segments it is
-- inside (n), the signed distance to the right of the segment direction (side) and the distance along the edge (u)
function Road.at(g, x, z, pad)
	pad = pad or 0
	local bs, be, bk, bt, bd, cnt = -1e9, nil, 0, 0, 0, 0
	local seen = {}
	Road.each(g, x, z, 50, function(e, k)
		local id = e.id * 4096 + k
		if seen[id] then return end
		seen[id] = true
		local hw = e.w / 2
		local th = hw + pad
		if th <= 0 then return end
		local ax, az = e.x[k], e.z[k]
		local dx, dz = e.x[k + 1] - ax, e.z[k + 1] - az
		local l2 = math.max(dx * dx + dz * dz, 1e-9)
		local t = math.clamp(((x - ax) * dx + (z - az) * dz) / l2, 0, 1)
		local ex, ez = x - ax - dx * t, z - az - dz * t
		local d2 = ex * ex + ez * ez
		if d2 >= th * th then return end
		local d = math.sqrt(d2)
		local sc = hw - d
		if sc >= 0 then cnt += 1 end
		if sc > bs then
			bs, be, bk, bt, bd = sc, e, k, t, d
		end
	end)
	if not be then return nil end
	local e, k, t = be, bk, bt
	local dx, dz = e.x[k + 1] - e.x[k], e.z[k + 1] - e.z[k]
	local l = math.max(math.sqrt(dx * dx + dz * dz), 1e-6)
	local px, pz = e.x[k] + dx * t, e.z[k] + dz * t
	local tx, tz = dx / l, dz / l
	return { e = e, k = k, t = t, d = bd, x = px, z = pz, tx = tx, tz = tz, side = (x - px) * -tz + (z - pz) * tx, n = cnt,
		u = e.cum[k] + (e.cum[k + 1] - e.cum[k]) * t }
end

-- the travel direction on an edge for a heading (fx, fz): 1 = a -> b, -1 = b -> a (one-way edges are always 1)
function Road.dirFor(near, fx, fz)
	if near.e.ow then
		return 1
	end
	return (near.tx * fx + near.tz * fz) >= 0 and 1 or -1
end

-- Dijkstra with a binary heap on junction nodes, one-way edges respected, service roads cost 1.25x (as in the web game)
-- -> list of traversals {e = edge, d = 1 | -1}, {} when from == to, nil when unreachable
function Road.route(g, from, to)
	if from == to then
		return {}
	end
	local D, prev, done, H = { [from] = 0 }, {}, {}, { { 0, from } }
	local function push(k, v)
		H[#H + 1] = { k, v }
		local i = #H
		while i > 1 do
			local p = i // 2
			if H[p][1] <= H[i][1] then
				break
			end
			H[p], H[i] = H[i], H[p]
			i = p
		end
	end
	local function pop()
		local t = H[1]
		local l = table.remove(H)
		if #H > 0 then
			H[1] = l
			local i = 1
			while true do
				local a, b, m = 2 * i, 2 * i + 1, i
				if a <= #H and H[a][1] < H[m][1] then
					m = a
				end
				if b <= #H and H[b][1] < H[m][1] then
					m = b
				end
				if m == i then
					break
				end
				H[m], H[i] = H[i], H[m]
				i = m
			end
		end
		return t
	end
	while #H > 0 do
		local top = pop()
		local du, u = top[1], top[2]
		if not done[u] then
			done[u] = true
			if u == to then
				break
			end
			for _, o in ipairs(g.nodes[u].out) do
				local v = o.d > 0 and o.e.b or o.e.a
				if not done[v] then
					local nd = du + o.e.len * (o.e.kind == 2 and 1.25 or 1)
					if D[v] == nil or nd < D[v] then
						D[v] = nd
						prev[v] = { u = u, o = o }
						push(nd, v)
					end
				end
			end
		end
	end
	if D[to] == nil then
		return nil
	end
	local r = {}
	local v = to
	while v ~= from do
		table.insert(r, 1, prev[v].o)
		v = prev[v].u
	end
	return r
end

-- lane offset to the right of the travel direction (traffic drives on the right in Jordan); same widths as the web game's appendTrav
function Road.lane(e)
	return e.ow and e.w * 0.18 or e.w * 0.25
end

-- a polyline along a list of traversals: {x, z, y, c (distance along), ends (distance at the end of each traversal)}
-- laneFn(e) -> metres to the right (nil = on the centre line)
function Road.path(travs, laneFn)
	local P = { x = {}, z = {}, y = {}, c = {}, ends = {} }
	local c = 0
	for ti, tr in ipairs(travs) do
		local e, d = tr.e, tr.d
		local off = laneFn and laneFn(e) or 0
		local n = e.n
		for q = 1, n do
			local k = d > 0 and q or n + 1 - q
			local k0, k1 = math.max(1, k - 1), math.min(n, k + 1)
			local tx, tz = (e.x[k1] - e.x[k0]) * d, (e.z[k1] - e.z[k0]) * d
			local l = math.max(math.sqrt(tx * tx + tz * tz), 1e-6)
			local px, pz = e.x[k] - tz / l * off, e.z[k] + tx / l * off
			local m = #P.x
			local step = m > 0 and math.sqrt((px - P.x[m]) ^ 2 + (pz - P.z[m]) ^ 2) or 0
			if m == 0 or step > 0.5 then
				c += step
				P.x[m + 1], P.z[m + 1], P.y[m + 1], P.c[m + 1] = px, pz, e.y[k], c
			end
		end
		P.ends[ti] = c
	end
	return P
end

-- decode an exported path string "x,z,y,..." (decimetres) into a polyline like Road.path's
function Road.pathFromString(s)
	local v = nums(s, {})
	local P = { x = {}, z = {}, y = {}, c = {}, ends = {} }
	local c = 0
	for i = 1, #v, 3 do
		local m = #P.x
		local px, pz = v[i] / 10, v[i + 1] / 10
		if m > 0 then
			c += math.sqrt((px - P.x[m]) ^ 2 + (pz - P.z[m]) ^ 2)
		end
		P.x[m + 1], P.z[m + 1], P.y[m + 1], P.c[m + 1] = px, pz, v[i + 2] / 10, c
	end
	P.ends[1] = c
	return P
end

-- position on a polyline at distance s; hint = a point index at or before s (pass the returned index back next frame)
-- -> x, z, y, direction x, direction z, index
function Road.sample(P, s, hint)
	local n = #P.x
	if n == 1 then
		return P.x[1], P.z[1], P.y[1], 0, 1, 1
	end
	local i = math.clamp(hint or 1, 1, n - 1)
	if P.c[i] > s then
		i = 1
	end
	while i < n - 1 and P.c[i + 1] < s do
		i += 1
	end
	local seg = math.max(P.c[i + 1] - P.c[i], 1e-6)
	local t = math.clamp((s - P.c[i]) / seg, 0, 1)
	local dx, dz = P.x[i + 1] - P.x[i], P.z[i + 1] - P.z[i]
	local l = math.max(math.sqrt(dx * dx + dz * dz), 1e-6)
	return P.x[i] + dx * t, P.z[i] + dz * t, P.y[i] + (P.y[i + 1] - P.y[i]) * t, dx / l, dz / l, i
end

-- the point index of a polyline nearest to (x, z), searching from index a to b
function Road.closestIndex(P, x, z, a, b)
	local bi, bd = a, math.huge
	for i = math.max(1, a), math.min(#P.x, b) do
		local d = (P.x[i] - x) ^ 2 + (P.z[i] - z) ^ 2
		if d < bd then
			bi, bd = i, d
		end
	end
	return bi, math.sqrt(bd)
end

-- the nearest point ON a polyline (between points a and b): distance along it, distance from it, segment index
function Road.project(P, x, z, a, b)
	local n = #P.x
	local bs, bd, bj = 0, math.huge, 1
	for j = math.max(1, a), math.min(n - 1, b) do
		local ax, az = P.x[j], P.z[j]
		local dx, dz = P.x[j + 1] - ax, P.z[j + 1] - az
		local l2 = math.max(dx * dx + dz * dz, 1e-9)
		local t = math.clamp(((x - ax) * dx + (z - az) * dz) / l2, 0, 1)
		local d = (x - ax - dx * t) ^ 2 + (z - az - dz * t) ^ 2
		if d < bd then
			bs, bd, bj = P.c[j] + (P.c[j + 1] - P.c[j]) * t, d, j
		end
	end
	if n == 1 then
		return 0, math.sqrt((x - P.x[1]) ^ 2 + (z - P.z[1]) ^ 2), 1
	end
	return bs, math.sqrt(bd), bj
end

-- a safe speed for each point of a polyline (m/s): the web game's curveCap (turn angle over a few points) plus braking room (10 m/s^2)
function Road.speedCaps(P)
	local n, cap = #P.x, {}
	for j = 1, n do
		local v = 120
		if j + 3 <= n then
			local a1 = math.atan2(P.x[j + 1] - P.x[j], P.z[j + 1] - P.z[j])
			local a2 = math.atan2(P.x[j + 3] - P.x[j + 2], P.z[j + 3] - P.z[j + 2])
			local da = (a2 - a1 + math.pi) % (2 * math.pi) - math.pi
			v = math.clamp(math.sqrt(224 / math.max(0.02, math.abs(da))), 9, 120)
		end
		cap[j] = v
	end
	for j = n - 1, 1, -1 do
		cap[j] = math.min(cap[j], math.sqrt(cap[j + 1] ^ 2 + 2 * 10 * (P.c[j + 1] - P.c[j])))
	end
	return cap
end

-- the edge's node in the travel direction, and the point index sequence helper for routing from a position
function Road.nodeAhead(near, d)
	return d > 0 and near.e.b or near.e.a
end

-- route from a position (on or near a road, heading fx, fz) to the node nearest (tx, tz); the first traversal is the current edge
-- -> traversals, distance along the first traversal where the position is   (nil when no road or no route)
function Road.routeFrom(g, x, z, fx, fz, tx, tz)
	local near = Road.nearest(g, x, z, 120)
	local dest = Road.nearest(g, tx, tz, 400)
	if not (near and dest) then
		return nil
	end
	local d = Road.dirFor(near, fx, fz)
	local start = Road.nodeAhead(near, d)
	-- the destination node: the end of its edge nearer along the edge
	local de = dest.e
	local goal = (dest.s <= de.len - dest.s) and de.a or de.b
	local r = Road.route(g, start, goal)
	if not r then
		-- try the other end (one-way streets)
		goal = goal == de.a and de.b or de.a
		r = Road.route(g, start, goal)
		if not r then
			return nil
		end
	end
	table.insert(r, 1, { e = near.e, d = d })
	return r, d > 0 and near.s or (near.e.len - near.s)
end

return Road
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">SettingsSchema</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the player settings (the web game's pause menu, 12e_pause.js, and its separate localStorage keys), shared by the
-- server (which checks and saves them with the progress) and the devices. Every setting is a whole number in [min, max].
-- Wire format (player attribute "Settings", remote SaveSettings): "key=value;key=value".
local Schema = {}

-- the gamepad buttons a binding can name (value -1 = none, 0 = A ... 11 = d-pad right)
local BTN = { "None", "A", "B", "X", "Y", "LB", "RB", "L3", "R3", "D-pad up", "D-pad down", "D-pad left", "D-pad right" }

-- key, min, max, default, label, value names (index = value - min + 1)
Schema.LIST = ({
	{ "hm", 0, 1, 0, "Handling", { "Arcade", "Realistic" } },
	{ "gb", 0, 1, 0, "Gearbox", { "Automatic", "Manual (Q / E)" } },
	{ "abs", 0, 1, 1, "ABS", { "Off", "On" } },
	{ "tc", 0, 1, 0, "Traction control", { "Off", "On" } },
	{ "esc", 0, 1, 0, "Stability control", { "Off", "On" } },
	{ "tt", 0, 1, 0, "Tyre temperature", { "Off", "On" } },
	{ "bf", 0, 1, 0, "Brake fade", { "Off", "On" } },
	{ "dm", 0, 2, 0, "Damage", { "Off", "Cosmetic", "Full" } },
	{ "wx", 0, 3, 0, "Weather", { "Auto (Irbid climate)", "Clear", "Cloudy", "Rain" } },
	{ "clk", 0, 1, 0, "Clock", { "Game time", "Irbid local time" } },
	{ "tr", 0, 3, 0, "Traffic", { "High", "Medium", "Low", "By time of day" } },
	{ "cam", 0, 4, 0, "Camera", { "Chase", "Cockpit", "Bonnet", "Bumper", "Free" } },
	{ "vol", 0, 10, 8, "Sound", nil },
	{ "veng", 0, 10, 8, "Engine volume", nil },
	{ "vfx", 0, 10, 8, "Effects volume", nil },
	{ "vamb", 0, 10, 6, "Ambient volume", nil },
	{ "mute", 0, 1, 0, "Mute", { "Off", "On" } },
	{ "rm", 0, 1, 0, "Reduced motion", { "Off", "On" } },
	{ "ts", 0, 3, 1, "Text size", { "90 %", "100 %", "120 %", "140 %" } },
	{ "rep", 0, 1, 1, "Road reputation", { "Off", "On" } },
	-- gamepad / racing wheel seen as a gamepad (the web game's wheel setup, key V): axes, invert, sensitivity, dead zones, curve, smoothing
	{ "gs", 0, 1, 0, "Gamepad steering", { "Left stick", "Right stick" } },
	{ "gp", 0, 2, 0, "Gamepad pedals", { "Triggers (RT gas, LT brake)", "Right stick up / down", "Left stick up / down" } },
	{ "ginv", 0, 1, 0, "Invert steering", { "Off", "On" } },
	{ "gsens", 5, 25, 10, "Steering sensitivity (x0.1)", nil },
	{ "gdz", 0, 30, 8, "Steering dead zone (%)", nil },
	{ "gcen", -20, 20, 0, "Steering centre offset (%)", nil },
	{ "gcurve", 10, 30, 10, "Steering response curve (x0.1)", nil },
	{ "gsm", 0, 10, 0, "Steering smoothing (x20 ms)", nil },
	{ "gpdz", 0, 20, 3, "Pedal dead zone (%)", nil },
	{ "grum", 0, 1, 1, "Rumble on impacts", { "Off", "On" } },
	-- gamepad buttons: -1 = none, then A B X Y LB RB L3 R3, d-pad up / down / left / right
	{ "bhb", -1, 11, 0, "Button: handbrake (hold)", BTN },
	{ "bup", -1, 11, 5, "Button: shift up", BTN },
	{ "bdn", -1, 11, 4, "Button: shift down", BTN },
	{ "bcam", -1, 11, 3, "Button: camera", BTN },
	{ "bhorn", -1, 11, 2, "Button: horn (hold)", BTN },
	{ "brace", -1, 11, 1, "Button: race / duel", BTN },
	{ "breset", -1, 11, 7, "Button: back to the start", BTN },
	{ "btour", -1, 11, 6, "Button: landmark tour", BTN },
	{ "bgps", -1, 11, 8, "Button: GPS", BTN },
	{ "bset", -1, 11, 9, "Button: settings", BTN },
	{ "bnext", -1, 11, 11, "Button: next car", BTN },
	{ "bprev", -1, 11, 10, "Button: previous car", BTN },
} :: { { any } })
-- the gamepad / wheel rows have their own panel (the web game's wheel setup screen)
Schema.PAD = {}
for _, k in ipairs({ "gs", "gp", "ginv", "gsens", "gdz", "gcen", "gcurve", "gsm", "gpdz", "grum" }) do Schema.PAD[k] = true end
for _, r in ipairs(Schema.LIST) do
	if r[6] == BTN then Schema.PAD[r[1]] = true end
end
Schema.BY = {}
for _, r in ipairs(Schema.LIST) do
	Schema.BY[r[1]] = { min = r[2], max = r[3], def = r[4], label = r[5], names = r[6] }
end

-- the defaults
function Schema.defaults()
	local t = {}
	for _, r in ipairs(Schema.LIST) do t[r[1]] = r[4] end
	return t
end

-- parse and check a wire string (unknown keys and bad values are ignored; missing keys get the default)
function Schema.parse(s)
	local t = Schema.defaults()
	if type(s) ~= "string" or #s > 1500 then return t end
	for k, v in string.gmatch(s, "(%a+)=(%-?%d+)") do
		local d = Schema.BY[k]
		local n = tonumber(v)
		if d and n and n >= d.min and n <= d.max and n == math.floor(n) then t[k] = n end
	end
	return t
end

function Schema.encode(t)
	local out = {}
	for _, r in ipairs(Schema.LIST) do
		local v = t[r[1]]
		if v == nil then v = r[4] end
		out[#out + 1] = r[1] .. "=" .. tostring(v)
	end
	return table.concat(out, ";")
end

-- the text of a value ("Realistic", "8 / 10")
function Schema.text(k, v)
	local d = Schema.BY[k]
	if d.names then return d.names[v - d.min + 1] or tostring(v) end
	return tostring(v) .. " / " .. tostring(d.max)
end

