,0,0.9978,0,1,0,-0.9978,0,-0.067,2764083,0,0","ball,-671.279,12.82,2020.256,0.6,0.6,0.6,-0.067,0,0.9978,0,1,0,-0.9978,0,-0.067,16773824,0,1","cyl,-671.814,10.62,2028.238,0.22,4.2,0.22,-0.067,0,0.9978,0,1,0,-0.9978,0,-0.067,2764083,0,0","ball,-671.814,12.82,2028.238,0.6,0.6,0.6,-0.067,0,0.9978,0,1,0,-0.9978,0,-0.067,16773824,0,1","box,-686.224,8.97,1971.145,0.3,0.9,46,-0.067,0,0.9978,0,1,0,-0.9978,0,-0.067,3816770,0,0","box,-690.509,8.97,2035.002,0.3,0.9,46,-0.067,0,0.9978,0,1,0,-0.9978,0,-0.067,3816770,0,0","box,-665.418,8.97,2004.614,64,0.9,0.3,-0.067,0,0.9978,0,1,0,-0.9978,0,-0.067,3816770,0,0","box,-711.315,8.97,2001.533,64,0.9,0.3,-0.067,0,0.9978,0,1,0,-0.9978,0,-0.067,3816770,0,0","box,-674.23,8.92,1984.779,4,0.6,4,-0.067,0,0.9978,0,1,0,-0.9978,0,-0.067,15327171,0,0","box,-672.313,10.12,1983.104,0.3,2.6,0.3,-0.067,0,0.9978,0,1,0,-0.9978,0,-0.067,14505301,0,0"}
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX107"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX93"><Properties><string name="Name">Game</string></Properties><Item class="ModuleScript" referent="RBX73"><Properties><string name="Name">CarBuilder</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - a player's car: the web game's shape for that car (Modules/CarBody: its body profile, glass house, lamps,
-- wheels and its own neon light lines), welded to an invisible root part "Body", plus a seat. Sizes from the web game's car data. The
-- player's device moves it; cars and drivers are in the collision group "Drive", which does not collide with the world (the devices do
-- their own ground and wall tests).
local Workspace = game:GetService("Workspace")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local CarBody = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("CarBody"))

local S = Config.SCALE
pcall(function() PhysicsService:RegisterCollisionGroup("Drive") end)
PhysicsService:CollisionGroupSetCollidable("Drive", "Default", false)
PhysicsService:CollisionGroupSetCollidable("Drive", "Drive", false)

local CarBuilder = {}

function CarBuilder.build(spec, color, carIndex)
	local m = CarBody.build(spec, color, { S = S, anchored = false, neon = true })
	local body = m.PrimaryPart
	-- anchored until the player's device has taken the car over (CarReady), so it cannot fall through the map before that
	body.Anchored = true
	body.Massless = false
	local W, L = spec.W * S, spec.L * S
	for _, hl in ipairs(m:GetChildren()) do
		if hl.Name == "Headlight" then
			local sl = Instance.new("SpotLight")
			sl.Name = "Beam"
			sl.Face = Enum.NormalId.Front
			sl.Range = 40 * S
			sl.Angle = 70
			sl.Brightness = 3
			sl.Enabled = Workspace:GetAttribute("Night") == true
			sl.Parent = hl
		end
	end
	-- the driver's seat (left-hand drive; the avatar is hidden, as the web game shows no driver)
	local seat = Instance.new("Seat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2, 0.4, 2)
	seat.CFrame = body.CFrame * CFrame.new(-W * 0.2, 0, L * 0.08)
	seat.Transparency = 1
	seat.Massless = true
	seat.Parent = m
	local sw = Instance.new("WeldConstraint"); sw.Part0 = body; sw.Part1 = seat; sw.Parent = seat
	-- counter gravity so the device's position updates are not fought by the physics engine
	local att = Instance.new("Attachment"); att.Parent = body
	local vf = Instance.new("VectorForce")
	vf.Name = "Lift"
	vf.Attachment0 = att
	vf.RelativeTo = Enum.ActuatorRelativeTo.World
	vf.ApplyAtCenterOfMass = true
	vf.Parent = body
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CollisionGroup = "Drive"
			p.CanQuery = false
			p.CanTouch = false
		end
	end
	m:SetAttribute("carIndex", carIndex)
	m:SetAttribute("carName", spec.name)
	return m
end

return CarBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX74"><Properties><string name="Name">DamageStore</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - each player's vehicle damage, kept on the server per car (the web game keeps it per car in localStorage):
-- the device computes the damage while driving (Modules/Damage, the web game's rules) and sends the record; the server checks it
-- (Damage.clean) and only lets a record get WORSE (a device cannot repair its car by sending a clean record). Repairs happen here, at
-- Apex Drift Customs: the server prices them with the same module (base + per % lost, x the rarity tier), charges the JD balance,
-- repairs the stored record and sends it back. Saved with the progress (PlayerData, field "dmg").
-- Remote Damage (function): ("get", car) -> record | ("save", car, record) -> true | ("repair", car, {ids} or "*") -> ok, record | reason, JD
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Damage = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Damage"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local Sites = require(script.Parent:WaitForChild("Sites"))

local DamageStore = {}
local COND = { "engine", "brakes", "cooling", "trans", "driveline", "steer" }

-- the record a device sent, merged so that nothing improves (condition can only drop, damage only grow) except the things that recover
-- by themselves (tyre and engine temperature)
function DamageStore.merge(old, new, car)
	local n = Damage.clean(new, car)
	local o = old or Damage.newRecord(car)
	for _, k in ipairs(COND) do n[k] = math.min(n[k], o[k]) end
	for _, z in ipairs(Damage.ZONES) do n.zones[z] = math.min(n.zones[z], o.zones[z]) end
	for j = 1, 4 do
		n.susp[j] = math.min(n.susp[j], o.susp[j])
		if math.abs(n.align[j]) < math.abs(o.align[j]) then n.align[j] = o.align[j] end
		n.lights[j] = math.max(n.lights[j], o.lights[j])
		n.glass[j] = math.max(n.glass[j], o.glass[j])
		n.rims[j] = math.max(n.rims[j], o.rims[j])
		local w, v = n.wheels[j], o.wheels[j]
		w.tread, w.health = math.min(w.tread, v.tread), math.min(w.health, v.health)
		w.punct = w.punct or v.punct
		w.km, w.tmax = math.max(w.km, v.km), math.max(w.tmax, v.tmax)
		for k in pairs(w.wear) do w.wear[k] = math.max(w.wear[k], v.wear[k]) end
		if #n.cracks[j] < #o.cracks[j] then n.cracks[j] = o.cracks[j] end
	end
	for _, k in ipairs(Damage.DP_KEYS) do n.parts[k] = math.max(n.parts[k], o.parts[k]) end
	if #n.dents < #o.dents then n.dents = o.dents end
	n.impacts = math.max(n.impacts, o.impacts)
	Damage.syncAggregates(n)
	return n
end

local function carOf(i)
	return type(i) == "number" and Config.CARS[i] and i or nil
end

Remotes.Damage.OnServerInvoke = function(plr, action, i, arg)
	local d = PlayerData.data[plr]
	local ci = carOf(i)
	if not (d and ci) then return false, "not ready" end
	d.damage = d.damage or {}
	local car = Config.CARS[ci]
	if action == "get" then
		return d.damage[ci] or Damage.newRecord(car)
	elseif action == "save" then
		-- at most twice a second per player
		local now = os.clock()
		if now - (d.dmgT or -1) < 0.5 then return false, "too often" end
		d.dmgT = now
		if type(arg) ~= "table" then return false, "bad record" end
		d.damage[ci] = DamageStore.merge(d.damage[ci], arg, car)
		return true
	elseif action == "repair" then
		if not Sites.near(plr, Sites.shop, 40) then return false, "Repairs are done at Apex Drift Customs" end
		local s = d.damage[ci] or Damage.newRecord(car)
		local items = Damage.repairItems(s, car)
		local want = {}
		if arg == "*" then
			for _, q in ipairs(items) do want[q.id] = true end
		elseif type(arg) == "table" then
			for _, id in ipairs(arg) do
				if type(id) == "string" then want[id] = true end
			end
		end
		local total, list = 0, {}
		for _, q in ipairs(items) do
			if want[q.id] then
				total += q.price
				list[#list + 1] = q
			end
		end
		if #list == 0 then return false, "Nothing to repair" end
		if d.cash < total then return false, "Not enough JD (" .. total .. " JD needed)" end
		d.cash -= total
		for _, q in ipairs(list) do Damage.repairPart(s, car, q.id) end
		d.damage[ci] = s
		PlayerData.commit(plr)
		return true, s, total, #list > 2 and (#list .. " items") or (list[1].label .. (list[2] and (", " .. list[2].label) or ""))
	end
	return false, "unknown action"
end

return DamageStore
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX75"><Properties><string name="Name">DayNight</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - day and night, as in the web game: the clock starts at 15:00 and runs one hour every 40 s
-- (Config.DAY_MINUTES = 16 for a whole day); T adds an hour (in Roblox for everyone on the server). Car headlights switch on at night
-- (Workspace attribute "Night", also read by CarBuilder for new cars).
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))

local night = false
local hour = 15
local lastT = {}
Remotes.AddHour.OnServerEvent:Connect(function(plr)
	-- at most once a second per player
	if os.clock() - (lastT[plr] or -9) < 1 then return end
	lastT[plr] = os.clock()
	hour = (hour + 1) % 24
end)

Workspace:SetAttribute("Night", false)
task.spawn(function()
	-- the clock starts when the map is ready (building it in Studio can take minutes; the web game starts at 15:00 when you can drive)
	Lighting.ClockTime = hour
	while not Workspace:GetAttribute("MapReady") do task.wait(0.25) end
	local last = os.clock()
	while true do
		local now = os.clock()
		hour = (hour + (now - last) / (Config.DAY_MINUTES * 60) * 24) % 24
		last = now
		Lighting.ClockTime = hour
		local nowNight = hour < 6.3 or hour > 18.2
		if nowNight ~= night then
			night = nowNight
			for _, m in ipairs(Workspace:GetChildren()) do
				if m:IsA("Model") and string.sub(m.Name, 1, 4) == "Car_" then
					for _, l in ipairs(m:GetDescendants()) do
						if l:IsA("SpotLight") then l.Enabled = night end
					end
				end
			end
		end
		Workspace:SetAttribute("Night", night)
		task.wait(0.5)
	end
end)

return {}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX76"><Properties><string name="Name">Drift</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - drift points from the device -> drift bank (pays for upgrades) + cash (0.25 per point, VIP x2).
-- Server cap: points per second of driving since the last bank, scaled by the car's rarity and Extra Drift Points upgrade (the most a
-- long, fast, full-combo drift can score), and never more than 60,000 at once. Bad values are ignored.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))

Remotes.BankDrift.OnServerEvent:Connect(function(plr, pts)
	local d = PlayerData.data[plr]
	if not d or type(pts) ~= "number" or pts ~= pts or pts <= 0 then return end
	local now = os.clock()
	local t = Config.tuned(d.cur, PlayerData.levels(d, d.cur))
	local cap = math.min(60000, (now - d.last) * 1500 * t.rm * (1 + 0.2 * t.dr))
	d.last = now
	pts = math.floor(math.min(pts, cap))
	d.bank += pts
	d.dt += pts
	d.cash += pts * Config.DRIFT_CASH * (d.vip and 2 or 1)
	PlayerData.sync(plr)
end)

return {}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX77"><Properties><string name="Name">Fines</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - traffic fines (the web game's amounts and cool-downs): speeding 15 JD (5 s), driving against traffic 20 JD
-- (6 s), red light 50 JD (3 s), collision with traffic 30 JD (2 s). As in the web game a fine ADDS to the JD balance: the car wheel is
-- paid with "law-breaking JD". The device detects the offence (Client/Laws); the server sets the amount and enforces the cool-down.
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))

local RULES = { spd = { 15, 5 }, way = { 20, 6 }, red = { 50, 3 }, hit = { 30, 2 } }

Remotes.Fine.OnServerEvent:Connect(function(plr, kind)
	local d = PlayerData.data[plr]
	local r = type(kind) == "string" and RULES[kind]
	if not (d and r) then return end
	d.fineT = d.fineT or {}
	local now = os.clock()
	if now - (d.fineT[kind] or -99) < r[2] then return end
	d.fineT[kind] = now
	d.cash += r[1]
	d.fines = (d.fines or 0) + r[1]
	PlayerData.sync(plr)
end)

return {}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX78"><Properties><string name="Name">Garage</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - buy or switch cars with cash. The VIP car needs the VIP pass. The new car appears where the old one was.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local Spawner = require(script.Parent:WaitForChild("Spawner"))

local Garage = {}

-- -> ok, car name | reason
function Garage.buyOrUse(plr, d, i)
	local spec = type(i) == "number" and Config.CARS[i]
	if not spec then return false, "no such car" end
	if spec.vip and not d.vip then
		if Config.GAMEPASS_VIP ~= 0 then MarketplaceService:PromptGamePassPurchase(plr, Config.GAMEPASS_VIP) end
		return false, "VIP car"
	end
	if not d.owned[i] then
		if d.cash < spec.price then return false, "Not enough JD" end
		d.cash -= spec.price
		d.owned[i] = true
	end
	d.cur = i
	PlayerData.commit(plr)
	Spawner.spawn(plr, true)
	return true, spec.name
end

return Garage
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX79"><Properties><string name="Name">HeistRewards</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the bank heist (the web game's rules): start only at the bank and while it is open; escaping (after the
-- full 2:00) pays +500, getting caught costs up to 50; then the bank is closed for 3:00.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local Sites = require(script.Parent:WaitForChild("Sites"))

local HeistRewards = {}

function HeistRewards.start(plr, d)
	if os.clock() < d.heistCool then return false, "The bank is closed for now" end
	if not Sites.near(plr, Sites.bank, 30) then return false, "Drive to the bank first" end
	d.heist = os.clock()
	return true
end

-- escaped = true (the timer ran out) or false (caught) -> ok, cash change
function HeistRewards.finish(plr, d, escaped)
	local t0 = d.heist
	d.heist = nil
	if not t0 then return false, "no heist" end
	d.heistCool = os.clock() + Config.HEIST_COOLDOWN
	plr:SetAttribute("BankOpenAt", Workspace.DistributedGameTime + Config.HEIST_COOLDOWN)
	if escaped == true then
		if os.clock() - t0 < Config.HEIST_TIME - 3 then return false, "Result not accepted" end
		d.cash += Config.HEIST_REWARD
		PlayerData.commit(plr)
		return true, Config.HEIST_REWARD
	end
	local loss = math.min(Config.HEIST_FINE, math.floor(d.cash))
	d.cash -= loss
	PlayerData.commit(plr)
	return true, -loss
end

return HeistRewards
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX80"><Properties><string name="Name">Missions</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the Mission remote: race_start / race_cancel / race_finish, heist_start / heist_end.
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local RaceRewards = require(script.Parent:WaitForChild("RaceRewards"))
local HeistRewards = require(script.Parent:WaitForChild("HeistRewards"))

local ACTIONS = {
	race_start = RaceRewards.start,
	race_cancel = RaceRewards.cancel,
	race_finish = RaceRewards.finish,
	heist_start = HeistRewards.start,
	heist_end = HeistRewards.finish,
}

Remotes.Mission.OnServerInvoke = function(plr, action, arg)
	local d = PlayerData.data[plr]
	if not d then return false, "not ready" end
	local f = ACTIONS[action]
	if not f then return false, "unknown action" end
	return f(plr, d, arg)
end

return {}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX81"><Properties><string name="Name">PlayerData</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - each player's progress: cash, drift bank, lifetime drift, owned cars, current car, upgrade levels per car.
-- Saved in a DataStore (works in a published game; in Studio enable "Studio Access to API Services" to test it), shown in the
-- leaderboard (Cash, Drift) and in player attributes the devices read (Cash, DriftBank, Owned, CurCar, Tune, VIP).
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Schema = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("SettingsSchema"))
local Damage = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Damage"))

local PlayerData = {}
local store
pcall(function() store = DataStoreService:GetDataStore("IrbidDrive_v1") end)
-- [player] = {cash, bank, dt, owned = {[i]=true}, cur, tune = {[i] = {4 levels}}, vip, last, heistCool, race, heist, lastReset}
PlayerData.data = {}

local function cleanLevels(t)
	local l = {}
	for k = 1, 4 do
		local v = type(t) == "table" and tonumber(t[k]) or 0
		l[k] = math.clamp(math.floor(v or 0), 0, Config.UPGRADE_MAX)
	end
	return l
end

-- read (and check) a saved record; a new player starts with Config.START_CASH and the starter car
function PlayerData.load(plr)
	local d
	if store then
		local ok, v = pcall(function() return store:GetAsync("u" .. plr.UserId) end)
		if ok and type(v) == "table" then d = v end
	end
	d = d or {}
	local owned = {}
	for _, i in ipairs(type(d.owned) == "table" and d.owned or {}) do
		if Config.CARS[i] then owned[i] = true end
	end
	owned[1] = true
	local tune = {}
	if type(d.tune) == "table" then
		for k, t in pairs(d.tune) do
			local i = tonumber(k)
			if i and Config.CARS[i] then tune[i] = cleanLevels(t) end
		end
	end
	local cur = (type(d.cur) == "number" and owned[d.cur]) and d.cur or 1
	-- the vehicle damage per car (version 4; checked field by field)
	local damage = {}
	if type(d.dmg) == "table" then
		for k, r in pairs(d.dmg) do
			local i = tonumber(k)
			if i and Config.CARS[i] then damage[i] = Damage.clean(r, Config.CARS[i]) end
		end
	end
	-- version 1 saves (the first Roblox build) had only a lifetime "drift" total
	local dt = tonumber(d.dt) or tonumber(d.drift) or 0
	return {
		cash = math.max(0, tonumber(d.cash) or Config.START_CASH), bank = math.max(0, tonumber(d.bank) or 0), dt = math.max(0, dt),
		owned = owned, cur = cur, tune = tune, last = os.clock(), heistCool = 0,
		-- the settings (version 4; older records have none: the defaults)
		settings = Schema.encode(Schema.parse(d.set)),
		damage = damage,
		-- road reputation and rival memory (Client/Reputation)
		rep = type(d.rep) == "string" and #d.rep <= 200 and d.rep or "70",
		school = type(d.school) == "string" and #d.school <= 120 and d.school or "runs=0",
		fav = type(d.fav) == "string" and #d.fav <= 2400 and d.fav or "",
	}
end

function PlayerData.save(plr)
	local d = PlayerData.data[plr]
	if not (d and store) then return end
	local owned, tune = {}, {}
	for i in pairs(d.owned) do owned[#owned + 1] = i end
	for i, t in pairs(d.tune) do tune[tostring(i)] = t end
	-- only damaged cars are stored
	local dmg = {}
	for i, r in pairs(d.damage or {}) do
		if Damage.hurt(r) then dmg[tostring(i)] = r end
	end
	pcall(function()
		store:SetAsync("u" .. plr.UserId, { v = 2, cash = math.floor(d.cash), bank = math.floor(d.bank), dt = math.floor(d.dt), owned = owned, cur = d.cur, tune = tune, set = d.settings, dmg = dmg, rep = d.rep, school = d.school, fav = d.fav })
	end)
end

-- the upgrade levels of car i (created at 0)
function PlayerData.levels(d, i)
	local t = d.tune[i]
	if not t then
		t = { 0, 0, 0, 0 }
		d.tune[i] = t
	end
	return t
end

-- push the numbers to the leaderboard and to the attributes the device reads
function PlayerData.sync(plr)
	local d = PlayerData.data[plr]
	local ls = plr:FindFirstChild("leaderstats")
	if not (d and ls) then return end
	ls.JD.Value = math.floor(d.cash)
	ls.Drift.Value = math.floor(d.dt)
	local owned = {}
	for i in pairs(d.owned) do owned[#owned + 1] = i end
	table.sort(owned)
	plr:SetAttribute("Owned", table.concat(owned, ","))
	plr:SetAttribute("CurCar", d.cur)
	plr:SetAttribute("VIP", d.vip == true)
	plr:SetAttribute("Cash", math.floor(d.cash))
	plr:SetAttribute("DriftBank", math.floor(d.bank))
	plr:SetAttribute("Tune", table.concat(PlayerData.levels(d, d.cur), ","))
	plr:SetAttribute("Fines", d.fines or 0)
	plr:SetAttribute("Settings", d.settings)
	plr:SetAttribute("Rep", d.rep)
	plr:SetAttribute("School", d.school)
	plr:SetAttribute("Fav", d.fav)
end

-- sync and save after a change of money or cars
function PlayerData.commit(plr)
	PlayerData.sync(plr)
	PlayerData.save(plr)
end

return PlayerData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX82"><Properties><string name="Name">Purchases</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - Robux: the VIP game pass (double drift cash + the VIP car) and two cash packs (developer products).
-- Everything is off while the IDs in Config are 0. A developer product is granted once per receipt (Roblox retries until granted).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))

local Purchases = {}

function Purchases.vipOwned(plr)
	if Config.GAMEPASS_VIP == 0 then return false end
	local ok, has = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(plr.UserId, Config.GAMEPASS_VIP) end)
	return ok and has
end

-- the buttons in the garage: open Roblox's purchase prompt
function Purchases.prompt(plr, what)
	if what == "cash_small" and Config.PRODUCT_CASH_SMALL ~= 0 then
		MarketplaceService:PromptProductPurchase(plr, Config.PRODUCT_CASH_SMALL)
	elseif what == "cash_big" and Config.PRODUCT_CASH_BIG ~= 0 then
		MarketplaceService:PromptProductPurchase(plr, Config.PRODUCT_CASH_BIG)
	elseif what == "vip" and Config.GAMEPASS_VIP ~= 0 then
		MarketplaceService:PromptGamePassPurchase(plr, Config.GAMEPASS_VIP)
	end
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(plr, id, bought)
	local d = PlayerData.data[plr]
	if bought and id == Config.GAMEPASS_VIP and d then
		d.vip = true
		for i, c in ipairs(Config.CARS) do
			if c.vip then d.owned[i] = true end
		end
		PlayerData.sync(plr)
	end
end)

local granted = {}
MarketplaceService.ProcessReceipt = function(info)
	local plr = Players:GetPlayerByUserId(info.PlayerId)
	local d = plr and PlayerData.data[plr]
	if not d then return Enum.ProductPurchaseDecision.NotProcessedYet end
	if granted[info.PurchaseId] then return Enum.ProductPurchaseDecision.PurchaseGranted end
	local add = (info.ProductId == Config.PRODUCT_CASH_SMALL and Config.CASH_SMALL) or (info.ProductId == Config.PRODUCT_CASH_BIG and Config.CASH_BIG) or 0
	if add == 0 then return Enum.ProductPurchaseDecision.NotProcessedYet end
	d.cash += add
	granted[info.PurchaseId] = true
	PlayerData.commit(plr)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

return Purchases
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX83"><Properties><string name="Name">RaceRewards</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - race results. The device plays the race; the server pays by finishing place (Config.RACE_REWARD) only when
-- the time is possible: no car can go round faster than its top speed (+20 %) the whole way, from the 3 s countdown on.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Circuits = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Circuits"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))

local RaceRewards = {}

-- length of each circuit's racing line (m)
local circuitLen = {}
for _, c in ipairs(Circuits) do
	local v, len, px, pz = {}, 0, nil, nil
	for n in string.gmatch(c.path, "-?%d+") do v[#v + 1] = tonumber(n) / 10 end
	for k = 1, #v, 3 do
		if px then len += math.sqrt((v[k] - px) ^ 2 + (v[k + 1] - pz) ^ 2) end
		px, pz = v[k], v[k + 1]
	end
	circuitLen[c.name] = len
end

function RaceRewards.start(plr, d, name)
	if type(name) ~= "string" or not circuitLen[name] then return false, "no such race" end
	d.race = { name = name, t0 = os.clock() }
	return true
end

function RaceRewards.cancel(plr, d)
	d.race = nil
	return true
end

function RaceRewards.finish(plr, d, place)
	local r = d.race
	d.race = nil
	if not r or type(place) ~= "number" then return false, "no race" end
	local t = Config.tuned(d.cur, PlayerData.levels(d, d.cur))
	if os.clock() - r.t0 < 3 + circuitLen[r.name] / (t.vm * 1.2) then return false, "Result not accepted" end
	local reward = Config.RACE_REWARD[math.clamp(math.floor(place), 1, #Config.RACE_REWARD)] or 0
	d.cash += reward
	PlayerData.commit(plr)
	return true, reward
end

return RaceRewards
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX84"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the remotes the players' devices use (ReplicatedStorage.Remotes):
--   BankDrift (event: drift points), CarAction (function: garage / shop / wheel / Robux prompts), ResetCar (event),
--   CarReady (event: the device has taken its car over), Mission (function: race and heist results), Fine (event: a traffic offence),
--   AddHour (event: the T key, +1 hour on the clock), SaveSettings (event: the player's settings, checked by Game/Settings),
--   Damage (function: vehicle damage records and paid repairs, Game/DamageStore).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local folder = Instance.new("Folder")
folder.Name = "Remotes"
local Remotes = {}
local function remote(cls, name)
	local r = Instance.new(cls)
	r.Name = name
	r.Parent = folder
	Remotes[name] = r
end
remote("RemoteEvent", "BankDrift")
remote("RemoteFunction", "CarAction")
remote("RemoteEvent", "ResetCar")
remote("RemoteEvent", "CarReady")
remote("RemoteFunction", "Mission")
remote("RemoteEvent", "Fine")
remote("RemoteEvent", "AddHour")
remote("RemoteEvent", "SaveSettings")
remote("RemoteFunction", "Damage")
remote("RemoteEvent", "SaveRep")
remote("RemoteEvent", "SaveSchool")
remote("RemoteEvent", "SaveFav")
folder.Parent = ReplicatedStorage

return Remotes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX85"><Properties><string name="Name">Sessions</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - players joining and leaving: load their progress, add the leaderboard, load the avatar once the map exists
-- (characters do not load by themselves: they would fall through the empty world while WorldBuilder runs), respawn after a death,
-- save on leaving, on shutdown and every 2 minutes.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local Spawner = require(script.Parent:WaitForChild("Spawner"))
local Purchases = require(script.Parent:WaitForChild("Purchases"))

Players.CharacterAutoLoads = false

local function setup(plr)
	local d = PlayerData.load(plr)
	d.vip = Purchases.vipOwned(plr)
	if d.vip then
		for i, c in ipairs(Config.CARS) do
			if c.vip then d.owned[i] = true end
		end
	end
	PlayerData.data[plr] = d
	local ls = Instance.new("Folder"); ls.Name = "leaderstats"; ls.Parent = plr
	local c = Instance.new("IntValue"); c.Name = "JD"; c.Parent = ls
	local dr = Instance.new("IntValue"); dr.Name = "Drift"; dr.Parent = ls
	PlayerData.sync(plr)
	plr.CharacterAdded:Connect(function(char)
		-- hats and clothes that load late stay hidden too (Spawner hides the avatar: the web game shows no driver)
		char.DescendantAdded:Connect(function(p)
			if p:IsA("BasePart") or p:IsA("Decal") then p.Transparency = 1 end
		end)
		local hum = char:WaitForChild("Humanoid")
		hum.Died:Connect(function()
			task.wait(2)
			if plr.Parent then plr:LoadCharacter() end
		end)
		task.wait(0.5)
		Spawner.spawn(plr, false)
	end)
	Spawner.waitForMap()
	if plr.Parent then plr:LoadCharacter() end
end

Players.PlayerAdded:Connect(setup)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(setup, p) end
Players.PlayerRemoving:Connect(function(plr)
	PlayerData.save(plr)
	local car = Workspace:FindFirstChild("Car_" .. plr.UserId)
	if car then car:Destroy() end
	PlayerData.data[plr] = nil
end)
game:BindToClose(function()
	for _, p in ipairs(Players:GetPlayers()) do PlayerData.save(p) end
end)
task.spawn(function()
	while true do
		task.wait(120)
		for _, p in ipairs(Players:GetPlayers()) do PlayerData.save(p) end
	end
end)

return {}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX86"><Properties><string name="Name">Settings</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - each player's settings (handling, gearbox, assists, damage, weather, clock, traffic, camera, sound, text size...):
-- the device sends them with the SaveSettings remote, the server checks every value against the shared schema
-- (ReplicatedStorage.Modules.SettingsSchema), keeps them with the progress (saved in the DataStore) and puts them in the player
-- attribute "Settings", which the device reads when it joins again.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Schema = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("SettingsSchema"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))

Remotes.SaveSettings.OnServerEvent:Connect(function(plr, s)
	local d = PlayerData.data[plr]
	if not d or type(s) ~= "string" then return end
	-- at most 4 changes a second are taken (a device cannot flood the DataStore record)
	local now = os.clock()
	if now - (d.setT or -1) < 0.25 then return end
	d.setT = now
	d.settings = Schema.encode(Schema.parse(s))
	plr:SetAttribute("Settings", d.settings)
end)

-- the road reputation and rival memory (Client/Reputation): "road;Name=r,w,l,h;..." checked by its pattern, at most every 0.5 s
Remotes.SaveRep.OnServerEvent:Connect(function(plr, s: any)
	local d = PlayerData.data[plr]
	if not d or type(s) ~= "string" or #s > 200 then return end
	if not string.match(s, "^%d+[;%a%d=,]*$") then return end
	local r = tonumber(string.match(s, "^(%d+)"))
	if not r or r > 100 then return end
	local now = os.clock()
	if now - (d.repT or -1) < 0.5 then return end
	d.repT = now
	d.rep = s
	plr:SetAttribute("Rep", s)
end)

-- the saved GPS places (Client/Search): at most 20 "name|x,z" separated by ";"
Remotes.SaveFav.OnServerEvent:Connect(function(plr, s: any)
	local d = PlayerData.data[plr]
	if not d or type(s) ~= "string" or #s > 2400 then return end
	local n = 0
	for _ in string.gmatch(s, "[^;]+") do n += 1 end
	if n > 20 then return end
	d.fav = s
	plr:SetAttribute("Fav", s)
end)

-- the driving school's best scores (Client/School): "runs=n;id=score;..." checked by its pattern
Remotes.SaveSchool.OnServerEvent:Connect(function(plr, s: any)
	local d = PlayerData.data[plr]
	if not d or type(s) ~= "string" or #s > 120 or not string.match(s, "^runs=%d+[;%a%d=]*$") then return end
	for _, v in string.gmatch(s, "(%a+)=(%d+)") do
		if tonumber(v) > 100000 then return end
	end
	d.school = s
	plr:SetAttribute("School", s)
end)

return {}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX87"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the CarAction remote: garage (buy / use), tuning shop (upgrade), car wheel (spin), Robux prompts.
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local Garage = require(script.Parent:WaitForChild("Garage"))
local Upgrades = require(script.Parent:WaitForChild("Upgrades"))
local Wheel = require(script.Parent:WaitForChild("Wheel"))
local Purchases = require(script.Parent:WaitForChild("Purchases"))

Remotes.CarAction.OnServerInvoke = function(plr, action, i)
	local d = PlayerData.data[plr]
	if not d then return false, "not ready" end
	if action == "use" or action == "buy" then
		return Garage.buyOrUse(plr, d, i)
	elseif action == "upgrade" then
		return Upgrades.buy(plr, d, i)
	elseif action == "spin" then
		return Wheel.spin(plr, d)
	end
	Purchases.prompt(plr, action)
	return true
end

return {}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX88"><Properties><string name="Name">Sites</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - is a player's car near a site (the bank, the tuning shop)? Uses the car's position as the server sees it.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Meta = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Meta"))

local Sites = { bank = Meta.bank, shop = Meta.shop }

-- site = {x, z} in metres; true when the car is within `metres`
function Sites.near(plr, site, metres)
	local car = Workspace:FindFirstChild("Car_" .. plr.UserId)
	if not (car and car.PrimaryPart) then return false end
	local p = car.PrimaryPart.Position / Config.SCALE
	return math.sqrt((p.X - site.x) ^ 2 + (p.Z - site.z) ^ 2) <= metres
end

return Sites
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX89"><Properties><string name="Name">Spawner</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - puts each player in their car: builds the current car, seats the driver, and hands the car to the player's
-- device once it says it has attached (CarReady). Also the ResetCar remote (at most every 3 s).
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Meta = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Meta"))
local Remotes = require(script.Parent:WaitForChild("Remotes"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local CarBuilder = require(script.Parent:WaitForChild("CarBuilder"))

local S = Config.SCALE
local Spawner = {}

-- wait for WorldBuilder, but never for ever (a failed map must not keep players out)
function Spawner.waitForMap()
	local waited = 0
	while not Workspace:GetAttribute("MapReady") and waited < 900 do
		waited += 0.5
		task.wait(0.5)
	end
end

-- builds the player's current car and seats them. keep = put it where the old car was (car change, reset), else at the start street
function Spawner.spawn(plr, keep)
	local char = plr.Character
	local d = PlayerData.data[plr]
	if not (char and d) then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) then return end
	Spawner.waitForMap()
	local spec = Config.CARS[d.cur]
	local pos, f
	local old = Workspace:FindFirstChild("Car_" .. plr.UserId)
	if old and keep and old.PrimaryPart then
		local cf = old.PrimaryPart.CFrame
		local lv = cf.LookVector
		f = Vector3.new(lv.X, 0, lv.Z)
		f = f.Magnitude > 0.01 and f.Unit or Vector3.new(0, 0, 1)
		pos = cf.Position + Vector3.new(0, 1.5 * S, 0)
	end
	if old then old:Destroy() end
	if not pos then
		-- each player starts a little apart along the start street
		local off = (#Players:GetPlayers() - 1) % 6
		local h = Meta.startHeading
		f = Vector3.new(math.sin(h), 0, math.cos(h))
		pos = Vector3.new(0, Meta.startY * S + spec.H * S * 0.6, 0) - f * off * 8 * S
	end
	-- the car's own paint, as in the web game (its PORS colour)
	local col = spec.col or 0x1f6fe0
	local car = CarBuilder.build(spec, Color3.fromRGB(math.floor(col / 65536) % 256, math.floor(col / 256) % 256, col % 256), d.cur)
	car.Name = "Car_" .. plr.UserId
	car:SetAttribute("Owner", plr.UserId)
	car:PivotTo(CFrame.lookAt(pos, pos + f))
	car.Parent = Workspace
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CollisionGroup = "Drive"
			p.CanQuery = false
		end
	end
	hum.UseJumpPower = true
	hum.JumpPower = 0
	root.CFrame = car.DriverSeat.CFrame + Vector3.new(0, 2, 0)
	car.DriverSeat:Sit(hum)
	-- the web game shows no driver (the avatar is taller than the cabin and stuck out through the roof)
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") or p:IsA("Decal") then p.Transparency = 1 end
	end
	plr:SetAttribute("CarReady", os.clock())
end

-- the device has attached to its car: let it go (unanchored, owned by that device, gravity cancelled by its Lift force)
Remotes.CarReady.OnServerEvent:Connect(function(plr, m)
	if typeof(m) ~= "Instance" or m.Name ~= "Car_" .. plr.UserId or m.Parent ~= Workspace then return end
	local body = m:FindFirstChild("Body")
	if not (body and body.Anchored) then return end
	body.Anchored = false
	local lift = body:FindFirstChild("Lift")
	if lift then lift.Force = Vector3.new(0, body.AssemblyMass * Workspace.Gravity, 0) end
	pcall(function() body:SetNetworkOwner(plr) end)
end)

Remotes.ResetCar.OnServerEvent:Connect(function(plr)
	local d = PlayerData.data[plr]
	if d and (not d.lastReset or os.clock() - d.lastReset > 3) then
		d.lastReset = os.clock()
		Spawner.spawn(plr, true)
	end
end)

return Spawner
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX90"><Properties><string name="Name">Upgrades</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - Apex Drift Customs (the web game's economy): Speed / Acceleration / Handling / Extra Drift Points,
-- price = base x 2^level, 5 levels, paid with banked drift points, only at the shop, saved per car.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local Sites = require(script.Parent:WaitForChild("Sites"))

local Upgrades = {}

-- -> ok, new level | reason
function Upgrades.buy(plr, d, i)
	local part = type(i) == "number" and Config.UPGRADES[i] and i
	if not part then return false, "no such part" end
	if not Sites.near(plr, Sites.shop, 40) then return false, "Drive to Apex Drift Customs first" end
	local l = PlayerData.levels(d, d.cur)
	if l[part] >= Config.UPGRADE_MAX then return false, "Already at the top level" end
	local price = Config.upgradePrice(part, l[part])
	if d.bank < price then return false, "Not enough drift points" end
	d.bank -= price
	l[part] += 1
	PlayerData.commit(plr)
	return true, l[part]
end

return Upgrades
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX91"><Properties><string name="Name">Weather</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the shared "Auto" weather (the web game's 12f_weather.js): SIMULATED, not live. The chance of a rainy day each
-- month is the Jordan Meteorological Department climate table for Irbid (1985-2018 precipitation days per month), read from the Asia/Amman
-- calendar (UTC+3 all year since late 2022). A new "day" every 8 blocks of 2 real minutes; a rainy day rains in ~45 % of its blocks, a dry
-- day is sometimes cloudy (estimates, as in the web game). The server rolls it once for everyone and publishes the target sky in Workspace
-- attributes (WxSt, WxTc cloud cover, WxTr rain, WxMon month 0-11); each device eases towards it (Client/Weather), or uses the
-- weather its player picked in the settings (Clear / Cloudy / Rain), exactly as the web game's setting does.
local Workspace = game:GetService("Workspace")

local Weather = {}
Weather.CLIM = { 11.3, 10.6, 9.4, 4.6, 2, 0.2, 0, 0, 0.2, 3.2, 6, 9.6 }
Weather.MD = { 31, 28.25, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 }

-- Irbid's local time (hours) and month (0-11)
function Weather.ammanNow()
	local d = os.date("!*t", os.time() + 3 * 3600)
	return d.hour + d.min / 60 + d.sec / 3600, d.month - 1
end

local WX = { blk = 0, day = false, st = "clear", tc = 0, tr = 0, mon = 0 }
Weather.state = WX

local function pick(st)
	WX.st = st
	WX.tc = st == "rain" and 0.95 or st == "cloudy" and 0.55 or 0.06 * math.random()
	WX.tr = st == "rain" and 0.55 + 0.45 * math.random() or 0
end

-- the web game's wxRoll
function Weather.roll()
	local _, mon = Weather.ammanNow()
	WX.mon = mon
	local p = Weather.CLIM[mon + 1] / Weather.MD[mon + 1]
	if WX.blk % 8 == 0 then WX.day = math.random() < p end
	WX.blk += 1
	if WX.day then
		pick(math.random() < 0.45 and "rain" or "cloudy")
	else
		pick(math.random() < math.min(0.45, p * 2 + 0.06) and "cloudy" or "clear")
	end
	Workspace:SetAttribute("WxSt", WX.st)
	Workspace:SetAttribute("WxTc", WX.tc)
	Workspace:SetAttribute("WxTr", WX.tr)
	Workspace:SetAttribute("WxMon", WX.mon)
end

task.spawn(function()
	while true do
		Weather.roll()
		task.wait(120)
	end
end)

return Weather
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX92"><Properties><string name="Name">Wheel</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the car wheel (the web game's): 10,000 cash a spin, tier by the odds 50 / 35 / 10 / 4 / 1 %, then one of
-- the web wheel's cars of that tier (not the VIP-pass car). A new car is equipped; a car already owned refunds 5,000.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Rules = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Rules"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local Spawner = require(script.Parent:WaitForChild("Spawner"))

local Wheel = {}

-- -> car index, tier (0-4)
function Wheel.roll()
	local r, a, tier = math.random(), 0, 0
	for i, p in ipairs(Config.WHEEL_ODDS) do
		a += p
		if r < a then
			tier = i - 1
			break
		end
	end
	for t = tier, 0, -1 do
		-- the web wheel's list for this tier (08a TIERS: that tier's traffic models + the older wheel cars), without the VIP-pass car
		local pool = {}
		for _, i in ipairs(Rules.wheelPools[t + 1]) do
			if not Config.CARS[i].vip then pool[#pool + 1] = i end
		end
		if #pool > 0 then
			return pool[math.random(#pool)], t
		end
	end
	return 1, 0
end

-- -> ok, {car, tier, dup} | reason
function Wheel.spin(plr, d)
	if d.cash < Config.WHEEL_COST then return false, "Not enough JD" end
	d.cash -= Config.WHEEL_COST
	local car, tier = Wheel.roll()
	local dup = d.owned[car] == true
	if dup then
		d.cash += Config.WHEEL_REFUND
	else
		d.owned[car] = true
		d.cur = car
	end
	PlayerData.commit(plr)
	if not dup then task.spawn(Spawner.spawn, plr, true) end
	return true, { car = car, tier = tier, dup = dup }
end

return Wheel
]]></ProtectedString></Properties></Item></Item><Item class="Script" referent="RBX94"><Properties><string name="Name">GameServer</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the server side of the game. Each job has its own module in Game/:
--   Remotes       the remotes the devices use            PlayerData   progress, saving, leaderboard, attributes
--   CarBuilder    the car model                          Spawner      seat players in their cars, hand cars to devices, reset
--   Sessions      join / leave / autosave                Drift        drift points -> drift bank + cash (capped)
--   Sites         "is the car near the bank / shop"      Garage, Upgrades, Wheel, Shop   buying cars and parts, the car wheel
--   RaceRewards, HeistRewards, Missions   paying for races and the heist (checked)
--   Purchases     Robux (VIP pass, cash packs)           DayNight     clock and headlights     Fines   traffic fines (+JD)
--   Settings      the player's settings (checked, saved with the progress)   Weather   the shared Auto weather (Irbid climate table)
--   DamageStore   vehicle damage per car (only gets worse from a device) and the paid repairs at Apex Drift Customs
-- Each player's device runs the driving, traffic, races and the heist (StarterPlayerScripts) and asks the server for every change
-- of money, which the server checks before it pays.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Meta = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Meta"))
local Game = script.Parent:WaitForChild("Game")

Workspace:SetAttribute("StartHeading", Meta.startHeading)
Workspace:SetAttribute("StartY", Meta.startY)
Workspace:SetAttribute("Attribution", Meta.attribution)

for _, name in ipairs({ "Remotes", "PlayerData", "CarBuilder", "Purchases", "Spawner", "Drift", "Fines", "Settings", "Shop", "Missions", "DayNight", "Weather", "DamageStore", "Sessions" }) do
	require(Game:WaitForChild(name))
end
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX105"><Properties><string name="Name">World</string></Properties><Item class="ModuleScript" referent="RBX95"><Properties><string name="Name">Buildings</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - buildings: OpenStreetMap footprint pieces (rectangles), estimated heights where OSM has none.
-- Data per piece: x, z, width, depth, angle (milliradians), height, lowest ground height, colour type.
local MapData = require(script.Parent:WaitForChild("MapData"))

local BC = {
	[0] = Color3.fromRGB(214, 200, 176), [1] = Color3.fromRGB(226, 214, 190), [2] = Color3.fromRGB(205, 192, 170),
	[3] = Color3.fromRGB(190, 186, 176), [4] = Color3.fromRGB(170, 166, 160), [5] = Color3.fromRGB(236, 230, 214),
	[6] = Color3.fromRGB(180, 196, 205), [7] = Color3.fromRGB(160, 150, 136),
}

return function(map)
	local S, D = MapData.S, MapData.D
	local bldF = map:WaitForChild("Buildings")
	local n = 0
	for _, b in ipairs(MapData.chunks("Buildings")) do
		for i = 1, #b, 8 do
			local w, d, h = b[i + 2] * D, b[i + 3] * D, b[i + 5] * D + 1 * S
			local p = Instance.new("Part")
			p.Anchored = true
			p.CanTouch = false
			p.Material = Enum.Material.Concrete
			p.Color = BC[b[i + 7]] or BC[0]
			p.Size = Vector3.new(w, h, d)
			p.CFrame = CFrame.new(b[i] * D, b[i + 6] * D - 1 * S + h / 2, b[i + 1] * D) * CFrame.Angles(0, b[i + 4] / 1000, 0)
			p.Name = "Building"
			p.Parent = bldF
			n += 1
			if n % 1500 == 0 then task.wait() end
		end
	end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX96"><Properties><string name="Name">Furniture</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - road furniture from the web game, at its positions:
--   traffic signal heads: a 4 m pole at the near-side kerb 9 m before the junction, a black 3-lamp housing facing the drivers, and a
--   white stop line 10 m back (lamps are recoloured by each device: Client/Signals); speed bumps (yellow / black, 75 mm; most are
--   ESTIMATED positions, as in the web game); the three stunt ramps; the drift zone (a marked circle).
-- Positions are in metres in the flat frame; heights come from the exported terrain heights.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Rules = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Rules"))
local MapData = require(script.Parent:WaitForChild("MapData"))
local Signs = require(script.Parent:WaitForChild("Signs"))

local Furniture = {}
local S = MapData.S

local function part(parent, name, size, cf, color, mat, collide)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = collide == true
	p.CanQuery = false
	p.CanTouch = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.Parent = parent
	return p
end

function Furniture.signals(map)
	local f = Instance.new("Folder")
	f.Name = "Signals"
	for _, h in ipairs(Rules.heads) do
		local m = Instance.new("Model")
		m.Name = "Head"
		m:SetAttribute("a", h.a)
		m:SetAttribute("o", h.o)
		local base = CFrame.new(h.x * S, h.y * S, h.z * S) * CFrame.Angles(0, h.f, 0)
		part(m, "Pole", Vector3.new(0.16, 4, 0.16) * S, base * CFrame.new(0, 2 * S, 0), Color3.fromRGB(90, 95, 99))
		part(m, "Housing", Vector3.new(0.36, 1.05, 0.26) * S, base * CFrame.new(0, 3.35 * S, 0), Color3.fromRGB(20, 21, 22))
		-- lamps on the side that faces the approaching drivers (the head faces along h.f), red on top
		for k, c in ipairs({ "r", "y", "g" }) do
			local lamp = part(m, "Lamp_" .. c, Vector3.new(0.26, 0.26, 0.05) * S, base * CFrame.new(0, (3.69 - (k - 1) * 0.33) * S, 0.14 * S), Color3.fromRGB(30, 30, 30), Enum.Material.Neon)
			lamp.Shape = Enum.PartType.Block
		end
		-- stop line across the approach (half the carriageway)
		part(m, "StopLine", Vector3.new(h.w, 0.04, 0.6) * S, CFrame.new(h.lx * S, (h.y + 0.13) * S, h.lz * S) * CFrame.Angles(0, h.f, 0), Color3.fromRGB(242, 242, 242))
		m.Parent = f
	end
	f.Parent = map
end

function Furniture.bumps(map)
	local f = Instance.new("Folder")
	f.Name = "SpeedBumps"
	for _, b in ipairs(Rules.bumps) do
		-- a low strip across the road, striped yellow / black; the cars feel the real profile (Client/Ground.bumpAt)
		local ang = math.atan2(b.tx, b.tz)
		local n = math.max(6, math.floor(b.w / 0.6 + 0.5))
		for j = 0, n - 1 do
			local lat = -b.w / 2 + b.w * (j + 0.5) / n
			local cx, cz = b.x + b.tz * lat, b.z - b.tx * lat
			part(f, "Bump", Vector3.new(b.w / n, b.h, b.l * 0.7) * S, CFrame.new(cx * S, (b.y + 0.12 + b.h / 2) * S, cz * S) * CFrame.Angles(0, ang, 0),
				j % 2 == 0 and Color3.fromRGB(184, 153, 36) or Color3.fromRGB(23, 23, 26))
		end
	end
	f.Parent = map
end

function Furniture.ramps(map)
	local f = Instance.new("Folder")
	f.Name = "Ramps"
	for _, r in ipairs(Rules.ramps) do
		-- a wedge rising along +z (WedgePart: high at the back, +Z)
		local w = Instance.new("WedgePart")
		w.Name = "Ramp"
		w.Anchored = true
		w.CanQuery = false
		w.CanTouch = false
		w.Color = Color3.fromRGB(230, 120, 30)
		w.Material = Enum.Material.DiamondPlate
		w.Size = Vector3.new(r.w, r.h, r.l) * S
		w.CFrame = CFrame.new(r.x * S, (r.y + 0.12 + r.h / 2) * S, r.z * S)
		w.Parent = f
	end
	if #Rules.ramps > 0 then
		local r = Rules.ramps[1]
		Signs.sign(f, Vector3.new(r.x * S, (r.y + 14) * S, (r.z - 40) * S), "🚀 STUNT RAMPS · J", Color3.fromRGB(255, 150, 40), 1500, 320)
	end
	f.Parent = map
end

function Furniture.driftZones(map)
	local f = Instance.new("Folder")
	f.Name = "DriftZones"
	for _, q in ipairs(Rules.dzones) do
		local ring = part(f, "Zone", Vector3.new(0.05 * S, q.r * 2 * S, q.r * 2 * S), CFrame.new(q.x * S, (q.y + 0.15) * S, q.z * S) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(255, 80, 200), Enum.Material.Neon)
		ring.Shape = Enum.PartType.Cylinder
		ring.Transparency = 0.85
		Signs.sign(f, Vector3.new(q.x * S, (q.y + 20) * S, q.z * S), "🏁 " .. q.n .. " · no limits, no fines", Color3.fromRGB(255, 120, 220), 1500, 360)
	end
	f.Parent = map
end

return Furniture
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX97"><Properties><string name="Name">Landmarks</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the web game's hand-built landmarks (06b / 06c / 06g2 / 06i: the Al-Balad sites, the clock square, the heritage
-- houses on their OSM footprints, arches, gantries ...), exported mesh by mesh with their real positions, rotations, sizes and colours
-- (tools/make_roblox.js). Boxes stay boxes; cylinders, spheres (ellipsoids) and discs are Roblox cylinders / sphere meshes; cones are
-- thinner cylinders (Roblox has no cone without an uploaded mesh); extruded shapes and planes are their bounding boxes. The web game's
-- textures (canvas-drawn detail) are not reproduced. They are scenery: cars pass through them, as before (the web game's landmark colliders
-- are not ported yet).
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))

local function hex(c)
	return Color3.fromRGB(math.floor(c / 65536) % 256, math.floor(c / 256) % 256, c % 256)
end
local CYL = CFrame.Angles(0, 0, math.pi / 2) -- three.js cylinders stand on Y, Roblox's lie on X
local DISC = CFrame.Angles(0, -math.pi / 2, 0) -- a three.js circle faces +Z

return function(map)
	local S = Config.SCALE
	local data = ServerStorage:WaitForChild("IrbidData"):FindFirstChild("Landmarks")
	if not data then return end
	local f = Instance.new("Folder")
	f.Name = "Landmarks"
	f.Parent = map
	for i, row in ipairs(require(data)) do
		local v = string.split(row, ",")
		local shape = v[1]
		local n = {}
		for k = 2, #v do n[k - 1] = tonumber(v[k]) end
		local pos = Vector3.new(n[1], n[2], n[3]) * S
		local sx, sy, sz = math.abs(n[4]) * S, math.abs(n[5]) * S, math.abs(n[6]) * S
		local cf = CFrame.fromMatrix(pos, Vector3.new(n[7], n[8], n[9]), Vector3.new(n[10], n[11], n[12]), Vector3.new(n[13], n[14], n[15]))
		local p = Instance.new("Part")
		p.Name = "Landmark"
		p.Anchored = true
		p.CanCollide, p.CanTouch, p.CanQuery = false, false, false
		p.Material = n[18] == 1 and Enum.Material.Neon or Enum.Material.SmoothPlastic
		p.Color = hex(n[16])
		p.Transparency = n[17] / 100
		if shape == "cyl" or shape == "cone" then
			local k = shape == "cone" and 0.55 or 1
			p.Shape = Enum.PartType.Cylinder
			p.Size = Vector3.new(math.max(0.05, sy), math.max(0.05, sx * k), math.max(0.05, sz * k))
			p.CFrame = cf * CYL
		elseif shape == "disc" then
			p.Shape = Enum.PartType.Cylinder
			p.Size = Vector3.new(0.05, math.max(0.05, sx), math.max(0.05, sy))
			p.CFrame = cf * DISC
		else
			p.Size = Vector3.new(math.max(0.05, sx), math.max(0.05, sy), math.max(0.05, sz))
			p.CFrame = cf
			if shape == "ball" then
				local m = Instance.new("SpecialMesh")
				m.MeshType = Enum.MeshType.Sphere
				m.Parent = p
			end
		end
		p.Parent = f
		if i % 400 == 0 then task.wait() end
	end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX98"><Properties><string name="Name">MapData</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - reads the generated map data in ServerStorage.IrbidData (tools/make_roblox.js: OpenStreetMap roads and
-- buildings, NASA SRTM terrain). The data are whole numbers in decimetres, centred on the web game's start point.
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))

local MapData = {}
local DATA = ServerStorage:WaitForChild("IrbidData")
MapData.S = Config.SCALE -- studs per metre
MapData.D = Config.SCALE / 10 -- decimetres -> studs

local function nums(s)
	local t = {}
	for n in string.gmatch(s, "-?%d+") do
		t[#t + 1] = tonumber(n)
	end
	return t
end

-- every module <prefix>1, <prefix>2, ... as lists of numbers
function MapData.chunks(prefix)
	local list, i = {}, 1
	while DATA:FindFirstChild(prefix .. i) do
		list[#list + 1] = nums(require(DATA[prefix .. i]))
		i += 1
	end
	return list
end

return MapData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX99"><Properties><string name="Name">Roads</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - roads: one part per OpenStreetMap segment, at the web game's road widths, sloped between the two terrain
-- heights, overlapping at the joints. Data per segment: x1, z1, x2, z2, y1, y2, width, class (0 major, 1 local, 2 service, 3 roundabout).
local MapData = require(script.Parent:WaitForChild("MapData"))

local ROADC = {
	[0] = Color3.fromRGB(58, 60, 64), -- major
	[1] = Color3.fromRGB(70, 72, 76), -- local
	[2] = Color3.fromRGB(96, 92, 86), -- service / alley
	[3] = Color3.fromRGB(58, 60, 64), -- roundabout
}

return function(map)
	local S, D = MapData.S, MapData.D
	local roadsF = map:WaitForChild("Roads")
	local n = 0
	for _, r in ipairs(MapData.chunks("Roads")) do
		for i = 1, #r, 8 do
			local a = Vector3.new(r[i] * D, r[i + 4] * D + 0.1 * S, r[i + 1] * D)
			local b = Vector3.new(r[i + 2] * D, r[i + 5] * D + 0.1 * S, r[i + 3] * D)
			local w = r[i + 6] * D
			local len = (b - a).Magnitude
			local p = Instance.new("Part")
			p.Anchored = true
			p.CanTouch = false
			p.TopSurface = Enum.SurfaceType.Smooth
			p.Material = Enum.Material.Asphalt
			p.Color = ROADC[r[i + 7]] or ROADC[1]
			p.Size = Vector3.new(w, 1.2 * S, len + w * 0.5)
			-- part centre sits 0.6 m below the road surface (thick slab, so it meets the ground)
			p.CFrame = CFrame.lookAt((a + b) / 2, b) * CFrame.new(0, -0.6 * S, 0)
			p.Name = "Road"
			p.Parent = roadsF
			n += 1
			if n % 1500 == 0 then task.wait() end
		end
	end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX100"><Properties><string name="Name">Signs</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - floating name signs, and the landmark labels (real OSM places near the start).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Meta = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Meta"))
local MapData = require(script.Parent:WaitForChild("MapData"))

local Signs = {}

-- an invisible anchor part with a BillboardGui (studs position)
function Signs.sign(parent, pos, text, color, maxDist, w)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.Position = pos
	p.Name = "Label"
	local g = Instance.new("BillboardGui")
	g.Size = UDim2.fromOffset(w or 260, 40)
	g.MaxDistance = maxDist or 700
	g.AlwaysOnTop = false
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.TextScaled = true
	t.Font = Enum.Font.GothamBold
	t.TextColor3 = color or Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.3
	t.Text = text
	t.Parent = g
	g.Parent = p
	p.Parent = parent
	return p
end

-- landmark names, 18 m above the ground
function Signs.labels(map)
	local S = MapData.S
	for _, L in ipairs(Meta.labels) do
		Signs.sign(map, Vector3.new(L.x * S, L.y * S + 18 * S, L.z * S), L.n)
	end
end

return Signs
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX101"><Properties><string name="Name">Sites</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the game sites at the web game's positions: the bank (red), Apex Drift Customs (orange), the race starts
-- (cyan). Glowing pads with a sign; no collision, ignored by ray tests.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("IrbidShared")
local Meta = require(Shared:WaitForChild("Meta"))
local Circuits = require(Shared:WaitForChild("Circuits"))
local MapData = require(script.Parent:WaitForChild("MapData"))
local Signs = require(script.Parent:WaitForChild("Signs"))

return function(map)
	local S = MapData.S
	local siteF = map:WaitForChild("Sites")
	local function pad(name, x, y, z, radius, color, text, lift)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Shape = Enum.PartType.Cylinder
		p.Material = Enum.Material.Neon
		p.Color = color
		p.Transparency = 0.45
		p.Size = Vector3.new(0.3 * S, radius * 2 * S, radius * 2 * S)
		p.CFrame = CFrame.new(x * S, (y + 0.25) * S, z * S) * CFrame.Angles(0, 0, math.pi / 2)
		p.Parent = siteF
		Signs.sign(siteF, Vector3.new(x * S, (y + (lift or 9)) * S, z * S), text, color, 1500, 320)
		return p
	end
	pad("BankPad", Meta.bank.x, Meta.bank.y, Meta.bank.z, 7, Color3.fromRGB(255, 60, 60), "🏦 BANK · press E")
	pad("ShopPad", Meta.shop.x, Meta.shop.y, Meta.shop.z, 7, Color3.fromRGB(255, 122, 0), "🔧 APEX DRIFT CUSTOMS · press U")
	for _, c in ipairs(Circuits) do
		local x, z, y = string.match(c.path, "^(-?%d+),(-?%d+),(-?%d+)")
		pad("RacePad", tonumber(x) / 10, tonumber(y) / 10, tonumber(z) / 10, 5, Color3.fromRGB(51, 224, 255), "🏁 " .. c.name .. " · press R", 15)
	end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX102"><Properties><string name="Name">Sky</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - light and haze (a dry, dusty afternoon look) and gravity in studs.
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

return function()
	Lighting.ClockTime = 9
	Lighting.Brightness = 2.5
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 140, 125)
	local atm = Instance.new("Atmosphere")
	atm.Density = 0.28
	atm.Haze = 1.2
	atm.Color = Color3.fromRGB(214, 200, 176)
	atm.Decay = Color3.fromRGB(120, 110, 95)
	atm.Parent = Lighting
	-- Roblox's default gravity; the cars run their own physics in metres (Client/Drive), so this only affects avatars
	Workspace.Gravity = 196.2
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX103"><Properties><string name="Name">Spawn</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the spawn point at the web game's start (Baghdad Street, Al-Balad). Invisible; the server seats every
-- player in their car anyway.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Meta = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Meta"))
local MapData = require(script.Parent:WaitForChild("MapData"))

return function(map)
	local sp = Instance.new("SpawnLocation")
	sp.Anchored = true
	sp.Size = Vector3.new(6, 1, 6)
	sp.Transparency = 1
	sp.CanCollide = false
	sp.CanQuery = false
	sp.Position = Vector3.new(0, Meta.startY * MapData.S + 6, 0)
	sp.Parent = map
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX104"><Properties><string name="Name">Terrain</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the ground: the web game's terrain height grid (SRTM, 25 m cells, the same grid the cars drive on), one block
-- per cell, tilted to the cell's slope and kept just under the road surface everywhere in the cell (flat tiles buried the roads on
-- slopes). Always parts (folder IrbidMap.Ground): Roblox voxel terrain rounds its surface to 4-stud voxels, which covered the roads in Studio.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("IrbidShared")
local Meta = require(Shared:WaitForChild("Meta"))
local MapData = require(script.Parent:WaitForChild("MapData"))

-- top of the ground under the web game's terrain height (the roads are drawn 0.1 m over it, the car drives 0.12 m over it)
local DROP = 0.3

return function(map)
	local S = MapData.S
	local HG = require(Shared:WaitForChild("Heights"))
	local H = {}
	local i = 1
	while Shared:FindFirstChild("HeightData" .. i) do
		for n in string.gmatch(require(Shared["HeightData" .. i]), "-?%d+") do H[#H + 1] = tonumber(n) / 10 end
		i += 1
	end
	local N, C, X0, Z0 = HG.n, HG.cell, HG.x0, HG.z0
	local R = Meta.radius + 100
	local groundF = map:WaitForChild("Ground")
	local k = 0
	for j = 0, N - 2 do
		for ii = 0, N - 2 do
			local xc, zc = X0 + (ii + 0.5) * C, Z0 + (j + 0.5) * C
			if xc * xc + zc * zc <= R * R then
				local a, b = H[j * N + ii + 1], H[j * N + ii + 2]
				local c, d = H[(j + 1) * N + ii + 1], H[(j + 1) * N + ii + 2]
				-- the plane through the cell's mean height and mean slopes; the bilinear surface leaves it by at most |a-b-c+d|/4
				local m = (a + b + c + d) / 4
				local sx, sz = ((b + d) - (a + c)) / (2 * C), ((c + d) - (a + b)) / (2 * C)
				local top = m - DROP - math.abs(a - b - c + d) / 4
				local th = math.max(a, b, c, d) - math.min(a, b, c, d) + 4
				local up = Vector3.new(-sx, 1, -sz).Unit
				local rx = Vector3.new(1, sx, 0).Unit
				local rz = rx:Cross(up)
				local pos = Vector3.new(xc, top, zc) * S - up * (th * S / 2)
				-- a little larger than the cell, so the tilted blocks overlap at the seams
				local cf = CFrame.fromMatrix(pos, rx, up, rz)
				local size = Vector3.new((C + 1.5) * S * math.sqrt(1 + sx * sx), th * S, (C + 1.5) * S * math.sqrt(1 + sz * sz))
				do
					local p = Instance.new("Part")
					p.Anchored = true
					p.CanTouch = false
					p.Material = Enum.Material.Ground
					p.Color = Color3.fromRGB(150, 128, 96)
					p.TopSurface = Enum.SurfaceType.Smooth
					p.CastShadow = false
					p.Size = size
					p.CFrame = cf
					p.Name = "Ground"
					p.Parent = groundF
					k += 1
					-- yield now and then: one long run would hit Roblox's script time limit
					if k % 1500 == 0 then task.wait() end
				end
			end
		end
	end
end
]]></ProtectedString></Properties></Item></Item><Item class="Script" referent="RBX106"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - builds the map when the server starts, from the real data (tools/make_roblox.js: OpenStreetMap roads +
-- buildings, NASA SRTM terrain; the same data as the web game). Each part of the map has its own module in World/.
-- Every stage runs protected: if one fails (reported in Output), the rest is still built and players still spawn.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Meta = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Meta"))
local World = script.Parent:WaitForChild("World")

local function stage(name, f, ...)
	local ok, err = pcall(f, ...)
	if not ok then warn("Irbid Drive: building the " .. name .. " failed: " .. tostring(err)) end
end

stage("sky", require(World:WaitForChild("Sky")))

local map = Instance.new("Folder")
map.Name = "IrbidMap"
for _, name in ipairs({ "Roads", "Buildings", "Sites", "Ground" }) do
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = map
end

stage("terrain", require(World:WaitForChild("Terrain")), map)
stage("roads", require(World:WaitForChild("Roads")), map)
stage("buildings", require(World:WaitForChild("Buildings")), map)
stage("landmarks", require(World:WaitForChild("Landmarks")), map)
stage("labels", require(World:WaitForChild("Signs")).labels, map)
stage("sites", require(World:WaitForChild("Sites")), map)
stage("spawn point", require(World:WaitForChild("Spawn")), map)
local Furniture = require(World:WaitForChild("Furniture"))
stage("traffic lights", Furniture.signals, map)
stage("speed bumps", Furniture.bumps, map)
stage("stunt ramps", Furniture.ramps, map)
stage("drift zones", Furniture.driftZones, map)

map.Parent = Workspace
-- the "press Play" sign that is only meant for Studio's edit view
local hint = Workspace:FindFirstChild("EditModeSign")
if hint then hint:Destroy() end
Workspace:SetAttribute("MapReady", true)
print(("Irbid Drive map built: %d roads, %d buildings, %d labels"):format(Meta.roadCount, Meta.buildingCount, #Meta.labels))
]]></ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX157"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX156"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX154"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX108"><Properties><string name="Name">Accessibility</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - accessibility (the web game's 12e A11Y): text size 90 / 100 / 120 / 140 % for the whole HUD and the menus
-- (setting "ts"), reduced motion (setting "rm": no speed zoom of the camera, read by Camera).
local Client = script.Parent
local Hud = require(Client:WaitForChild("Hud"))
local Settings = require(Client:WaitForChild("Settings"))

local Accessibility = {}
local SIZES = { 0.9, 1, 1.2, 1.4 }
local scale = Instance.new("UIScale")
scale.Name = "TextSize"
scale.Parent = Hud.gui
Accessibility.scale = scale
Settings.provide("ts", "rm")
Settings.onChange(function(k, v)
	if k == "ts" then scale.Scale = SIZES[v + 1] or 1 end
end)

return Accessibility
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX109"><Properties><string name="Name">AutoDrive</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - auto-drive (key Z; the web game's 11c apInput): follows the GPS route through the SAME car physics as the player
-- (it only supplies steering / throttle / brake, like a wheel), keeps right of the centre line, obeys the speed limit of each street and the
-- red lights, slows for curves and for cars ahead, and stops at the destination. Any steering, throttle, brake or handbrake input hands
-- control back; never teleports; gives up when blocked for 6 s. A simple rule-based driver, not a self-driving system.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Road = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Road"))
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("Hud"))
local Gps = require(Client:WaitForChild("Gps"))
local Signals = require(Client:WaitForChild("Signals"))
local Laws = require(Client:WaitForChild("Laws"))

local AutoDrive = {}
local AP = { on = false, stop = 0, stuck = 0, vt = 0, why = "" }
AutoDrive.state = AP
local st, spec = State.st, State.spec
local CP, legs, total, j, builtFor = nil, nil, 0, 1, nil

local function clamp(v, a, b)
	return v < a and a or v > b and b or v
end

-- the route's centre line and its legs (start / end distance, edge, the node at its end)
local function build(nav)
	CP = Road.path(nav.trs, nil)
	legs = {}
	local s0 = 0
	for ti, tr in ipairs(nav.trs) do
		local s1 = CP.ends[ti]
		legs[ti] = { s0 = s0, s1 = s1, e = tr.e, node = tr.d > 0 and tr.e.b or tr.e.a }
		s0 = s1
	end
	total = CP.c[#CP.c]
	local _, _, i = Road.project(CP, st.x, st.z, 1, #CP.x)
	j = i
	builtFor = nav.P
end

local function off(msg)
	AP.on, AP.stop = false, 0
	Hud.ap.Text = ""
	if msg then Hud.toast(msg) end
end
AutoDrive.off = off

function AutoDrive.toggle()
	if AP.on then
		off("Auto-drive off")
		return
	end
	local nav = Gps.route()
	if not (nav and nav.trs) then
		Hud.toast("Auto-drive follows a route: press M and choose a destination first")
		return
	end
	if State.mission == "race" or State.mission == "duel" then
		Hud.toast("Auto-drive is not available during races")
		return
	end
	if State.mission == "heist" then
		Hud.toast("Auto-drive is not available during a heist")
		return
	end
	AP.on, AP.stop, AP.stuck = true, 0, 0
	builtFor = nil
	Hud.toast("🤖 Auto-drive on (Z): following the route · steer, gas or brake to take over")
end

-- every frame after the controls: user = the player gave any input this frame (keys, pads, a gamepad above 0.15)
function AutoDrive.apply(inp, user, dt)
	if not AP.on then return end
	if user then
		off("Auto-drive off: you took control")
		return
	end
	local nav = Gps.route()
	local fx, fz = math.sin(st.h), math.cos(st.h)
	local u = st.vx * fx + st.vz * fz
	inp.hb, inp.an = false, true
	if not nav or AP.stop ~= 0 then
		AP.stop = 1
		inp.steer, inp.th, inp.br = 0, 0, 1
		if math.abs(u) < 0.4 then off(nav and "Auto-drive off" or "🏁 Auto-drive: arrived") end
		return
	end
	if State.mission == "race" or State.mission == "duel" or State.mission == "heist" then
		off("Auto-drive off")
		return
	end
	if builtFor ~= nav.P then build(nav) end
	-- progress: the car's projection on the route (near the last segment)
	local s, _, jj = Road.project(CP, st.x, st.z, math.max(1, j - 2), math.min(#CP.x, j + 3))
	j = jj
	local ri = State.ri
	local rd = (ri and ri.e and ri.d <= ri.e.w / 2 + 4) and ri.e or nil
	local lane = rd and (rd.ow and rd.w * 0.18 or math.min(2.6, rd.w * 0.25)) or 1.6
	-- steering: pure pursuit on a point Ld ahead, shifted to the right-hand lane
	local Ld = 7 + 0.45 * math.max(0, u)
	local qx, qz, _, qtx, qtz = Road.sample(CP, clamp(s + Ld, 0, total), j)
	local tx, tz = qx - qtz * lane - st.x, qz + qtx * lane - st.z
	local rx, rz = -fz, fx
	local lat, fw = tx * rx + tz * rz, tx * fx + tz * fz
	local d2 = math.max(9, lat * lat + fw * fw)
	local kap = 2 * lat / d2
	local real = State.phys and State.phys.mode == 1
	local sv
	if real then
		local beta = math.abs(math.atan2(st.vx * rx + st.vz * rz, math.abs(u) + 0.5))
		local dm = 0.6 / (1 + math.max(0, u) / (12 + 45 * math.min(1, beta * 2.5)))
		sv = -math.atan(kap * spec.pt.wb * 1.15) / dm
	elseif u > 0.5 then
		sv = -kap * u * (1 + u / 18) / (1.8 * spec.hd * clamp(u / 4, -1, 1))
	else
		sv = -math.sign(kap) * math.min(1, math.abs(kap) * 20)
	end
	inp.steer = clamp(sv, -1, 1)
	-- target speed: the limit, the legs ahead, a big heading error, curvature, red / amber lights, cars ahead, the destination
	local mu = real and State.phys.wx.mu or 1
	local he = math.abs(math.atan2(lat, fw))
	local vt, why = math.min(Laws.limit or 50, 90) / 3.6 * 0.95, "limit"
	for _, L in ipairs(legs) do
		if L.s1 >= s then
			if L.s0 > s + 90 then break end
			local vl = math.min(L.e.lim or 50, 90) / 3.6 * 0.95
			local dd = math.max(0, L.s0 - s - 4)
			if L.s0 <= s then vt = vl else vt = math.min(vt, math.sqrt(vl * vl + 2 * 2.5 * dd)) end
		end
	end
	if he > 0.3 then
		local vh = math.max(3, 14 * (1 - (he - 0.3) / 1.2))
		if vh < vt then vt, why = vh, "turning" end
	end
	local _, _, _, px, pz = Road.sample(CP, clamp(s, 0, total), j)
	for d = 10, 110, 10 do
		local _, _, _, dx, dz = Road.sample(CP, clamp(s + d, 0, total), j)
		local cr, dp = px * dz - pz * dx, px * dx + pz * dz
		local k2 = math.abs(math.atan2(cr, dp)) / 10
		px, pz = dx, dz
		if k2 > 0.004 then
			local vc = math.sqrt(3 * mu / k2)
			local va = math.sqrt(vc * vc + 2 * 3 * mu * math.max(0, d - 10))
			if va < vt then vt, why = va, "curve" end
		end
	end
	-- red / amber: stop 13.5 m before the junction node; once inside at speed, carry on
	for _, L in ipairs(legs) do
		local de = L.s1 - s
		if de >= -2 then
			if de > 95 then break end
			local nd = State.road.nodes[L.node]
			if nd and nd.lit then
				local lt = Signals.at(nd, L.e)
				local dd = de - 13.5
				if (dd > -2 or (dd > -8 and u < 3)) and (lt == "r" or (lt == "y" and dd > u * 1.1)) then
					local vr = math.sqrt(2 * 3 * math.max(0, dd))
					if vr < vt then vt, why = vr, "red light" end
				end
				break
			end
		end
	end
	for _, o in ipairs(State.ai) do
		local dx, dz = o.x - st.x, o.z - st.z
		local f = dx * fx + dz * fz
		if f > 0 and f < 40 and math.abs(dx * rx + dz * rz) < 2.4 then
			local vo = math.max(0, (f - 8) * 0.8)
			if vo < vt then vt, why = vo, "car ahead" end
		end
	end
	local ve = math.sqrt(2 * 2.5 * math.max(0, total - s - 6))
	if ve < vt then vt, why = ve, "arriving" end
	AP.vt, AP.why = vt, why
	local e = vt - u
	inp.th = e > 0 and clamp(e * 0.45, 0, 1) or 0
	-- hold the brake while waiting (no creeping over the stop line)
	inp.br = (vt < 0.3 and u < 2) and 1 or e < -0.8 and clamp(-e * 0.3, 0, 1) or 0
	AP.stuck = (vt > 3 and u < 0.5) and AP.stuck + dt or 0
	if AP.stuck > 6 then
		off("Auto-drive stopped: the way is blocked")
		return
	end
	Hud.ap.Text = "🤖 AUTO · " .. math.floor(vt * 3.6 + 0.5) .. " km/h target · " .. why
end

return AutoDrive
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX110"><Properties><string name="Name">Bump</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - car-to-car contact, the web game's rules (10_laws_player.js): every car is a 3.4 m circle.
--   traffic: the player is pushed out (60 %), bounces off (restitution 0.3), loses 20 % of its speed; the traffic car stops for 1.5 s;
--            "Collision with traffic" costs 30 JD
--   race rivals, duel rival, police (and, in Roblox, other players' cars): the player is pushed out (50 %) and slowed (2 / s)
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Ground = require(Client:WaitForChild("Ground"))

local Bump = {}
local S = Config.SCALE
local st = State.st
local Laws -- (required lazily: Laws needs Ground, Signals; no cycle at load)
-- Bump.onImpact(v, car): a contact closing faster than 1.8 m/s along the contact normal (the web game's registerPlayerImpact: sound, damage)
Bump.onImpact = nil

-- the closing speed along n with the other car moving at c.v along its heading
local function closing(c, nx, nz)
	local rvx = st.vx - math.sin(c.h or 0) * (c.v or 0)
	local rvz = st.vz - math.cos(c.h or 0) * (c.v or 0)
	return rvx * nx + rvz * nz
end

-- other players' car bodies (the list is refreshed twice a second, their positions every frame)
local function others()
	local list = {}
	for _, m in ipairs(Workspace:GetChildren()) do
		if m:IsA("Model") and string.sub(m.Name, 1, 4) == "Car_" and m ~= State.car and m.PrimaryPart then
			list[#list + 1] = m.PrimaryPart
		end
	end
	return list
end
local otherCars, otherT = {}, 0

function Bump.step(dt)
	Laws = Laws or require(Client:WaitForChild("Laws"))
	for _, c in ipairs(State.ai) do
		local dx, dz = st.x - c.x, st.z - c.z
		local d = math.sqrt(dx * dx + dz * dz)
		if d < 3.4 then
			local nx, nz = dx / math.max(d, 1e-6), dz / math.max(d, 1e-6)
			if c.kind == "traffic" then
				if st.y < Ground.TH(st.x, st.z) + 2 then
					st.x += nx * (3.4 - d) * 0.6
					st.z += nz * (3.4 - d) * 0.6
					local rvn = closing(c, nx, nz)
					if rvn < -1.8 and Bump.onImpact then Bump.onImpact(-rvn, c, nx, nz) end
					local vn = st.vx * nx + st.vz * nz
					if vn < 0 then
						st.vx -= vn * nx * 1.3
						st.vz -= vn * nz * 1.3
					end
					st.vx *= 0.8
					st.vz *= 0.8
					c.hit = 1.5
					c.v = 0
					Laws.fine("hit", "Collision with traffic", 2)
				end
			else
				local rvn = closing(c, nx, nz)
				if rvn < -1.8 and Bump.onImpact then Bump.onImpact(-rvn, c, nx, nz) end
				st.x += nx * (3.4 - d) * 0.5
				st.z += nz * (3.4 - d) * 0.5
				st.vx *= 1 - 2 * dt
				st.vz *= 1 - 2 * dt
				-- (Roblox police and rivals pause briefly after contact so they do not push through the player)
				c.hit = c.cop and 0.6 or math.max(c.hit or 0, 0.3)
			end
		end
	end
	otherT -= dt
	if otherT <= 0 then
		otherT = 0.5
		otherCars = others()
	end
	for _, b in ipairs(otherCars) do
		local p = b.Position / S
		local dx, dz = st.x - p.X, st.z - p.Z
		local d = math.sqrt(dx * dx + dz * dz)
		if d < 3.4 then
			local nx, nz = dx / math.max(d, 1e-6), dz / math.max(d, 1e-6)
			st.x += nx * (3.4 - d) * 0.5
			st.z += nz * (3.4 - d) * 0.5
			st.vx *= 1 - 2 * dt
			st.vz *= 1 - 2 * dt
		end
	end
end

return Bump
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX111"><Properties><string name="Name">Camera</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the camera, the web game's views (12_hud_loop.js, key C): 0 chase (9 m behind, 3.6 m up, eased; looks 5 m ahead),
-- 1 cockpit, 2 bonnet, 3 front bumper (placed from each car's length and height, as in the web game), and Roblox only: 4 free (Roblox's
-- orbit camera: mouse / touch drag). Field of view 65°, widening with speed up to 85° (not with Reduced motion). The view is a setting
-- ("cam", saved); C cycles through the five.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("Hud"))
local Settings = require(Client:WaitForChild("Settings"))

local Camera = {}
local S = Config.SCALE
local st, spec = State.st, State.spec
local mode, camPos = 0, nil
local NAMES = { "chase", "cockpit", "bonnet", "bumper", "free (drag to look around)" }
Camera.NAMES = NAMES

Settings.provide("cam")
Settings.onChange(function(k, v)
	if k ~= "cam" then return end
	local changed = mode ~= v
	mode = v
	camPos = nil
	local cam = Workspace.CurrentCamera
	if mode == 4 then
		cam.CameraType = Enum.CameraType.Custom
		if State.body then cam.CameraSubject = State.body end
	end
	if changed then Hud.toast("Camera: " .. NAMES[mode + 1], 1.5) end
end)

function Camera.cycle()
	Settings.set("cam", (mode + 1) % 5)
end

-- a view directly (the settings menu, tests)
function Camera.set(m)
	Settings.set("cam", m)
end

function Camera.mode()
	return mode
end

local CAMV = Vector3.new()
function Camera.step(dt)
	if mode == 4 or not (State.car and State.body) then return end
	local cam = Workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	local fx, fz = math.sin(st.h), math.cos(st.h)
	local px, py, pz = st.x, st.y, st.z
	if mode == 0 then
		CAMV = Vector3.new(px - fx * 9, py + 3.6, pz - fz * 9) * S
		camPos = camPos and camPos:Lerp(CAMV, math.min(1, dt * 6)) or CAMV
		cam.CFrame = CFrame.lookAt(camPos, Vector3.new(px + fx * 5, py + 1.2, pz + fz * 5) * S)
	else
		-- per-car views from the car's length L and height H (the web game's v48 numbers)
		local L, Hh = spec.L or 4.4, spec.H or 1.4
		local cf = mode == 1 and 0.08 * L or mode == 2 and 0.2 * L or 0.5 * L + 0.25
		local cy = mode == 1 and math.max(1.05, 0.82 * Hh + 0.08) or mode == 2 and Hh * 0.86 + 0.12 or 0.55
		local pos = Vector3.new(px + fx * cf, py + cy, pz + fz * cf) * S
		cam.CFrame = CFrame.lookAt(pos, Vector3.new(px + fx * (cf + 20), py + cy - 0.08, pz + fz * (cf + 20)) * S)
		camPos = nil
	end
	cam.FieldOfView = 65 + (Settings.get("rm") == 1 and 0 or math.min(20, st.sp * 3.6 * 0.12))
end

return Camera
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX112"><Properties><string name="Name">CarAudio</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the car and world sounds (the web game's 12d_audio.js audTick). Roblox cannot synthesise sound, so the web game's
-- synthesised sounds were rendered once into a sound atlas (tools/make_roblox_audio.js -> roblox/audio/IrbidDriveSounds.wav, upload it and
-- put its ID in Config.AUDIO_ATLAS_ID); each sound plays its region of the atlas and this module moves pitch and volume every frame with
-- the web game's rules:
--   engine: the car's engine layout (27 voices: cylinders, bank layout, aspiration), pitch = rpm, a full-load and a no-load voice mixed
--     by load, a second copy 0.4 % sharp (the web game's two detuned oscillators), level from load and rpm, a low-pass that opens with
--     load and rpm (approximated with an equaliser), the rev limiter, the dip at an upshift, turbo whistle and blow-off, supercharger
--     whine, intake roar, overrun pops (sporty petrol cars), hybrids creeping on the motor, the EV motor, the start-up sequence on a new
--     car (starter, uneven firing, flare, settle). RPM and gear: the Realistic gearbox, or in Arcade the web game's sound-only gearbox.
--   tyres: squeal on paved roads from the slip state (noise band + tone), gravel crunch off the road; wind, road roll, rain and wet hiss;
--   the nearest traffic car's engine; the horn (X); impacts (crash, glass, bump thump).
-- Volumes: the settings Sound / Engine / Effects / Ambient and Mute (L). The cockpit view muffles everything (the web game's low-pass).
local Workspace = game:GetService("Workspace")
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local CarPhysics = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("CarPhysics"))
local Atlas = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("AudioAtlas"))
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("Hud"))
local Settings = require(Client:WaitForChild("Settings"))
local CarDamage = require(Client:WaitForChild("CarDamage"))

local CarAudio = {}
local st, spec = State.st, State.spec
local ID = Config.AUDIO_ATLAS_ID or 0
CarAudio.enabled = ID ~= 0
Settings.provide("vol", "veng", "vfx", "vamb", "mute")

-- ---- the sound groups (the web game's master / engine / effects / ambient buses) and the cockpit muffle ----
local groups = {}
local function group(name)
	local g = Instance.new("SoundGroup")
	g.Name = "Irbid" .. name
	g.Volume = 0
	local eq = Instance.new("EqualizerSoundEffect")
	eq.Name = "Muffle"
	eq.HighGain, eq.MidGain, eq.LowGain = 0, 0, 0
	eq.Parent = g
	g.Parent = SoundService
	groups[name] = g
	return g
end
group("Engine")
group("Effects")
group("Ambient")
CarAudio.groups = groups

local function applyVolumes()
	local m = Settings.get("mute") == 1 and 0 or Settings.get("vol") / 10 * 0.8
	groups.Engine.Volume = m * Settings.get("veng") / 10
	groups.Effects.Volume = m * Settings.get("vfx") / 10
	groups.Ambient.Volume = m * Settings.get("vamb") / 10
end
Settings.onChange(function(k)
	if k == "vol" or k == "veng" or k == "vfx" or k == "vamb" or k == "mute" then applyVolumes() end
end)
applyVolumes()

-- L: mute / unmute (the web game's key)
function CarAudio.toggleMute()
	Settings.set("mute", 1 - Settings.get("mute"))
	Hud.toast(Settings.get("mute") == 1 and "Sound muted (L)" or "Sound on (L)")
end

-- ---- one sound = one region of the atlas ----
local sounds = {}
local function mk(name, part, grp)
	local a = Atlas[part]
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = "rbxassetid://" .. ID
	s.PlaybackRegionsEnabled = true
	s.PlaybackRegion = NumberRange.new(a.start, a.start + a.len)
	s.LoopRegion = NumberRange.new(a.start, a.start + a.len)
	s.Looped = a.loop
	s.Volume = 0
	s.SoundGroup = groups[grp]
	s.Parent = groups[grp]
	sounds[name] = { s = s, a = a }
	if a.loop and CarAudio.enabled then s:Play() end
	return s
end
-- a region change (the engine voice of another layout)
local function region(name, part)
	local o = sounds[name]
	local a = Atlas[part]
	if not (o and a) or o.a == a then return end
	o.a = a
	o.s.PlaybackRegion = NumberRange.new(a.start, a.start + a.len)
	o.s.LoopRegion = NumberRange.new(a.start, a.start + a.len)
	if CarAudio.enabled then o.s:Play() end
end
-- the loudness the part was normalised by, so the web game's relative levels hold
local function vol(name, v)
	local o = sounds[name]
	o.s.Volume = math.clamp(v * o.a.level, 0, 10)
end
local function speed(name, v)
	sounds[name].s.PlaybackSpeed = math.clamp(v, 0.05, 20)
end
-- one-shots: a pool of a few copies each, the web game's random pitch 0.85-1.15
local shots = {}
local function shot(part, n)
	shots[part] = { i = 0, list = {} }
	for k = 1, n do shots[part].list[k] = mk(part .. k, part, "Effects") end
end

mk("engOn", "eng_I4n_on", "Engine")
mk("engOff", "eng_I4n_off", "Engine")
mk("engOnB", "eng_I4n_on", "Engine")
mk("engOffB", "eng_I4n_off", "Engine")
mk("intake", "intake", "Engine")
mk("turbo", "turbo", "Engine")
mk("super", "super", "Engine")
mk("ev", "ev", "Engine")
mk("starter", "starter", "Engine")
mk("squeal", "squeal", "Effects")
mk("squealtone", "squealtone", "Effects")
mk("gravel", "gravel", "Effects")
mk("horn", "horn", "Effects")
mk("wind", "wind", "Ambient")
mk("road", "road", "Ambient")
mk("rain", "rain", "Ambient")
mk("wethiss", "wethiss", "Ambient")
mk("traffic", "traffic", "Ambient")
shot("crash", 3)
shot("glass", 2)
shot("thump", 2)
shot("blowoff", 2)
shot("pop", 3)

local function play(part, lvl, pitch)
	if not CarAudio.enabled then return end
	local p = shots[part]
	p.i = p.i % #p.list + 1
	local s = p.list[p.i]
	s.Volume = math.clamp(lvl * Atlas[part].level, 0, 10)
	s.PlaybackSpeed = pitch or (0.85 + math.random() * 0.3)
	s.TimePosition = Atlas[part].start
	s:Play()
	CarAudio.lastShot = part
end
CarAudio.play = play

-- ---- impacts (the web game: crash above 1.5 m/s, glass too above 11 m/s, at most every 60 ms), speed bumps ----
local hitT = -1
function CarAudio.hit(v)
	local now = Workspace.DistributedGameTime
	if v <= 1.5 or now - hitT < 0.06 then return end
	hitT = now
	play("crash", math.min(1, v / 22))
	if v > 11 then play("glass", 0.5) end
end
function CarAudio.bump(sev)
	play("thump", 0.25 + 0.5 * math.min(1, sev or 0))
end

-- an AI car honks (Reputation): a 3D horn at the car, its own pitch, quieter with distance (the web game's audHornAt)
function CarAudio.honkAt(a, dur, pitch)
	if not CarAudio.enabled or not (a.model and a.model.PrimaryPart) then return end
	local at = Atlas.trafhorn
	local s = Instance.new("Sound")
	s.Name = "Honk"
	s.SoundId = "rbxassetid://" .. ID
	s.PlaybackRegionsEnabled = true
	s.PlaybackRegion = NumberRange.new(at.start, at.start + math.min(at.len, dur or 0.5))
	s.PlaybackSpeed = pitch or 1
	s.Volume = 0.22 * at.level
	s.RollOffMaxDistance = 120 * Config.SCALE
	s.RollOffMinDistance = 8 * Config.SCALE
	s.SoundGroup = groups.Effects
	s.Parent = a.model.PrimaryPart
	s:Play()
	CarAudio.lastHonk = a
	task.delay((dur or 0.5) + 0.3, function() s:Destroy() end)
end

-- the player's horn (X): on / off
local hornOn = false
function CarAudio.horn(on)
	hornOn = on
end

-- ---- the web game's sound-only gearbox for Arcade (same per-car ratios as Realistic, upshift near the redline under throttle) ----
local AG = { gear = 1, rpm = 850, sh = 0 }
local function audRpm(snd, v, th, real)
	local P = State.phys and State.phys.pts
	if real and P then return P.rpm, P.gear, P.spin, P.shift > 0 end
	local s = spec.pt
	local kv = math.max(0.3, spec.vm / s.vref)
	local T = State.phys and State.phys.tslip
	local spin = T and T.spin or 0
	if snd.ev then
		AG.gear = 1
		AG.rpm = math.max(0, CarPhysics.ptGear(s, v, 1) / kv)
		return AG.rpm, 1, spin, false
	end
	local r = CarPhysics.ptGear(s, v, AG.gear) / kv
	if AG.gear < s.ng and r >= s.red * (th > 0.6 and 0.95 or 0.62) then
		AG.gear += 1
		AG.sh = s.shiftT
		r = CarPhysics.ptGear(s, v, AG.gear) / kv
	elseif AG.gear > 1 and CarPhysics.ptGear(s, v, AG.gear - 1) / kv < s.red * (th > 0.6 and 0.85 or 0.5) and r < s.red * (th > 0.6 and 0.55 or 0.3) then
		AG.gear -= 1
	end
	AG.sh = math.max(0, AG.sh - 1 / 60)
	r = math.max(r, (v < 6 and AG.gear == 1) and s.idle + (s.red * 0.45 - s.idle) * th * math.clamp(v / 6 + 0.4, 0, 1) or s.idle)
	if spin > 0.2 then r = math.max(r, s.red * (0.6 + 0.35 * spin)) end
	AG.rpm += (math.min(r, s.red) - AG.rpm) * 0.25
	return AG.rpm, AG.gear, spin, AG.sh > 0
end

-- ---- per frame ----
local cur, sw = nil, { ph = "start", t = 0 }
local lastG, dip, boost, bov, frame, t = 1, 0, 0, false, 0, 0
local trT, trCar, trD = 0, nil, 1e9
function CarAudio.step(dt, paved, cam)
	t += dt
	frame += 1
	local c = Config.CARS[spec.ci or 1]
	local snd = c and c.snd
	if not (snd and spec.pt) then return end
	-- a new car: the old engine stops (0.35 s), then the new one cranks and starts
	if cur ~= spec.ci then
		if cur ~= nil and sw.ph ~= "stop" then
			sw = { ph = "stop", t = 0 }
		elseif cur == nil or sw.t > 0.35 then
			cur = spec.ci
			AG.gear, AG.rpm = 1, snd.idle
			lastG = 1
			sw = { ph = "start", t = 0 }
			if not snd.ev then
				region("engOn", "eng_" .. snd.code .. "_on")
				region("engOff", "eng_" .. snd.code .. "_off")
				region("engOnB", "eng_" .. snd.code .. "_on")
				region("engOffB", "eng_" .. snd.code .. "_off")
			end
		end
	end
	sw.t += dt
	local inp = State.input
	local th, br = inp.th, inp.br
	if State.ui then th, br = 0, 1 end
	local v = math.sqrt(st.vx * st.vx + st.vz * st.vz)
	local real = State.phys and State.phys.mode == 1
	local rpm, gear, spin = audRpm(snd, v, th, real)
	local red, idle = snd.red, snd.idle
	-- start-up sequence: crank (starter whine, slow uneven firing), flare above idle, settle
	local crank, lvlK = 0, 1
	if sw.ph == "stop" then
		local k = math.max(0, 1 - sw.t / 0.35)
		rpm, lvlK, spin = idle * k, k, 0
	elseif sw.ph == "start" then
		if snd.ev then
			lvlK = math.min(1, sw.t / 0.6)
			if sw.t > 0.6 then sw.ph = "run" end
		elseif sw.t < 0.55 then
			crank, rpm, lvlK = 1, 230 + 50 * math.sin(sw.t * 55), 0.35
		elseif sw.t < 1.5 then
			rpm = math.max(rpm, idle * (1 + 0.7 * math.exp(-(sw.t - 0.6) * 5) * (sw.t < 0.7 and (sw.t - 0.55) / 0.15 or 1)))
		else
			sw.ph = "run"
		end
	end
	local lim = not snd.ev and rpm >= red * 0.975 and th > 0.5
	local gate = lim and ((math.floor(frame / 2) % 2 == 1) and 1 or 0.2) or 1
	local load = math.clamp(th * (0.6 + 0.4 * (1 - v / math.max(10, spec.vm))) + (spin > 0.2 and 0.3 or 0), 0, 1)
	if gear ~= lastG then
		if gear > lastG and th > 0.3 then
			dip = 0.14
			if snd.asp == "t" then play("blowoff", 0.05) end
		end
		lastG = gear
	end
	dip = math.max(0, dip - dt)
	local hybEV = snd.hyb and v < 6 and th < 0.5 and sw.ph == "run"
	-- damage (Full): a weak engine misfires, a dead one is silent
	local dr = CarDamage.mode() == 2 and CarDamage.record() or nil
	local eh = dr and dr.engine or 100
	local mis = eh < 35 and math.random() < (35 - eh) / 120
	if not snd.ev then
		local f = rpm / 3000
		speed("engOn", f)
		speed("engOff", f)
		speed("engOnB", f * 1.004)
		speed("engOffB", f * 1.004)
		local lv = snd.lvl * (hybEV and 0 or 1) * gate * (mis and 0.15 or 1) * (dip > 0 and 0.4 or 1) * lvlK * (eh <= 0 and 0 or 1)
		local base = lv * (0.32 + 0.68 * load) * (0.55 + 0.45 * rpm / red)
		vol("engOn", base * load)
		vol("engOff", base * (1 - load))
		vol("engOnB", base * load * 0.32)
		vol("engOffB", base * (1 - load) * 0.32)
		-- the web game's load / rpm low-pass, approximated by the engine group's equaliser
		local cut = math.min(16000, snd.lpf * (0.45 + 0.9 * load) * (0.7 + 0.6 * rpm / red))
		local eq = groups.Engine.Muffle
		eq.HighGain = cam == 1 and -20 or math.clamp(20 * math.log10(cut / 8000), -30, 0)
		eq.MidGain = cam == 1 and -6 or math.clamp(20 * math.log10(cut / 2000), -20, 0)
		vol("intake", 0.07 * th * rpm / red * snd.lvl)
		speed("intake", (150 + rpm * 0.12) / 300)
		local b = snd.asp == "t" and math.clamp((rpm / red - 0.3) / 0.5, 0, 1) * th or 0
		boost += (b - boost) * math.min(1, dt * (b > boost and 2.2 or 6))
		vol("turbo", 0.012 * boost * boost)
		speed("turbo", (2600 + 5200 * boost) / 3000)
		if snd.asp == "t" and th < 0.15 and boost > 0.45 and not bov then
			bov = true
			play("blowoff", 0.09 * boost, 1)
		end
		if th > 0.3 then bov = false end
		vol("super", snd.asp == "s" and 0.02 * th * rpm / red or 0)
		speed("super", rpm * 0.23 / 800)
		if th < 0.05 and rpm > red * 0.5 and not snd.lux and snd.asp ~= "d" and string.find("rmqco", snd.kind, 1, true) and math.random() < 0.05 then
			play("pop", 0.2 * snd.lvl * math.random())
		end
	else
		vol("engOn", 0)
		vol("engOff", 0)
		vol("engOnB", 0)
		vol("engOffB", 0)
		vol("intake", 0)
		vol("turbo", 0)
		vol("super", 0)
	end
	vol("starter", crank == 1 and 0.05 or 0)
	-- EV whine (also hybrids in EV mode)
	local evOn = snd.ev or hybEV
	local mr = snd.ev and rpm or v * 60
	vol("ev", evOn and (0.012 + 0.05 * load) * lvlK * math.min(1, 0.15 + mr / 4000) or 0)
	speed("ev", (40 + mr * 0.11) / 400)
	-- tyres: squeal on pavement from the slip state, gravel off the road
	local T = State.phys and State.phys.tslip
	local tr, tf, tl = T and T.r or 0, T and T.f or 0, T and T.lock or 0
	local sl = math.clamp(math.max(tr, tf * 0.8, spin * 0.9, tl, (br > 0.8 and v > 8) and 0.25 or 0), 0, 1.6)
	local sq = (st.gnd and (v > 2 or spin > 0.2)) and math.min(1, sl) or 0
	vol("squeal", paved and 0.22 * sq or 0)
	vol("squealtone", paved and 0.045 * sq * sq or 0)
	speed("squeal", (900 + 260 * sl) / 1000)
	speed("squealtone", (980 + 220 * sl) * (1 + 0.015 * math.sin(t * 33)) / 1050)
	vol("gravel", (not paved and st.gnd) and math.min(0.25, v / 40) * (0.4 + sq) or 0)
	-- wind, road roll, rain, wet tyres
	vol("wind", 0.32 * math.min(1.4, v / 45) ^ 2)
	speed("wind", (350 + v * 14) / 500)
	vol("road", st.gnd and math.min(0.35, v / 30 * 0.22) * (paved and 1 or 1.7) or 0)
	speed("road", (160 + v * 7) / 250)
	local wx = State.phys and State.phys.wx
	local rain = State.weather and State.weather.rain or 0
	vol("rain", 0.16 * rain)
	vol("wethiss", (st.gnd and wx) and 0.12 * wx.wet * math.min(1, v / 25) or 0)
	speed("wethiss", (1800 + v * 25) / 2400)
	-- the nearest traffic car (refreshed 6 times a second)
	trT -= dt
	if trT <= 0 then
		trT = 0.16
		trCar, trD = nil, 1600
		for _, a in ipairs(State.ai) do
			if a.kind == "traffic" then
				local d = (a.x - st.x) ^ 2 + (a.z - st.z) ^ 2
				if d < trD then trCar, trD = a, d end
			end
		end
		trD = math.sqrt(trD)
	end
	vol("traffic", trCar and 0.18 * math.min(1, 6 / math.max(6, trD)) * (0.3 + math.min(1, (trCar.v or 0) / 12)) or 0)
	if trCar then speed("traffic", (850 + (trCar.v or 0) * 110) / 3000) end
	vol("horn", hornOn and 0.16 or 0)
	-- cockpit: everything outside muffled (the web game's 2.6 kHz low-pass)
	local m = cam == 1
	groups.Effects.Muffle.HighGain = m and -20 or 0
	groups.Ambient.Muffle.HighGain = m and -20 or 0
	groups.Effects.Muffle.MidGain = m and -6 or 0
	groups.Ambient.Muffle.MidGain = m and -6 or 0
	CarAudio.rpm, CarAudio.load = rpm, load
end

return CarAudio
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX113"><Properties><string name="Name">CarDamage</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - vehicle damage on this device (the web game's 07c / 07d / 07h, rules in Modules/Damage): the mode (setting "dm",
-- key I: Off / Cosmetic / Full), the current car's record (kept on the server per car, Game/DamageStore), the hooks into the driving
-- (damage effects and burnouts before each physics step, the tyres after it), impacts with buildings and cars, hard landings, speed
-- bumps taken too fast, the engine temperature, and saving (every 8 s and after an impact). Off = nothing is recorded and the driving is
-- exactly the undamaged physics (CarPhysics.NO_DAMAGE). The looks are in CarDamageFx, the report in Diagnostics.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Damage = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Damage"))
local CarPhysics = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("CarPhysics"))
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("Hud"))
local Settings = require(Client:WaitForChild("Settings"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local CarDamage = { tyres = Damage.newTyreState(), changed = {} }
local st, spec = State.st, State.spec
local F = {}
for k, v in pairs(CarPhysics.NO_DAMAGE) do F[k] = v end
CarDamage.fx = F
local rec, ci = nil, nil
local T = CarDamage.tyres
local mode = 0
local lastToast, saveT, dirty, saving = -99, 0, false, false
Settings.provide("dm")

local function now()
	return Workspace.DistributedGameTime
end
local function car()
	return Config.CARS[ci or 1]
end
function CarDamage.mode()
	return mode
end
function CarDamage.record()
	return rec
end
-- something changed: the looks, the Repair button, the diagnostics
local function changed()
	for _, fn in ipairs(CarDamage.changed) do fn(rec, mode) end
end
local function toast(msg, gap)
	local t = now()
	if t - lastToast > (gap or 0.7) then
		lastToast = t
		Hud.toast(msg)
	end
end

-- the record of the car the player drives (asked from the server when the car changes)
local function load(i)
	ci = i
	local ok, r = pcall(function() return Remotes.Damage:InvokeServer("get", i) end)
	rec = Damage.clean(ok and type(r) == "table" and r or nil, Config.CARS[i])
	T.h0, T.burn, T.burnT = nil, false, 0
	changed()
end
function CarDamage.attach(i)
	if i ~= ci or not rec then task.spawn(load, i) end
end

function CarDamage.save()
	if not (rec and ci) or saving then return end
	saving, dirty = true, false
	local r, i = rec, ci
	task.spawn(function()
		pcall(function() Remotes.Damage:InvokeServer("save", i, r) end)
		saving = false
	end)
end

-- a repaired record from the server (the repair bay)
function CarDamage.setRecord(r)
	if type(r) == "table" and ci then
		rec = Damage.clean(r, car())
		changed()
	end
end

Settings.onChange(function(k, v)
	if k ~= "dm" then return end
	local was = mode
	mode = v
	if was ~= v then changed() end
end)
-- I: the next mode (the web game's toasts)
function CarDamage.cycle()
	Settings.set("dm", (mode + 1) % 3)
	Hud.toast("Vehicle damage: " .. Damage.MODE_NAMES[mode + 1] .. (mode == 2 and " — tyres, engine, suspension and brakes active" or mode == 1 and " — visual damage only" or " — disabled"))
end

-- ---- the physics hooks (Drive.sim): effects + burnout before the step, the tyres after it ----
local burnFn = function(th, thA, br, brA, hb, fs)
	return Damage.burnoutState(T, car(), mode, th, thA, br, brA, hb, fs, { gnd = st.gnd, bk = spec.bk, a0 = spec.a0 }, State.phys.sfc, F.accel)
end
local tp = { gnd = true, h = 0, al = 0, a0 = 0, vm = 0, bk = 0 }
function CarDamage.pre(env)
	if mode == 0 or not rec then
		env.dfx, env.burnout = CarPhysics.NO_DAMAGE, nil
		return
	end
	Damage.effects(rec, car(), mode, F)
	env.dfx, env.burnout = F, burnFn
end
function CarDamage.post(dt, thr, brk, hb, fs, ls, frozen, sfc)
	if mode == 0 or not rec then
		T.thr = thr
		return
	end
	tp.gnd, tp.h, tp.al, tp.a0, tp.vm, tp.bk = st.gnd, st.h, st.al, spec.a0, spec.vm, spec.bk
	local blown = Damage.tyreStep(T, rec, car(), mode, dt, thr, brk, hb, fs, ls, frozen, tp, sfc)
	if blown then
		dirty = true
		changed()
		Hud.toast("💥 Tyre " .. Damage.WHEEL_NAMES[blown] .. " failed — the car will pull and lose grip")
	end
end

-- ---- impacts ----
-- a building wall (Drive.onWall): v = closing speed along the wall normal (m/s), n from the wall to the car, the building part
function CarDamage.wall(v, nx, nz, part)
	local hw = part and part.Size.X / Config.SCALE / 2 or 6
	local hd = part and part.Size.Z / Config.SCALE / 2 or 6
	return CarDamage.impact(v, { type = "solid", hw = hw, hd = hd }, nx, nz)
end
-- another car (Bump.onImpact)
function CarDamage.vehicle(v, nx, nz)
	return CarDamage.impact(v, { type = "vehicle" }, nx, nz)
end
function CarDamage.impact(v, ob, nx, nz)
	if mode == 0 or not rec then return nil end
	local r = Damage.impact(rec, car(), mode, { v = v, ob = ob, nx = nx, nz = nz, x = st.x, z = st.z, h = st.h, vx = st.vx, vz = st.vz, t = now() })
	if not r then return nil end
	toast(r.toast)
	for _, k in ipairs(r.torn) do Hud.toast("💥 " .. Damage.DP_NAMES[k] .. " torn off") end
	CarDamage.lastImpact = r
	dirty = true
	changed()
	if CarDamage.onImpact then CarDamage.onImpact(r, v, nx, nz) end
	CarDamage.save()
	return r
end
-- a hard landing (Drive.onLand: the vertical speed just before touchdown, negative)
function CarDamage.landing(vy)
	if mode == 0 or not rec then return end
	local msg = Damage.landing(rec, car(), mode, vy, now())
	if msg then
		dirty = true
		changed()
		toast(msg, 0.8)
	end
end
-- a speed bump taken too fast (SpeedBumps.onImpact)
function CarDamage.speedBump(speed, sev, axle)
	if mode == 0 or not rec then return end
	local msg = Damage.speedBump(rec, car(), mode, speed, sev, axle)
	if msg then
		dirty = true
		changed()
		toast(msg, 0.8)
		if CarDamage.onBump then CarDamage.onBump(sev) end
	end
end

-- ---- every frame: the engine temperature (Full), smoke, saving every 8 s ----
function CarDamage.step(dt)
	if spec.ci and spec.ci ~= ci then CarDamage.attach(spec.ci) end
	-- a new model of the same car (reset, respawn): the looks again
	if State.car ~= CarDamage.model then
		CarDamage.model = State.car
		if rec then changed() end
	end
	if mode == 0 or not rec then
		CarDamage.smoking = false
		return
	end
	local e0 = rec.engine
	CarDamage.smoking = Damage.engineTick(rec, mode, T.thr, dt)
	if rec.engine ~= e0 then dirty = true end
	saveT += dt
	if saveT > 8 then
		saveT = 0
		Damage.syncAggregates(rec)
		if dirty then CarDamage.save() end
		changed()
	end
end

return CarDamage
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX114"><Properties><string name="Name">CarDamageFx</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - what damage looks like on the player's car (the web game's 07c refreshDamageVisual + 07h dpVisual), built from
-- parts on this device only (other players see the car undamaged, as the web game is single player):
--   bumpers that crack (darker, then bare metal), hang and tear off (they fall and lie on the road for 90 s, at most 8); mirrors that fold
--   and snap off; a buckled bonnet / boot lid (a creased copy of the panel); bowed doors; glass cracks drawn as lines from the stored crack
--   origins (the web game's deterministic pattern; a failed tempered pane frosts over); dark broken lamps; dents (shaded patches at the
--   impact points, their size and depth from the record); paint scratches on the damaged zones; flat tyres (squashed), corners that lean
--   (camber) and toe out; bent rims that wobble; smoke from a badly damaged engine; sparks at hard impacts; tyre smoke.
-- Roblox cannot deform a mesh or draw a canvas texture at run time, so dents, creases and cracks are approximated with parts.
-- Web mesh coordinates (+x the car's left, +z forward, y up from the ground) -> model (+X right, -Z forward): (-x, y - lift, -z).
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Damage = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Damage"))
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Ground = require(Client:WaitForChild("Ground"))

local Fx = {}
local S = Config.SCALE
local st, spec = State.st, State.spec
local built = nil -- {car, body, geo, parts = {bf, br, ml, mr, hood, trunk, dl, dr}, wheels = {[corner] = {part, base}}, lights, overlay}
local debris = {}
local METAL, LIGHT_DEAD, CRACK, SCRATCH = Color3.fromRGB(140, 143, 148), Color3.fromRGB(42, 43, 45), Color3.fromRGB(236, 241, 246), Color3.fromRGB(205, 208, 212)

-- a point in the web game's car-local metres -> an offset from the body part's centre (studs)
local function off(x, y, z)
	local lift = spec.H * 0.34 - 0.12
	return CFrame.new(-x * S, (y - lift) * S, -z * S)
end
-- a web rotation (x about the car's left, y about up, z about forward; applied y, then x, then z) in the model frame
local function rot(rx, ry, rz)
	return CFrame.Angles(0, ry or 0, 0) * CFrame.Angles(-(rx or 0), 0, 0) * CFrame.Angles(0, 0, -(rz or 0))
end
local function part(name, size, color, mat, parent)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.CanCollide, p.CanQuery, p.CanTouch, p.Massless = false, false, false, true
	p.Parent = parent
	return p
end
-- place p at an offset from the body and weld it there
local function weld(p, body, cf)
	p.CFrame = body.CFrame * cf
	local w = p:FindFirstChildOfClass("WeldConstraint")
	if not w then
		w = Instance.new("WeldConstraint")
		w.Part0, w.Part1 = body, p
		w.Parent = p
	end
end
local function paintColor(v, paint)
	if v > 0.6 then return METAL end
	if v > 0.15 then return Color3.new(paint.R * 0.68, paint.G * 0.68, paint.B * 0.68) end
	return paint
end

-- ---- the tagged parts, once per car model ----
local function build(car)
	local body = car:FindFirstChild("Body")
	local c = Config.CARS[car:GetAttribute("carIndex") or spec.ci or 1]
	if not (body and c and c.geo) then return nil end
	local g = c.geo
	local B = { car = car, body = body, geo = g, parts = {}, wheels = {}, rims = {}, lights = {}, paint = car:GetAttribute("Paint") or body.Color }
	local folder = Instance.new("Folder")
	folder.Name = "DamageParts"
	folder.Parent = car
	B.folder = folder
	local bh = math.min(0.2, (g.ny - 0.3) * 0.75)
	for _, q in ipairs({ { "bf", 1 }, { "br", -1 } }) do
		local p = part(q[1], Vector3.new((g.W - 0.02) * S, bh * S, 0.16 * S), body.Color, nil, folder)
		B.parts[q[1]] = { p = p, base = { 0, 0.3 + bh / 2, q[2] * (g.L / 2 + 0.01) } }
	end
	for _, q in ipairs({ { "ml", 1 }, { "mr", -1 } }) do
		local p = part(q[1], Vector3.new(0.15 * S, 0.1 * S, 0.09 * S), body.Color, nil, folder)
		B.parts[q[1]] = { p = p, base = { q[2] * (g.W / 2 + 0.1), g.y0 + 0.07, g.ws[1] - 0.08 } }
	end
	-- bonnet / boot lid: two halves meeting at the crease, hidden until damaged
	local function lid(key, z0, y0, z1, y1, w, pk)
		local a = part(key .. "A", Vector3.new(w * S, 0.02 * S, 1), body.Color, nil, folder)
		local b = part(key .. "B", Vector3.new(w * S, 0.02 * S, 1), body.Color, nil, folder)
		a.Transparency, b.Transparency = 1, 1
		B.parts[key] = { a = a, b = b, z0 = z0, y0 = y0, z1 = z1, y1 = y1, pk = pk }
	end
	lid("hood", g.L / 2 - 0.14, g.ny, g.hz + 0.04, g.y0, g.W * 0.86, 0.55)
	lid("trunk", -g.L / 2 + 0.12, g.ty, g.rz - 0.04, g.y0, g.W * 0.84, 0.5)
	local dz0 = g.ws[1] + 0.1
	local dz1 = g.four and math.max(g.rs[1] - 0.1, dz0 - 1.6) or dz0 - 1.1
	for _, q in ipairs({ { "dl", 1 }, { "dr", -1 } }) do
		local p = part(q[1], Vector3.new(0.02 * S, (g.y0 - 0.42) * S, (dz0 - dz1) * S), body.Color, nil, folder)
		p.Transparency = 1
		B.parts[q[1]] = { p = p, base = { q[2] * (g.W / 2 - 0.005), (g.y0 + 0.42) / 2, (dz0 + dz1) / 2 }, sx = q[2] }
	end
	for _, p in ipairs(car:GetChildren()) do
		if p.Name == "Wheel" and p:GetAttribute("Corner") then
			B.wheels[p:GetAttribute("Corner")] = { p = p, base = body.CFrame:ToObjectSpace(p.CFrame), size = p.Size }
		elseif p.Name == "Rim" and p:GetAttribute("Corner") then
			B.rims[p:GetAttribute("Corner")] = { p = p, base = body.CFrame:ToObjectSpace(p.CFrame), size = p.Size }
		elseif (p.Name == "Headlight" or p.Name == "Taillight") and p:GetAttribute("Light") then
			B.lights[p:GetAttribute("Light")] = { p = p, color = p.Color, mat = p.Material }
		end
	end
	-- smoke (engine), sparks (impacts), tyre smoke (one emitter per corner)
	local function emitter(name, tex, color, size, life, speed)
		local a = Instance.new("Attachment")
		a.Name = name
		a.Parent = body
		local e = Instance.new("ParticleEmitter")
		e.Name = "E"
		e.Texture = tex
		e.Color = ColorSequence.new(color)
		e.Size = NumberSequence.new(size)
		e.Lifetime = NumberRange.new(life[1], life[2])
		e.Speed = NumberRange.new(speed[1], speed[2])
		e.Rate = 0
		e.Enabled = true
		e.Parent = a
		return a, e
	end
	local engZ = (c.dmg.eng == "F" and 0.37 or -0.37) * g.L
	B.smokeA, B.smoke = emitter("EngineSmoke", "rbxasset://textures/particles/smoke_main.dds", Color3.fromRGB(119, 124, 128), 0.6 * S, { 1.2, 2 }, { 1 * S, 2 * S })
	B.smokeA.Position = off(0, 0.52, engZ).Position
	B.sparkA, B.spark = emitter("Sparks", "rbxasset://textures/particles/sparkles_main.dds", Color3.fromRGB(255, 190, 110), 0.12 * S, { 0.18, 0.34 }, { 1.5 * S, 3.5 * S })
	B.tyreA, B.tyre = {}, {}
	for j = 0, 3 do
		local a, e = emitter("TyreSmoke" .. j, "rbxasset://textures/particles/smoke_main.dds", Color3.fromRGB(237, 237, 237), 1.2 * S, { 1.2, 2 }, { 0.5 * S, 1.2 * S })
		e.Transparency = NumberSequence.new(0.55)
		local zw, xw = (j < 2 and 1 or -1) * g.L * 0.31, (j % 2 == 0 and 1 or -1) * (g.W / 2 - 0.12)
		a.Position = off(xw, 0.3, zw).Position
		B.tyreA[j], B.tyre[j] = a, e
	end
	return B
end

-- a part torn off: a copy falls and lies on the road (the web game's dpDetach: at most 8, each removed after 90 s)
local function detach(B, k)
	local q = B.parts[k]
	if not (q and q.p) then return end
	local c = q.p:Clone()
	for _, w in ipairs(c:GetChildren()) do w:Destroy() end
	c.Anchored = true
	c.Transparency = 0
	c.Name = "Debris_" .. k
	c.Parent = Workspace
	local k2 = string.sub(k, 1, 1) == "b" and 0.55 or 0.85
	debris[#debris + 1] = { p = c, vx = st.vx * k2 + (math.random() - 0.5) * 2, vz = st.vz * k2 + (math.random() - 0.5) * 2, vy = 1.2 + math.random(),
		sp = (math.random() - 0.5) * 6, age = 0, rest = false, hh = string.sub(k, 1, 1) == "b" and 0.08 or 0.05 }
	while #debris > 8 do table.remove(debris, 1).p:Destroy() end
end

-- the web game's deterministic random numbers for the crack pattern (dpRand)
local function dpRand(seed)
	local s = seed ~= 0 and seed or 1
	return function()
		s = (s * 1103515245 + 12345) % 2147483648
		return s / 2147483647
	end
end
-- the glass panes: origin (centre), u (across) and v (up) half-axes in web car-local metres, size (m)
local function panes(g)
	local P = {}
	local function slope(j, za, ya, zb, yb, wd)
		local cz, cy = (za + zb) / 2, (ya + yb) / 2
		local len = math.sqrt((zb - za) ^ 2 + (yb - ya) ^ 2)
		P[j] = { c = { 0, cy + 0.05, cz }, u = { 1, 0, 0 }, v = { 0, (yb - ya) / len, (zb - za) / len }, w = wd, h = len }
	end
	slope(1, g.ws[1], g.y0, g.ws[2], g.H, g.W * 0.78)
	if g.rs then slope(2, g.rs[1], g.y0, g.rs[2], g.H, g.W * 0.74) end
	local zc = g.four and (g.ws[2] + g.rs[2]) / 2 or g.ws[1] - 0.45
	local zl = g.four and math.abs(g.ws[2] - g.rs[2]) + 0.5 or 0.7
	for _, q in ipairs({ { 3, 1 }, { 4, -1 } }) do
		P[q[1]] = { c = { q[2] * (g.W * 0.42 + 0.1), (g.y0 + g.H) / 2, zc }, u = { 0, 0, -q[2] }, v = { 0, 1, 0 }, w = zl, h = (g.H - g.y0) * 0.78 }
	end
	return P
end
-- a line on a pane from (u0, v0) to (u1, v1) in pane units (0..1)
local function paneLine(B, pane, u0, v0, u1, v1, width)
	local function at(u, v)
		local a, b = (u - 0.5) * pane.w, (v - 0.5) * pane.h
		return pane.c[1] + pane.u[1] * a + pane.v[1] * b, pane.c[2] + pane.u[2] * a + pane.v[2] * b, pane.c[3] + pane.u[3] * a + pane.v[3] * b
	end
	local x0, y0, z0 = at(u0, v0)
	local x1, y1, z1 = at(u1, v1)
	local p0, p1 = (B.body.CFrame * off(x0, y0, z0)).Position, (B.body.CFrame * off(x1, y1, z1)).Position
	local len = (p1 - p0).Magnitude
	if len < 0.01 then return end
	local p = part("Crack", Vector3.new(width * S, width * S, len), CRACK, Enum.Material.SmoothPlastic, B.overlay)
	p.Transparency = 0.1
	p.CFrame = CFrame.lookAt((p0 + p1) / 2, p1)
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1 = B.body, p
	w.Parent = p
end

-- ---- rebuild the looks from the record (after every change of the record or the mode) ----
function Fx.refresh(rec, mode)
	local car = State.car
	if not (car and car.Parent) then return end
	if not built or built.car ~= car then
		built = build(car)
		if not built then return end
	end
	local B, g = built, built.geo
	local show = mode ~= 0 and rec ~= nil
	if B.overlay then B.overlay:Destroy() end
	B.overlay = Instance.new("Folder")
	B.overlay.Name = "DamageOverlay"
	B.overlay.Parent = car
	local q = show and rec.parts or {}
	-- bumpers and mirrors
	for _, k in ipairs({ "bf", "br", "ml", "mr" }) do
		local o = B.parts[k]
		local v = q[k] or 0
		o.p.Transparency = v >= 1 and 1 or 0
		o.p.Color = paintColor(v, B.paint)
		local x, y, z = o.base[1], o.base[2], o.base[3]
		local rx, ry, rz = 0, 0, 0
		if string.sub(k, 1, 1) == "b" and v > 0.3 then
			local front = k == "bf"
			local sd = (rec.zones[front and "fl" or "rl"] < rec.zones[front and "fr" or "rr"]) and 1 or -1
			local zs = front and 1 or -1
			z -= zs * math.min(0.12, v * 0.12)
			ry = sd * v * 0.06 * zs
			if v > 0.6 then
				rz = sd * (v - 0.6) * 0.55
				y -= (v - 0.6) * 0.22
			end
		elseif string.sub(k, 1, 1) == "m" and v > 0.4 then
			local sx = k == "ml" and 1 or -1
			rz, ry, y = sx * -1.1 * (v - 0.3), sx * 0.6 * v, y - 0.06
		end
		weld(o.p, B.body, off(x, y, z) * rot(rx, ry, rz))
		-- torn off now: the debris falls
		if v >= 1 and not o.gone then detach(B, k) end
		o.gone = v >= 1
	end
	-- bonnet / boot lid: two halves creased at pk, the crease raised by sev * 0.11 m (the web game's dpBend tent)
	for _, k in ipairs({ "hood", "trunk" }) do
		local o = B.parts[k]
		local v = q[k] or 0
		local on = show and v > 0.12
		o.a.Transparency, o.b.Transparency = on and 0 or 1, on and 0 or 1
		if on then
			local zp, yp = o.z0 + (o.z1 - o.z0) * o.pk, o.y0 + (o.y1 - o.y0) * o.pk + v * 0.11 + 0.02
			for _, seg in ipairs({ { o.a, o.z0, o.y0 + 0.02 }, { o.b, o.z1, o.y1 + 0.02 } }) do
				local pa, pb = (B.body.CFrame * off(0, seg[3], seg[2])).Position, (B.body.CFrame * off(0, yp, zp)).Position
				seg[1].Size = Vector3.new(seg[1].Size.X, seg[1].Size.Y, math.max(0.05, (pb - pa).Magnitude))
				seg[1].Color = Color3.new(B.paint.R * 0.68, B.paint.G * 0.68, B.paint.B * 0.68)
				seg[1].CFrame = CFrame.lookAt((pa + pb) / 2, pb, B.body.CFrame.UpVector)
				weld(seg[1], B.body, B.body.CFrame:ToObjectSpace(seg[1].CFrame))
			end
		end
	end
	-- doors: bowed in towards the dents on that side
	for _, k in ipairs({ "dl", "dr" }) do
		local o = B.parts[k]
		local v = q[k] or 0
		local on = show and v > 0.15
		o.p.Transparency = on and 0 or 1
		if on then
			o.p.Color = Color3.new(B.paint.R * 0.68, B.paint.G * 0.68, B.paint.B * 0.68)
			weld(o.p, B.body, off(o.base[1] - o.sx * v * 0.09 * 0.5, o.base[2], o.base[3]) * rot(0, o.sx * v * 0.05, 0))
		end
	end
	-- lamps
	for j = 0, 3 do
		local L = B.lights[j]
		if L then
			local broken = show and rec.lights[j + 1] ~= 0
			L.p.Color = broken and LIGHT_DEAD or L.color
			L.p.Material = broken and Enum.Material.SmoothPlastic or L.mat
			local beam = L.p:FindFirstChild("Beam")
			if beam and broken then beam.Enabled = false end
			L.p:SetAttribute("Broken", broken)
		end
	end
	-- wheels: flat (squashed, lower), camber on a damaged corner, toe from the alignment
	for j = 0, 3 do
		local w = B.wheels[j]
		if w then
			local ww = show and rec.wheels[j + 1] or nil
			local size, drop = w.size, 0
			if ww and ww.punct then
				size = Vector3.new(w.size.X * 1.14, w.size.Y * 0.82, w.size.Z)
				drop = w.size.Y * 0.09
			end
			local camber = (show and rec.susp[j + 1] < 60) and (60 - rec.susp[j + 1]) / 60 * 0.16 or 0
			local side = j % 2 == 0 and 1 or -1
			local toe = show and (j < 2 and 1 or 0.5) * rec.align[j + 1] * math.pi / 180 or 0
			w.p.Size = size
			w.cf = w.base * CFrame.new(0, -drop, 0) * rot(0, toe, side * camber)
			weld(w.p, B.body, w.cf)
			-- the rim goes with its wheel, and a bent one is squashed a little (the web game's dpVisual)
			local rm = B.rims[j]
			if rm then
				local b = show and rec.rims[j + 1] or 0
				rm.p.Size = b > 0.05 and Vector3.new(rm.size.X, rm.size.Y * (1 - b * 0.07), rm.size.Z * (1 + b * 0.04)) or rm.size
				rm.cf = rm.base * CFrame.new(0, -drop, 0) * rot(0, toe, side * camber)
				rm.bent = b
				weld(rm.p, B.body, rm.cf)
			end
		end
	end
	if not show then return end
	-- dents: a shaded patch at each impact point, sized by the dent radius, set in by its depth
	for _, d in ipairs(rec.dents) do
		local p = part("Dent", Vector3.new(0.02 * S, d[7] * 0.9 * S, d[7] * 0.9 * S), Color3.new(B.paint.R * 0.55, B.paint.G * 0.55, B.paint.B * 0.55), nil, B.overlay)
		p.Shape = Enum.PartType.Cylinder
		local cf = off(d[1] + d[4] * d[6] * 0.3, d[2], d[3] + d[5] * d[6] * 0.3)
		local look = Vector3.new(d[4], 0, d[5])
		if look.Magnitude < 1e-6 then look = Vector3.new(0, 0, 1) end
		-- the cylinder's axis (X) along the dent normal (web n -> model (-nx, 0, -nz))
		p.CFrame = B.body.CFrame * cf * CFrame.fromMatrix(Vector3.zero, Vector3.new(-look.X, 0, -look.Z).Unit, Vector3.new(0, 1, 0))
		local wcf = B.body.CFrame:ToObjectSpace(p.CFrame)
		weld(p, B.body, wcf)
	end
	-- scratches on the zones that lost condition
	for _, z in ipairs({ { "fl", 1, 0.33 }, { "fr", -1, 0.33 }, { "l", 1, 0 }, { "r", -1, 0 }, { "rl", 1, -0.33 }, { "rr", -1, -0.33 } }) do
		local loss = 100 - rec.zones[z[1]]
		if loss >= 1.5 then
			local len = math.min(g.L * 0.3, 0.35 + loss * 0.025)
			local h = math.min(0.3, 0.08 + loss * 0.006)
			local p = part("Scratch", Vector3.new(0.01 * S, h * S, len * S), SCRATCH, nil, B.overlay)
			p.Transparency = 0.25
			weld(p, B.body, off(z[2] * (g.W / 2 + 0.012), 0.42 + ((z[3] * 7) % 3) * 0.03, z[3] * g.L))
		end
	end
	-- glass cracks (laminated windscreen: lines from each origin, rings when severe; tempered panes frost over when they fail)
	local P = panes(g)
	for j = 1, 4 do
		local pane = P[j]
		local L = rec.cracks[j]
		if pane and #L > 0 then
			for _, c in ipairs(L) do
				local cu, cv, sev = c[1], c[2], c[3]
				local r = dpRand(Damage.jsround(cu * 977 + cv * 331 + (j - 1) * 71))
				local arms = Damage.jsround(6 + sev * 12)
				local reach = (40 + sev * 170) / 256
				for k = 0, arms - 1 do
					local a = k / arms * math.pi * 2 + r() * 0.4
					local mid = 0.45 + r() * 0.2
					local a2 = a + (r() - 0.5) * 0.5
					local u1, v1 = cu + math.cos(a) * reach * mid, cv + math.sin(a) * reach * mid
					local u2, v2 = u1 + math.cos(a2) * reach * (1 - mid), v1 + math.sin(a2) * reach * (1 - mid)
					paneLine(B, pane, cu, cv, math.clamp(u1, 0, 1), math.clamp(v1, 0, 1), 0.008)
					paneLine(B, pane, math.clamp(u1, 0, 1), math.clamp(v1, 0, 1), math.clamp(u2, 0, 1), math.clamp(v2, 0, 1), 0.006)
				end
				if j >= 2 and sev >= 0.85 then
					-- tempered glass crazes into small cubes over the whole pane: a frosted sheet over it
					local p = part("Crazed", Vector3.new(pane.w * S, pane.h * S, 0.01 * S), Color3.fromRGB(205, 210, 216), Enum.Material.Glass, B.overlay)
					p.Transparency = 0.35
					local x, y, z = pane.c[1], pane.c[2], pane.c[3]
					local pc = (B.body.CFrame * off(x, y, z)).Position
					local vx, vy, vz = pane.v[1], pane.v[2], pane.v[3]
					local ux, uz = pane.u[1], pane.u[3]
					local right = (B.body.CFrame * off(x + ux, y, z + uz)).Position - pc
					local up = (B.body.CFrame * off(x + vx, y + vy, z + vz)).Position - pc
					p.CFrame = CFrame.fromMatrix(pc, right.Unit, up.Unit)
					weld(p, B.body, B.body.CFrame:ToObjectSpace(p.CFrame))
				end
			end
		end
	end
end

-- ---- every frame: debris, bent rims, smoke ----
local phase, smA = 0, 0
function Fx.step(dt, mode, T)
	for i = #debris, 1, -1 do
		local d = debris[i]
		d.age += dt
		if d.age > 90 then
			d.p:Destroy()
			table.remove(debris, i)
		elseif not d.rest then
			d.vy -= 9.81 * dt
			local pos = d.p.Position / S + Vector3.new(d.vx, d.vy, d.vz) * dt
			local gy = Ground.TH(pos.X, pos.Z) + 0.06 + d.hh
			if pos.Y < gy then
				pos = Vector3.new(pos.X, gy, pos.Z)
				d.vy = math.abs(d.vy) > 2 and -d.vy * 0.25 or 0
				d.vx *= 0.5
				d.vz *= 0.5
				d.sp *= 0.4
				if math.sqrt(d.vx * d.vx + d.vz * d.vz) < 0.3 and d.vy == 0 then d.rest = true end
			end
			d.p.CFrame = CFrame.new(pos * S) * (d.p.CFrame - d.p.CFrame.Position) * CFrame.Angles(d.sp * 0.4 * dt, d.sp * dt, 0)
		end
	end
	local B = built
	if not (B and B.car.Parent) or mode == 0 then
		if B and B.smoke then B.smoke.Rate = 0 end
		return
	end
	-- bent rims wobble with the wheel's rotation (the web game's dpTick)
	local v = st.vx * math.sin(st.h) + st.vz * math.cos(st.h)
	phase += v * dt / 0.33
	for j = 0, 3 do
		local r = B.rims[j]
		if r and (r.bent or 0) > 0.05 then r.p.CFrame = B.body.CFrame * r.cf * CFrame.Angles(0, math.sin(phase + j) * r.bent * 0.07, 0) end
	end
	-- engine smoke (Full: a badly damaged or overheating engine)
	B.smoke.Rate = State.damageSmoke and 12 or 0
	-- tyre smoke from burnouts and slides (the web game: every wheel slipping more than 4 puffs, faster in a burnout)
	if T and (T.burn or (T.sl[1] + T.sl[2] + T.sl[3] + T.sl[4] > 12)) then
		smA += dt * (T.burn and 22 or 8)
		while smA >= 1 do
			smA -= 1
			for j = 0, 3 do
				if T.sl[j + 1] > 4 then B.tyre[j]:Emit(1) end
			end
		end
	end
end

-- sparks at a hard impact (the web game: 5 sparks above 11 m/s, at the contact point)
function Fx.sparks(r, v)
	local B = built
	if not (B and r and v >= 11) then return end
	B.sparkA.Position = off(r.cx, 0.28, r.cz).Position
	B.spark:Emit(5)
end

return Fx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX115"><Properties><string name="Name">CarFx</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the player's car effects on this device: brake lights (the sounds are in CarAudio).

local CarFx = {}
local lights = {}
local DIM, BRIGHT = Color3.fromRGB(140, 10, 10), Color3.fromRGB(255, 40, 40)

-- a new car: find its tail lights, start the engine sound
function CarFx.attach(m, body)
	lights = {}
	for _, p in ipairs(m:GetChildren()) do
		if p.Name == "Taillight" then lights[#lights + 1] = p end
	end
end

-- br = brake input, fs = forward speed (m/s), th = throttle input
function CarFx.step(br, fs, th)
	local braking = br > 0 and fs > 0.5
	for _, l in ipairs(lights) do
		l.Color = braking and BRIGHT or DIM
	end
end

return CarFx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX116"><Properties><string name="Name">CarInfo</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - small helpers for the menus: which cars this player owns, a car's rarity text, its upgrade levels.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))

local CarInfo = {}
local plr = Players.LocalPlayer

-- {[car index] = true} from the player attribute "Owned" (set by the server)
function CarInfo.owned()
	local o = {}
	for i in string.gmatch(plr:GetAttribute("Owned") or "1", "%d+") do o[tonumber(i)] = true end
	return o
end

-- "Rare ×1.5"
function CarInfo.tierLine(c)
	local r = Config.RARITY[c.tier + 1]
	return r.name .. " ×" .. string.format("%.1f", r.mult)
end

-- the current car's 4 upgrade levels from the player attribute "Tune"
function CarInfo.levels()
	local lv, i = { 0, 0, 0, 0 }, 0
	for n in string.gmatch(plr:GetAttribute("Tune") or "", "%d+") do
		i += 1
		lv[i] = tonumber(n)
	end
	return lv
end

return CarInfo
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX117"><Properties><string name="Name">CarSpec</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the numbers of the player's car: its base stats (Config.CARS, from the web game) with this player's
-- upgrades (player attribute "Tune", set by the server), written into State.spec. Updates when the upgrades change.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local State = require(script.Parent:WaitForChild("State"))
local Hud = require(script.Parent:WaitForChild("Hud"))

local CarSpec = {}
local plr = Players.LocalPlayer
local spec = State.spec

function CarSpec.apply()
	local car = State.car
	local ci = (car and car:GetAttribute("carIndex")) or plr:GetAttribute("CurCar") or 1
	local lv, i = { 0, 0, 0, 0 }, 0
	for n in string.gmatch(plr:GetAttribute("Tune") or "", "%d+") do
		i += 1
		lv[i] = tonumber(n)
	end
	local t = Config.tuned(ci, lv)
	local c = Config.CARS[ci] or Config.CARS[1]
	spec.vm, spec.a0, spec.hd, spec.dr, spec.bk, spec.rm = t.vm, t.a0, t.hd, t.dr, t.bk, t.rm
	spec.tier, spec.name, spec.L, spec.W, spec.H = c.tier, c.name, c.L, c.W, c.H
	spec.wb, spec.fn, spec.zeta = c.wb, c.fn, c.zeta
	-- the car index and its Realistic-handling data (Modules/CarPhysics)
	spec.ci, spec.pt = ci, c.pt
	spec.body = c.body
	Hud.car.Text = c.name .. " · " .. Config.RARITY[c.tier + 1].name .. " ×" .. string.format("%.1f", t.rm)
end
plr:GetAttributeChangedSignal("Tune"):Connect(CarSpec.apply)

return CarSpec
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX118"><Properties><string name="Name">CarWheel</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the car wheel menu (key K): the tier odds, a SPIN button (the server rolls and pays), and a reel that
-- cycles the tiers, slows down and stops on the result.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local CarWheel = {}
local plr = Players.LocalPlayer
local fmt = Hud.fmt
local spinning = false

function CarWheel.open()
	if spinning then return end
	if Hud.isOpen("Car Wheel") then
		Hud.closePanel()
		return
	end
	local p = Hud.panel("Car Wheel", 380, 330)
	local odds = {}
	for k, r in ipairs(Config.RARITY) do
		odds[#odds + 1] = r.name .. " " .. math.floor(Config.WHEEL_ODDS[k] * 100 + 0.5) .. "%"
	end
	p.sub.Text = table.concat(odds, " · ")
	local reel = Hud.label(p.list, UDim2.new(), UDim2.fromOffset(340, 70), Vector2.zero, "?", 34)
	reel.LayoutOrder = 1
	local res = Hud.label(p.list, UDim2.new(), UDim2.fromOffset(340, 48), Vector2.zero, "Each spin costs " .. fmt(Config.WHEEL_COST) .. " JD · a duplicate refunds " .. fmt(Config.WHEEL_REFUND), 15)
	res.TextWrapped = true
	res.LayoutOrder = 2
	local go
	go = Hud.button(p.list, "SPIN · " .. fmt(Config.WHEEL_COST) .. " JD", function()
		if spinning then return end
		if (plr:GetAttribute("Cash") or 0) < Config.WHEEL_COST then
			res.Text = "Not enough JD: fines, races and the bank heist pay JD"
			return
		end
		spinning = true
		go.Text = "Spinning…"
		local ok, r = Remotes.CarAction:InvokeServer("spin")
		if not ok or type(r) ~= "table" then
			spinning = false
			go.Text = "SPIN · " .. fmt(Config.WHEEL_COST) .. " JD"
			res.Text = tostring(r)
			return
		end
		local steps = 22 + r.tier
		for k = 0, steps do
			local t = (r.tier - (steps - k)) % #Config.RARITY
			reel.Text = Config.RARITY[t + 1].name
			reel.TextColor3 = Config.TIER_COLORS[t + 1]
			task.wait(0.04 + 0.012 * k)
		end
		local car = Config.CARS[r.car]
		reel.Text = Config.RARITY[r.tier + 1].name .. " · " .. car.name
		res.Text = r.dup and ("Duplicate: you already own it, " .. fmt(Config.WHEEL_REFUND) .. " JD refunded")
			or ("Unlocked and equipped! (×" .. string.format("%.1f", Config.RARITY[r.tier + 1].mult) .. " drift points)")
		Hud.toast("Wheel: " .. car.name .. (r.dup and " (duplicate)" or " unlocked!"), 4)
		spinning = false
		if go.Parent then go.Text = "SPIN AGAIN · " .. fmt(Config.WHEEL_COST) .. " JD" end
	end, 340, 40, Color3.fromRGB(180, 120, 0))
	go.LayoutOrder = 3
end

return CarWheel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX119"><Properties><string name="Name">Controls</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - controls, the web game's keys: W/S or the thumbstick = gas / brake-reverse, A/D steer (Roblox's movement input),
-- Space or DRIFT = handbrake, F reset to the start, C camera, G car wheel, N / B next / previous car, M GPS search, K landmark tour,
-- J stunt ramps, T +1 hour, R race (or a duel next to a traffic car), E rob the bank (elsewhere: shift up), Q shift down, H handling
-- Arcade / Realistic, U or P tuning shop, X horn, L mute, I damage Off / Cosmetic / Full, O diagnostics, Z auto-drive, Esc closes a menu. Roblox only: V garage, Y settings (the web game's Esc pause menu:
-- Roblox keeps Esc for its own menu). Phones and tablets get the web game's touch pads (steer left / right, GAS, BRAKE, DRIFT) and the menu buttons.
local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("Hud"))
local Gamepad = require(Client:WaitForChild("Gamepad"))

local Controls = {}
local plr = Players.LocalPlayer
local move = require(plr:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()
local hb = false
-- the touch pads held down: l, r, gas, brake, drift
local pad = { l = false, r = false, gas = false, brake = false, drift = false }

local function touchPads()
	local f = Instance.new("Frame")
	f.Name = "TouchPads"
	f.BackgroundTransparency = 1
	f.Size = UDim2.fromScale(1, 1)
	f.Parent = Hud.gui
	local function mk(key, txt, pos, size, color)
		local b = Instance.new("TextButton")
		b.Name = key
		b.Text = txt
		b.Position = pos
		b.Size = size
		b.AnchorPoint = Vector2.new(0, 1)
		b.BackgroundColor3 = color
		b.BackgroundTransparency = 0.35
		b.TextColor3 = Color3.new(1, 1, 1)
		b.Font = Enum.Font.GothamBold
		b.TextSize = 22
		b.AutoButtonColor = false
		b.Parent = f
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 14)
		c.Parent = b
		local function set(on)
			pad[key] = on
			b.BackgroundTransparency = on and 0.1 or 0.35
		end
		b.InputBegan:Connect(function(io)
			if io.UserInputType == Enum.UserInputType.Touch or io.UserInputType == Enum.UserInputType.MouseButton1 then set(true) end
		end)
		b.InputEnded:Connect(function(io)
			if io.UserInputType == Enum.UserInputType.Touch or io.UserInputType == Enum.UserInputType.MouseButton1 then set(false) end
		end)
		b.MouseLeave:Connect(function() set(false) end)
	end
	local GREY, GREEN, RED, ORANGE = Color3.fromRGB(40, 46, 56), Color3.fromRGB(30, 150, 70), Color3.fromRGB(190, 40, 40), Color3.fromRGB(220, 120, 0)
	-- left thumb: steering, above the minimap; right thumb: pedals and the handbrake, beside the speed
	mk("l", "◀", UDim2.new(0, 16, 1, -250), UDim2.fromOffset(96, 96), GREY)
	mk("r", "▶", UDim2.new(0, 124, 1, -250), UDim2.fromOffset(96, 96), GREY)
	mk("brake", "BRAKE", UDim2.new(1, -350, 1, -150), UDim2.fromOffset(100, 96), RED)
	mk("gas", "GAS", UDim2.new(1, -240, 1, -150), UDim2.fromOffset(100, 130), GREEN)
	mk("drift", "DRIFT", UDim2.new(1, -350, 1, -260), UDim2.fromOffset(210, 60), ORANGE)
end

-- actions = {reset, camera, wheel, nextCar, prevCar, gps, tour, ramps, hour, race, eKey, gearDown, handling, settings, shop, horn(on), garage}
function Controls.start(a)
	Hud.sideButton("⚙ Settings (Y)", a.settings)
	Hud.sideButton("🎡 Wheel (G)", a.wheel)
	Hud.sideButton("🚗 Garage (V)", a.garage)
	Hud.sideButton("📍 GPS (M)", a.gps)
	Hud.sideButton("🏁 Race (R)", a.race)
	Hud.sideButton("🗺 Tour (K)", a.tour)
	Hud.sideButton("🎥 Camera (C)", a.camera)
	Hud.sideButton("🏠 Start (F)", a.reset)
	ContextActionService:BindAction("Handbrake", function(_, state)
		hb = state == Enum.UserInputState.Begin
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.Space)
	-- gamepad / wheel buttons call the same actions as the keys (bindings in the gamepad setup)
	Gamepad.bind({ up = a.eKey, down = a.gearDown, camera = a.camera, horn = a.horn, race = a.race, reset = a.reset, tour = a.tour,
		gps = a.gps, settings = a.settings, nextCar = a.nextCar, prevCar = a.prevCar })
	if UserInputService.TouchEnabled then touchPads() end
	local KEYS = {
		[Enum.KeyCode.F] = a.reset,
		[Enum.KeyCode.C] = a.camera,
		[Enum.KeyCode.G] = a.wheel,
		[Enum.KeyCode.N] = a.nextCar,
		[Enum.KeyCode.B] = a.prevCar,
		[Enum.KeyCode.M] = a.gps,
		[Enum.KeyCode.K] = a.tour,
		[Enum.KeyCode.J] = a.ramps,
		[Enum.KeyCode.T] = a.hour,
		[Enum.KeyCode.R] = a.race,
		[Enum.KeyCode.E] = a.eKey,
		[Enum.KeyCode.Q] = a.gearDown,
		[Enum.KeyCode.H] = a.handling,
		[Enum.KeyCode.Y] = a.settings,
		[Enum.KeyCode.L] = a.mute,
		[Enum.KeyCode.I] = a.damage,
		[Enum.KeyCode.O] = a.diag,
		[Enum.KeyCode.Z] = a.autodrive,
		[Enum.KeyCode.U] = a.shop,
		[Enum.KeyCode.P] = a.shop,
		[Enum.KeyCode.V] = a.garage,
		[Enum.KeyCode.Escape] = Hud.closePanel,
	}
	UserInputService.InputBegan:Connect(function(io, gp)
		if gp then return end
		if io.KeyCode == Enum.KeyCode.X then
			a.horn(true)
			return
		end
		-- menus block the driving keys (the web game's ui flag); Esc and the menu keys still work
		local f = KEYS[io.KeyCode]
		if f then f() end
	end)
	UserInputService.InputEnded:Connect(function(io)
		if io.KeyCode == Enum.KeyCode.X then a.horn(false) end
	end)
end

-- every frame: the driving input into State.input. With a gamepad / wheel in use: the keys first, then its analog values (the web
-- game's order: keyboard, then the wheel; analog steering goes straight to the steering angle in Realistic). Otherwise Roblox's move
-- input (keyboard, touch thumbstick) and the touch pads.
local K = Enum.KeyCode
local function down(a, b)
	return UserInputService:IsKeyDown(a) or UserInputService:IsKeyDown(b)
end
function Controls.read(dt)
	local inp = State.input
	local gp = Gamepad.poll(dt or 1 / 60)
	local st = (pad.l and 1 or 0) - (pad.r and 1 or 0)
	if gp.on then
		local kW, kS = down(K.W, K.Up), down(K.S, K.Down)
		local ks = ((pad.l or down(K.A, K.Left)) and 1 or 0) - ((pad.r or down(K.D, K.Right)) and 1 or 0)
		inp.th = (kW or pad.gas) and 1 or gp.thr
		inp.br = (kS or pad.brake) and 1 or gp.brk
		if ks ~= 0 then
			inp.steer, inp.an = ks, false
		else
			inp.steer, inp.an = -gp.steer, true
		end
		inp.hb = hb or pad.drift or gp.hb
		if Controls.after then Controls.after(inp, dt or 1 / 60) end
		return
	end
	local mv = move:GetMoveVector()
	inp.th = math.max(0, -mv.Z, pad.gas and 1 or 0)
	inp.br = math.max(0, mv.Z, pad.brake and 1 or 0)
	inp.steer = st ~= 0 and st or -mv.X
	inp.an = false
	inp.hb = hb or pad.drift
	if Controls.after then Controls.after(inp, dt or 1 / 60) end
end

return Controls
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX120"><Properties><string name="Name">Diagnostics</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the vehicle diagnostics (key O; the web game's 07f panel): the damage mode, every component with its condition
-- and its effect (Full) or "visual only" (Cosmetic), the body zones, lights, glass and panels, one card per wheel (tread, carcass,
-- temperature, grip, load, slip, wear by cause, distance on the tyre), the last impacts, and the gamepad / racing-wheel status.
-- Refreshed twice a second while it is open.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Damage = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Damage"))
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("Hud"))
local CarDamage = require(Client:WaitForChild("CarDamage"))
local Gamepad = require(Client:WaitForChild("Gamepad"))

local Diagnostics = {}
local TITLE = "Diagnostics"

-- the web game's condition words and colours (07f sev)
local function sev(c)
	if c >= 95 then return "OK", Color3.fromHex("#7fd68a") end
	if c >= 75 then return "minor", Color3.fromHex("#c9e36b") end
	if c >= 45 then return "moderate", Color3.fromHex("#ffcf6b") end
	if c >= 15 then return "severe", Color3.fromHex("#ff9a5c") end
	return "failed", Color3.fromHex("#ff6b6b")
end
Diagnostics.sev = sev

local function line(p, txt, order, color, h)
	local t = Hud.label(p.list, UDim2.new(), UDim2.fromOffset(450, h or 18), Vector2.new(0, 0), txt, 14)
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.TextWrapped = true
	t.Font = Enum.Font.Gotham
	t.TextStrokeTransparency = 1
	if color then t.TextColor3 = color end
	t.LayoutOrder = order
	return t
end

-- the report as lines (also used by tests)
function Diagnostics.lines()
	local rec, mode = CarDamage.record(), CarDamage.mode()
	local car = Config.CARS[State.spec.ci or 1]
	local L = {}
	local function add(t, c) L[#L + 1] = { t, c } end
	add(car.name .. " · damage " .. Damage.MODE_NAMES[mode + 1] .. (mode == 0 and " (press I for Cosmetic or Full)" or ""), Color3.fromRGB(255, 210, 74))
	if not rec then
		add("No record yet")
		return L
	end
	local full = mode == 2
	add(string.format("Body %d %% · tyres %d %% · suspension %d %% · %d impacts", Damage.jsround(rec.body), Damage.jsround(rec.tyres), Damage.jsround(rec.suspension), rec.impacts))
	for _, r in ipairs(Damage.diagRows(rec, car, full)) do
		local w, c = sev(r[2])
		add(r[1] .. ": " .. Damage.jsround(r[2]) .. " % " .. w .. " · " .. r[3], c)
	end
	local zs = {}
	for _, z in ipairs(Damage.ZONES) do zs[#zs + 1] = Damage.ZONE_NAMES[z] .. " " .. Damage.jsround(rec.zones[z]) .. "%" end
	add("Body zones: " .. table.concat(zs, " · "))
	local bits = {}
	for j = 1, 4 do
		if rec.lights[j] ~= 0 then bits[#bits + 1] = Damage.LIGHT_NAMES[j] .. " broken" end
		if rec.glass[j] > 0 then bits[#bits + 1] = Damage.GLASS_NAMES[j] .. " cracked " .. Damage.jsround(rec.glass[j] * 100) .. "%" end
	end
	for _, k in ipairs(Damage.DP_KEYS) do
		local v = rec.parts[k]
		if v > 0.005 then bits[#bits + 1] = Damage.DP_NAMES[k] .. (v >= 1 and " torn off" or (" " .. Damage.jsround(v * 100) .. "%")) end
	end
	add(#bits > 0 and table.concat(bits, " · ") or "Lights, glass and panels: no damage", #bits > 0 and Color3.fromRGB(240, 150, 70) or nil)
	if #rec.dents > 0 then add(#rec.dents .. " dent" .. (#rec.dents > 1 and "s" or "")) end
	local T = CarDamage.tyres
	for j = 1, 4 do
		local w = rec.wheels[j]
		local c = w.punct and 0 or math.min(w.tread, w.health)
		local wd, col = sev(c)
		local wr = w.wear
		add(string.format("Tyre %s: %s · tread %d %% · carcass %d %% · %d °C (max %d) · grip x%.2f · load %d N · slip %.1f · wear: slide %.2f, spin %.2f, lock %.2f, burnout %.2f · %.1f km%s%s",
			Damage.WHEEL_NAMES[j], wd, Damage.jsround(w.tread), Damage.jsround(w.health), Damage.jsround(w.temp), Damage.jsround(w.tmax), Damage.tyreMu(w), Damage.jsround(T.fz[j]),
			T.sl[j], wr.slide, wr.spin, wr.lock, wr.burn, w.km, w.punct and " · PUNCTURED" or "", rec.rims[j] > 0.005 and (" · rim bent " .. Damage.jsround(rec.rims[j] * 100) .. "%") or ""), col)
	end
	if full then add(string.format("Engine %d °C%s", Damage.jsround(rec.engTemp), rec.engTemp > 112 and " · power limited" or "")) end
	for i, e in ipairs(rec.log) do
		if i > 4 then break end
		add(string.format("Impact: %d km/h (barrier %d) · %s · %s", e.kmh, e.ebs, e.zone, e.obj))
	end
	local g = Gamepad.state
	add(g.on and string.format("Gamepad / wheel: connected · steering %+.2f · gas %.2f · brake %.2f", g.steer, g.thr, g.brk) or "Gamepad / wheel: not in use (a G29 works through Steam Input or x360ce)")
	return L
end

function Diagnostics.toggle()
	if Hud.isOpen(TITLE) then
		Hud.closePanel()
		return
	end
	local p = Hud.panel(TITLE, 480, 520)
	p.sub.Text = "Damage, wear and tyres of this car · numbers are gameplay estimates"
	local labels = {}
	local function fill()
		local L = Diagnostics.lines()
		for i, q in ipairs(L) do
			local t = labels[i]
			if not t then
				t = line(p, "", i, nil, string.len(q[1]) > 70 and 34 or 18)
				labels[i] = t
			end
			t.Text = q[1]
			t.TextColor3 = q[2] or Color3.new(1, 1, 1)
		end
	end
	fill()
	local acc = 0
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		if not Hud.isOpen(TITLE) then
			conn:Disconnect()
			return
		end
		acc += dt
		if acc > 0.5 then
			acc = 0
			fill()
		end
	end)
end

-- the web game's two buttons (right edge, under Roblox's player list): "Damage: Off / Cosmetic / Full" (click = the next mode, like I) and "🔧 Repair" (shown when the
-- car is damaged and damage is on; at Apex Drift Customs it opens the repair bay, elsewhere it sets the GPS route there)
function Diagnostics.buttons(openShop, nearShop, routeShop)
	local dmgB = Hud.button(Hud.gui, "Damage: Off", CarDamage.cycle, 150, 30, Color3.fromRGB(70, 50, 50))
	dmgB.Name = "DamageButton"
	dmgB.AnchorPoint = Vector2.new(1, 0)
	dmgB.Position = UDim2.new(1, -12, 0.5, -70)
	dmgB.ZIndex = 4
	local repB = Hud.button(Hud.gui, "🔧 Repair", function()
		if nearShop() then
			openShop()
		else
			Hud.toast("🔧 Repairs are done at Apex Drift Customs (Baghdad Street) — route set")
			routeShop()
		end
	end, 150, 30, Color3.fromRGB(150, 80, 20))
	repB.Name = "RepairButton"
	repB.AnchorPoint = Vector2.new(1, 0)
	repB.Position = UDim2.new(1, -12, 0.5, -34)
	repB.ZIndex = 4
	repB.Visible = false
	table.insert(CarDamage.changed, function(rec, mode)
		dmgB.Text = "Damage: " .. Damage.MODE_NAMES[mode + 1]
		repB.Visible = mode ~= 0 and rec ~= nil and Damage.hurt(rec)
	end)
	Diagnostics.damageButton, Diagnostics.repairButton = dmgB, repB
end

return Diagnostics
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX121"><Properties><string name="Name">DriftScore</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - drift points, the web game's formula: slip angle x speed x 8 per second, x a combo that grows over 12 s
-- (up to x5), x the Extra Drift Points upgrade (+20 % a level, and it starts counting at a smaller angle), x the car's rarity.
-- 0.7 s after the drift ends, more than 40 points are sent to the server (drift bank + cash). A crash loses the drift.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local State = require(script.Parent:WaitForChild("State"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local DriftScore = { state = { pts = 0, t = 0, off = 0 } }
local drift = DriftScore.state
local spec = State.spec

function DriftScore.clear()
	drift.pts, drift.t = 0, 0
	Hud.drift.Text = ""
end

-- a crash: the drift in progress is lost
function DriftScore.lose()
	if drift.pts > 0 then
		DriftScore.clear()
		Hud.toast("Drift lost", 1.5)
	end
end

-- sa = slip angle (rad), sp = speed (m/s), gnd = wheels on the ground
function DriftScore.step(dt, sa, sp, gnd)
	if gnd and sp > 8 and sa > 0.22 - 0.012 * spec.dr and not State.frozen then
		drift.t += dt
		drift.off = 0
		local combo = 1 + math.min(4, drift.t / 3)
		drift.pts += sa * sp * 8 * dt * combo * (1 + 0.2 * spec.dr) * spec.rm
		Hud.drift.Text = "DRIFT  " .. Hud.fmt(drift.pts) .. "  ×" .. string.format("%.1f", combo)
	elseif drift.pts > 0 then
		drift.off += dt
		if drift.off > 0.7 then
			if drift.pts > 40 then
				local n = math.floor(drift.pts + 0.5)
				Remotes.BankDrift:FireServer(n)
				Hud.toast("Drift +" .. Hud.fmt(n) .. (spec.rm > 1 and ("  (" .. Config.RARITY[spec.tier + 1].name .. " ×" .. string.format("%.1f", spec.rm) .. ")") or ""))
			end
			DriftScore.clear()
		end
	end
end

return DriftScore
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX122"><Properties><string name="Name">Drive</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the player's car on this device: attaching to it, the driving model, placing it, reset.
-- The driving model is the web game's updP (10_laws_player.js) in its two handling modes (key H, as in the web game), both line for line
-- in Modules/CarPhysics (checked against the web build by tests/physics_equiv.js):
--   Arcade (default): steering (rate falls with speed, needs speed, sharper with the handbrake, weak in the air); grip from the surface
--     under the car (paved road / drift zone 1, unpaved track .75, built-up ground .9, open ground .65) scaling acceleration and braking;
--     gravity along the slope; extra drag on poor surfaces; handbrake; rolling and air drag; the sideways velocity decaying.
--   Realistic: engine torque curve, automatic or manual gearbox, traction limit with load transfer, aero drag and rolling resistance,
--     engine braking, a two-axle slip-angle tyre model, ABS / traction / stability control, optional tyre temperature and brake fade,
--     a sprung body; frames longer than 1/60 s are split into equal steps (the web game's updPStep).
-- Height: the web game's groundH (terrain + ramps): the car follows the ground, and leaves it where the ground drops away faster
-- (ramps, crests). Units: metres, seconds.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Road = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Road"))
local CarPhysics = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("CarPhysics"))
local Meta = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Meta"))
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("Hud"))
local Ground = require(Client:WaitForChild("Ground"))
local CarSpec = require(Client:WaitForChild("CarSpec"))
local DriftScore = require(Client:WaitForChild("DriftScore"))
local Bump = require(Client:WaitForChild("Bump"))
local CarFx = require(Client:WaitForChild("CarFx"))
local Camera = require(Client:WaitForChild("Camera"))
local SpeedBumps = require(Client:WaitForChild("SpeedBumps"))
local Laws = require(Client:WaitForChild("Laws"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Drive = {}
local S = Config.SCALE
local plr = Players.LocalPlayer
local st, spec, inp = State.st, State.spec, State.input
-- the physics input and environment (with the Realistic state: gearbox, tyres, assists...), reused every frame (no allocation per frame)
local pin = { th = 0, br = 0, steer = 0, hb = false, an = false }
local penv = CarPhysics.newState()
penv.sfc, penv.frozen, penv.TH, penv.mode = 1, false, Ground.TH, 0
Drive.phys = penv
State.phys = penv
Drive.drift = DriftScore.state
Drive.applySpec = CarSpec.apply
Drive.cycleCam = Camera.cycle
Drive.camera = Camera.step
st.pgh, st.pitch, st.bp, st.br, st.h0, st.al = 0, 0, 0, 0, 0, 0

local clamp = CarPhysics.clamp
-- the web game's wrap: an angle into (-pi, pi]
local function wrap(a)
	return math.atan2(math.sin(a), math.cos(a))
end

-- the visible ground (roads, terrain) under (x, z), looking down from yTop at most 400 m
function Drive.groundY(x, z, yTop)
	return Ground.below(x, z, yTop, 400)
end

-- the web game's surface grip (surfK)
local function surfK()
	if State.inDrift then return 1 end
	local r = State.ri
	if r and r.d <= r.e.w / 2 + 0.3 then return r.e.track and 0.75 or 1 end
	return Ground.urban(st.x, st.z) and 0.9 or 0.65
end

-- paved surface under the car (the sounds: squeal on tarmac, gravel crunch off it)
function Drive.paved()
	return surfK() >= 1
end

-- ---- attach to a newly built car ----
local function attach(m)
	State.car = m
	local body = m:WaitForChild("Body")
	State.body = body
	CarSpec.apply()
	local cf = body.CFrame
	local lv = cf.LookVector
	st.h = math.atan2(lv.X, lv.Z)
	st.x, st.z = cf.X / S, cf.Z / S
	st.y = Ground.groundH(st.x, st.z)
	st.pgh = st.y
	st.vx, st.vz, st.vy = 0, 0, 0
	CarFx.attach(m, body)
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	if hum then hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false) end
	-- the server keeps the car anchored until now
	Remotes.CarReady:FireServer(m)
end
Workspace.ChildAdded:Connect(function(c)
	if c.Name == "Car_" .. plr.UserId then attach(c) end
end)
local existing = Workspace:FindFirstChild("Car_" .. plr.UserId)
if existing then task.spawn(attach, existing) end

-- ---- the web game's warp(): put the car at (x, z), heading h, stopped, on the ground ----
function Drive.place(x, z, h)
	st.x, st.z, st.h = x, z, h
	st.vx, st.vz, st.vy = 0, 0, 0
	st.y = Ground.groundH(x, z)
	st.pgh = st.y
	DriftScore.clear()
end

-- F / Reset: back to the start on Baghdad Street (as in the web game)
function Drive.reset()
	Drive.place(0, 0, Meta.startHeading)
end

-- onto the nearest road (right-hand lane, facing the way the car was going); used when a car is stuck far from the start
function Drive.toRoad()
	local near = State.road and Road.nearest(State.road, st.x, st.z, 400)
	if not near then
		Drive.reset()
		return
	end
	local d = Road.dirFor(near, math.sin(st.h), math.cos(st.h))
	local tx, tz = near.tx * d, near.tz * d
	local off = Road.lane(near.e)
	Drive.place(near.x - tz * off, near.z + tx * off, math.atan2(tx, tz))
end

-- ---- one physics step (the web game's updP): the car model, walls, moving, ground, body, other cars, laws ----
local function sim(dt, frozen, thA, brA, steer, hb)
	pin.th, pin.br, pin.steer, pin.hb, pin.an = thA, brA, steer, hb, inp.an == true
	penv.frozen = frozen
	penv.sfc = surfK()
	-- damage (CarDamage): the effects on driving and the burnout test before the step, the tyres after it (the web game's order)
	local dmg = Drive.damage
	if dmg then dmg.pre(penv) end
	local fs, ls = CarPhysics.step(st, spec, pin, penv, dt)
	if dmg then dmg.post(dt, thA, brA, hb, fs, ls, frozen, penv.sfc) end
	local fx, fz = math.sin(st.h), math.cos(st.h)
	DriftScore.step(dt, math.abs(math.atan2(ls, math.abs(fs) + 0.5)), math.sqrt(st.vx * st.vx + st.vz * st.vz), st.gnd)
	-- move; buildings stop the car (the web game's static colliders, colB): an impact above 1.8 m/s is reported first (damage, sound),
	-- then the car bounces off with the web game's factor 1.4 (restitution 0.4); the drift is lost
	local prevX, prevZ = st.x, st.z
	local sp0 = math.sqrt(st.vx * st.vx + st.vz * st.vz)
	if sp0 > 0.05 then
		local hit = Ground.wall(st.x, st.y + 0.3, st.z, st.vx / sp0, st.vz / sp0, sp0 * dt + 2.4)
		if hit then
			local n = Vector3.new(hit.Normal.X, 0, hit.Normal.Z).Unit
			local vn = st.vx * n.X + st.vz * n.Z
			if vn < 0 then
				if -vn > 1.8 and Drive.onWall then Drive.onWall(-vn, n.X, n.Z, hit.Instance) end
				st.vx -= 1.4 * vn * n.X
				st.vz -= 1.4 * vn * n.Z
				DriftScore.lose()
			end
		end
	end
	st.x += st.vx * dt
	st.z += st.vz * dt
	SpeedBumps.step(prevX, prevZ, dt)
	-- height: follow the ground; where it falls away faster than the car (ramp ends, crests) the car flies
	local gh = Ground.groundH(st.x, st.z)
	local vy0 = st.vy
	st.vy -= 9.81 * dt
	st.y += st.vy * dt
	if st.y <= gh then
		-- touchdown: the vertical speed of the last airborne step (the web game's registerLanding)
		if not st.gnd and Drive.onLand then Drive.onLand(vy0) end
		st.y = gh
		st.vy = (gh - st.pgh) / dt
		st.gnd = true
	else
		st.gnd = false
	end
	st.pgh = gh
	-- body: pitch with the slope (or the flight path), and a little pitch / roll from acceleration and cornering
	local sl = (Ground.groundH(st.x + fx * 2, st.z + fz * 2) - Ground.groundH(st.x - fx * 2, st.z - fz * 2)) / 4
	local pt = st.gnd and -math.atan(sl) or -math.atan2(st.vy, math.max(fs, 5)) * 0.7
	st.pitch += (pt - st.pitch) * math.min(1, dt * 8)
	local yr = wrap(st.h - st.h0) / dt
	st.h0 = st.h
	local al = (st.gnd and not frozen) and clamp(st.al, -12, 8) or 0
	local ay = (st.gnd and not frozen) and clamp(fs * yr, -12, 12) or 0
	st.bp += (-al * 0.0022 - st.bp) * math.min(1, dt * 6)
	st.br += (ay * 0.0065 - st.br) * math.min(1, dt * 6)
	-- Realistic: the sprung body (pitch / roll / heave springs)
	if penv.mode == 1 then CarPhysics.body(st, spec, penv, dt, frozen, fs) end
	-- other cars (the web game's circles); then the laws
	Bump.step(dt)
	local sp = math.sqrt(st.vx * st.vx + st.vz * st.vz)
	st.sp, st.fs = sp, fs
	if not frozen then Laws.step(sp * 3.6) end
	return fs
end

-- the Realistic line under the speed (the web game's ptHud): gear, rpm, wheelspin, locked wheels, assists acting, temperatures
local function realLine()
	if penv.mode ~= 1 or not spec.pt then return "" end
	local P, X = penv.pts, penv.simx
	local s = (spec.pt.ev and "EV" or ((P.man ~= 0 and "M" or "G") .. P.gear)) .. " · " .. tostring(math.floor(P.rpm / 100 + 0.5) * 100) .. " rpm"
	if P.spin > 0.25 then s ..= " · wheelspin" end
	if P.flock ~= 0 then s ..= " · LOCKED" end
	if P.absA ~= 0 then s ..= " · ABS" end
	if P.tcA ~= 0 then s ..= " · TC" end
	if P.escA ~= 0 then s ..= " · ESC" end
	if X.tt then s ..= " · tyres " .. math.floor(X.tT + 0.5) .. "°C" end
	if X.bf then s ..= " · brakes " .. math.floor(X.bT + 0.5) .. "°C" .. (X.bk < 0.97 and " FADE" or "") end
	return s
end
Drive.realLine = realLine
local hudT = 0

-- ---- one frame of driving ----
function Drive.step(dtr)
	local car, body = State.car, State.body
	if not (car and car.Parent and body and body.Parent) then return end
	-- the driver left the seat (should not happen; jumping is off): ask the server to seat them again
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	if hum and not hum.Sit and os.clock() - (st.reseat or 0) > 3 then
		st.reseat = os.clock()
		Remotes.ResetCar:FireServer()
	end
	local dt = clamp(dtr, 0.004, 0.05)
	local frozen = State.frozen
	if not (st.x == st.x and st.y == st.y and st.z == st.z and st.vx == st.vx and st.vz == st.vz and st.h == st.h) then
		Drive.place(0, 0, Meta.startHeading)
	end
	local thA, brA, steer, hb = inp.th, inp.br, inp.steer, inp.hb
	-- a menu open = no input, brakes on (the web game: ui -> brake)
	if State.ui then thA, brA, steer, hb = 0, 1, 0, false end
	local n = CarPhysics.substeps(penv.mode, dt)
	local fs = 0
	for _ = 1, n do
		fs = sim(dt / n, frozen, thA, brA, steer, hb)
	end
	-- place the car: yaw, then pitch and roll (web pitch is nose-down positive; this model faces -Z). Realistic: the sprung body's
	-- heave / pitch / roll replace the Arcade body lean (the web game's ptBody)
	local heave, bpitch, broll = SpeedBumps.visual(dt)
	local lean, roll = st.bp, st.br
	if penv.mode == 1 then
		heave += penv.pts.hz
		lean, roll = penv.pts.pz, penv.pts.rz
	end
	-- Full damage: a flat tyre, a bent driveline or bent rims shake the body (the web game's damageTick vibration, looks only)
	local dmg = Drive.damage
	if dmg and dmg.mode() == 2 and st.gnd and st.sp > 2 then
		local vib = dmg.fx.vib
		if vib > 0 then
			local a = vib * 0.011 * math.min(1, st.sp / 18)
			roll += (math.random() - 0.5) * a
			bpitch += (math.random() - 0.5) * a * 0.6
		end
	end
	local pos = Vector3.new(st.x, st.y + spec.H * 0.34 - 0.12 + heave, st.z) * S
	car:PivotTo(CFrame.new(pos) * CFrame.Angles(0, st.h + math.pi, 0) * CFrame.Angles(-(st.pitch + lean) + bpitch, 0, roll + broll))
	local lift = body:FindFirstChild("Lift")
	if lift then lift.Force = Vector3.new(0, body.AssemblyMass * Workspace.Gravity, 0) end
	body.AssemblyLinearVelocity = Vector3.new(st.vx, st.vy, st.vz) * S
	body.AssemblyAngularVelocity = Vector3.zero
	CarFx.step(brA, fs, thA)
	Hud.speed.Text = tostring(math.floor(st.sp * 3.6 + 0.5))
	hudT -= dt
	if hudT <= 0 then
		hudT = 0.1
		Hud.gear.Text = realLine()
	end
end

return Drive
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX123"><Properties><string name="Name">Duel</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - duels (the web game's): R next to a traffic car (within 5.5 m) challenges it. Its driver lines up on the player's
-- left, both race 720 m along the road ahead (the straightest way at each junction) to a light beam, after a 3 s countdown; first to
-- the beam wins. No money, as in the web game.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Rules = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Rules"))
local Road = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Road"))
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("Hud"))
local Drive = require(Client:WaitForChild("Drive"))
local Traffic = require(Client:WaitForChild("Traffic"))

local Duel = { rivals = {} }
local S = Config.SCALE
local st = State.st
local duel = nil -- {rival, src (the traffic car), dest = {x, z}, s = "count"|"run"|"done", t}

local beam = Instance.new("Part")
beam.Name = "DuelBeam"
beam.Anchored = true
beam.CanCollide = false
beam.CanQuery = false
beam.CanTouch = false
beam.Shape = Enum.PartType.Cylinder
beam.Material = Enum.Material.Neon
beam.Color = Color3.fromRGB(51, 224, 255)
beam.Transparency = 1
beam.Size = Vector3.new(70 * S, 12 * S, 12 * S)
beam.Parent = Workspace.CurrentCamera

-- the traffic car within 5.5 m, if any
function Duel.nearCar()
	local best, bd = nil, 5.5
	for _, c in ipairs(Traffic.agents) do
		local d = math.sqrt((c.x - st.x) ^ 2 + (c.z - st.z) ^ 2)
		if d < bd then
			best, bd = c, d
		end
	end
	return best
end

-- the road ahead: from the current edge, at each junction the straightest way on, until 650 m
local function travsAhead(near, d)
	local trs = { { e = near.e, d = d } }
	local len = d > 0 and near.e.len - near.u or near.u
	local cur = trs[1]
	while len < 650 do
		local e = cur.e
		local n = e.n
		local hx, hz
		if cur.d > 0 then
			hx, hz = e.x[n] - e.x[math.max(1, n - 2)], e.z[n] - e.z[math.max(1, n - 2)]
		else
			hx, hz = e.x[1] - e.x[math.min(n, 3)], e.z[1] - e.z[math.min(n, 3)]
		end
		local hl = math.max(math.sqrt(hx * hx + hz * hz), 1e-6)
		local best, bc = nil, -9
		for _, o in ipairs(State.road.nodes[cur.d > 0 and e.b or e.a].out) do
			if not (o.e == e and o.d == -cur.d) then
				local oe = o.e
				local k2 = math.min(3, oe.n)
				local dx, dz
				if o.d > 0 then
					dx, dz = oe.x[k2] - oe.x[1], oe.z[k2] - oe.z[1]
				else
					dx, dz = oe.x[oe.n + 1 - k2] - oe.x[oe.n], oe.z[oe.n + 1 - k2] - oe.z[oe.n]
				end
				local cs = (hx * dx + hz * dz) / (hl * math.max(math.sqrt(dx * dx + dz * dz), 1e-6))
				if cs > bc then
					bc, best = cs, o
				end
			end
		end
		if not best then break end
		trs[#trs + 1] = best
		len += best.e.len
		cur = best
	end
	return trs
end

function Duel.active()
	return duel ~= nil
end

local function finish(msg)
	if not duel then return end
	if duel.rival then Traffic.remove(duel.rival) end
	table.clear(Duel.rivals)
	-- the traffic car goes back to traffic
	if duel.src then duel.src.x = 1e5 end
	duel = nil
	State.mission = nil
	State.frozen = false
	State.raceMark = nil
	beam.Transparency = 1
	Hud.mission.Text = ""
	if msg then Hud.toast(msg) end
end
Duel.cancel = finish

function Duel.start(c)
	local near = Road.at(State.road, st.x, st.z, 0)
	if not near then
		Hud.toast("Get on a road to start a duel")
		return
	end
	local d = near.e.ow and 1 or ((math.sin(st.h) * near.tx + math.cos(st.h) * near.tz) >= 0 and 1 or -1)
	local P = Road.path(travsAhead(near, d), nil)
	local s0 = d > 0 and near.u or near.e.len - near.u
	local endS = math.min(P.c[#P.c], s0 + 720)
	local dx, dz = Road.sample(P, endS, 1)
	local _, _, _, tx, tz = Road.sample(P, s0, 1)
	-- the player on the line facing along it, the rival 3.6 m to the left
	st.h = math.atan2(tx, tz)
	st.vx, st.vz, st.vy = 0, 0, 0
	-- the rival's car: one of the web game's sports catalogue (11_race: a random index below NRACE)
	local rv = Traffic.agent("rival", Config.CARS[Rules.racers[math.random(#Rules.racers)]])
	rv.P, rv.s, rv.pi, rv.skill, rv.lane = P, s0, 1, 1, 0
	rv.endS = endS
	local fx, fz = math.sin(st.h), math.cos(st.h)
	rv.x, rv.z, rv.h, rv.y = st.x + fz * 3.6, st.z - fx * 3.6, st.h, st.y
	rv.offX, rv.offZ = fz * 3.6, -fx * 3.6
	Traffic.draw(rv)
	-- the challenged traffic car leaves the road while its driver races
	c.x, c.z = 1e5, 1e5
	Traffic.draw(c)
	Duel.rivals[1] = rv
	duel = { rival = rv, src = c, dest = { dx, dz }, s = "count", t = 3.99 }
	State.mission = "duel"
	State.frozen = true
	State.raceMark = duel.dest
	Hud.toast("Duel vs " .. rv.name .. "! First to the beam wins")
end

function Duel.step(dt)
	if not duel then return end
	local rv = duel.rival
	if duel.s == "count" then
		duel.t -= dt
		Hud.mission.Text = "Duel · starts in " .. math.ceil(duel.t)
		if duel.t <= 0 then
			duel.s = "run"
			State.frozen = false
			Hud.toast("GO!", 1.5)
		end
	elseif duel.s == "run" or duel.s == "done" then
		-- the rival drives the line (its lateral offset fades out over the first 50 m)
		local fin = rv.s >= rv.endS - 1
		Traffic.follow(rv, dt, fin and 0 or math.min(rv.vm, Traffic.curveCap(rv, 10)))
		local k = math.max(0, 1 - (rv.s - (rv.endS - 720)) / 50)
		rv.x += (rv.offX or 0) * k
		rv.z += (rv.offZ or 0) * k
		Traffic.draw(rv)
		if duel.s == "run" then
			if not rv.fin and (duel.dest[1] - rv.x) ^ 2 + (duel.dest[2] - rv.z) ^ 2 < 16 * 16 then rv.fin = true end
			if rv.fin then
				duel.s, duel.t = "done", 6
				Hud.toast("You lost the duel")
			elseif (duel.dest[1] - st.x) ^ 2 + (duel.dest[2] - st.z) ^ 2 < 18 * 18 then
				duel.s, duel.t = "done", 6
				Hud.toast("You won the duel!")
			else
				Hud.mission.Text = "Duel · " .. math.floor(math.sqrt((duel.dest[1] - st.x) ^ 2 + (duel.dest[2] - st.z) ^ 2)) .. " m to the beam"
			end
		else
			duel.t -= dt
			if duel.t <= 0 then
				finish()
				return
			end
		end
	end
	local gy = Drive.groundY(duel.dest[1], duel.dest[2], st.y + 80) or st.y
	beam.CFrame = CFrame.new(duel.dest[1] * S, (gy + 35) * S, duel.dest[2] * S) * CFrame.Angles(0, 0, math.pi / 2)
	beam.Transparency = 0.7
end

return Duel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX124"><Properties><string name="Name">Extras</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the web game's other keys: K landmark tour (the next of its tour stops, when no heist is on), J the stunt
-- ramps, T +1 hour, N / B next / previous owned car, X horn (CarAudio; a traffic car still sitting after a knock moves off, as in the web game).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Rules = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Rules"))
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("Hud"))
local Drive = require(Client:WaitForChild("Drive"))
local CarInfo = require(Client:WaitForChild("CarInfo"))
local CarAudio = require(Client:WaitForChild("CarAudio"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Extras = {}
local plr = Players.LocalPlayer
local tourI = 0

function Extras.tour()
	if State.mission == "heist" or #Rules.tour == 0 then return end
	tourI = tourI % #Rules.tour + 1
	local L = Rules.tour[tourI]
	Drive.place(L.x, L.z, L.h)
	Hud.toast("📍 " .. L.n)
end

function Extras.ramps()
	if State.mission == "heist" then return end
	local r = Rules.ramps[1]
	if not r then
		Hud.toast("The stunt ramps are outside the Roblox map")
		return
	end
	-- the web game: 50 m east and 70 m north of the first ramp, facing +z (south) up the middle ramp
	Drive.place(r.x + 50, r.z - 70, 0)
end

function Extras.hour()
	Remotes.AddHour:FireServer()
end

function Extras.cycleCar(dir)
	if State.mission then return end
	local list = {}
	for i in pairs(CarInfo.owned()) do list[#list + 1] = i end
	table.sort(list)
	if #list < 2 then
		Hud.toast("You own one car: win more on the wheel (G) or buy one in the garage (V)")
		return
	end
	local cur = plr:GetAttribute("CurCar") or 1
	local k = 1
	for j, i in ipairs(list) do
		if i == cur then k = j end
	end
	local nxt = list[(k - 1 + dir) % #list + 1]
	task.spawn(function()
		local ok, msg = Remotes.CarAction:InvokeServer("use", nxt)
		Hud.toast(ok and ("🚗 " .. tostring(msg)) or tostring(msg))
	end)
end

function Extras.horn(on)
	CarAudio.horn(on)
	if not on then return end
	-- the web game's hornSet: a traffic car up to 22 m ahead in the lane, still held after a knock, moves off
	local st = State.st
	local fx, fz = math.sin(st.h), math.cos(st.h)
	for _, a in ipairs(State.ai) do
		if a.kind == "traffic" and (a.hit or 0) > 0.4 then
			local dx, dz = a.x - st.x, a.z - st.z
			local f = dx * fx + dz * fz
			if f > 0 and f < 22 and math.abs(dx * fz - dz * fx) < 3 then a.hit = 0.4 end
		end
	end
end

return Extras
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX125"><Properties><string name="Name">Gamepad</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - gamepads and racing wheels (the web game's 10c_wheel.js input path, ported to what Roblox exposes).
-- Roblox reads gamepads only (XInput-style: two sticks, two triggers, buttons); it has no access to HID devices, so a Logitech G29 is
-- seen only through a layer that presents it as a gamepad (Steam Input or x360ce: steering on a stick axis, pedals on the triggers or
-- on a stick axis). Force feedback is not available; the web game's fallback for pads without force feedback (a short rumble on impacts
-- and hard landings) is used instead (HapticService).
-- The steering value goes through the web game's processing, in this order: invert, centre offset, sensitivity (the web game's
-- range / lock), dead zone, response curve, smoothing. Pedals: dead zone at both ends. Buttons call the same actions as the keys
-- (one code path, as in the web game); every binding is a setting (the settings menu cycles through the buttons).
-- Gamepad.state = {on, steer (-1..1, + = right, like the web wheel), thr, brk (0..1), hb, raw}
local UserInputService = game:GetService("UserInputService")
local HapticService = game:GetService("HapticService")
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Settings = require(Client:WaitForChild("Settings"))

local Gamepad = {}
local PAD = Enum.UserInputType.Gamepad1
local S = { on = false, steer = 0, thr = 0, brk = 0, hb = false, raw = 0 }
Gamepad.state = S
-- the raw axes: sticks -1..1 (y up = +), triggers 0..1
local ax = { lx = 0, ly = 0, rx = 0, ry = 0, l2 = 0, r2 = 0 }
Gamepad.axes = ax
-- the bindable buttons (setting value -> KeyCode); the order is the settings' value order
Gamepad.BUTTONS = { Enum.KeyCode.ButtonA, Enum.KeyCode.ButtonB, Enum.KeyCode.ButtonX, Enum.KeyCode.ButtonY, Enum.KeyCode.ButtonL1, Enum.KeyCode.ButtonR1,
	Enum.KeyCode.ButtonL3, Enum.KeyCode.ButtonR3, Enum.KeyCode.DPadUp, Enum.KeyCode.DPadDown, Enum.KeyCode.DPadLeft, Enum.KeyCode.DPadRight }
-- action -> setting key (the defaults are in the settings schema: A handbrake, RB / LB gears, Y camera, X horn, B race, R3 start,
-- L3 tour, d-pad: up GPS, down settings, right / left next / previous car)
Gamepad.BIND = { hb = "bhb", up = "bup", down = "bdn", camera = "bcam", horn = "bhorn", race = "brace", reset = "breset", tour = "btour",
	gps = "bgps", settings = "bset", nextCar = "bnext", prevCar = "bprev" }
local held = {}
local actions = nil

Settings.provide("gs", "gp", "ginv", "gsens", "gdz", "gcen", "gcurve", "gsm", "gpdz", "grum")
for _, k in pairs(Gamepad.BIND) do Settings.provide(k) end

-- which action a button is bound to (nil = none)
local function actionOf(code)
	for a, k in pairs(Gamepad.BIND) do
		local v = Settings.get(k)
		if v >= 0 and Gamepad.BUTTONS[v + 1] == code then return a end
	end
	return nil
end

local function onInput(io, down)
	if io.UserInputType ~= PAD then return end
	S.on = true
	local kc = io.KeyCode
	if kc == Enum.KeyCode.Thumbstick1 then
		ax.lx, ax.ly = io.Position.X, io.Position.Y
	elseif kc == Enum.KeyCode.Thumbstick2 then
		ax.rx, ax.ry = io.Position.X, io.Position.Y
	elseif kc == Enum.KeyCode.ButtonL2 then
		ax.l2 = down == false and 0 or io.Position.Z
	elseif kc == Enum.KeyCode.ButtonR2 then
		ax.r2 = down == false and 0 or io.Position.Z
	elseif down ~= nil then
		held[kc] = down
		local a = actionOf(kc)
		if a and actions then
			if a == "hb" then
				-- held (read every frame)
			elseif a == "horn" then
				if actions.horn then actions.horn(down) end
			elseif down and actions[a] then
				actions[a]()
			end
		end
	end
end

-- acts = the same action table as the keys (Controls.start)
function Gamepad.bind(acts)
	actions = acts
end

UserInputService.InputBegan:Connect(function(io) onInput(io, true) end)
UserInputService.InputEnded:Connect(function(io) onInput(io, false) end)
UserInputService.InputChanged:Connect(function(io) onInput(io, nil) end)
UserInputService.GamepadDisconnected:Connect(function(pad)
	if pad == PAD then
		S.on, S.steer, S.thr, S.brk, S.hb = false, 0, 0, 0, false
		for k in pairs(ax) do ax[k] = 0 end
		table.clear(held)
	end
end)

local function pedal(v, dz)
	v = math.clamp(v, 0, 1)
	return v < dz and 0 or math.min(1, (v - dz) / (1 - 2 * dz))
end

-- every frame (from Controls.read)
function Gamepad.poll(dt)
	if not S.on then return S end
	-- steering (the web game's poll): axis, invert, centre offset, sensitivity, dead zone, curve, smoothing
	local a = Settings.get("gs") == 1 and ax.rx or ax.lx
	if Settings.get("ginv") == 1 then a = -a end
	S.raw = a
	local n = math.clamp((a - Settings.get("gcen") / 100) * Settings.get("gsens") / 10, -1, 1)
	local d = Settings.get("gdz") / 100
	n = math.abs(n) < d and 0 or math.sign(n) * (math.abs(n) - d) / (1 - d)
	local cv = Settings.get("gcurve") / 10
	if cv > 1 then n = math.sign(n) * math.abs(n) ^ cv end
	local sm = Settings.get("gsm") * 0.02
	S.steer = sm > 0 and S.steer + (n - S.steer) * (1 - math.exp(-dt / sm)) or n
	-- pedals: the triggers (R2 gas, L2 brake) or one stick's up / down
	local pdz = Settings.get("gpdz") / 100
	local mode = Settings.get("gp")
	if mode == 0 then
		S.thr, S.brk = pedal(ax.r2, pdz), pedal(ax.l2, pdz)
	else
		local y = mode == 1 and ax.ry or ax.ly
		S.thr, S.brk = pedal(y, pdz), pedal(-y, pdz)
	end
	local hbk = Settings.get("bhb")
	S.hb = hbk >= 0 and held[Gamepad.BUTTONS[hbk + 1]] == true and not State.ui
	return S
end

-- the web game's rumble fallback: a short pulse on a hard impact (speed change > 3 m/s in one frame above 5 m/s) or a hard landing
local FF = { pvx = 0, pvz = 0, px = 0, pz = 0, pv = 0, air = false, vyp = 0, imp = 0, impT = 9, rum = 0, t = 0 }
local vib = nil
function Gamepad.rumble(dt)
	FF.t += dt
	if not S.on or Settings.get("grum") == 0 then return end
	if vib == nil then
		vib = false
		pcall(function() vib = HapticService:IsVibrationSupported(PAD) and HapticService:IsMotorSupported(PAD, Enum.VibrationMotor.Large) end)
	end
	local st = State.st
	local vx, vz = st.vx, st.vz
	local v = math.sqrt(vx * vx + vz * vz)
	local dvx, dvz = vx - FF.pvx, vz - FF.pvz
	local dv = math.sqrt(dvx * dvx + dvz * dvz)
	local tele = math.sqrt((st.x - FF.px) ^ 2 + (st.z - FF.pz) ^ 2) > math.max(4, v * dt * 3)
	local ie = FF.imp * math.exp(-FF.impT * 9)
	if not tele and FF.pv > 5 and dv > 3 then
		local m = math.min(1, dv / 10)
		if m > ie then FF.imp, FF.impT = m, 0 end
	end
	if st.gnd and FF.air and FF.vyp < -3 then
		local m = math.min(0.8, -FF.vyp / 10)
		if m > FF.imp * math.exp(-FF.impT * 9) then FF.imp, FF.impT = m, 0 end
	end
	FF.air = not st.gnd
	if not st.gnd then FF.vyp = st.vy end
	FF.pvx, FF.pvz, FF.px, FF.pz, FF.pv = vx, vz, st.x, st.z, v
	ie = FF.imp * math.exp(-FF.impT * 9)
	FF.impT += dt
	Gamepad.lastRumble = Gamepad.lastRumble or 0
	if ie > 0.25 and FF.t - FF.rum > 0.16 then
		FF.rum = FF.t
		Gamepad.lastRumble = math.min(1, ie)
		if vib then
			pcall(function() HapticService:SetMotor(PAD, Enum.VibrationMotor.Large, math.min(1, ie)) end)
			task.delay(0.11, function()
				pcall(function() HapticService:SetMotor(PAD, Enum.VibrationMotor.Large, 0) end)
			end)
		end
	end
end

return Gamepad
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX126"><Properties><string name="Name">Garage</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the garage menu (key G): every car with its rarity, top speed and price; buy or switch cars (the server
-- does it); the Robux buttons when their IDs are set in Config.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local CarInfo = require(script.Parent:WaitForChild("CarInfo"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Garage = {}
local plr = Players.LocalPlayer
local fmt = Hud.fmt

function Garage.open()
	if Hud.isOpen("Garage") then
		Hud.closePanel()
		return
	end
	local p = Hud.panel("Garage", 400, 400)
	local function fill()
		for _, ch in ipairs(p.list:GetChildren()) do
			if ch:IsA("GuiObject") then ch:Destroy() end
		end
		p.sub.Text = "Balance: " .. fmt(plr:GetAttribute("Cash") or 0) .. " JD · cars come from this list or the wheel"
		local o = CarInfo.owned()
		for i, c in ipairs(Config.CARS) do
			local km = math.floor(c.vm * 3.6 + 0.5)
			local status = plr:GetAttribute("CurCar") == i and "driving" or o[i] and "use" or c.vip and "VIP pass" or (fmt(c.price) .. " JD")
			local b = Hud.button(p.list, c.name .. " · " .. CarInfo.tierLine(c) .. " · " .. km .. " km/h · " .. status, function()
				local ok, msg = Remotes.CarAction:InvokeServer("buy", i)
				Hud.toast(ok and ("Now driving: " .. tostring(msg)) or tostring(msg))
				fill()
			end, 370, 32, plr:GetAttribute("CurCar") == i and Color3.fromRGB(40, 110, 60) or nil)
			b.TextSize = 13
			b.LayoutOrder = i
			local bar = Instance.new("Frame")
			bar.Size = UDim2.new(0, 6, 1, 0)
			bar.BorderSizePixel = 0
			bar.BackgroundColor3 = Config.TIER_COLORS[c.tier + 1]
			bar.Parent = b
		end
		local k = #Config.CARS
		if Config.PRODUCT_CASH_SMALL ~= 0 then
			Hud.button(p.list, "+" .. fmt(Config.CASH_SMALL) .. " JD (Robux)", function() Remotes.CarAction:InvokeServer("cash_small") end, 370, 32, Color3.fromRGB(0, 140, 80)).LayoutOrder = k + 1
		end
		if Config.PRODUCT_CASH_BIG ~= 0 then
			Hud.button(p.list, "+" .. fmt(Config.CASH_BIG) .. " JD (Robux)", function() Remotes.CarAction:InvokeServer("cash_big") end, 370, 32, Color3.fromRGB(0, 140, 80)).LayoutOrder = k + 2
		end
		if Config.GAMEPASS_VIP ~= 0 and not plr:GetAttribute("VIP") then
			Hud.button(p.list, "VIP pass: double drift JD + the VIP car (Robux)", function() Remotes.CarAction:InvokeServer("vip") end, 370, 32, Color3.fromRGB(180, 140, 0)).LayoutOrder = k + 3
		end
	end
	fill()
end

return Garage
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX127"><Properties><string name="Name">Gps</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the GPS: a route over the real road graph (one-way streets respected) to a place, a trail of dots on the
-- road for the next 300 m, the distance left, a new route when the player leaves this one, "arrived" within 30 m.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Road = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Road"))
local State = require(script.Parent:WaitForChild("State"))
local Hud = require(script.Parent:WaitForChild("Hud"))

local Gps = {}
local S = Config.SCALE
local st = State.st
local nav = nil -- {name, x, z, P (polyline), i (segment index), s (distance along), checkT}
local dots = {}

local function dotPool()
	if #dots > 0 then return end
	for k = 1, 30 do
		local p = Instance.new("Part")
		p.Name = "GpsDot"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(60, 255, 140)
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(0.8, 0.8, 0.8) * S
		p.Transparency = 1
		p.Parent = Workspace.CurrentCamera
		dots[k] = p
	end
end

function Gps.clear()
	nav = nil
	Hud.gps.Text = ""
	for _, p in ipairs(dots) do p.Transparency = 1 end
end

local function plan(target)
	local trs, s0 = Road.routeFrom(State.road, st.x, st.z, math.sin(st.h), math.cos(st.h), target.x, target.z)
	if not trs then return nil end
	local P = Road.path(trs, Road.lane)
	local _, _, i = Road.project(P, st.x, st.z, 1, #P.x)
	return P, i, s0, trs
end

-- target = a place {n, x, z} -> true when a route was found
function Gps.go(target)
	local P, i, _, trs = plan(target)
	if not P then
		Hud.toast("No route found to " .. target.n)
		return false
	end
	dotPool()
	-- trs: the route's traversals (auto-drive follows their centre line)
	nav = { name = target.n, x = target.x, z = target.z, P = P, i = i, trs = trs, checkT = 1 }
	Hud.toast("GPS: route to " .. target.n, 2.5)
	return true
end

-- the current route (or nil): {name, x, z, P, i, s}
function Gps.route()
	return nav
end

function Gps.step(dt)
	if not nav then return end
	local P = nav.P
	local s, d, i = Road.project(P, st.x, st.z, nav.i - 3, nav.i + 40)
	nav.i, nav.s = i, s
	local left = P.c[#P.c] - s + math.sqrt((nav.x - P.x[#P.x]) ^ 2 + (nav.z - P.z[#P.z]) ^ 2)
	if math.sqrt((nav.x - st.x) ^ 2 + (nav.z - st.z) ^ 2) < 30 then
		Hud.toast("You have arrived: " .. nav.name, 4)
		Gps.clear()
		return
	end
	-- left the route: plan again (at most once a second)
	nav.checkT -= dt
	if d > 35 and nav.checkT <= 0 then
		nav.checkT = 1
		local P2, i2, _, trs2 = plan(nav)
		if P2 then
			nav.P, nav.i, nav.trs, P, i = P2, i2, trs2, P2, i2
			s = Road.project(P, st.x, st.z, i, i + 1)
			nav.s = s
		end
	end
	Hud.gps.Text = "📍 GPS: " .. nav.name .. " · " .. (left >= 1000 and string.format("%.1f km", left / 1000) or (math.floor(left / 10) * 10 .. " m"))
	-- dots every 10 m for the next 300 m
	for k, p in ipairs(dots) do
		local sd = s + 8 + (k - 1) * 10
		if sd < P.c[#P.c] then
			local x, z, y = Road.sample(P, sd, i)
			p.Position = Vector3.new(x, y + 0.9, z) * S
			p.Transparency = 0.15
		else
			p.Transparency = 1
		end
	end
end

return Gps
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX128"><Properties><string name="Name">Ground</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the ground, as in the web game. The car physics does not ride on Roblox parts: like the web game it uses the
-- terrain height TH (SRTM, a 25 m grid exported from the web game, interpolated), + 0.12 m, + the stunt ramps (groundH), and the
-- speed bump profiles (bumpAt). Walls are ray tests against the buildings. Units: metres.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Shared = ReplicatedStorage:WaitForChild("IrbidShared")
local Rules = require(Shared:WaitForChild("Rules"))
local HG = require(Shared:WaitForChild("Heights"))

local Ground = {}
local S = Config.SCALE

-- the height grid (decimetres)
local H = {}
do
	local i = 1
	while Shared:FindFirstChild("HeightData" .. i) do
		for n in string.gmatch(require(Shared["HeightData" .. i]), "-?%d+") do H[#H + 1] = tonumber(n) / 10 end
		i += 1
	end
end
local N, C, X0, Z0 = HG.n, HG.cell, HG.x0, HG.z0

-- terrain height at (x, z): bilinear in the 25 m grid
function Ground.TH(x, z)
	local fx, fz = (x - X0) / C, (z - Z0) / C
	local i, j = math.clamp(math.floor(fx), 0, N - 2), math.clamp(math.floor(fz), 0, N - 2)
	local u, v = math.clamp(fx - i, 0, 1), math.clamp(fz - j, 0, 1)
	local a, b = H[j * N + i + 1], H[j * N + i + 2]
	local c, d = H[(j + 1) * N + i + 1], H[(j + 1) * N + i + 2]
	return (a * (1 - u) + b * u) * (1 - v) + (c * (1 - u) + d * u) * v
end

-- the web game's groundH: terrain + 0.12 m, raised on the stunt ramps (each rises linearly along +z over its length)
local RAMPS = Rules.ramps
function Ground.groundH(x, z)
	local h = Ground.TH(x, z) + 0.12
	for _, r in ipairs(RAMPS) do
		if math.abs(x - r.x) < r.w / 2 and z > r.z - r.l / 2 and z < r.z + r.l / 2 then
			h = r.y + 0.12 + r.h * (z - (r.z - r.l / 2)) / r.l
		end
	end
	return h
end

-- speed bumps: height of the bump surface above the road at (x, z) (profile H cos^2(pi u / len)), through a 50 m hash
local SBH = {}
for _, b in ipairs(Rules.bumps) do
	for i = -1, 1 do
		for j = -1, 1 do
			local k = (math.floor(b.x / 50) + i) * 100000 + math.floor(b.z / 50) + j
			SBH[k] = SBH[k] or {}
			table.insert(SBH[k], b)
		end
	end
end
function Ground.bumpAt(x, z)
	local L = SBH[math.floor(x / 50) * 100000 + math.floor(z / 50)]
	if not L then return 0 end
	local h = 0
	for _, b in ipairs(L) do
		local dx, dz = x - b.x, z - b.z
		local al = dx * b.tx + dz * b.tz
		if al > -b.l / 2 and al < b.l / 2 and math.abs(dx * b.tz - dz * b.tx) <= b.w / 2 then
			local c = math.cos(math.pi * al / b.l)
			h = math.max(h, b.h * c * c)
		end
	end
	return h
end
Ground.anyBumps = #Rules.bumps > 0

-- built-up ground (the web game's urbanK > 0.5), for the off-road grip
local U = Rules.urban
function Ground.urban(x, z)
	local i, j = math.floor((x - U.x0) / U.cell), math.floor((z - U.z0) / U.cell)
	if i < 0 or j < 0 or i >= U.n or j >= U.n then return false end
	local k = j * U.n + i + 1
	return string.sub(U.bits, k, k) == "1"
end

-- ray tests against the map parts (the race beam and police cars use the visible ground)
local map = Workspace:WaitForChild("IrbidMap")
local groundP = RaycastParams.new()
groundP.FilterType = Enum.RaycastFilterType.Include
local list = { map:WaitForChild("Roads"), map:WaitForChild("Ground") }
local terrain = Workspace:FindFirstChildOfClass("Terrain")
if terrain then list[#list + 1] = terrain end
groundP.FilterDescendantsInstances = list
local wallP = RaycastParams.new()
wallP.FilterType = Enum.RaycastFilterType.Include
wallP.FilterDescendantsInstances = { map:WaitForChild("Buildings") }

-- the visible ground under (x, z) looking down from yTop at most `len` metres -> height (m) or nil, ray result
function Ground.below(x, z, yTop, len)
	local g = Workspace:Raycast(Vector3.new(x, yTop, z) * S, Vector3.new(0, -(len or 400) * S, 0), groundP)
	return g and g.Position.Y / S, g
end

-- the first building wall from (x, y, z) along (dx, dz) (unit) within `len` metres -> ray result or nil
function Ground.wall(x, y, z, dx, dz, len)
	local hit = Workspace:Raycast(Vector3.new(x, y, z) * S, Vector3.new(dx, 0, dz) * len * S, wallP)
	if hit and hit.Normal.Y < 0.6 then return hit end
	return nil
end

return Ground
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX129"><Properties><string name="Name">Handling</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the handling settings on the car (the web game's 07g / 11c keys and pause-menu rows): H Arcade / Realistic,
-- Q / E manual gears (E robs the bank instead when the car is next to it, as in the web game), the gearbox (Automatic / Manual), ABS,
-- traction control, stability control, tyre temperature and brake fade. The values live in Settings (saved with the progress) and
-- are applied to the physics state (Drive.phys).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CarPhysics = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("CarPhysics"))
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("Hud"))
local Drive = require(Client:WaitForChild("Drive"))
local Settings = require(Client:WaitForChild("Settings"))
local Heist = require(Client:WaitForChild("Heist"))

local Handling = {}
local P = Drive.phys

Settings.provide("hm", "gb", "abs", "tc", "esc", "tt", "bf")
Settings.onChange(function(k, v)
	if k == "hm" then
		if P.mode ~= v then
			P.mode = v
			-- the web game's setHandling: gearbox back to first, body springs at rest
			CarPhysics.resetRealistic(P)
		end
	elseif k == "gb" then
		P.pts.man, P.pts.req = v, 0
	elseif k == "abs" then
		P.assist.abs = v == 1
	elseif k == "tc" then
		P.assist.tc = v == 1
	elseif k == "esc" then
		P.assist.esc = v == 1
	elseif k == "tt" then
		P.simx.tt = v == 1
	elseif k == "bf" then
		P.simx.bf = v == 1
	end
end)

-- H
function Handling.toggle()
	Settings.set("hm", 1 - Settings.get("hm"))
	Hud.toast(Settings.get("hm") == 1 and "Handling: Realistic (engine, gears, traction, suspension; estimates)" or "Handling: Arcade")
end

-- Q (d = -1) / E (d = +1) / gamepad: a gear request (the web game's gearKey); the first one selects the manual gearbox
function Handling.shift(d)
	local s = State.spec.pt
	if P.mode == 1 and s and not s.ev and s.ng >= 2 and Settings.get("gb") == 0 then
		Settings.set("gb", 1)
		Hud.toast("Gearbox: Manual (Q down · E up · gamepad LB / RB)")
	end
	local msg = CarPhysics.requestShift(State.spec, P, d)
	if msg and P.mode ~= 1 then Hud.toast(msg) end
	if msg and P.mode == 1 and (s.ev or s.ng < 2) then Hud.toast(msg) end
end

-- E: rob the bank when the car is next to it and no heist is running, else shift up
function Handling.eKey(rob)
	if Heist.nearBank() and State.mission ~= "heist" then
		rob()
	else
		Handling.shift(1)
	end
end

-- a refused downshift (the web game's message)
function Handling.step()
	if P.pts.deny ~= 0 then
		P.pts.deny = 0
		Hud.toast("Downshift refused: the engine would over-rev")
	end
end

return Handling
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX130"><Properties><string name="Name">Heist</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the bank heist (the web game's rules): E at the bank starts it; survive the police for 2:00. More police join
-- over time (4, then one more every 25 s, up to 8). 2.5 s within 7 m of a police car = caught (the meter drains twice as fast).
-- The server pays +500 for an escape, takes up to 50 when caught, and closes the bank for 3:00.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Meta = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Meta"))
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("Hud"))
local Police = require(Client:WaitForChild("Police"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Heist = {}
local st = State.st
local heist = nil -- {t (seconds left), catch (seconds near police)}

function Heist.nearBank()
	return (Meta.bank.x - st.x) ^ 2 + (Meta.bank.z - st.z) ^ 2 < 14 * 14
end

function Heist.rob()
	if State.ui or heist or not Heist.nearBank() then return end
	if State.mission ~= nil then
		Hud.toast("Finish the race first")
		return
	end
	local ok, err = Remotes.Mission:InvokeServer("heist_start")
	if not ok then
		Hud.toast(tostring(err))
		return
	end
	heist = { t = Config.HEIST_TIME, catch = 0 }
	State.mission = "heist"
	Hud.toast("🚨 Bank robbed! Stay away from the police for 2:00", 4)
end

local function finish(escaped)
	Police.clear()
	heist = nil
	State.mission = nil
	Hud.mission.Text = ""
	local ok, amount = Remotes.Mission:InvokeServer("heist_end", escaped)
	if escaped then
		Hud.toast(ok and ("Escaped! +" .. Hud.fmt(amount) .. " JD") or "Escaped!", 5)
	else
		st.vx *= 0.2
		st.vz *= 0.2
		Hud.toast("Busted! " .. (ok and Hud.fmt(amount) or "") .. " JD", 5)
	end
end

function Heist.step(dt)
	if not heist then return end
	heist.t -= dt
	if #Police.cops < math.min(8, 4 + math.floor((Config.HEIST_TIME - heist.t) / 25)) then Police.spawn() end
	local near = Police.step(dt)
	heist.catch = near and heist.catch + dt or math.max(0, heist.catch - dt * 2)
	if heist.catch >= 2.5 then
		finish(false)
		return
	end
	if heist.t <= 0 then
		finish(true)
		return
	end
	local m, s = math.floor(heist.t / 60), math.floor(heist.t % 60)
	Hud.mission.Text = string.format("🚨 ROBBERY · survive %d:%02d · police %d · caught %d%%", m, s, #Police.cops, math.floor(heist.catch / 2.5 * 100))
end

function Heist.current()
	return heist
end

return Heist
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX131"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the on-screen display: info line, speed, drift, mission line, toasts, the context button (rob the bank /
-- tune the car), the button column, and a helper for the menus (garage, shop, wheel, GPS). Sizes in pixels, so it also fits phones.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local State = require(script.Parent:WaitForChild("State"))

local Hud = {}
local plr = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "IrbidHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = plr:WaitForChild("PlayerGui")
Hud.gui = gui

local DARK = Color3.fromRGB(21, 24, 29)
local BLUE = Color3.fromRGB(39, 64, 107)

function Hud.fmt(n)
	local s = tostring(math.floor(n + 0.5))
	local neg = string.sub(s, 1, 1) == "-"
	if neg then s = string.sub(s, 2) end
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1,")))
	if string.sub(out, 1, 1) == "," then out = string.sub(out, 2) end
	return (neg and "-" or "") .. out
end

function Hud.label(parent, pos, size, anchor, txt, ts)
	local t = Instance.new("TextLabel")
	t.Position = pos
	t.Size = size
	t.AnchorPoint = anchor
	t.BackgroundTransparency = 1
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.4
	t.Font = Enum.Font.GothamBold
	t.TextScaled = true
	t.Text = txt
	t.Parent = parent
	if ts then
		local c = Instance.new("UITextSizeConstraint")
		c.MaxTextSize = ts
		c.Parent = t
	end
	return t
end

function Hud.button(parent, txt, cb, w, h, color)
	local b = Instance.new("TextButton")
	b.Size = UDim2.fromOffset(w or 310, h or 34)
	b.BackgroundColor3 = color or BLUE
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 15
	b.TextWrapped = true
	b.AutoButtonColor = true
	b.Text = txt
	b.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = b
	b.Activated:Connect(cb)
	return b
end

-- ---- fixed HUD ----
Hud.info = Hud.label(gui, UDim2.new(0.5, 0, 0, 4), UDim2.fromOffset(760, 40), Vector2.new(0.5, 0), "IRBID DRIVE", 15)
Hud.info.TextWrapped = true
Hud.speed = Hud.label(gui, UDim2.new(1, -20, 1, -70), UDim2.fromOffset(200, 60), Vector2.new(1, 1), "0", 54)
Hud.label(gui, UDim2.new(1, -20, 1, -50), UDim2.fromOffset(200, 22), Vector2.new(1, 1), "km/h", 18)
Hud.drift = Hud.label(gui, UDim2.new(0.5, 0, 0, 48), UDim2.fromOffset(460, 36), Vector2.new(0.5, 0), "", 30)
Hud.mission = Hud.label(gui, UDim2.new(0.5, 0, 0, 86), UDim2.fromOffset(620, 26), Vector2.new(0.5, 0), "", 20)
Hud.mission.TextColor3 = Color3.fromRGB(255, 220, 120)
Hud.gps = Hud.label(gui, UDim2.new(0.5, 0, 0, 114), UDim2.fromOffset(620, 22), Vector2.new(0.5, 0), "", 17)
Hud.gps.TextColor3 = Color3.fromRGB(120, 255, 160)
local toastL = Hud.label(gui, UDim2.new(0.5, 0, 0, 140), UDim2.fromOffset(620, 30), Vector2.new(0.5, 0), "", 22)
local credit = Hud.label(gui, UDim2.new(0.5, 0, 1, -4), UDim2.fromOffset(520, 16), Vector2.new(0.5, 1),
	Workspace:GetAttribute("Attribution") or "Map data © OpenStreetMap contributors (ODbL)", 13)
credit.TextStrokeTransparency = 0.6
Hud.car = Hud.label(gui, UDim2.new(1, -20, 1, -128), UDim2.fromOffset(330, 20), Vector2.new(1, 1), "", 16)
-- Realistic handling: gear, rpm, assists acting, temperatures (the web game's line under the speed)
Hud.gear = Hud.label(gui, UDim2.new(1, -20, 1, -150), UDim2.fromOffset(420, 18), Vector2.new(1, 1), "", 15)
Hud.gear.TextXAlignment = Enum.TextXAlignment.Right
-- auto-drive (Z): target speed and why (the web game's badge above the bottom edge)
Hud.ap = Hud.label(gui, UDim2.new(0.5, 0, 1, -64), UDim2.fromOffset(420, 22), Vector2.new(0.5, 1), "", 15)
Hud.ap.TextColor3 = Color3.fromRGB(140, 190, 255)
Hud.car.TextXAlignment = Enum.TextXAlignment.Right

local toastT = 0
function Hud.toast(s, secs)
	toastL.Text = s
	toastT = secs or 3.5
end

-- context button (bottom centre): shown near the bank / the tuning shop / a race start
local ctxB = Hud.button(gui, "", function() end, 230, 46, Color3.fromRGB(200, 60, 40))
ctxB.AnchorPoint = Vector2.new(0.5, 1)
ctxB.Position = UDim2.new(0.5, 0, 1, -30)
ctxB.TextSize = 18
ctxB.Visible = false
local ctxCb
ctxB.Activated:Connect(function()
	if ctxCb then ctxCb() end
end)
function Hud.context(text, cb, color)
	if text and not State.ui then
		ctxB.Text = text
		ctxB.BackgroundColor3 = color or Color3.fromRGB(200, 60, 40)
		ctxB.Visible = true
		ctxCb = cb
	else
		ctxB.Visible = false
		ctxCb = nil
	end
end

-- button column (left)
local col = Instance.new("Frame")
col.BackgroundTransparency = 1
col.Position = UDim2.new(0, 12, 0, 56)
col.Size = UDim2.fromOffset(124, 300)
col.Parent = gui
local cl = Instance.new("UIListLayout")
cl.Padding = UDim.new(0, 6)
cl.Parent = col
function Hud.sideButton(txt, cb)
	return Hud.button(col, txt, cb, 124, 32)
end

-- ---- menus: one open at a time; while one is open the car does not take input ----
local open
function Hud.panel(title, w, h)
	if open then open.close() end
	local f = Instance.new("Frame")
	f.Size = UDim2.fromOffset(w or 360, h or 330)
	f.Position = UDim2.fromScale(0.5, 0.5)
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.BackgroundColor3 = DARK
	f.BackgroundTransparency = 0.05
	f.Parent = gui
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 10)
	c.Parent = f
	local t = Hud.label(f, UDim2.new(0.5, 0, 0, 8), UDim2.new(1, -60, 0, 26), Vector2.new(0.5, 0), title, 20)
	t.TextStrokeTransparency = 1
	local sub = Hud.label(f, UDim2.new(0.5, 0, 0, 36), UDim2.new(1, -24, 0, 18), Vector2.new(0.5, 0), "", 14)
	sub.Font = Enum.Font.Gotham
	sub.TextStrokeTransparency = 1
	sub.TextColor3 = Color3.fromRGB(200, 205, 215)
	local list = Instance.new("ScrollingFrame")
	list.Position = UDim2.fromOffset(10, 60)
	list.Size = UDim2.new(1, -20, 1, -70)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 6
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	list.Parent = f
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, 6)
	l.HorizontalAlignment = Enum.HorizontalAlignment.Center
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = list
	local p = { frame = f, list = list, sub = sub, title = title }
	function p.close()
		if open == p then
			open = nil
			State.ui = nil
		end
		f:Destroy()
	end
	local x = Hud.button(f, "✕", p.close, 34, 30, Color3.fromRGB(90, 40, 40))
	x.Position = UDim2.new(1, -40, 0, 6)
	open = p
	State.ui = title
	Hud.context(nil)
	return p
end
function Hud.closePanel()
	if open then open.close() end
end
function Hud.isOpen(title)
	return open ~= nil and open.title == title
end

function Hud.step(dt)
	if toastT > 0 then
		toastT -= dt
		if toastT <= 0 then toastL.Text = "" end
	end
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX132"><Properties><string name="Name">InfoLine</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the info line at the top: street name, clock, cash, drift bank (5 times a second).
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Client = script.Parent
local Hud = require(Client:WaitForChild("Hud"))
local Nav = require(Client:WaitForChild("Nav"))

local InfoLine = {}
local plr = Players.LocalPlayer
local t = 0

local function clockText()
	local h = Lighting.ClockTime
	return string.format("%02d:%02d", math.floor(h), math.floor((h % 1) * 60))
end

function InfoLine.step(dt)
	t -= dt
	if t > 0 then return end
	t = 0.2
	local street = Nav.streetName()
	Hud.info.Text = "IRBID DRIVE · 📍 " .. (street ~= "" and street or "off-road") .. " · " .. clockText()
		.. " · Balance: " .. Hud.fmt(plr:GetAttribute("Cash") or 0) .. " JD · Drift bank " .. Hud.fmt(plr:GetAttribute("DriftBank") or 0)
end

return InfoLine
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX133"><Properties><string name="Name">Laws</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - traffic laws, the web game's rules and amounts (10_laws_player.js):
--   speeding: more than the street's limit + 10 km/h, counted after 1.5 s on that street             15 JD (at most every 5 s)
--   driving against traffic (one-way the wrong way, or the left lane of a two-way street, > 14 km/h)  20 JD (every 6 s)
--   running a red light at a signalised junction (> 14 km/h)                                          50 JD (every 3 s)
--   collision with traffic (Bump)                                                                     30 JD (every 2 s)
-- No limits and no fines in a drift zone. Like the web game, a fine ADDS to the JD balance (the wheel is paid with "law-breaking JD").
-- The server keeps the amounts and the cool-downs; this module detects the offences and shows them.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Road = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Road"))
local Rules = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Rules"))
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("Hud"))
local Ground = require(Client:WaitForChild("Ground"))
local Signals = require(Client:WaitForChild("Signals"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Laws = { LIMIT = 50, limit = 50 }
local st = State.st
local last = {}
local LIMT = { l = -1, t = 0 }
local curL = nil
local inZone = nil
local AMOUNT = { spd = 15, way = 20, red = 50, hit = 30 }

local function now()
	return Workspace.DistributedGameTime
end

function Laws.fine(k, msg, cd)
	if now() - (last[k] or -99) < cd then return end
	last[k] = now()
	Remotes.Fine:FireServer(k)
	-- road reputation (Reputation.event) hears every fine given
	if Laws.onFine then Laws.onFine(k) end
	Hud.toast(msg .. " — fine " .. AMOUNT[k] .. " JD")
end

function Laws.driftZoneAt(x, z)
	for _, q in ipairs(Rules.dzones) do
		if math.sqrt((x - q.x) ^ 2 + (z - q.z) ^ 2) < q.r then return q end
	end
	return nil
end

-- the web game's wrongWay(): only on one clear road (not alleys, service roads, campus roads, drift pads, roundabouts), not within
-- 18 m of either end; one-way: moving backwards along it; two-way: moving along it on the left half
local NOWRONG = { alley = true, svc = true, campus = true, drift = true, ring = true }
local function wrongWay(s)
	if not s or s.d > s.e.w / 2 or s.n ~= 1 then return false end
	local e = s.e
	if NOWRONG[e.fk] then return false end
	if s.u < 18 or e.len - s.u < 18 then return false end
	local al = st.vx * s.tx + st.vz * s.tz
	if e.ow then return al < -4 end
	return (al > 4 and s.side < -1) or (al < -4 and s.side > 1)
end

-- direction a car arriving along edge e travels into node nd (from the point 14 m back along the edge)
local function approachOf(nd, e)
	local atB = e.b == nd.id
	local s = atB and math.max(0, e.len - 14) or math.min(e.len, 14)
	local k = 1
	while k < e.n - 1 and e.cum[k + 1] < s do k += 1 end
	local t = math.clamp((s - e.cum[k]) / math.max(e.cum[k + 1] - e.cum[k], 1e-6), 0, 1)
	local bx, bz = e.x[k] + (e.x[k + 1] - e.x[k]) * t, e.z[k] + (e.z[k + 1] - e.z[k]) * t
	local dx, dz = nd.x - bx, nd.z - bz
	local l = math.max(math.sqrt(dx * dx + dz * dz), 1e-6)
	return dx / l, dz / l
end

local litNodes = nil
local function redLight(sp)
	if not litNodes then
		litNodes = {}
		for _, s in ipairs(Rules.signals) do litNodes[#litNodes + 1] = State.road.nodes[s.n] end
	end
	local near = nil
	for _, nd in ipairs(litNodes) do
		if (st.x - nd.x) ^ 2 + (st.z - nd.z) ^ 2 < 144 then
			near = nd
			break
		end
	end
	if near and curL == nil and st.y - Ground.TH(st.x, st.z) < 1.5 and sp > 14 then
		local v = math.max(math.sqrt(st.vx * st.vx + st.vz * st.vz), 1e-6)
		local vx, vz = st.vx / v, st.vz / v
		local best, bd = nil, -2
		for _, e in ipairs(near.inn or {}) do
			local hx, hz = approachOf(near, e)
			local dd = hx * vx + hz * vz
			if dd > bd then
				bd, best = dd, e
			end
		end
		if best and bd > 0.5 and Signals.at(near, best) == "r" then Laws.fine("red", "Ran a red light", 3) end
	end
	curL = near and near.id or nil
end

-- after the car has moved; sp = speed in km/h
function Laws.step(sp)
	local RI = State.road and Road.at(State.road, st.x, st.z, 6)
	State.ri = RI
	local lim = (RI and RI.d <= RI.e.w / 2 + 0.3) and RI.e.lim or 0
	Laws.limit = lim > 0 and lim or Laws.LIMIT
	if lim ~= LIMT.l then
		LIMT.l = lim
		LIMT.t = now()
	end
	local dzo = Laws.driftZoneAt(st.x, st.z)
	if dzo ~= inZone then
		inZone = dzo
		Hud.toast(dzo and ("🏁 " .. dzo.n .. " — no speed limit, no fines") or "Leaving the drift zone")
	end
	State.inDrift = dzo ~= nil
	if dzo then return end
	if st.gnd and lim > 0 and sp > lim + 10 and now() - LIMT.t > 1.5 then
		Laws.fine("spd", "Speeding (" .. math.floor(sp + 0.5) .. " km/h)", 5)
	end
	if st.gnd and sp > 14 and wrongWay(RI) then Laws.fine("way", "Driving against traffic", 6) end
	redLight(sp)
end

return Laws
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX134"><Properties><string name="Name">Menus</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the menus in one place: Garage (G), Apex Drift Customs (U, TuneShop), the car wheel (K, CarWheel).
local Client = script.Parent
local Garage = require(Client:WaitForChild("Garage"))
local TuneShop = require(Client:WaitForChild("TuneShop"))
local CarWheel = require(Client:WaitForChild("CarWheel"))

return {
	garage = Garage.open,
	shop = TuneShop.open,
	wheel = CarWheel.open,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX135"><Properties><string name="Name">Minimap</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the minimap: a round window (bottom left), the car in the centre pointing up; the real roads within 260 m
-- redrawn 7 times a second, the GPS route in green, the bank / shop / race starts (clamped to the edge when far), the GPS
-- destination, the next race checkpoint, AI cars (police red, rivals yellow).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Road = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Road"))
local Shared = ReplicatedStorage:WaitForChild("IrbidShared")
local Meta = require(Shared:WaitForChild("Meta"))
local Circuits = require(Shared:WaitForChild("Circuits"))
local State = require(script.Parent:WaitForChild("State"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local Gps = require(script.Parent:WaitForChild("Gps"))

local Minimap = {}
local st = State.st
local MAP_PX, MAP_R = 180, 260

local mm = Instance.new("CanvasGroup")
mm.Name = "Minimap"
mm.Size = UDim2.fromOffset(MAP_PX, MAP_PX)
mm.AnchorPoint = Vector2.new(0, 1)
mm.Position = UDim2.new(0, 12, 1, -26)
mm.BackgroundColor3 = Color3.fromRGB(28, 32, 26)
mm.BackgroundTransparency = 0.15
mm.Parent = Hud.gui
local mmc = Instance.new("UICorner")
mmc.CornerRadius = UDim.new(0.5, 0)
mmc.Parent = mm

local lines = {}
local function line(i)
	local f = lines[i]
	if not f then
		f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.BorderSizePixel = 0
		f.Parent = mm
		lines[i] = f
	end
	f.Visible = true
	return f
end
local arrow = Instance.new("TextLabel")
arrow.Size = UDim2.fromOffset(20, 20)
arrow.AnchorPoint = Vector2.new(0.5, 0.5)
arrow.Position = UDim2.fromScale(0.5, 0.5)
arrow.BackgroundTransparency = 1
arrow.Text = "▲"
arrow.TextColor3 = Color3.fromRGB(80, 200, 255)
arrow.TextSize = 18
arrow.Font = Enum.Font.GothamBold
arrow.ZIndex = 5
arrow.Parent = mm
local marks = {}
local function mark(i, color, size)
	local f = marks[i]
	if not f then
		f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.BorderSizePixel = 0
		f.ZIndex = 4
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0.5, 0)
		c.Parent = f
		f.Parent = mm
		marks[i] = f
	end
	f.Size = UDim2.fromOffset(size, size)
	f.BackgroundColor3 = color
	return f
end
local SITES = { { Meta.bank.x, Meta.bank.z, Color3.fromRGB(255, 60, 60) }, { Meta.shop.x, Meta.shop.z, Color3.fromRGB(255, 122, 0) } }
for _, c in ipairs(Circuits) do
	local x, z = string.match(c.path, "^(-?%d+),(-?%d+)")
	SITES[#SITES + 1] = { tonumber(x) / 10, tonumber(z) / 10, Color3.fromRGB(51, 224, 255) }
end
local ROADCOL = { [0] = Color3.fromRGB(235, 225, 200), [1] = Color3.fromRGB(170, 170, 165), [2] = Color3.fromRGB(110, 110, 105), [3] = Color3.fromRGB(235, 225, 200) }

local t = 0
function Minimap.step(dt)
	t -= dt
	if t > 0 or not State.road then return end
	t = 0.14
	local k = MAP_PX / 2 / MAP_R
	local fx, fz = math.sin(st.h), math.cos(st.h)
	local rx, rz = -fz, fx
	local function proj(x, z)
		local dx, dz = x - st.x, z - st.z
		return MAP_PX / 2 + (dx * rx + dz * rz) * k, MAP_PX / 2 - (dx * fx + dz * fz) * k
	end
	local nLines = 0
	local seen = {}
	Road.each(State.road, st.x, st.z, MAP_R, function(e, j)
		local id = e.id * 4096 + j
		if seen[id] or nLines >= 700 then return end
		seen[id] = true
		local x1, z1, x2, z2 = e.x[j], e.z[j], e.x[j + 1], e.z[j + 1]
		if (x1 - st.x) ^ 2 + (z1 - st.z) ^ 2 > MAP_R * MAP_R * 1.1 and (x2 - st.x) ^ 2 + (z2 - st.z) ^ 2 > MAP_R * MAP_R * 1.1 then return end
		local u1, v1 = proj(x1, z1)
		local u2, v2 = proj(x2, z2)
		nLines += 1
		local f = line(nLines)
		local len = math.sqrt((u2 - u1) ^ 2 + (v2 - v1) ^ 2)
		f.Position = UDim2.fromOffset((u1 + u2) / 2, (v1 + v2) / 2)
		f.Size = UDim2.fromOffset(len + 1, math.max(2, e.w * k))
		f.Rotation = math.deg(math.atan2(v2 - v1, u2 - u1))
		f.BackgroundColor3 = ROADCOL[e.kind] or ROADCOL[1]
	end)
	-- the GPS route on top
	local nav = Gps.route()
	if nav then
		local P = nav.P
		local j = nav.i
		while j < #P.x and P.c[j] - P.c[nav.i] < MAP_R * 1.4 and nLines < 760 do
			local u1, v1 = proj(P.x[j], P.z[j])
			local u2, v2 = proj(P.x[j + 1], P.z[j + 1])
			nLines += 1
			local f = line(nLines)
			f.Position = UDim2.fromOffset((u1 + u2) / 2, (v1 + v2) / 2)
			f.Size = UDim2.fromOffset(math.sqrt((u2 - u1) ^ 2 + (v2 - v1) ^ 2) + 1, 4)
			f.Rotation = math.deg(math.atan2(v2 - v1, u2 - u1))
			f.BackgroundColor3 = Color3.fromRGB(60, 255, 140)
			j += 1
		end
	end
	for i = nLines + 1, #lines do lines[i].Visible = false end
	local mi = 0
	local function put(x, z, color, size)
		mi += 1
		local u, v = proj(x, z)
		local du, dv = u - MAP_PX / 2, v - MAP_PX / 2
		local r = math.sqrt(du * du + dv * dv)
		local lim = MAP_PX / 2 - 6
		if r > lim then
			u, v = MAP_PX / 2 + du / r * lim, MAP_PX / 2 + dv / r * lim
		end
		local f = mark(mi, color, size)
		f.Position = UDim2.fromOffset(u, v)
		f.Visible = true
	end
	for _, s in ipairs(SITES) do put(s[1], s[2], s[3], 10) end
	if nav then put(nav.x, nav.z, Color3.fromRGB(60, 255, 140), 12) end
	for _, a in ipairs(State.ai) do
		if (a.x - st.x) ^ 2 + (a.z - st.z) ^ 2 < MAP_R * MAP_R then
			put(a.x, a.z, a.cop and Color3.fromRGB(255, 40, 40) or a.kind == "rival" and Color3.fromRGB(255, 200, 40) or Color3.fromRGB(200, 200, 200), a.cop and 8 or 5)
		end
	end
	if State.mission == "race" and State.raceMark then put(State.raceMark[1], State.raceMark[2], Color3.fromRGB(51, 224, 255), 12) end
	for i = mi + 1, #marks do marks[i].Visible = false end
end

return Minimap
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX136"><Properties><string name="Name">Missions</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the missions in one place: races (Race), duels (Duel), the bank heist (Heist, Police), and the context button at the
-- bottom of the screen ("ROB THE BANK" at the bank, "TUNE CAR" at Apex Drift Customs).
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Meta = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Meta"))
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("Hud"))
local Race = require(Client:WaitForChild("Race"))
local Heist = require(Client:WaitForChild("Heist"))
local Police = require(Client:WaitForChild("Police"))
local Duel = require(Client:WaitForChild("Duel"))

local Missions = {}
local st = State.st
Missions.circuits = Race.circuits
Missions.rivals = Race.rivals
Missions.cops = Police.cops
Missions.duelRivals = Duel.rivals
-- R (the web game): a duel when next to a traffic car and nothing is running, else start / cancel the nearest race
function Missions.race()
	if Duel.active() then
		Duel.cancel("Duel cancelled")
		return
	end
	if State.mission == nil then
		local c = Duel.nearCar()
		if c then
			Duel.start(c)
			return
		end
	end
	Race.toggle()
end
Missions.rob = Heist.rob
-- Missions.openShop is set by Main (it needs the menus)

function Missions.nearShop()
	return (Meta.shop.x - st.x) ^ 2 + (Meta.shop.z - st.z) ^ 2 < 14 * 14
end

-- the current race / heist tables (or nil), read-only for tests
function Missions.debug()
	return Race.current(), Heist.current()
end

function Missions.step(dt)
	Race.step(dt)
	Duel.step(dt)
	Heist.step(dt)
	Police.lights(dt)
	if State.ui then return end
	local busy = State.mission ~= nil
	if not busy and Heist.nearBank() then
		local openAt = Players.LocalPlayer:GetAttribute("BankOpenAt") or 0
		if Workspace.DistributedGameTime < openAt then
			Hud.context("Bank closed · back in " .. math.ceil(openAt - Workspace.DistributedGameTime) .. " s", function() end, Color3.fromRGB(90, 90, 90))
		else
			Hud.context("🏦 ROB THE BANK (E)", Missions.rob)
		end
	elseif State.mission ~= "heist" and Missions.nearShop() then
		Hud.context("🔧 TUNE CAR (U)", Missions.openShop, Color3.fromRGB(230, 110, 0))
	else
		Hud.context(nil)
	end
end

return Missions
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX137"><Properties><string name="Name">Nav</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - navigation, one place to reach it: street name (StreetName), GPS route (Gps), place search (Search),
-- minimap (Minimap).
local Client = script.Parent
local StreetName = require(Client:WaitForChild("StreetName"))
local Gps = require(Client:WaitForChild("Gps"))
local Search = require(Client:WaitForChild("Search"))
local Minimap = require(Client:WaitForChild("Minimap"))

local Nav = {}
Nav.go = Gps.go
Nav.clear = Gps.clear
Nav.route = Gps.route
Nav.open = Search.open
function Nav.active()
	return Gps.route() ~= nil
end
function Nav.streetName()
	return StreetName.name
end

function Nav.step(dt)
	StreetName.step(dt)
	Gps.step(dt)
	Minimap.step(dt)
end

return Nav
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX138"><Properties><string name="Name">Police</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - police cars for the heist (the web game's rules): they appear 220-460 m away on a road, are as fast as
-- 85 % of the player's car, follow a route to the player over the real road graph (planned again every 0.8 s), and drive straight at
-- the player when close or at the end of their route, slowing down so they box the car in instead of ramming past. Lights flash.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Road = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Road"))
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Rules = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Rules"))
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Drive = require(Client:WaitForChild("Drive"))
local Traffic = require(Client:WaitForChild("Traffic"))

local Police = { cops = {} }
local st, spec = State.st, State.spec

function Police.spawn()
	for _ = 1, 10 do
		local ang, r = math.random() * 2 * math.pi, 220 + math.random() * 240
		local near = Road.nearest(State.road, st.x + math.sin(ang) * r, st.z + math.cos(ang) * r, 80)
		if near then
			-- the web game's police car (mkCop: a white Ford Crown Victoria with a light bar), as fast as 85 % of the player's car
			local cv = Config.CARS[Rules.copCar]
			local a = Traffic.agent("cop", { L = cv.L, W = cv.W, H = cv.H, body = cv.body, name = "Police", vm = spec.vm * 0.85, a0 = spec.a0 * 0.85 }, Color3.fromHex("#f4f4f4"))
			a.x, a.z, a.y = near.x, near.z, near.y
			a.h = math.atan2(st.x - a.x, st.z - a.z)
			a.thinkT = 0
			Police.cops[#Police.cops + 1] = a
			Traffic.draw(a)
			return
		end
	end
end

function Police.clear()
	for _, a in ipairs(Police.cops) do Traffic.remove(a) end
	table.clear(Police.cops)
end

local function chase(a, dt)
	a.vm, a.a0 = spec.vm * 0.85, spec.a0 * 0.85
	local dx, dz = st.x - a.x, st.z - a.z
	local d = math.sqrt(dx * dx + dz * dz)
	-- close, or at the end of the route (the junction nearest the player): straight at where the player is going
	local endOfPath = a.P ~= nil and a.s >= a.P.c[#a.P.c] - 3
	if d < 28 or (a.direct and d < 60) or (endOfPath and d < 200) then
		a.direct = true
		local want = math.atan2(st.x + st.vx * 0.4 - a.x, st.z + st.vz * 0.4 - a.z)
		local df = (want - a.h + math.pi) % (2 * math.pi) - math.pi
		local r = 2.2 / (1 + a.v / 14) * dt
		a.h += math.clamp(df, -r, r)
		-- approach at a speed that can still stop ~5 m from the player (7 m/s^2), and slow down to turn round
		local vt = math.min(a.vm, math.sqrt(2 * 7 * math.max(0, d - 5)) + st.sp, a.vm * (1 - math.abs(df) / math.pi) + 4)
		if a.hit > 0 then
			vt = 0
			a.hit -= dt
		end
		a.v = math.max(0, a.v + math.clamp(vt - a.v, -9 * dt, a.a0 * dt))
		a.x += math.sin(a.h) * a.v * dt
		a.z += math.cos(a.h) * a.v * dt
		a.y = Drive.groundY(a.x, a.z, a.y + 4) or a.y
		a.P = nil
		return
	end
	a.direct = false
	-- far: follow a route to the player over the road graph
	a.thinkT -= dt
	if not a.P or a.thinkT <= 0 then
		a.thinkT = 0.8
		local trs, s0 = Road.routeFrom(State.road, a.x, a.z, math.sin(a.h), math.cos(a.h), st.x + st.vx * 1.2, st.z + st.vz * 1.2)
		if trs then
			a.P = Road.path(trs, nil)
			a.s, a.pi = s0, 1
		else
			a.direct = true
			return
		end
	end
	Traffic.follow(a, dt, math.min(a.vm, Traffic.curveCap(a) * 1.15))
end

-- moves every police car; true when one is within 7 m of the player
function Police.step(dt)
	local near = false
	for _, a in ipairs(Police.cops) do
		chase(a, dt)
		Traffic.draw(a)
		if (a.x - st.x) ^ 2 + (a.z - st.z) ^ 2 < 49 then near = true end
	end
	return near
end

-- red / blue light bars, 3 flashes a second
local flash = 0
function Police.lights(dt)
	flash += dt
	local on = math.floor(flash * 6) % 2 == 0
	for _, a in ipairs(Police.cops) do
		local r, b = a.model:FindFirstChild("LightR"), a.model:FindFirstChild("LightB")
		if r and b then
			r.Color = on and Color3.fromRGB(255, 30, 30) or Color3.fromRGB(50, 0, 0)
			b.Color = on and Color3.fromRGB(0, 0, 50) or Color3.fromRGB(30, 80, 255)
		end
	end
end

return Police
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX139"><Properties><string name="Name">Props</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the web game's street furniture and vegetation (its instanced props, exported per family by tools/make_roblox.js:
-- street lights, utility poles and transformers, guardrails, bus stops, roundabout islands, dumpsters, traffic cones, manhole covers, tree
-- trunks, round / pine / palm / olive canopies, cypresses, bushes, rocks; about 77,000 within the map). Like the web game, each family is
-- drawn only within its level-of-detail radius around the player (lamps and trees 420 m, rails 330 m, bins 200 m ...), so this device
-- builds the props of the 100 m cells near the car and removes those that fall behind (checked twice a second). Scenery only: they do not
-- collide yet (the web game's breakable poles, trees and bins are not ported). Cones (cypresses) are tapered in the web game: here cylinders.
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Shared = ReplicatedStorage:WaitForChild("IrbidShared")
local Client = script.Parent
local State = require(Client:WaitForChild("State"))

local Props = { fam = {} }
local S = Config.SCALE
local CELL = 100
local CYL = CFrame.Angles(0, 0, math.pi / 2)
local folder = Instance.new("Folder")
folder.Name = "Props_" .. Players.LocalPlayer.UserId
folder.Parent = Workspace
Props.folder = folder
local MAT = { trunk = Enum.Material.Wood, canopy = Enum.Material.Grass, olive = Enum.Material.Grass, cypress = Enum.Material.Grass, bush = Enum.Material.Grass,
	island = Enum.Material.Grass, rock = Enum.Material.Rock, utilPole = Enum.Material.Concrete, utilArm = Enum.Material.Concrete, lampHead = Enum.Material.Neon }

local function hex(c)
	return Color3.fromRGB(math.floor(c / 65536) % 256, math.floor(c / 256) % 256, c % 256)
end

-- the families: rows of 8 numbers (x, z dm; y cm; heading mrad; size cm x 3; colour), cells of item indices
local function key(i, j)
	return (i + 500) * 1000 + (j + 500)
end
for _, m in ipairs(Shared:GetChildren()) do
	if string.sub(m.Name, 1, 6) == "Props_" then
		local d = require(m)
		local id = string.match(m.Name, "^Props_(%d+)_")
		local F = Props.fam[id]
		if not F then
			F = { kind = d.kind, shape = d.shape, R = d.R, v = {}, cells = {}, built = {} }
			Props.fam[id] = F
		end
		for n in string.gmatch(d.rows, "-?%d+") do F.v[#F.v + 1] = tonumber(n) end
	end
end
Props.count = 0
for _, F in pairs(Props.fam) do
	for i = 1, #F.v, 8 do
		local k = key(math.floor(F.v[i] / 10 / CELL), math.floor(F.v[i + 1] / 10 / CELL))
		F.cells[k] = F.cells[k] or {}
		table.insert(F.cells[k], i)
		Props.count += 1
	end
end

local function make(F, i)
	local v = F.v
	local x, z, y, h = v[i] / 10, v[i + 1] / 10, v[i + 2] / 100, v[i + 3] / 1000
	local sx, sy, sz = v[i + 4] / 100 * S, v[i + 5] / 100 * S, v[i + 6] / 100 * S
	local p = Instance.new("Part")
	p.Name = F.kind
	p.Anchored = true
	p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
	p.CastShadow = F.kind ~= "manhole"
	p.Color = hex(v[i + 7])
	p.Material = MAT[F.kind] or Enum.Material.SmoothPlastic
	local cf = CFrame.new(x * S, y * S, z * S) * CFrame.Angles(0, h, 0)
	if F.shape == "cyl" or F.shape == "cone" then
		local k = F.shape == "cone" and 0.6 or 1
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(math.max(0.05, sy), math.max(0.05, sx * k), math.max(0.05, sz * k))
		p.CFrame = cf * CYL
	else
		p.Size = Vector3.new(math.max(0.05, sx), math.max(0.05, sy), math.max(0.05, sz))
		p.CFrame = cf
		if F.shape == "ball" then
			local m = Instance.new("SpecialMesh")
			m.MeshType = Enum.MeshType.Sphere
			m.Parent = p
		end
	end
	p.Parent = folder
	return p
end

-- twice a second: the cells within each family's radius are built, cells beyond it (+ 60 m) removed
local t = 0
Props.live = 0
function Props.step(dt)
	t -= dt
	if t > 0 then return end
	t = 0.5
	local st = State.st
	local ci, cj = math.floor(st.x / CELL), math.floor(st.z / CELL)
	for _, F in pairs(Props.fam) do
		local r = math.ceil(F.R / CELL)
		-- remove far cells
		for k, list in pairs(F.built) do
			local i, j = math.floor(k / 1000) - 500, k % 1000 - 500
			local dx, dz = (i + 0.5) * CELL - st.x, (j + 0.5) * CELL - st.z
			if dx * dx + dz * dz > (F.R + 60) ^ 2 then
				for _, p in ipairs(list) do p:Destroy() end
				Props.live -= #list
				F.built[k] = nil
			end
		end
		-- build near cells
		for i = ci - r, ci + r do
			for j = cj - r, cj + r do
				local k = key(i, j)
				local items = F.cells[k]
				if items and not F.built[k] then
					local dx, dz = (i + 0.5) * CELL - st.x, (j + 0.5) * CELL - st.z
					if dx * dx + dz * dz <= F.R * F.R then
						local list = {}
						for _, idx in ipairs(items) do list[#list + 1] = make(F, idx) end
						F.built[k] = list
						Props.live += #list
					end
				end
			end
		end
	end
end

return Props
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX140"><Properties><string name="Name">Race</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - street races on the web game's circuits (routed over real roads by the web game): R starts the nearest
-- circuit (R again cancels). 3 rivals of about the player's tier on the web game's grid (20 / 34 / 48 m, the player at 62 m),
-- a 3 s countdown, a light beam over the next checkpoint, the position from checkpoints passed. The server pays by place.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Rules = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Rules"))
local Road = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Road"))
local Circuits = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Circuits"))
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("Hud"))
local Drive = require(Client:WaitForChild("Drive"))
local Traffic = require(Client:WaitForChild("Traffic"))
local Gps = require(Client:WaitForChild("Gps"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Race = { rivals = {} }
local S = Config.SCALE
local st = State.st

-- circuits: racing line, checkpoint distances along it, a safe speed per point (for the rivals)
local C = {}
for _, c in ipairs(Circuits) do
	local P = Road.pathFromString(c.path)
	local cpS, j = {}, 1
	for k, cp in ipairs(c.cps) do
		-- each checkpoint is matched forward along the line (laps pass the same place more than once)
		local best, bd = j, math.huge
		for i = j, #P.x do
			local d = (P.x[i] - cp.x) ^ 2 + (P.z[i] - cp.z) ^ 2
			if d < bd then
				best, bd = i, d
			end
			if bd < 4 and d > 400 then break end
		end
		cpS[k] = P.c[best]
		j = best + 1
	end
	C[#C + 1] = { name = c.name, laps = c.laps, cps = c.cps, cpS = cpS, P = P, caps = Road.speedCaps(P) }
end
Race.circuits = C

-- the light beam over the next checkpoint
local beam = Instance.new("Part")
beam.Name = "Checkpoint"
beam.Anchored = true
beam.CanCollide = false
beam.CanQuery = false
beam.CanTouch = false
beam.Shape = Enum.PartType.Cylinder
beam.Material = Enum.Material.Neon
beam.Color = Color3.fromRGB(51, 224, 255)
beam.Transparency = 1
beam.Size = Vector3.new(70 * S, 12 * S, 12 * S)
beam.Parent = Workspace.CurrentCamera

-- the web game's named racers (09_ai)
local RIVALS = { "Samer", "Layth", "Omar" }
Race.RIVALS = RIVALS
local race = nil -- {c, t, s = "count"|"run"|"done", prog, fin, time}

local function finish(msg)
	if race and race.s ~= "done" then pcall(function() Remotes.Mission:InvokeServer("race_cancel") end) end
	race = nil
	State.mission = nil
	State.frozen = false
	State.raceMark = nil
	beam.Transparency = 1
	for _, a in ipairs(Race.rivals) do Traffic.remove(a) end
	table.clear(Race.rivals)
	Hud.mission.Text = ""
	if msg then Hud.toast(msg) end
end

function Race.toggle()
	if State.mission == "heist" then
		Hud.toast("Lose the police first")
		return
	end
	if race then
		finish("Race cancelled")
		return
	end
	if #C == 0 then return end
	local best, bd = C[1], math.huge
	for _, c in ipairs(C) do
		local d = (c.P.x[1] - st.x) ^ 2 + (c.P.z[1] - st.z) ^ 2
		if d < bd then
			best, bd = c, d
		end
	end
	local ok, err = Remotes.Mission:InvokeServer("race_start", best.name)
	if not ok then
		Hud.toast(tostring(err))
		return
	end
	Gps.clear()
	Traffic.clear(best.P.x[1], best.P.z[1], 120)
	-- three different cars of the web game's sports catalogue (11_race: a shuffle of the indices below NRACE), as in the web game
	local pool = table.clone(Rules.racers)
	local names = {}
	for k, s0 in ipairs({ 20, 34, 48 }) do
		local car = Config.CARS[table.remove(pool, math.random(#pool))]
		local a = Traffic.agent("rival", car)
		a.P, a.s, a.pi = best.P, s0, 1
		-- the web game's three named racers and their skills (09_ai bots: Samer .96, Layth .98, Omar 1.00); road reputation adjusts them
		a.driver = RIVALS[k]
		a.sk0 = 0.96 + (k - 1) * 0.02
		a.skill = a.sk0
		a.lane = (k - 2) * 1.6
		local x, z, y, tx, tz, i = Road.sample(a.P, a.s, 1)
		a.x, a.z, a.y, a.h, a.pi = x, z, y, math.atan2(tx, tz), i
		Traffic.draw(a)
		Race.rivals[#Race.rivals + 1] = a
		names[#names + 1] = a.driver .. " (" .. car.name .. ")"
	end
	local x, z, _, tx, tz = Road.sample(best.P, 62, 1)
	Drive.place(x, z, math.atan2(tx, tz))
	race = { c = best, t = 3.99, s = "count", prog = 1, fin = 0 }
	if Race.onStart then Race.onStart(Race.rivals) end
	State.mission = "race"
	State.frozen = true
	Hud.toast(best.name .. " · rivals: " .. table.concat(names, ", "), 4)
end

local function rivalStep(a, dt)
	local c = race.c
	if a.done then
		Traffic.follow(a, dt, 0)
	else
		Traffic.follow(a, dt, math.min(a.vm * a.skill, c.caps[a.pi] or 30))
		if a.s >= c.cpS[#c.cpS] - 2 then
			a.done = true
			race.fin += 1
		end
	end
	-- side offset so the three rivals do not drive inside each other (follow() puts the car back on the line every frame)
	a.x, a.z = a.x - math.cos(a.h) * a.lane, a.z + math.sin(a.h) * a.lane
	Traffic.draw(a)
end

function Race.step(dt)
	if not race then return end
	local c = race.c
	if race.s == "count" then
		race.t -= dt
		Hud.mission.Text = c.name .. " · starts in " .. math.ceil(race.t)
		if race.t <= 0 then
			race.s = "run"
			race.time = 0
			State.frozen = false
			Hud.toast("GO!", 1.5)
		end
	end
	if race.s ~= "count" then
		for _, a in ipairs(Race.rivals) do rivalStep(a, dt) end
	else
		for _, a in ipairs(Race.rivals) do Traffic.draw(a) end
	end
	if race.s == "run" then
		race.time += dt
		local cp = c.cps[race.prog]
		if (cp.x - st.x) ^ 2 + (cp.z - st.z) ^ 2 < 28 * 28 then
			race.prog += 1
			if race.prog > #c.cps then
				race.s = "done"
				race.t = 6
				local place = race.fin + 1
				if Race.onFinish then Race.onFinish(Race.rivals) end
				Hud.mission.Text = "Finished P" .. place .. " of 4 · " .. string.format("%.1f s", race.time)
				local ok, reward = Remotes.Mission:InvokeServer("race_finish", place)
				Hud.toast("Finished P" .. place .. " of 4!" .. (ok and reward and reward > 0 and ("  +" .. Hud.fmt(reward) .. " JD") or ""), 5)
				beam.Transparency = 1
				State.raceMark = nil
				return
			end
		end
		-- position: checkpoints passed, then distance to the next one
		local pos = 1
		local myS = c.cpS[race.prog] - math.sqrt((cp.x - st.x) ^ 2 + (cp.z - st.z) ^ 2)
		for _, a in ipairs(Race.rivals) do
			if a.done or a.s > myS then pos += 1 end
		end
		local lap = c.laps > 1 and (" · lap " .. math.min(c.laps, 1 + math.floor((race.prog - 1) / (#c.cps / c.laps)))) or ""
		Hud.mission.Text = c.name .. " · P" .. pos .. " of 4 · checkpoint " .. race.prog .. "/" .. #c.cps .. lap .. " · " .. string.format("%.1f s", race.time)
	end
	if race.s == "done" then
		race.t -= dt
		if race.t <= 0 then finish() end
		return
	end
	local cp = c.cps[race.prog]
	local gy = Drive.groundY(cp.x, cp.z, st.y + 80) or st.y
	beam.CFrame = CFrame.new(cp.x * S, (gy + 35) * S, cp.z * S) * CFrame.Angles(0, 0, math.pi / 2)
	beam.Transparency = 0.7
	State.raceMark = { cp.x, cp.z }
end

function Race.current()
	return race
end

return Race
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX141"><Properties><string name="Name">Reputation</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - road reputation and rival memory (the web game's 11c_assist.js). Fixed, documented rules (no learning):
--   reputation 0-100, starts at 70: -6 hitting a traffic car, -4 a red light, -2 driving against traffic, -1 a speeding fine;
--   +1 for every 45 s of driving above 15 km/h with no incident (and no menu open).
--   Effects: below 50 the traffic behind you keeps a longer gap (6.5 m -> 12 m at 0); a traffic car stuck right behind you while you stand
--   still honks after its patience runs out (6 s at >= 60, 3 s at >= 30, 1.5 s below); a traffic car you hit always honks.
--   The three named racers (Samer, Layth, Omar) remember races, wins, losses and hits; at the start of a race each one's skill moves with
--   its record against you (wins - losses x 0.004, at most -0.02 / +0.03, +0.01 after 3 hits; between 0.94 and 1.05).
-- Saved with the progress (the server keeps it: remote SaveRep, player attribute "Rep").
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("Hud"))
local Signals = require(Client:WaitForChild("Signals"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Reputation = {}
local plr = Players.LocalPlayer
local NAMES = { "Samer", "Layth", "Omar" }
local D = { hit = -6, red = -4, way = -2, spd = -1 }
local REP = { road = 70, clean = 0, riv = {} }
Reputation.state = REP

-- the wire format (attribute "Rep" / remote SaveRep): "road;Samer=r,w,l,h;Layth=...;Omar=..."
function Reputation.encode(t)
	local out = { tostring(math.floor(t.road + 0.5)) }
	for _, n in ipairs(NAMES) do
		local q = t.riv[n]
		if q then out[#out + 1] = string.format("%s=%d,%d,%d,%d", n, q.r, q.w, q.l, q.h) end
	end
	return table.concat(out, ";")
end
function Reputation.decode(s)
	local t = { road = 70, clean = 0, riv = {} }
	if type(s) ~= "string" or #s > 200 then return t end
	local r = tonumber(string.match(s, "^(%d+)"))
	if r then t.road = math.clamp(r, 0, 100) end
	for n, a, b, c, d in string.gmatch(s, "(%a+)=(%d+),(%d+),(%d+),(%d+)") do
		if table.find(NAMES, n) then
			t.riv[n] = { r = math.min(999, tonumber(a)), w = math.min(999, tonumber(b)), l = math.min(999, tonumber(c)), h = math.min(999, tonumber(d)) }
		end
	end
	return t
end

local function gap()
	State.repGap = 6.5 + (REP.road < 50 and (50 - REP.road) * 0.11 or 0)
end
local saveT = 0
local function save()
	saveT = 1
end
local function load()
	local t = Reputation.decode(plr:GetAttribute("Rep"))
	REP.road, REP.riv = t.road, t.riv
	gap()
end
load()
plr:GetAttributeChangedSignal("Rep"):Connect(function()
	if saveT <= 0 then load() end
end)

local function riv(n)
	REP.riv[n] = REP.riv[n] or { r = 0, w = 0, l = 0, h = 0 }
	return REP.riv[n]
end

-- a honk from an AI car (positional, CarAudio), at most every 4 s per car
local function honk(a, dur)
	local t = Workspace.DistributedGameTime
	if t - (a.hk or -99) < 4 then return end
	a.hk = t
	a.hp = a.hp or (0.85 + math.random() * 0.35)
	if Reputation.onHonk then Reputation.onHonk(a, dur, a.hp) end
end

-- a fine was given (Laws.onFine): the reputation drops; a traffic car you hit honks
function Reputation.event(k)
	if not D[k] then return end
	REP.road = math.clamp(REP.road + D[k], 0, 100)
	REP.clean = 0
	gap()
	save()
	if k == "hit" then
		local st, best, bd = State.st, nil, 49
		for _, a in ipairs(State.ai) do
			if a.kind == "traffic" then
				local d = (a.x - st.x) ^ 2 + (a.z - st.z) ^ 2
				if d < bd then best, bd = a, d end
			end
		end
		if best then honk(best, 1.1) end
	end
end

-- a race starts (Race.onStart): each racer's skill from its record against you
function Reputation.raceStart(rivals)
	local msg = {}
	for _, a in ipairs(rivals) do
		if a.driver then
			local q = riv(a.driver)
			a.skill = math.clamp(a.sk0 + math.clamp((q.w - q.l) * 0.004, -0.02, 0.03) + (q.h >= 3 and 0.01 or 0), 0.94, 1.05)
			if q.h >= 3 then
				msg[#msg + 1] = a.driver .. " remembers " .. q.h .. " hits"
			elseif q.w - q.l >= 3 then
				msg[#msg + 1] = a.driver .. " wants revenge (" .. q.l .. "-" .. q.w .. ")"
			end
		end
	end
	if #msg > 0 then task.delay(2.6, function() Hud.toast("🧠 " .. table.concat(msg, " · ")) end) end
	Reputation.racing = rivals
end
-- you finished (Race.onFinish): a racer already home beat you, the others lost
function Reputation.raceEnd(rivals)
	for _, a in ipairs(rivals) do
		if a.driver then
			local q = riv(a.driver)
			q.r = math.min(999, q.r + 1)
			if a.done then q.l = math.min(999, q.l + 1) else q.w = math.min(999, q.w + 1) end
		end
	end
	Reputation.racing = nil
	save()
end

-- is this traffic car waiting at a red light ahead of it (then it is not the player's fault)
local function atRed(a)
	local P = a.P
	if not (P and a.trs) then return false end
	for i, tr in ipairs(a.trs) do
		local endS = P.ends and P.ends[i]
		if endS and endS >= a.s then
			if endS - a.s > 45 then break end
			local nd = State.road.nodes[tr.d > 0 and tr.e.b or tr.e.a]
			if nd and nd.lit and Signals.at(nd, tr.e) ~= "g" then return true end
		end
	end
	return false
end

local honkT, hitT = 0, {}
function Reputation.step(dt)
	local st = State.st
	local v = math.sqrt(st.vx * st.vx + st.vz * st.vz)
	if v > 4.2 and not State.ui then
		REP.clean += dt
		if REP.clean >= 45 then
			REP.clean = 0
			if REP.road < 100 then
				REP.road = math.min(100, REP.road + 1)
				gap()
				save()
			end
		end
	end
	-- hits on the racers during a race
	if Reputation.racing and State.mission == "race" then
		local t = Workspace.DistributedGameTime
		for _, a in ipairs(Reputation.racing) do
			if a.driver and not a.done and math.sqrt((a.x - st.x) ^ 2 + (a.z - st.z) ^ 2) < 3.6 and v > 3 and t - (hitT[a.driver] or -99) > 2 then
				hitT[a.driver] = t
				local q = riv(a.driver)
				q.h = math.min(999, q.h + 1)
				save()
			end
		end
	end
	-- impatient drivers: a traffic car stuck right behind the stopped player honks when its patience runs out
	honkT -= dt
	if honkT <= 0 then
		honkT = 0.25
		local pat = REP.road >= 60 and 6 or REP.road >= 30 and 3 or 1.5
		for _, a in ipairs(State.ai) do
			if a.kind == "traffic" then
				local dx, dz = st.x - a.x, st.z - a.z
				if dx * dx + dz * dz > 900 then
					a.blk = 0
				else
					local sh, ch = math.sin(a.h), math.cos(a.h)
					local f = dx * sh + dz * ch
					if f > 0 and f < 14 and math.abs(dx * ch - dz * sh) < 2.6 and a.v < 1 and v < 1.5 and not ((a.hit or 0) > 0) and not atRed(a) then
						a.blk = (a.blk or 0) + 0.25
						if a.blk > pat then
							a.blk = -4
							honk(a, 0.45)
						end
					else
						a.blk = 0
					end
				end
			end
		end
	end
	-- save at most every 3 s
	if saveT > 0 then
		saveT -= dt
		if saveT <= 0 then Remotes.SaveRep:FireServer(Reputation.encode(REP)) end
	end
end

-- the line in the settings menu (the web game's pause-menu row)
function Reputation.line()
	local rv = {}
	for _, n in ipairs(NAMES) do
		local q = REP.riv[n]
		if q and q.r > 0 then rv[#rv + 1] = n .. " " .. q.w .. "–" .. q.l .. (q.h > 0 and (" (" .. q.h .. " hits)") or "") end
	end
	return "Road reputation " .. math.floor(REP.road + 0.5) .. "/100 (traffic remembers hits, red lights, wrong way, speeding; clean driving earns it back)"
		.. (#rv > 0 and (" · Rivals you–them: " .. table.concat(rv, " · ")) or "")
end

return Reputation
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX142"><Properties><string name="Name">School</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the driving school (the web game's 11d_school.js): five lessons on REAL streets near the start, with the player's
-- normal car and controls (nothing is simulated for the player). A lesson finds a straight two-way OSM street (or an approach to a signalised
-- junction), marks zones on the road, gives instructions, watches speed, stops and the real fine rules (speeding, red light, wrong way,
-- hitting cars) and scores 0-100. Rules: right-hand traffic, stop lines 13.5 m before the junction centre, the OSM speed limits, 3 km/h
-- tolerance. Best scores are saved with the progress (remote SaveSchool, player attribute "School"). Opened from the settings menu.
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("Hud"))
local Ground = require(Client:WaitForChild("Ground"))
local Signals = require(Client:WaitForChild("Signals"))
local Drive = require(Client:WaitForChild("Drive"))
local Traffic = require(Client:WaitForChild("Traffic"))
local Gps = require(Client:WaitForChild("Gps"))
local AutoDrive = require(Client:WaitForChild("AutoDrive"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local School = {}
local S = Config.SCALE
local plr = Players.LocalPlayer
local st = State.st
local RULES = { side = 1, stopLine = 13.5, tolKmh = 3 }
local SCH = { on = nil, t = 0, best = {}, runs = 0, site = nil, pen = {}, score = 0, st = "", msg = "", over = false, last = {} }
School.state = SCH

-- ---- saving: "runs=n;stop=95;brake=80;..." ----
local function load()
	local s = plr:GetAttribute("School")
	if type(s) ~= "string" then return end
	for k, v in string.gmatch(s, "(%a+)=(%d+)") do
		if k == "runs" then SCH.runs = tonumber(v) else SCH.best[k] = math.clamp(tonumber(v), 0, 100) end
	end
end
load()
local function save()
	local out = { "runs=" .. SCH.runs }
	for k, v in pairs(SCH.best) do out[#out + 1] = k .. "=" .. v end
	Remotes.SaveSchool:FireServer(table.concat(out, ";"))
end

local function kmh()
	return math.sqrt(st.vx * st.vx + st.vz * st.vz) * 3.6
end
local function fwd()
	return st.vx * math.sin(st.h) + st.vz * math.cos(st.h)
end

-- ---- finding a street: a straight stretch of `len` m along an edge's points (dir 1 = along, -1 = against); toEnd = it must end there ----
local function straight(e, dir: number, len: number, toEnd: boolean)
	local p: { { number } } = {}
	for k = 1, e.n do
		local q = dir > 0 and k or e.n + 1 - k
		p[k] = { e.x[q], e.z[q] }
	end
	local n = #p
	local c = { 0 }
	for i = 2, n do c[i] = c[i - 1] + math.sqrt((p[i][1] - p[i - 1][1]) ^ 2 + (p[i][2] - p[i - 1][2]) ^ 2) end
	local function ok(i, j)
		local ax, az = p[i][1], p[i][2]
		local dx, dz = p[j][1] - ax, p[j][2] - az
		local l = math.sqrt(dx * dx + dz * dz)
		if l == 0 then l = 1 end
		for k = i + 1, j - 1 do
			if math.abs(((p[k][1] - ax) * dz - (p[k][2] - az) * dx) / l) > 1.2 then return false end
		end
		return true
	end
	for j = n, 2, -1 do
		local i = j
		while i > 1 and c[j] - c[i] < len do i -= 1 end
		if c[j] - c[i] >= len and ok(i, j) then
			local dx, dz = p[j][1] - p[i][1], p[j][2] - p[i][2]
			local l = math.sqrt(dx * dx + dz * dz)
			return { x0 = p[i][1], z0 = p[i][2], x1 = p[j][1], z1 = p[j][2], ux = dx / l, uz = dz / l, len = l, e = e }
		end
		if toEnd then return nil end
	end
	return nil
end
-- the nearest suitable street to (x, z): two-way, not a ramp or roundabout, 6+ m wide, 30-70 km/h; lit = approach to a signalised junction
function School.find(x, z, len, lit)
	local best, bd = nil, 1e18
	for _, e in ipairs(State.road.edges) do
		if not (e.ow or e.fk == "ring" or e.fk == "ramp" or e.w < 6 or e.lim < 30 or e.lim > 70 or e.len < len) then
			local mx, mz = (e.x[1] + e.x[e.n]) / 2, (e.z[1] + e.z[e.n]) / 2
			local d = (mx - x) ^ 2 + (mz - z) ^ 2
			if d < bd and d <= 3000 * 3000 then
				if lit then
					for _, q in ipairs({ { e.b, 1 }, { e.a, -1 } }) do
						local nd = State.road.nodes[q[1]]
						if nd and nd.lit and nd.lit.ph[e.id] ~= nil then
							local s = straight(e, q[2], len, true)
							if s then
								s.nd = nd
								best, bd = s, d
							end
						end
					end
				else
					local s = straight(e, 1, len, false)
					if s then best, bd = s, d end
				end
			end
		end
	end
	if best then
		best.rx, best.rz = -best.uz * RULES.side, best.ux * RULES.side
		best.h = math.atan2(best.ux, best.uz)
		best.lane = math.min(2.6, best.e.w * 0.25)
	end
	return best
end

-- ---- road markers: a translucent floor scaled to the zone + two 1.8 m posts at its far corners ----
local folder = Instance.new("Folder")
folder.Name = "SchoolMarkers"
folder.Parent = Workspace
local function marker(name, color)
	local m = { floor = Instance.new("Part"), posts = { Instance.new("Part"), Instance.new("Part") } }
	for _, p in ipairs({ m.floor, m.posts[1], m.posts[2] }) do
		p.Name = name
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
		p.Color = color
		p.Material = Enum.Material.Neon
		p.Transparency = 1
		p.Parent = folder
	end
	return m
end
local MK = { zone = marker("Zone", Color3.fromHex("#3cff9a")), line = marker("Line", Color3.fromHex("#ff5a5a")), finish = marker("End", Color3.fromHex("#4aa3ff")) }
local function put(m, s, along, side, w, l)
	local x, z = s.x0 + s.ux * along + s.rx * side, s.z0 + s.uz * along + s.rz * side
	local y = Ground.TH(x, z) + 0.12 + 0.08
	local cf = CFrame.new(Vector3.new(x, y, z) * S) * CFrame.Angles(0, s.h + math.pi, 0)
	m.floor.Size = Vector3.new(w * S, 0.08 * S, l * S)
	m.floor.CFrame = cf
	m.floor.Transparency = 0.4
	for i, p in ipairs(m.posts) do
		p.Size = Vector3.new(0.18 * S, 1.8 * S, 0.18 * S)
		p.CFrame = cf * CFrame.new((i == 1 and 1 or -1) * w / 2 * S, 0.9 * S, -l / 2 * S)
		p.Transparency = 0
	end
	return { x = x, z = z }
end
local function hideAll()
	for _, m in pairs(MK) do
		m.floor.Transparency = 1
		for _, p in ipairs(m.posts) do p.Transparency = 1 end
	end
end
local function loc(s)
	local dx, dz = st.x - s.x0, st.z - s.z0
	return { a = dx * s.ux + dz * s.uz, l = dx * s.rx + dz * s.rz }
end

-- ---- penalties and the end of a lesson ----
local function pen(m, p, k, cd)
	if not SCH.on or SCH.over then return end
	local t = SCH.last[k]
	if t ~= nil and SCH.t - t < cd then return end
	SCH.last[k] = SCH.t
	SCH.pen[#SCH.pen + 1] = { m, p }
	SCH.score = math.max(0, SCH.score - p)
	if p > 0 then Hud.toast("Instructor: " .. m .. " (−" .. p .. ")") end
end
local function finish(r, m)
	SCH.over, SCH.st, SCH.msg = true, r, m
	if r == "fail" then SCH.score = 0 end
	local L = SCH.on
	SCH.runs += 1
	if r == "pass" and not ((SCH.best[L.id] or -1) >= SCH.score) then SCH.best[L.id] = SCH.score end
	save()
	School.result()
	return r
end

-- ---- the lessons (the web game's LESSONS): setup(site) places markers; tick(dt, s, L) -> "run" | "pass" | "fail" ----
local LESSONS = {
	{ id = "stop", name = "1. Start and stop", goal = "Drive to the green box and stop inside it. Stay under 40 km/h.", len = 130,
		setup = function(s) s.zc = put(MK.zone, s, 90, s.lane, 3.2, 8) end,
		tick = function(dt, s, L)
			if kmh() > 40 + RULES.tolKmh then pen("Too fast: " .. math.floor(kmh() + 0.5) .. " km/h (40 max)", 8, "spd", 1.5) end
			if L.a > 110 then return finish("fail", "You drove past the box.") end
			if kmh() < 0.6 and SCH.t > 3 and L.a > 20 then
				local da, dl = math.abs(L.a - 90), math.abs(L.l - s.lane)
				if da <= 4 and dl <= 1.6 then
					pen("Distance from the box centre " .. string.format("%.1f", da) .. " m", math.floor(da * 3 + 0.5), "pos", 99)
					return finish("pass", "Stopped in the box.")
				end
				if SCH.t > 8 then SCH.msg = "Not in the box yet: " .. (L.a < 90 and (math.floor(86 - L.a + 0.5) .. " m to go") or "too far") end
			end
			return "run"
		end },
	{ id = "brake", name = "2. Emergency stop", goal = "Reach 50 km/h before the red line, then brake hard and stop within 30 m, keeping straight.", len = 230,
		setup = function(s)
			put(MK.line, s, 130, s.lane, 4, 1.2)
			put(MK.zone, s, 145, s.lane, 3.2, 30)
		end,
		tick = function(dt, s, L)
			if not s.at and L.a >= 130 then
				s.at, s.v0, s.l0 = true, kmh(), L.l
				if s.v0 < 50 then pen("Only " .. math.floor(s.v0 + 0.5) .. " km/h at the line (50 needed)", math.floor((50 - s.v0) * 2 + 0.5), "slow", 99) end
				SCH.msg = "BRAKE!"
			end
			if s.at then
				s.dl = math.max(s.dl or 0, math.abs(L.l - s.l0))
				if kmh() < 0.6 then
					local d = L.a - 130
					if d > 30 then return finish("fail", "Stopped " .. string.format("%.1f", d) .. " m after the line (30 m allowed).") end
					pen("Stopping distance " .. string.format("%.1f", d) .. " m", math.max(0, math.floor((d - 18) * 2 + 0.5)), "dist", 99)
					if s.dl > 1.5 then pen("Drifted " .. string.format("%.1f", s.dl) .. " m sideways", math.floor(s.dl * 6 + 0.5), "lat", 99) end
					return finish("pass", "Stopped " .. string.format("%.1f", d) .. " m after the line from " .. math.floor(s.v0 + 0.5) .. " km/h.")
				end
			elseif L.a > 40 and kmh() < 5 and SCH.t > 12 then
				SCH.msg = "Accelerate to 50 km/h before the red line."
			end
			if L.a > 200 then return finish("fail", "You did not stop.") end
			return "run"
		end },
	{ id = "limit", name = "3. Speed limit", goal = "Drive to the blue marker without going over the street's speed limit. Keep to the right.", len = 320,
		setup = function(s)
			s.lim = s.e.lim or 50
			put(MK.finish, s, 300, s.lane, 4, 3)
		end,
		tick = function(dt, s, L)
			if kmh() > s.lim + RULES.tolKmh then pen("Over the limit: " .. math.floor(kmh() + 0.5) .. " in a " .. s.lim .. " km/h street", 4, "spd", 1) end
			if L.l < -0.3 then pen("Left of the centre line (keep right)", 5, "side", 2) end
			if SCH.msg == "" then SCH.msg = "Limit " .. s.lim .. " km/h · " .. math.max(0, math.floor(300 - L.a + 0.5)) .. " m to go" end
			if L.a >= 298 then
				local fast = SCH.t < 300 / (s.lim / 3.6) * 0.8
				return finish(fast and "fail" or "pass", fast and "Impossible time: you must have sped." or ("Reached the marker in " .. string.format("%.0f", SCH.t) .. " s."))
			end
			if SCH.t > 120 then return finish("fail", "Too slow (2 minutes).") end
			return "run"
		end },
	{ id = "light", name = "4. Traffic light", goal = "Approach the junction. Stop before the line on red or amber; go on green. Cross the junction.", len = 130, lit = true,
		setup = function(s)
			s.stop = s.len - RULES.stopLine
			put(MK.line, s, s.stop, s.lane, 4, 0.6)
		end,
		tick = function(dt, s, L)
			local l = Signals.at(s.nd, s.e)
			SCH.msg = (l == "g" and "🟢 Green: go" or l == "y" and "🟡 Amber: stop if you safely can" or "🔴 Red: stop before the line") .. " · "
				.. math.max(0, math.floor(s.stop - L.a + 0.5)) .. " m to the line"
			if s.ranRed then return finish("fail", "You ran the red light.") end
			if L.a > s.stop and not s.cross then s.cross, s.cst = true, l end
			if l ~= "g" and L.a < s.stop and L.a > s.stop - 6 and kmh() < 1 then s.waited = true end
			if L.a > s.len + 25 then return finish("pass", s.waited and "Waited for green, then crossed." or ("Crossed on " .. (s.cst == "g" and "green" or "amber") .. ".")) end
			if SCH.t > 150 then return finish("fail", "Too slow.") end
			return "run"
		end },
	{ id = "park", name = "5. Reverse parking", goal = "Reverse (S) into the green bay behind you and stop straight inside it.", len = 60, start = 34,
		setup = function(s) s.zc = put(MK.zone, s, 22, s.lane + 0.2, 2.8, 6) end,
		tick = function(dt, s, L)
			if fwd() > 2 and SCH.t > 2 then SCH.msg = "Reverse: hold S (brake, then backwards)." end
			if L.a < 10 then return finish("fail", "You reversed past the bay.") end
			if kmh() < 0.4 and SCH.t > 3 and L.a < 30 then
				local da, dl = math.abs(L.a - 22), math.abs(L.l - (s.lane + 0.2))
				local dh = math.abs(math.atan2(math.sin(st.h - s.h), math.cos(st.h - s.h))) * 57.3
				if da <= 2 and dl <= 0.9 and dh <= 12 then
					pen("Off-centre " .. string.format("%.1f", math.sqrt(da * da + dl * dl)) .. " m, angle " .. string.format("%.0f", dh) .. "°", math.floor(da * 6 + dl * 12 + dh + 0.5), "pos", 99)
					return finish("pass", "Parked.")
				end
				if SCH.t > 6 then SCH.msg = "Not inside yet (" .. (dh > 12 and "straighten up" or da > 2 and (L.a > 22 and "further back" or "too far back") or "line up sideways") .. ")." end
			end
			if SCH.t > 90 then return finish("fail", "Out of time (90 s).") end
			return "run"
		end },
}
School.LESSONS = LESSONS

-- ---- the instructor panel (top centre) ----
local panel = Hud.label(Hud.gui, UDim2.new(0.5, 0, 0, 170), UDim2.fromOffset(560, 64), Vector2.new(0.5, 0), "", 15)
panel.Name = "SchoolPanel"
panel.TextWrapped = true
panel.BackgroundTransparency = 0.15
panel.BackgroundColor3 = Color3.fromHex("#0d2a1c")
panel.TextColor3 = Color3.fromHex("#eafff2")
panel.Visible = false
School.panel = panel

function School.stop(silent)
	SCH.on, SCH.site = nil, nil
	hideAll()
	panel.Visible = false
	if not silent and Hud.isOpen("Driving school result") then Hud.closePanel() end
end

function School.start(i)
	local L = LESSONS[i]
	if not L then return false end
	local s = School.find(0, 0, L.len, L.lit == true)
	if not s then
		Hud.toast("No suitable street found for this lesson")
		return false
	end
	School.stop(true)
	AutoDrive.off()
	if Gps.route() then Gps.clear() end
	SCH.on, SCH.site, SCH.t, SCH.pen, SCH.score, SCH.over, SCH.st, SCH.msg, SCH.last = L, s, 0, {}, 100, false, "run", "", {}
	L.setup(s)
	local a0 = L.start or (L.lit and 0 or 5)
	Drive.place(s.x0 + s.ux * a0 + s.rx * s.lane, s.z0 + s.uz * a0 + s.rz * s.lane, s.h)
	Traffic.clear(st.x, st.z, L.len + 80)
	Hud.closePanel()
	panel.Visible = true
	Hud.toast("Driving school: " .. L.name)
	return true
end

-- the result card: score, message, penalties, best, Retry / Next / Close
function School.result()
	local L = SCH.on
	if not L then return end
	local ok = SCH.st == "pass"
	local ix = table.find(LESSONS, L)
	panel.Visible = false
	local p = Hud.panel("Driving school result", 440, 380)
	p.sub.Text = (ok and "✅ Passed" or "❌ Not passed") .. " · " .. L.name .. " · " .. SCH.score .. "/100"
	local function text(t, order, color)
		local l = Hud.label(p.list, UDim2.new(), UDim2.fromOffset(410, 36), Vector2.new(0, 0), t, 15)
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.LayoutOrder = order
		if color then l.TextColor3 = color end
		return l
	end
	text(SCH.msg, 1)
	local lines = {}
	for _, q in ipairs(SCH.pen) do lines[#lines + 1] = "• " .. q[1] .. (q[2] > 0 and (" (−" .. q[2] .. ")") or "") end
	text(#lines > 0 and table.concat(lines, "\n") or "No mistakes.", 2, Color3.fromRGB(190, 190, 190)).Size = UDim2.fromOffset(410, math.max(36, 18 * #lines))
	text("Best: " .. (SCH.best[L.id] and (SCH.best[L.id] .. "/100") or "—"), 3, Color3.fromRGB(150, 200, 220))
	local r = Hud.button(p.list, "↻ Retry", function() School.start(ix) end, 410, 32)
	r.Name, r.LayoutOrder = "Retry", 4
	if ix < #LESSONS then
		local n = Hud.button(p.list, "Next ▶", function() School.start(ix + 1) end, 410, 32)
		n.Name, n.LayoutOrder = "Next", 5
	end
	local c = Hud.button(p.list, "Close", function() School.stop() end, 410, 32)
	c.Name, c.LayoutOrder = "Close", 6
end

-- the lesson list (from the settings menu)
function School.menu()
	local p = Hud.panel("Driving school", 420, 360)
	p.sub.Text = "Five lessons on real streets near the start · " .. SCH.runs .. " runs so far"
	for i, L in ipairs(LESSONS) do
		local b = Hud.button(p.list, L.name .. (SCH.best[L.id] and (" · best " .. SCH.best[L.id]) or ""), function() School.start(i) end, 390, 34)
		b.Name, b.LayoutOrder = "Lesson_" .. L.id, i
	end
	if SCH.on then
		local q = Hud.button(p.list, "✕ Quit the lesson", function()
			School.stop()
			Hud.closePanel()
		end, 390, 34, Color3.fromRGB(110, 40, 40))
		q.Name, q.LayoutOrder = "Quit", 9
	end
end

-- a fine was given (Laws.onFine): the instructor's penalties, a red light ends lesson 4
function School.onFine(k)
	if not SCH.on or SCH.over then return end
	if k == "hit" then
		pen("Hit another car", 30, "hit", 2)
	elseif k == "way" then
		pen("Wrong way", 20, "way", 3)
	elseif k == "red" and SCH.site then
		SCH.site.ranRed = true
	end
end

function School.step(dt)
	if not SCH.on or SCH.over then return end
	SCH.t += dt
	SCH.msg = ""
	local s = SCH.site
	local L = loc(s)
	if math.abs(L.l) > 12 and SCH.t > 2 and L.a > -5 and L.a < s.len then
		finish("fail", "You left the street.")
		return
	end
	SCH.on.tick(dt, s, L)
	if not SCH.over then
		panel.Text = "🎓 " .. SCH.on.name .. " · " .. SCH.score .. " pts · " .. string.format("%.0f", SCH.t) .. " s\n" .. SCH.on.goal .. (SCH.msg ~= "" and ("\n" .. SCH.msg) or "")
	end
end

return School
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX143"><Properties><string name="Name">Search</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the GPS search panel (key M): type part of a name, a kind ("mall") or a description; the 14 nearest matches among the
-- real OpenStreetMap places are listed with their distance; picking one starts the GPS. The web game's v49 additions: 11 category chips
-- above the results filter by place kind (also with a typed query; an empty query lists the nearest of that kind), and ☆ / ★ on each
-- result saves up to 20 places, listed first when the search box is empty (saved with the progress: remote SaveFav, attribute "Fav").
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Places = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Places"))
local State = require(script.Parent:WaitForChild("State"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local Gps = require(script.Parent:WaitForChild("Gps"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Search = {}
local st = State.st
local plr = Players.LocalPlayer
-- the web game's categories (11b NCAT): id, chip text, place kinds
Search.CATS = {
	{ "food", "🍽️ Food", { "cafe", "food" } }, { "shop", "🛍️ Shops", { "dukkan", "grocery", "mall", "market", "barber", "pet", "tech", "cleaner" } },
	{ "health", "⚕️ Health", { "medical", "hospital" } }, { "edu", "🎓 Schools", { "school", "campus" } }, { "wor", "🕌 Worship", { "mosque", "church" } },
	{ "sight", "🏛️ Sights", { "landmark", "heritage", "museum", "square", "culture" } }, { "car", "🔧 Car", { "auto", "garage", "dealer", "ev", "drift" } },
	{ "sport", "🌳 Parks & sport", { "park", "stadium", "cage", "gym" } }, { "bank", "🏦 Banks", { "bank" } }, { "civic", "🏤 Civic & bus", { "civic", "transport" } },
	{ "area", "🏘️ Areas", { "area" } },
}
local KINDS = {}
for _, c in ipairs(Search.CATS) do
	KINDS[c[1]] = {}
	for _, k in ipairs(c[3]) do KINDS[c[1]][k] = true end
end
local cat = ""
-- saved places: {n, x, z}, at most 20 ("name|x,z" separated by ";")
Search.fav = {}
local function favKey(p)
	return p.n .. "|" .. math.floor(p.x + 0.5) .. "," .. math.floor(p.z + 0.5)
end
local function loadFav()
	table.clear(Search.fav)
	local s = plr:GetAttribute("Fav")
	if type(s) ~= "string" then return end
	for n, x, z in string.gmatch(s, "([^|;]+)|(%-?%d+),(%-?%d+)") do
		if #Search.fav < 20 then Search.fav[#Search.fav + 1] = { n = n, x = tonumber(x), z = tonumber(z) } end
	end
end
loadFav()
local saving = false
plr:GetAttributeChangedSignal("Fav"):Connect(function()
	if not saving then loadFav() end
end)
local function isFav(p)
	local k = favKey(p)
	for _, f in ipairs(Search.fav) do
		if favKey(f) == k then return true end
	end
	return false
end
function Search.toggleFav(p)
	local k = favKey(p)
	for i, f in ipairs(Search.fav) do
		if favKey(f) == k then
			table.remove(Search.fav, i)
			Hud.toast("Removed from saved: " .. p.n)
			Search.saveFav()
			return false
		end
	end
	if #Search.fav >= 20 then
		Hud.toast("Up to 20 saved places: remove one first")
		return false
	end
	table.insert(Search.fav, 1, { n = p.n, x = p.x, z = p.z })
	Hud.toast("☆ Saved: " .. p.n)
	Search.saveFav()
	return true
end
function Search.saveFav()
	local out = {}
	for _, f in ipairs(Search.fav) do out[#out + 1] = string.gsub(f.n, "[|;]", " ") .. "|" .. math.floor(f.x + 0.5) .. "," .. math.floor(f.z + 0.5) end
	saving = true
	Remotes.SaveFav:FireServer(table.concat(out, ";"))
	task.delay(1, function() saving = false end)
end

function Search.open()
	if Hud.isOpen("GPS") then
		Hud.closePanel()
		return
	end
	local p = Hud.panel("GPS", 400, 420)
	p.sub.Text = "Search " .. #Places .. " real places (OpenStreetMap)"
	local box = Instance.new("TextBox")
	box.Name = "Query"
	box.Size = UDim2.new(1, -12, 0, 34)
	box.BackgroundColor3 = Color3.fromRGB(40, 44, 52)
	box.TextColor3 = Color3.new(1, 1, 1)
	box.PlaceholderText = "Type a place: mall, university, Clock Tower…"
	box.Font = Enum.Font.Gotham
	box.TextSize = 15
	box.ClearTextOnFocus = false
	box.Text = ""
	box.LayoutOrder = 0
	box.Parent = p.list
	-- the category chips: a row that scrolls sideways
	local chips = Instance.new("ScrollingFrame")
	chips.Name = "Chips"
	chips.Size = UDim2.new(1, -12, 0, 34)
	chips.BackgroundTransparency = 1
	chips.ScrollBarThickness = 3
	chips.AutomaticCanvasSize = Enum.AutomaticSize.X
	chips.CanvasSize = UDim2.new()
	chips.ScrollingDirection = Enum.ScrollingDirection.X
	chips.LayoutOrder = 1
	chips.Parent = p.list
	local cl = Instance.new("UIListLayout")
	cl.FillDirection = Enum.FillDirection.Horizontal
	cl.Padding = UDim.new(0, 4)
	cl.Parent = chips
	local rows = {}
	local show
	local chipB = {}
	for i, c in ipairs(Search.CATS) do
		local b = Hud.button(chips, c[2], function()
			cat = cat == c[1] and "" or c[1]
			show()
		end, 104, 28)
		b.Name = "Chip_" .. c[1]
		b.TextSize = 12
		b.LayoutOrder = i
		chipB[c[1]] = b
	end
	show = function()
		for _, r in ipairs(rows) do r:Destroy() end
		table.clear(rows)
		for id, b in pairs(chipB) do b.BackgroundColor3 = id == cat and Color3.fromRGB(60, 130, 80) or Color3.fromRGB(39, 64, 107) end
		local q = string.lower(box.Text)
		local order = 2
		local function row(pl, dist, saved)
			order += 1
			local f = Instance.new("Frame")
			f.Name = "Result"
			f.Size = UDim2.fromOffset(360, 32)
			f.BackgroundTransparency = 1
			f.LayoutOrder = order
			f.Parent = p.list
			local label = (saved and "★ " or "") .. pl.n .. "  ·  " .. ((pl.s and pl.s ~= "") and pl.s or (pl.k or "saved")) .. "  ·  "
				.. (dist >= 1000 and string.format("%.1f km", dist / 1000) or (math.floor(dist) .. " m"))
			local b = Hud.button(f, label, function()
				if Gps.go(pl) then p.close() end
			end, 316, 32)
			b.Name = "Go"
			b.TextXAlignment = Enum.TextXAlignment.Left
			b.TextSize = 13
			local s = Hud.button(f, isFav(pl) and "★" or "☆", function()
				Search.toggleFav(pl)
				show()
			end, 38, 32, Color3.fromRGB(70, 60, 20))
			s.Name = "Star"
			s.Position = UDim2.fromOffset(322, 0)
			rows[#rows + 1] = f
		end
		if Gps.route() then
			local b = Hud.button(p.list, "✖ Stop the GPS", function()
				Gps.clear()
				p.close()
			end, 360, 30, Color3.fromRGB(110, 50, 50))
			b.LayoutOrder = 2
			rows[#rows + 1] = b
		end
		-- the saved places first when nothing is typed and no chip is chosen
		local n = 0
		if q == "" and cat == "" then
			for _, f in ipairs(Search.fav) do
				row(f, math.sqrt((f.x - st.x) ^ 2 + (f.z - st.z) ^ 2), true)
				n += 1
			end
		end
		local found = {}
		local K = cat ~= "" and KINDS[cat] or nil
		for _, pl in ipairs(Places) do
			if (not K or K[pl.k]) and (q == "" or string.find(string.lower(pl.n), q, 1, true) or string.find(string.lower(pl.s), q, 1, true) or string.find(string.lower(pl.k), q, 1, true)) then
				found[#found + 1] = { pl = pl, d = math.sqrt((pl.x - st.x) ^ 2 + (pl.z - st.z) ^ 2) }
			end
		end
		table.sort(found, function(a, b) return a.d < b.d end)
		for k = 1, math.min(14, #found) do row(found[k].pl, found[k].d, false) end
		if #found == 0 and n == 0 then
			local l = Hud.label(p.list, UDim2.new(), UDim2.fromOffset(340, 24), Vector2.zero, "No place matches \"" .. box.Text .. "\"", 15)
			l.LayoutOrder = 3
			rows[#rows + 1] = l
		end
	end
	box:GetPropertyChangedSignal("Text"):Connect(show)
	show()
end

return Search
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX144"><Properties><string name="Name">Settings</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - this player's settings on the device: read from the player attribute "Settings" (the saved ones, set by the
-- server), changed by the settings menu and the keys (H handling, Q / E gearbox...), sent back to the server to be saved.
-- Settings.onChange(fn) -> fn(key, value) after every change (and once per key at the start).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Schema = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("SettingsSchema"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Settings = { schema = Schema }
local plr = Players.LocalPlayer
local cur = Schema.parse(plr:GetAttribute("Settings"))
local subs = {}
local dirty = false

function Settings.get(k)
	return cur[k]
end

function Settings.onChange(fn)
	subs[#subs + 1] = fn
	for _, r in ipairs(Schema.LIST) do fn(r[1], cur[r[1]]) end
end

local function fire(k, v)
	for _, fn in ipairs(subs) do fn(k, v) end
end

-- set one setting (checked against the schema); saved within a second
function Settings.set(k, v)
	local d = Schema.BY[k]
	if not d then return end
	v = math.clamp(math.floor(v), d.min, d.max)
	if cur[k] == v then return end
	cur[k] = v
	dirty = true
	fire(k, v)
end

-- the next value of a setting (menu rows cycle through their values)
function Settings.cycle(k, dir)
	local d = Schema.BY[k]
	local n = d.max - d.min + 1
	Settings.set(k, d.min + (cur[k] - d.min + (dir or 1)) % n)
	return cur[k]
end

function Settings.text(k)
	return Schema.text(k, cur[k])
end

-- the settings whose system exists on this device (the menu lists only these); modules call provide() for theirs
Settings.active = {}
function Settings.provide(...)
	for _, k in ipairs({ ... }) do Settings.active[k] = true end
end

-- the saved settings arrive after the device started (the server loads the DataStore record first)
plr:GetAttributeChangedSignal("Settings"):Connect(function()
	if dirty then return end
	local t = Schema.parse(plr:GetAttribute("Settings"))
	for _, r in ipairs(Schema.LIST) do
		local k = r[1]
		if t[k] ~= cur[k] then
			cur[k] = t[k]
			fire(k, t[k])
		end
	end
end)

-- send the changes (at most once a second)
task.spawn(function()
	while true do
		task.wait(1)
		if dirty then
			dirty = false
			Remotes.SaveSettings:FireServer(Schema.encode(cur))
		end
	end
end)

return Settings
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX145"><Properties><string name="Name">SettingsMenu</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the settings menu (key Y or the ⚙ button; the web game's Esc pause menu, 12e_pause.js: Roblox keeps Esc for its
-- own menu) and the gamepad / racing-wheel setup (the web game's wheel setup screen, key V there; here a button in the settings menu),
-- with live readings of the steering and the pedals. One row per setting: click a row for its next value; numbers have − / + buttons.
-- Changes apply at once and are saved with the progress. While a menu is open the car brakes (the web game's ui flag). Extra rows
-- (the driving school...) come from the modules that own them (SettingsMenu.extra).
local RunService = game:GetService("RunService")
local Client = script.Parent
local Hud = require(Client:WaitForChild("Hud"))
local Settings = require(Client:WaitForChild("Settings"))
local Gamepad = require(Client:WaitForChild("Gamepad"))

local SettingsMenu = { extra = {} }
local Schema = Settings.schema

local function rows(p, pad)
	local order = 0
	for _, r in ipairs(Schema.LIST) do
		local k = r[1]
		if Settings.active[k] and (Schema.PAD[k] == true) == pad then
			order += 1
			local d = Schema.BY[k]
			if d.names then
				local b
				b = Hud.button(p.list, "", function()
					Settings.cycle(k, 1)
					b.Text = d.label .. ": " .. Settings.text(k)
				end, 400, 32)
				b.Name = "Row_" .. k
				b.Text = d.label .. ": " .. Settings.text(k)
				b.LayoutOrder = order
			else
				local row = Instance.new("Frame")
				row.Name = "Row_" .. k
				row.Size = UDim2.fromOffset(400, 32)
				row.BackgroundTransparency = 1
				row.LayoutOrder = order
				row.Parent = p.list
				local lab = Hud.label(row, UDim2.fromOffset(0, 0), UDim2.fromOffset(280, 32), Vector2.new(0, 0), "", 16)
				lab.TextXAlignment = Enum.TextXAlignment.Left
				local function show() lab.Text = d.label .. ": " .. Settings.text(k) end
				show()
				local minus = Hud.button(row, "−", function()
					Settings.set(k, Settings.get(k) - 1)
					show()
				end, 50, 30)
				minus.Name = "Minus"
				minus.Position = UDim2.fromOffset(290, 1)
				local plus = Hud.button(row, "+", function()
					Settings.set(k, Settings.get(k) + 1)
					show()
				end, 50, 30)
				plus.Name = "Plus"
				plus.Position = UDim2.fromOffset(348, 1)
			end
		end
	end
	return order
end

function SettingsMenu.open()
	if Hud.isOpen("Settings") then
		Hud.closePanel()
		return
	end
	local p = Hud.panel("Settings", 430, 470)
	p.sub.Text = "Click a row to change it · saved with your progress"
	local order = rows(p, false)
	order += 1
	local g = Hud.button(p.list, "🎮 Gamepad / racing wheel setup", SettingsMenu.openPad, 400, 32, Color3.fromRGB(60, 90, 60))
	g.Name = "Extra_pad"
	g.LayoutOrder = order
	for _, e in ipairs(SettingsMenu.extra) do
		order += 1
		local b = Hud.button(p.list, e.text(), function() e.click(p) end, 400, 32, e.color)
		b.Name = "Extra_" .. e.name
		b.LayoutOrder = order
	end
end

-- the gamepad / wheel setup: live readings (raw axis, steering after the processing, gas, brake), then the rows
function SettingsMenu.openPad()
	local p = Hud.panel("Gamepad / racing wheel", 430, 500)
	p.sub.Text = "A G29 works through Steam Input or x360ce (as a gamepad) · no force feedback"
	local live = Hud.label(p.list, UDim2.new(), UDim2.fromOffset(400, 40), Vector2.new(0, 0), "", 15)
	live.Name = "Live"
	live.LayoutOrder = 0
	live.TextWrapped = true
	rows(p, true)
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if not live.Parent or not Hud.isOpen("Gamepad / racing wheel") then
			conn:Disconnect()
			return
		end
		local s = Gamepad.state
		live.Text = (s.on and "Gamepad connected" or "No gamepad input yet (move a stick or press a pedal)")
			.. string.format(" · raw %+.2f · steering %+.2f · gas %.2f · brake %.2f%s", s.raw, s.steer, s.thr, s.brk, s.hb and " · handbrake" or "")
	end)
end

return SettingsMenu
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX146"><Properties><string name="Name">Signals</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - traffic lights (the web game's): signalised real junctions (OSM traffic_signals, or major crossroads, which
-- the web game marks as estimated). A 60 s cycle: 24 s green, 3 s amber, the rest red; the two axes of a junction are half a cycle
-- apart; junctions are in 4 groups 15 s apart; a link inside a split junction is always green. The clock is the server's game time,
-- so every player sees the same lights. Also recolours the lamps of the signal heads that WorldBuilder put up.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Rules = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Rules"))
local State = require(script.Parent:WaitForChild("State"))

local Signals = {}
local CYC, G, Y = 60, 24, 3

-- 'g' / 'y' / 'r' for an approach axis ('x', 'z', 'i') at a junction whose cycle offset is o (seconds)
function Signals.light(ax, o)
	if ax == "i" or ax == nil then return "g" end
	local p = (Workspace.DistributedGameTime + (o or 0) + (ax == "x" and 0 or CYC / 2)) % CYC
	return p < G and "g" or p < G + Y and "y" or "r"
end

-- mark the signalised nodes of the road graph: node.lit = {o = offset, ph = {[edge id] = axis}}
function Signals.attach(g)
	for _, s in ipairs(Rules.signals) do
		local nd = g.nodes[s.n]
		if nd then
			local ph = {}
			for _, q in ipairs(s.ph) do ph[q[1]] = q[2] end
			nd.lit = { o = s.o, ph = ph }
		end
	end
end

-- the light for a car arriving at node nd along edge e ('g' where there is no signal)
function Signals.at(nd, e)
	if not (nd and nd.lit) then return "g" end
	return Signals.light(nd.lit.ph[e.id], nd.lit.o)
end

-- lamps: recoloured only when some junction group changes state
local ON = { r = Color3.fromRGB(255, 40, 30), y = Color3.fromRGB(255, 190, 20), g = Color3.fromRGB(40, 255, 110) }
local OFF = { r = Color3.fromRGB(50, 10, 8), y = Color3.fromRGB(50, 38, 6), g = Color3.fromRGB(8, 46, 20) }
local heads = nil
local lastKey = ""
function Signals.step()
	if not heads then
		local f = Workspace:FindFirstChild("IrbidMap") and Workspace.IrbidMap:FindFirstChild("Signals")
		if not f then return end
		heads = {}
		for _, h in ipairs(f:GetChildren()) do
			local lamps = {}
			for _, c in ipairs({ "r", "y", "g" }) do lamps[c] = h:FindFirstChild("Lamp_" .. c) end
			heads[#heads + 1] = { a = h:GetAttribute("a"), o = h:GetAttribute("o"), lamps = lamps }
		end
	end
	local key = ""
	for grp = 0, 3 do key ..= Signals.light("x", grp * 15) .. Signals.light("z", grp * 15) end
	if key == lastKey then return end
	lastKey = key
	for _, h in ipairs(heads) do
		local s = Signals.light(h.a, h.o)
		for c, p in pairs(h.lamps) do
			p.Color = c == s and ON[c] or OFF[c]
		end
	end
end

-- (State is shared with the traffic and laws modules that read the lights)
State.signals = Signals
return Signals
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX147"><Properties><string name="Name">SpeedBumps</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - crossing speed bumps, the web game's quarter-car model (07c_realism.js checkSpeedBumpCrossing): per axle the
-- tyre follows the bump profile (or falls back to it no faster than WDROP), the body is a spring-damper on it (natural frequency and
-- damping from the car's handling profile, wheelbase from its spec). The car only gets a short hop when the body rises past full
-- suspension droop (fast crossings), never a launch. Also the body heave / pitch and a short vibration for the car's looks.
-- Taken too fast (the bump stop reached, or the damper compressed faster than ~4 m/s) the crossing is reported to the damage system
-- (SpeedBumps.onImpact(speed, severity, axle 0 front / 1 rear), at most every 0.6 s, as in the web game).
local Workspace = game:GetService("Workspace")
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Ground = require(Client:WaitForChild("Ground"))

local SpeedBumps = {}
local st, spec = State.st, State.spec
local WDROP = 110
local SUSP = { zb = { 0, 0 }, vb = { 0, 0 }, zh = { 0, 0 }, vh = { 0, 0 }, vrel = { 0, 0 }, comp = { 0, 0 }, heave = 0, pitch = 0, jolt = 0, active = false, last = -9 }
-- the suspension travel before the bump stop, by body type (the web game's suspTravel)
local function travel(k)
	return (k == "r" or k == "m" or k == "q") and 0.05 or (k == "s" or k == "p" or k == "v") and 0.11 or 0.075
end
SpeedBumps.SUSP = SUSP

-- prevX, prevZ = the car's position before this frame's move
function SpeedBumps.step(prevX, prevZ, dt)
	if not Ground.anyBumps then return end
	local fn, ze, wb = spec.fn or 1.5, spec.zeta or 0.4, spec.wb or 2.6
	local w = 2 * math.pi * fn
	local fx, fz = math.sin(st.h), math.cos(st.h)
	local hw = wb / 2
	local any = false
	SUSP.jolt *= math.exp(-7 * dt)
	for a = 1, 2 do
		local s = a == 2 and -1 or 1
		local zp = st.gnd and Ground.bumpAt(st.x + fx * hw * s, st.z + fz * hw * s) or 0
		if zp > 0 or Ground.bumpAt((prevX + st.x) / 2 + fx * hw * s, (prevZ + st.z) / 2 + fz * hw * s) > 0
			or SUSP.zh[a] > 1e-4 or math.abs(SUSP.zb[a]) > 1e-4 or math.abs(SUSP.vb[a]) > 1e-3 then
			any = true
			-- sub-steps sample the profile along the axle's path this frame (5 cm apart), so a 0.9 m bump is resolved at any speed
			local n = math.clamp(math.ceil(math.sqrt((st.x - prevX) ^ 2 + (st.z - prevZ) ^ 2) / 0.05), 4, 24)
			local h = dt / n
			local ax, az = fx * hw * s, fz * hw * s
			for k = 1, n do
				local f = k / n
				local zpk = st.gnd and Ground.bumpAt(prevX + (st.x - prevX) * f + ax, prevZ + (st.z - prevZ) * f + az) or 0
				SUSP.vh[a] -= WDROP * h
				local zh = SUSP.zh[a] + SUSP.vh[a] * h
				if zh <= zpk then
					SUSP.vh[a] = (zpk - SUSP.zh[a]) / h
					zh = zpk
				end
				if zh > zpk + 0.02 then
					zh = zpk + 0.02
					SUSP.vh[a] = math.min(SUSP.vh[a], 0)
				end
				SUSP.zh[a] = zh
				local vrel = SUSP.vh[a] - SUSP.vb[a]
				local acc = -w * w * (SUSP.zb[a] - zh) + 2 * ze * w * vrel
				SUSP.vb[a] += acc * h
				SUSP.zb[a] += SUSP.vb[a] * h
				SUSP.vrel[a] = vrel
				SUSP.jolt = math.max(SUSP.jolt, math.abs(vrel))
			end
			SUSP.zb[a] = math.clamp(SUSP.zb[a], -0.15, 0.3)
			SUSP.comp[a] = SUSP.zh[a] - SUSP.zb[a]
			-- harshness: hitting the bump stop (main term), or compressing faster than the damper can soak up
			local sev = math.max((SUSP.comp[a] - travel(spec.body)) / 0.02, (SUSP.vrel[a] - 4) / 2)
			local now = Workspace.DistributedGameTime
			if sev > 0 and now - SUSP.last > 0.6 then
				SUSP.last = now
				if SpeedBumps.onImpact then SpeedBumps.onImpact(math.sqrt(st.vx * st.vx + st.vz * st.vz), sev, a - 1) end
			end
			-- the axle leaves the ground only when the body rises past full suspension droop (~6 cm): a short hop
			if st.gnd and SUSP.vb[a] > 0 and SUSP.zb[a] - SUSP.zh[a] > 0.06 then st.vy = math.max(st.vy, math.min(1.2, SUSP.vb[a] * 0.5)) end
		end
	end
	SUSP.active = any
	SUSP.heave = (SUSP.zb[1] + SUSP.zb[2]) / 2
	SUSP.pitch = math.atan2(SUSP.zb[2] - SUSP.zb[1], wb)
end

-- extra body movement for the car's CFrame: heave (m), pitch (rad, nose up +), roll (rad)
local t = 0
function SpeedBumps.visual(dt)
	t += dt
	local heave, pitch, roll = 0, 0, 0
	if SUSP.active then
		heave, pitch = SUSP.heave, -SUSP.pitch
	end
	if SUSP.jolt > 0.15 then
		local j = math.min(1, SUSP.jolt / 6)
		heave += math.sin(t * 83) * 0.012 * j
		roll += math.sin(t * 61) * 0.012 * j
		pitch += math.sin(t * 71) * 0.008 * j
	end
	return heave, pitch, roll
end

return SpeedBumps
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX148"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - state shared by the client modules (one table; every module that requires it gets the same one).
-- Units: metres, metres per second, radians. Heading h has forward (sin h, cos h); x = east, z = south.
return {
	car = nil, -- the player's car model (Car_<UserId>)
	body = nil, -- its Body part
	st = { x = 0, y = 0, z = 0, h = 0, vx = 0, vz = 0, vy = 0, gnd = false, sp = 0, fs = 0 },
	spec = { vm = 40, a0 = 8, bk = 9.81, hd = 1, dr = 0, rm = 1, tier = 0, name = "", L = 4.4, W = 1.8, H = 1.45 },
	input = { th = 0, br = 0, steer = 0, hb = false, an = false }, -- an = steering from an analog axis (gamepad / wheel)
	frozen = false, -- race countdown: the car is held still
	ui = nil, -- name of the open menu (nil = driving)
	road = nil, -- the road graph (Modules/Road)
	ai = {}, -- every AI car this frame (traffic, rivals, police): {x, z, h, v, L, W, hit}
	mission = nil, -- "race" | "heist" | nil
	raceMark = nil, -- {x, z} of the next race checkpoint (minimap)
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX149"><Properties><string name="Name">StreetName</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the name of the street under the car (OpenStreetMap), checked 4 times a second, for the info line.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Road = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Road"))
local State = require(script.Parent:WaitForChild("State"))

local StreetName = { name = "" }
local t = 0

function StreetName.step(dt)
	t -= dt
	if t > 0 then return end
	t = 0.25
	local near = State.road and Road.nearest(State.road, State.st.x, State.st.z, 25)
	StreetName.name = near and near.e.name or ""
end

return StreetName
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX150"><Properties><string name="Name">Traffic</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - AI cars on this device. Traffic follows the web game (09_ai.js): 80 cars on the real road graph in the right-hand
-- lane, cruising at 13 m/s x the street limit / 50 x a factor by rarity, slower in bends, stopping at red lights and slowing at
-- roundabouts, keeping 6.5 m behind the car ahead, choosing at each junction by road kind, width and straightness.
-- Also the shared pieces the race rivals and the police use (models, path following). Every device has its own traffic.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Road = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Road"))
local Rules = require(ReplicatedStorage:WaitForChild("IrbidShared"):WaitForChild("Rules"))
local CarBody = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("CarBody"))
local State = require(script.Parent:WaitForChild("State"))

local Traffic = {}
local S = Config.SCALE
local folder = Instance.new("Folder")
folder.Name = "LocalAI_" .. Players.LocalPlayer.UserId
folder.Parent = Workspace
Traffic.folder = folder
local agents = {}
Traffic.agents = agents

-- a web colour (0xRRGGBB) as a Color3
function Traffic.hex(c)
	return Color3.fromRGB(math.floor(c / 65536) % 256, math.floor(c / 256) % 256, c % 256)
end
-- the web game's traffic paints (07a2 TCOL: mostly white, silver, grey, black)
local PAINT = {}
for i, c in ipairs(Rules.traffic.tcol) do PAINT[i] = Traffic.hex(c) end

-- an AI car's model: the web game's shape for that car (Modules/CarBody), anchored, no collision, ignored by ray tests; pivot = its root
-- part at H * 0.34 - 0.12 above the car's ground point. opt = {neon (the light lines), cop (the light bar)}
function Traffic.model(c, color, opt)
	local m = CarBody.build(c, color, { S = S, anchored = true, neon = opt and opt.neon, cop = opt and opt.cop })
	m.Parent = folder
	return m
end

-- an AI car: position / heading / speed in metres, a polyline to follow (P) and the distance along it (s)
function Traffic.agent(kind, car, color)
	local c = car or Config.CARS[math.random(#Config.CARS)]
	local a = {
		kind = kind, cop = kind == "cop", name = c.name or "Police", L = c.L, W = c.W, H = c.H, vm = c.vm, a0 = c.a0,
		x = 0, z = 0, y = 0, h = 0, v = 0, s = 0, pi = 1, hit = 0, active = true, skill = 1,
	}
	a.model = Traffic.model(c, color or PAINT[math.random(#PAINT)], Traffic.look(kind, c))
	a.car, a.col = c, color
	return a
end

-- the web game's looks: traffic cars from Uncommon up carry their light lines (carMesh), race and duel rivals the full set (mkPorsche),
-- police a light bar and no lines (mkCop)
function Traffic.look(kind, c)
	if kind == "cop" then return { cop = true } end
	return { neon = kind == "rival" or (kind == "traffic" and (c.tier or 0) >= 1) }
end

-- give an AI car another model (the web game's setTrafficModel): a new model only when the car or the paint changes
function Traffic.setCar(a, c, color)
	if a.car == c and a.col == color then return end
	local cf = a.model and a.model:GetPivot()
	if a.model then a.model:Destroy() end
	a.model = Traffic.model(c, color, Traffic.look(a.kind, c))
	if cf then a.model:PivotTo(cf) end
	a.car, a.col, a.name, a.L, a.W, a.H, a.vm, a.a0 = c, color, c.name, c.L, c.W, c.H, c.vm, c.a0
end

function Traffic.draw(a)
	-- the root part at the web game's car height (terrain + 0.12 m) + its lift
	local pos = Vector3.new(a.x, a.y + 0.12 + CarBody.lift(a.H), a.z) * S
	a.model:PivotTo(CFrame.lookAt(pos, pos + Vector3.new(math.sin(a.h), 0, math.cos(a.h))))
end

function Traffic.remove(a)
	a.active = false
	if a.model then a.model:Destroy() end
end

-- move along the polyline at the target speed vt (accelerate with the car's own curve, brake at up to 9 m/s^2)
function Traffic.follow(a, dt, vt)
	if a.hit > 0 then
		a.hit -= dt
		vt = 0
	end
	local acc = a.a0 * (1 - math.pow(math.max(a.v, 0) / (a.vm * 1.05), 2.5))
	a.v = math.max(0, a.v + math.clamp(vt - a.v, -9 * dt, math.max(acc, 0.5) * dt))
	a.s = math.min(a.s + a.v * dt, a.P.c[#a.P.c])
	local x, z, y, tx, tz, i = Road.sample(a.P, a.s, a.pi)
	a.x, a.z, a.y, a.pi = x, z, y, i
	local want = math.atan2(tx, tz)
	local d = (want - a.h + math.pi) % (2 * math.pi) - math.pi
	a.h += math.clamp(d, -4 * dt, 4 * dt)
end

-- the web game's curve cap over the next 150 m of the path, plus braking room
function Traffic.curveCap(a, brake)
	local P, j = a.P, a.pi
	local c0, best = a.s, 1e9
	while j + 3 <= #P.x and P.c[j] - c0 < 150 do
		local a1 = math.atan2(P.x[j + 1] - P.x[j], P.z[j + 1] - P.z[j])
		local a2 = math.atan2(P.x[j + 3] - P.x[j + 2], P.z[j + 3] - P.z[j + 2])
		local sa = math.max(0.02, math.abs((a2 - a1 + math.pi) % (2 * math.pi) - math.pi))
		local cp = math.clamp(math.sqrt(224 / sa), 9, 120)
		best = math.min(best, math.sqrt(cp * cp + 2 * (brake or 8) * math.max(0, P.c[j] - c0 - 4)))
		j += 1
	end
	return best
end

-- slow down for anything in front within 24 m and 2.6 m of the lane (other AI cars and the player)
function Traffic.gap(a, vt)
	local sh, ch = math.sin(a.h), math.cos(a.h)
	local function check(x, z)
		local dx, dz = x - a.x, z - a.z
		local f = dx * sh + dz * ch
		if f > 0 and f < 24 then
			local l = dx * ch - dz * sh
			if math.abs(l) < 2.6 then
				vt = math.min(vt, math.max(0, (f - 7) * 1.2))
			end
		end
	end
	for _, o in ipairs(State.ai) do
		if o ~= a then check(o.x, o.z) end
	end
	check(State.st.x, State.st.z)
	return vt
end

-- ---- traffic: the web game's (09_ai.js) ----
-- which roads traffic starts on (TRW) and how it picks a way at a junction (nextTrav): a weight per road kind x width x straightness
local TRW = { hw = 1, arch = 1, petra = 1, main = 0.85, ["local"] = 0.4, svc = 0.07, ramp = 0.5, ring = 0.7, drift = 0, campus = 0.5, alley = 0.3 }
local function nextTrav(tr)
	local e, d = tr.e, tr.d
	local node = State.road.nodes[d > 0 and e.b or e.a]
	local n = e.n
	local ax, az
	if d > 0 then
		ax, az = e.x[n] - e.x[math.max(1, n - 2)], e.z[n] - e.z[math.max(1, n - 2)]
	else
		ax, az = e.x[1] - e.x[math.min(n, 3)], e.z[1] - e.z[math.min(n, 3)]
	end
	local al = math.max(math.sqrt(ax * ax + az * az), 1e-6)
	local opts, wsum = {}, 0
	for _, o in ipairs(node.out) do
		if not (o.e == e and o.d == -d) and o.e.fk ~= "drift" then
			local oe = o.e
			local k2 = math.min(3, oe.n)
			local bx, bz
			if o.d > 0 then
				bx, bz = oe.x[k2] - oe.x[1], oe.z[k2] - oe.z[1]
			else
				bx, bz = oe.x[oe.n + 1 - k2] - oe.x[oe.n], oe.z[oe.n + 1 - k2] - oe.z[oe.n]
			end
			local cs = (ax * bx + az * bz) / (al * math.max(math.sqrt(bx * bx + bz * bz), 1e-6))
			local w = (oe.fk == "svc" and 0.2 or oe.fk == "local" and 0.7 or oe.fk == "ramp" and 0.6 or 1) * (0.6 + oe.w / 20) * (1 + 1.5 * math.max(0, cs))
			opts[#opts + 1] = { o = o, w = w }
			wsum += w
		end
	end
	if #opts == 0 then return nil end
	local r = math.random() * wsum
	for _, q in ipairs(opts) do
		r -= q.w
		if r <= 0 then return q.o end
	end
	return opts[#opts].o
end

local function rebuild(a)
	a.P = Road.path(a.trs, Road.lane)
	a.pi = 1
end

-- keep 170 m of path ahead, and drop traversals already driven
local function extend(a)
	local g = 0
	while a.P.c[#a.P.c] - a.s < 170 and g < 6 do
		g += 1
		local nt = nextTrav(a.trs[#a.trs])
		if not nt then
			a.dead = true
			break
		end
		a.trs[#a.trs + 1] = nt
		rebuild(a)
	end
	if #a.trs > 3 and a.s > a.P.ends[1] + 25 then
		local cut = a.P.ends[1]
		table.remove(a.trs, 1)
		rebuild(a)
		a.s = math.max(0, a.s - cut)
	end
end

-- the web game's traffic cars (07a2 rollTraffic / setTrafficModel): the rarity tier by the spawn odds of the street's traffic zone (old
-- Al-Balad mostly common cars, Petra Street and the mall area more expensive ones), then one of that tier's traffic models; tiers from
-- Rare up keep their own paint when they are sports / named models, every other car gets a traffic paint. Faster tiers cruise faster (cru).
local TR = Rules.traffic
local function rollCar(e)
	local zi = e and tonumber(string.sub(TR.ezone, e.id, e.id)) or 0
	local w = TR.odds[zi + 1] or TR.odds[1]
	local r, tier = math.random(), 0
	while tier < 4 and r >= w[tier + 1] do
		r -= w[tier + 1]
		tier += 1
	end
	local pool = TR.pools[tier + 1]
	local ix = pool[math.random(#pool)]
	local c = Config.CARS[ix]
	local col = (tier >= 2 and string.sub(TR.own, ix, ix) == "1") and Traffic.hex(c.col) or PAINT[math.random(#PAINT)]
	local function R(a, b) return a + math.random() * (b - a) end
	local cru = tier >= 3 and R(1, 1.3) or tier == 2 and R(0.98, 1.25) or tier == 1 and R(0.9, 1.15) or R(0.85, 1.1)
	return c, cru, col
end
Traffic.rollCar = rollCar

-- (re)place a traffic car on a road rmin-640 m from the player (the web game's respawn / pickSeg)
local function spawn(a, rmin)
	local st = State.st
	for _ = 1, 120 do
		local ang, r = math.random() * 2 * math.pi, (rmin or 260) + math.random() * (640 - (rmin or 260))
		local near = Road.nearest(State.road, st.x + math.cos(ang) * r, st.z + math.sin(ang) * r, 50)
		if near and not near.e.track and math.random() < (TRW[near.e.fk] or 0.4) then
			local d = near.e.ow and 1 or (math.random() < 0.5 and 1 or -1)
			-- a new car for the new street (the web game re-rolls the model at every respawn)
			local c, cru, col = rollCar(near.e)
			Traffic.setCar(a, c, col)
			a.cru = cru
			a.trs = { { e = near.e, d = d } }
			a.dead = false
			rebuild(a)
			a.s = d > 0 and near.s or near.e.len - near.s
			extend(a)
			a.v, a.hit, a.stuck = 0, 0, 0
			local x, z, y, tx, tz, i = Road.sample(a.P, a.s, 1)
			a.x, a.z, a.y, a.pi, a.h = x, z, y, i, math.atan2(tx, tz)
			return true
		end
	end
	a.x, a.z = 1e5, 1e5
	return false
end

function Traffic.start()
	for _ = 1, Config.TRAFFIC_CARS do
		local car, cru, col = rollCar(nil)
		local a = Traffic.agent("traffic", car, col)
		a.cru = cru
		agents[#agents + 1] = a
		spawn(a, 40)
		Traffic.draw(a)
	end
end

-- the traffic density (the web game's trApply): the first round(N x den) cars drive, the others are parked far away; soft = a car
-- within 250 m of the player is never parked (By time of day changes)
function Traffic.density(den, soft)
	local n = math.floor(#agents * den + 0.5)
	local st = State.st
	for i, a in ipairs(agents) do
		local pk = i > n
		if pk ~= (a.park == true) and not (soft and pk and math.sqrt((a.x - st.x) ^ 2 + (a.z - st.z) ^ 2) < 250) then
			a.park = pk
			if pk then
				a.x, a.z, a.v = 2e5, 2e5, 0
				Traffic.draw(a)
			else
				a.x, a.z = 1e5, 1e5
			end
		end
	end
end
function Traffic.driving()
	local n = 0
	for _, a in ipairs(agents) do
		if not a.park then n += 1 end
	end
	return n
end

-- move traffic cars out of a circle (race starts)
function Traffic.clear(x, z, r)
	for _, a in ipairs(agents) do
		if (a.x - x) ^ 2 + (a.z - z) ^ 2 < r * r then spawn(a, 200) end
	end
end

local Signals
function Traffic.step(dt)
	Signals = Signals or State.signals
	local st = State.st
	for _, a in ipairs(agents) do
		if a.park then
			-- a parked car (traffic density): not simulated
			continue
		end
		if a.x > 9e4 then
			spawn(a, 60)
		else
			extend(a)
			-- the street's limit, the cruise factor, bends
			local ti = 1
			while ti < #a.trs and a.s > a.P.ends[ti] do ti += 1 end
			local tgt = 13 * a.cru * a.trs[ti].e.lim / 50
			tgt = math.min(tgt, Traffic.curveCap(a, 10) * 0.8)
			-- junctions within 110 m: stop 11 m before a red light (or an amber one it cannot clear), 8 m/s near a roundabout
			for k = ti, #a.trs do
				local d = a.P.ends[k] - a.s
				if d > 110 then break end
				local tr = a.trs[k]
				local nd = State.road.nodes[tr.d > 0 and tr.e.b or tr.e.a]
				if nd.lit and Signals then
					local dd = d - 11
					local l = Signals.at(nd, tr.e)
					if dd > -4 and (l == "r" or (l == "y" and dd > a.v * 0.9)) then tgt = math.min(tgt, math.sqrt(7 * math.max(dd, 0))) end
				elseif nd.rb and d < 38 then
					tgt = math.min(tgt, 8)
				end
			end
			-- the car ahead: keep 6.5 m; behind the player the gap of the road reputation (6.5 m, up to 12 m when it is low)
			local sh, ch = math.sin(a.h), math.cos(a.h)
			local function gap(x, z, g)
				local dx, dz = x - a.x, z - a.z
				local f = dx * sh + dz * ch
				if f > 0 and f < 26 and math.abs(dx * ch - dz * sh) < 2.6 then tgt = math.min(tgt, math.max(0, (f - g) * 0.9)) end
			end
			for _, o in ipairs(State.ai) do
				if o ~= a then gap(o.x, o.z, 6.5) end
			end
			gap(st.x, st.z, State.repGap or 6.5)
			if a.hit > 0 then
				a.hit -= dt
				tgt = 0
			end
			-- +3 m/s^2 up, -9 m/s^2 down
			a.v = tgt > a.v and math.min(tgt, a.v + 3 * dt) or math.max(tgt, a.v - 9 * dt)
			a.s = math.min(a.s + a.v * dt, a.P.c[#a.P.c])
			local x, z, y, tx, tz, i = Road.sample(a.P, a.s, a.pi)
			a.x, a.z, a.y, a.pi = x, z, y, i
			local want = math.atan2(tx, tz)
			a.h += math.clamp((want - a.h + math.pi) % (2 * math.pi) - math.pi, -2.8 * dt, 2.8 * dt)
			a.stuck = (a.v < 0.4 and a.hit <= 0) and a.stuck + dt or 0
			if (a.x - st.x) ^ 2 + (a.z - st.z) ^ 2 > 680 * 680 or a.stuck > 14 or (a.dead and a.s >= a.P.c[#a.P.c] - 3) then
				spawn(a, 260)
			end
			Traffic.draw(a)
		end
	end
end

return Traffic
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX151"><Properties><string name="Name">TrafficDensity</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - traffic density (the web game's 12e trDen / trApply / trAutoTick; setting "tr"): High 100 %, Medium 65 %, Low 35 %
-- of the traffic cars, or By time of day: a generic weekday curve by the hour (30 % at night, 100 % at 08:00 and 14:00-16:00; an
-- estimate, not Irbid counts), checked every 5 s; a car within 250 m of the player is never parked then.
local Lighting = game:GetService("Lighting")
local Client = script.Parent
local Settings = require(Client:WaitForChild("Settings"))
local Traffic = require(Client:WaitForChild("Traffic"))

local TrafficDensity = {}
local TDEN = { 1, 0.65, 0.35 }
local TPROF = { 0.35, 0.32, 0.3, 0.3, 0.3, 0.4, 0.6, 0.9, 1, 0.9, 0.8, 0.8, 0.85, 0.95, 1, 1, 0.95, 0.9, 0.85, 0.75, 0.65, 0.55, 0.45, 0.4 }
TrafficDensity.TPROF = TPROF
Settings.provide("tr")

function TrafficDensity.den()
	local m = Settings.get("tr")
	if m < 3 then return TDEN[m + 1] end
	local h = Lighting.ClockTime % 24
	local i = math.floor(h)
	local f = h - i
	return TPROF[i + 1] + (TPROF[(i + 1) % 24 + 1] - TPROF[i + 1]) * f
end

Settings.onChange(function(k)
	if k == "tr" then Traffic.density(TrafficDensity.den(), false) end
end)

local t = 0
function TrafficDensity.step(dt)
	if Settings.get("tr") ~= 3 then return end
	t -= dt
	if t > 0 then return end
	t = 5
	Traffic.density(TrafficDensity.den(), true)
end

return TrafficDensity
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX152"><Properties><string name="Name">TuneShop</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the Apex Drift Customs menu (key U or P, only at the orange pad): the 4 upgrades of the current car with their
-- level and next price in drift points, and the repair bay (the web game's 08d): every damaged item with its condition, effect and price
-- in JD (base + per % lost, x the rarity tier; gameplay estimates, not workshop quotes), "Repair all", and the full inspection of all
-- 42 parts. The server does every purchase and repair.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local State = require(script.Parent:WaitForChild("State"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local CarInfo = require(script.Parent:WaitForChild("CarInfo"))
local CarDamage = require(script.Parent:WaitForChild("CarDamage"))
local Diagnostics = require(script.Parent:WaitForChild("Diagnostics"))
local Damage = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Damage"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local TuneShop = {}
local plr = Players.LocalPlayer
local fmt = Hud.fmt

function TuneShop.open()
	if Hud.isOpen("Apex Drift Customs") then
		Hud.closePanel()
		return
	end
	local p = Hud.panel("Apex Drift Customs", 420, 520)
	local inspect = false
	local fill
	local function repair(ids)
		local ci = State.spec.ci or 1
		local ok, r, total, label = Remotes.Damage:InvokeServer("repair", ci, ids)
		if ok then
			CarDamage.setRecord(r)
			Hud.toast("🔧 Repaired: " .. tostring(label) .. " · −" .. fmt(total) .. " JD")
		else
			Hud.toast(tostring(r))
		end
		fill()
	end
	-- the repair bay rows, after the upgrades
	local function repairs(order)
		local rec = CarDamage.record()
		local car = Config.CARS[State.spec.ci or 1]
		local cash = plr:GetAttribute("Cash") or 0
		local function text(t, h, color)
			order += 1
			local l = Hud.label(p.list, UDim2.new(), UDim2.fromOffset(390, h or 20), Vector2.new(0, 0), t, 15)
			l.TextXAlignment = Enum.TextXAlignment.Left
			l.TextWrapped = true
			if color then l.TextColor3 = color end
			l.LayoutOrder = order
			return l
		end
		text("🛠 Repair bay · balance " .. fmt(cash) .. " JD · prices are gameplay estimates", 22, Color3.fromRGB(255, 210, 74))
		local items = rec and Damage.repairItems(rec, car) or {}
		if #items == 0 then
			text("No damage recorded on this car." .. (CarDamage.mode() == 0 and " Damage is Off (press I for Cosmetic or Full)." or ""))
		else
			local total, grp = 0, ""
			for _, q in ipairs(items) do
				total += q.price
				if q.grp ~= grp then
					grp = q.grp
					text(grp, 20, Color3.fromRGB(255, 210, 74))
				end
				order += 1
				local w = Diagnostics.sev(q.cond)
				local b = Hud.button(p.list, q.label .. " · " .. Damage.jsround(q.cond) .. "% " .. w .. "\n" .. q.eff .. " · Repair " .. fmt(q.price) .. " JD", function()
					repair({ q.id })
				end, 390, 44, cash < q.price and Color3.fromRGB(60, 62, 70) or Color3.fromRGB(60, 80, 110))
				b.Name = "Repair_" .. q.id
				b.TextSize = 13
				b.LayoutOrder = order
			end
			order += 1
			local all = Hud.button(p.list, "Repair all · " .. fmt(total) .. " JD" .. (cash < total and " (not enough balance)" or ""), function() repair("*") end, 390, 34,
				cash < total and Color3.fromRGB(60, 62, 70) or Color3.fromRGB(43, 107, 58))
			all.Name = "RepairAll"
			all.LayoutOrder = order
		end
		order += 1
		local ins = Hud.button(p.list, (inspect and "▾" or "▸") .. " 🔍 Full inspection: every part (42)", function()
			inspect = not inspect
			fill()
		end, 390, 30, Color3.fromRGB(50, 56, 66))
		ins.Name = "Inspect"
		ins.LayoutOrder = order
		if inspect and rec then
			for _, q in ipairs(Damage.inspectRows(rec, car)) do
				local w, c = Diagnostics.sev(q.cond)
				local l = text(q.label .. " · " .. Damage.jsround(q.cond) .. "% " .. w .. (q.price > 0 and (" · repair " .. fmt(q.price) .. " JD") or " · OK, no charge"), 18, c)
				l.Name = "Inspect_" .. q.id
				l.TextSize = 13
			end
		end
	end
	fill = function()
		for _, ch in ipairs(p.list:GetChildren()) do
			if ch:IsA("GuiObject") then ch:Destroy() end
		end
		local bank = plr:GetAttribute("DriftBank") or 0
		local lv = CarInfo.levels()
		p.sub.Text = "Drift bank: " .. fmt(bank) .. " points · " .. State.spec.name .. " (" .. CarInfo.tierLine(Config.CARS[plr:GetAttribute("CurCar") or 1]) .. ")"
		for k, u in ipairs(Config.UPGRADES) do
			local l = lv[k]
			local max = l >= Config.UPGRADE_MAX
			local price = Config.upgradePrice(k, l)
			local txt = u.name .. " · level " .. (l + 1) .. (max and " (MAX)" or "") .. "\n" .. u.info .. (max and "" or (" · next: " .. fmt(price) .. " pts"))
			local b = Hud.button(p.list, txt, function()
				if max then return end
				local ok, msg = Remotes.CarAction:InvokeServer("upgrade", k)
				Hud.toast(ok and (u.name .. " → level " .. (tonumber(msg) + 1)) or tostring(msg))
				fill()
			end, 370, 52, (max or bank < price) and Color3.fromRGB(60, 62, 70) or nil)
			b.TextSize = 14
			b.LayoutOrder = k
		end
		repairs(#Config.UPGRADES)
	end
	fill()
end

return TuneShop
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX153"><Properties><string name="Name">Weather</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - weather and the Irbid local clock on this device (the web game's 12f_weather.js). SIMULATED weather, not live:
-- "Auto" follows the server's roll (Game/Weather: the Irbid climate table by month), or the player picks Clear / Cloudy / Rain (setting
-- "wx"). The sky eases like the web game's: cloud cover over ~20 s, rain over ~12 s; the road gets wet while it rains (fully wet after
-- ~40 s of heavy rain) and dries in ~4 minutes. Physics: ONLY Realistic handling feels the wet road (peak tyre grip x0.72 when fully wet,
-- an estimate from published wet / dry friction ratios); Arcade never changes. Visuals: clouds, a greyer and darker sky, a shorter view,
-- rain streaks around the camera, darker and shinier roads. Clock (setting "clk"): the shared game clock, or Irbid's real local time
-- (Asia/Amman, UTC+3) on this device only; T switches back to game time (as in the web game).
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("Hud"))
local Settings = require(Client:WaitForChild("Settings"))

local Weather = {}
local S = Config.SCALE
local CLIM = { 11.3, 10.6, 9.4, 4.6, 2, 0.2, 0, 0, 0.2, 3.2, 6, 9.6 }
local MON = { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" }
local MODES = { "auto", "clear", "cloudy", "rain" }
local WX = { st = "clear", cov = 0, rain = 0, wet = 0, mu = 1, tc = 0, tr = 0, lw = -1, mon = 0, lh = nil, lt = 0 }
Weather.state = WX
State.weather = WX
Settings.provide("wx", "clk")

-- Irbid's local time (hours) and month (0-11): UTC+3, as the web game's fallback (Jordan keeps UTC+3 all year)
function Weather.ammanNow()
	local d = os.date("!*t", os.time() + 3 * 3600)
	return d.hour + d.min / 60 + d.sec / 3600, d.month - 1
end
WX.mon = select(2, Weather.ammanNow())

local function pick(st)
	WX.st = st
	WX.tc = st == "rain" and 0.95 or st == "cloudy" and 0.55 or 0.06 * math.random()
	WX.tr = st == "rain" and 0.55 + 0.45 * math.random() or 0
end

Settings.onChange(function(k, v)
	if k == "wx" and v ~= 0 then
		pick(MODES[v + 1])
	elseif k == "clk" then
		WX.lh = nil
	end
end)

-- the look of a dry day (World/Sky) and of a grey one
local base = nil
local GREY = Color3.fromRGB(153, 163, 173)
local function lighting()
	if base then return base end
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	base = { br = Lighting.Brightness, amb = Lighting.OutdoorAmbient, atm = atm, den = atm and atm.Density or 0, haze = atm and atm.Haze or 0,
		col = atm and atm.Color or Color3.new(1, 1, 1) }
	return base
end

-- rain: one particle emitter on an invisible box that follows the camera (the web game: one draw of streaks wrapped around the camera)
local rainBox = nil
local function rainEmitter()
	if rainBox then return rainBox end
	local p = Instance.new("Part")
	p.Name = "RainBox"
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Transparency = 1
	p.Size = Vector3.new(64 * S, 1, 64 * S)
	local e = Instance.new("ParticleEmitter")
	e.Name = "Rain"
	e.Texture = "rbxasset://textures/particles/SquareParticle.png"
	e.Color = ColorSequence.new(Color3.fromRGB(184, 194, 209))
	e.Transparency = NumberSequence.new(0.55)
	e.Size = NumberSequence.new(0.08)
	e.Squash = NumberSequence.new(3)
	e.Orientation = Enum.ParticleOrientation.VelocityParallel
	e.EmissionDirection = Enum.NormalId.Bottom
	e.Speed = NumberRange.new(15 * S, 17 * S)
	e.Lifetime = NumberRange.new(1.4, 1.6)
	e.LightInfluence = 0.6
	e.Rate = 0
	e.Parent = p
	p.Parent = Workspace.CurrentCamera
	rainBox = p
	return p
end

-- wet roads: colour darker (x(1 - 0.22 wet)) and shinier, a slice of the road pieces per frame (the change is slow)
local roads, roadBase, roadI, roadWet = nil, {}, 0, 0
local function wetRoads()
	if not roads then
		local map = Workspace:FindFirstChild("IrbidMap")
		local f = map and map:FindFirstChild("Roads")
		if not f then return end
		roads = f:GetChildren()
	end
	if roadI == 0 then
		if math.abs(WX.wet - WX.lw) <= 0.02 then return end
		WX.lw = WX.wet
		roadWet = WX.wet
		roadI = 1
	end
	local k = 1 - 0.22 * roadWet
	for _ = 1, 1500 do
		local p = roads[roadI]
		if not p then
			roadI = 0
			return
		end
		local c = roadBase[p]
		if not c then
			c = p.Color
			roadBase[p] = c
		end
		p.Color = Color3.new(c.R * k, c.G * k, c.B * k)
		p.Reflectance = 0.25 * roadWet
		roadI += 1
	end
end

-- headlights follow this device's clock (the local clock can differ from the server's)
local night = nil
local function headlights(h)
	local n = h < 6.3 or h > 18.2
	if n == night then return end
	night = n
	for _, m in ipairs(Workspace:GetChildren()) do
		if m:IsA("Model") and string.sub(m.Name, 1, 4) == "Car_" then
			for _, l in ipairs(m:GetDescendants()) do
				if l:IsA("SpotLight") then l.Enabled = n end
			end
		end
	end
end

function Weather.step(dt)
	local mode = Settings.get("wx")
	if mode == 0 then
		WX.tc = Workspace:GetAttribute("WxTc") or 0
		WX.tr = Workspace:GetAttribute("WxTr") or 0
		WX.st = Workspace:GetAttribute("WxSt") or "clear"
	elseif WX.st ~= MODES[mode + 1] then
		pick(MODES[mode + 1])
	end
	-- the web game's easing, wetting and drying
	local k = math.min(1, dt / 20)
	WX.cov += (WX.tc - WX.cov) * k
	WX.rain += (WX.tr - WX.rain) * math.min(1, dt / 12)
	-- the web game snaps a fading shower to 0 below 0.003 and, by mistake, a starting one too (its first step from 0 is about 0.001 at
	-- any frame rate, so in the web build v49 rain never starts: checked headless, 45 s of "Rain" -> rain 0.000). Here only a fading
	-- shower snaps, as the web game describes it (README: "Rain greys the sky, shortens the view, draws rain and makes the roads darker")
	if WX.rain < 0.003 and WX.tr < WX.rain then WX.rain = 0 end
	WX.wet = WX.rain > 0.08 and math.min(1, WX.wet + dt * WX.rain / 40) or math.max(0, WX.wet - dt / 240)
	WX.mu = 1 - 0.28 * WX.wet
	-- the physics (Realistic only reads it)
	local P = State.phys
	if P then P.wx.mu, P.wx.wet = WX.mu, WX.wet end
	-- the clock
	if Settings.get("clk") == 1 then
		WX.lt -= dt
		if WX.lt <= 0 or WX.lh == nil then
			WX.lt = 1
			WX.lh, WX.mon = Weather.ammanNow()
		else
			WX.lh = (WX.lh + dt / 3600) % 24
		end
		Lighting.ClockTime = WX.lh
	else
		WX.mon = Workspace:GetAttribute("WxMon") or WX.mon
	end
	headlights(Lighting.ClockTime)
	-- the sky: greyer and darker with cloud cover, a shorter view in rain
	local b = lighting()
	local c, r = WX.cov, WX.rain
	local el = Lighting:GetSunDirection().Y
	local dayF = math.clamp(el * 4 + 0.2, 0, 1)
	Lighting.Brightness = b.br * (1 - 0.75 * c)
	Lighting.OutdoorAmbient = b.amb:Lerp(GREY:Lerp(Color3.new(), 1 - (0.08 + 0.92 * dayF)), c * 0.65)
	if b.atm then
		b.atm.Density = b.den + 0.3 * r + 0.08 * c
		b.atm.Haze = b.haze + 1.2 * c
		b.atm.Color = b.col:Lerp(Color3.fromRGB(176, 182, 188), c)
	end
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if terrain then
		local cl = terrain:FindFirstChildOfClass("Clouds")
		if not cl then
			cl = Instance.new("Clouds")
			cl.Parent = terrain
		end
		cl.Cover = math.clamp(c * 0.95, 0, 1)
		cl.Density = 0.3 + 0.5 * c
		cl.Color = Color3.new(1, 1, 1):Lerp(Color3.fromRGB(120, 128, 136), c)
	end
	-- rain streaks around the camera
	local box = rainEmitter()
	local cam = Workspace.CurrentCamera
	box.Rain.Rate = r > 0.02 and 1800 * math.min(1, r * 1.3) or 0
	if r > 0.02 and cam then box.CFrame = CFrame.new(cam.CFrame.Position + Vector3.new(0, 16 * S, 0)) end
	wetRoads()
end

-- T: in local-clock mode, back to the game clock first (the web game)
function Weather.onHourKey()
	if Settings.get("clk") == 1 then
		Settings.set("clk", 0)
		Hud.toast("Clock: game time (T moves it on)")
	end
end

-- the web game's weather line (shown in the settings menu)
function Weather.line()
	local now = WX.rain > 0.08 and "raining" or WX.cov > 0.3 and "cloudy" or "clear"
	local mode = Settings.get("wx")
	local real = State.phys and State.phys.mode == 1
	return (mode == 0 and "Auto (Irbid seasons)" or ("Chosen: " .. MODES[mode + 1])) .. " · now " .. now
		.. " · road " .. (WX.wet > 0.05 and ("wet " .. math.floor(WX.wet * 100 + 0.5) .. "%" .. (real and (" (grip −" .. math.floor((1 - WX.mu) * 100 + 0.5) .. "%)") or " (grip unchanged in Arcade)")) or "dry")
		.. " · simulated, not live: " .. MON[WX.mon + 1] .. " averages " .. CLIM[WX.mon + 1] .. " rain days in Irbid (JMD 1985–2018)"
end

return Weather
]]></ProtectedString></Properties></Item></Item><Item class="LocalScript" referent="RBX155"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Irbid Drive (Roblox) - the player's device: loads the road graph, starts the modules in Client/ and runs them every frame.
-- What each module does is written at the top of its file. Order of a frame: controls -> the player's car (Drive) -> traffic ->
-- races / heist (Missions) -> street name, GPS, minimap (Nav) -> camera -> info line -> messages.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Road = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Road"))
local Shared = ReplicatedStorage:WaitForChild("IrbidShared")
local Client = script.Parent:WaitForChild("Client")
local State = require(Client:WaitForChild("State"))
local Meta = require(Shared:WaitForChild("Meta"))

local plr = Players.LocalPlayer

-- the road graph (traffic, GPS, minimap, street names, reset)
do
	local edges, i = {}, 1
	while Shared:FindFirstChild("GraphEdges" .. i) do
		edges[#edges + 1] = require(Shared["GraphEdges" .. i])
		i += 1
	end
	State.road = Road.build(require(Shared:WaitForChild("GraphNodes")), edges, require(Shared:WaitForChild("GraphNames")))
end
local Signals = require(Client:WaitForChild("Signals"))
Signals.attach(State.road)
while not Workspace:GetAttribute("MapReady") do task.wait(0.25) end

local Hud = require(Client:WaitForChild("Hud"))
local Controls = require(Client:WaitForChild("Controls"))
local Drive = require(Client:WaitForChild("Drive"))
local Traffic = require(Client:WaitForChild("Traffic"))
local Nav = require(Client:WaitForChild("Nav"))
local Missions = require(Client:WaitForChild("Missions"))
local Menus = require(Client:WaitForChild("Menus"))
local InfoLine = require(Client:WaitForChild("InfoLine"))
local Extras = require(Client:WaitForChild("Extras"))
local Handling = require(Client:WaitForChild("Handling"))
local SettingsMenu = require(Client:WaitForChild("SettingsMenu"))
local Weather = require(Client:WaitForChild("Weather"))
local Gamepad = require(Client:WaitForChild("Gamepad"))
local CarAudio = require(Client:WaitForChild("CarAudio"))
local Camera = require(Client:WaitForChild("Camera"))
local Bump = require(Client:WaitForChild("Bump"))
local CarDamage = require(Client:WaitForChild("CarDamage"))
local CarDamageFx = require(Client:WaitForChild("CarDamageFx"))
local Diagnostics = require(Client:WaitForChild("Diagnostics"))
local SpeedBumps = require(Client:WaitForChild("SpeedBumps"))
local Reputation = require(Client:WaitForChild("Reputation"))
local AutoDrive = require(Client:WaitForChild("AutoDrive"))
local School = require(Client:WaitForChild("School"))
local TrafficDensity = require(Client:WaitForChild("TrafficDensity"))
require(Client:WaitForChild("Accessibility"))
local Props = require(Client:WaitForChild("Props"))
local Race = require(Client:WaitForChild("Race"))
local Laws = require(Client:WaitForChild("Laws"))
-- the weather line in the settings menu (the web game's pause menu shows it under the weather row)
table.insert(SettingsMenu.extra, { name = "weather", text = Weather.line, click = function() end, color = Color3.fromRGB(40, 60, 80) })
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

-- the tuning shop opens only at Apex Drift Customs
function Missions.openShop()
	if Missions.nearShop() then
		Menus.shop()
	else
		Hud.toast("Apex Drift Customs is the orange pad: find it on the minimap")
	end
end

Controls.start({
	reset = Drive.reset, camera = Drive.cycleCam, wheel = Menus.wheel, garage = Menus.garage, gps = Nav.open,
	nextCar = function() Extras.cycleCar(1) end, prevCar = function() Extras.cycleCar(-1) end,
	tour = Extras.tour, ramps = Extras.ramps, hour = function()
		Weather.onHourKey()
		Extras.hour()
	end, horn = Extras.horn,
	race = Missions.race, shop = Missions.openShop,
	eKey = function() Handling.eKey(Missions.rob) end, gearDown = function() Handling.shift(-1) end,
	handling = Handling.toggle, settings = SettingsMenu.open, mute = CarAudio.toggleMute,
	damage = CarDamage.cycle, diag = Diagnostics.toggle, autodrive = AutoDrive.toggle,
})

Traffic.start()
Traffic.density(TrafficDensity.den(), false)
Hud.toast("Welcome to Irbid! Drift for points · R race / duel · M GPS · G wheel · K tour · F start", 6)

local ai = State.ai
-- vehicle damage: the physics hooks, impacts with walls (Drive) and cars (Bump) -> sound + damage, hard landings, speed bumps (the
-- thump is heard whenever the suspension bottoms out, as in the web game), the looks, the Damage / Repair buttons
Drive.damage = CarDamage
table.insert(CarDamage.changed, CarDamageFx.refresh)
CarDamage.onImpact = function(r, v) CarDamageFx.sparks(r, v) end
Drive.onWall = function(v, nx, nz, part)
	CarAudio.hit(v)
	CarDamage.wall(v, nx, nz, part)
end
Bump.onImpact = function(v, _, nx, nz)
	CarAudio.hit(v)
	CarDamage.vehicle(v, nx, nz)
end
Drive.onLand = CarDamage.landing
SpeedBumps.onImpact = function(speed, sev, axle)
	CarAudio.bump(sev)
	CarDamage.speedBump(speed, sev, axle)
end
-- road reputation and rival memory; auto-drive takes the controls unless the player gives any input (the web game: above 0.15)
Laws.onFine = function(k)
	Reputation.event(k)
	School.onFine(k)
end
table.insert(SettingsMenu.extra, { name = "school", text = function() return "🎓 Driving school (5 lessons on real streets)" end, click = School.menu, color = Color3.fromRGB(30, 90, 60) })
Race.onStart = Reputation.raceStart
Race.onFinish = Reputation.raceEnd
Reputation.onHonk = CarAudio.honkAt
table.insert(SettingsMenu.extra, { name = "reputation", text = Reputation.line, click = function() end, color = Color3.fromRGB(40, 60, 80) })
Controls.after = function(inp, dt)
	local user = inp.th > 0.15 or inp.br > 0.15 or math.abs(inp.steer) > 0.15 or inp.hb
	AutoDrive.apply(inp, user, dt)
end
Diagnostics.buttons(Missions.openShop, Missions.nearShop, function()
	Nav.go({ n = "Apex Drift Customs", x = Meta.shop.x, z = Meta.shop.z })
end)
RunService.RenderStepped:Connect(function(dt)
	Controls.read(dt)
	-- every AI car of this frame, for bumping, following and the minimap
	table.clear(ai)
	for _, a in ipairs(Traffic.agents) do ai[#ai + 1] = a end
	for _, a in ipairs(Missions.rivals) do ai[#ai + 1] = a end
	for _, a in ipairs(Missions.cops) do ai[#ai + 1] = a end
	for _, a in ipairs(Missions.duelRivals) do ai[#ai + 1] = a end
	Drive.step(dt)
	Handling.step()
	Gamepad.rumble(dt)
	Weather.step(dt)
	Reputation.step(dt)
	School.step(dt)
	TrafficDensity.step(dt)
	Props.step(dt)
	CarDamage.step(dt)
	State.damageSmoke = CarDamage.smoking
	CarDamageFx.step(dt, CarDamage.mode(), CarDamage.tyres)
	CarAudio.step(dt, Drive.paved(), Camera.mode())
	Traffic.step(dt)
	Missions.step(dt)
	Nav.step(dt)
	Signals.step()
	Drive.camera(dt)
	InfoLine.step(dt)
	Hud.step(dt)
end)

-- keep the seat: if the player somehow stands up, the server seats them again
plr.CharacterAdded:Connect(function()
	task.wait(1)
	if State.car and not State.car.Parent then Remotes.ResetCar:FireServer() end
end)
]]></ProtectedString></Properties></Item></Item></Item></roblox>
