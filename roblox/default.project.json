{
  "name": "IrbidDrive",
  "tree": {
    "$className": "DataModel",
    "Workspace": { "$properties": { "StreamingEnabled": false } },
    "ReplicatedStorage": {
      "$path": "src/ReplicatedStorage",
      "IrbidShared": { "$path": "shared" }
    },
    "ServerStorage": { "IrbidData": { "$path": "data" } },
    "ServerScriptService": { "$path": "src/ServerScriptService" },
    "StarterPlayer": { "StarterPlayerScripts": { "$path": "src/StarterPlayerScripts" } }
  }
}
